ules[0].args == [7]\n\n\ndef test_set_renderfunc_rerenders_every_style_attribute():\n    \"\"\"Lines 153-156: every Style attribute is re-rendered, others are not.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    reg.style_a = Register.Style(DummyRule(1))\n    reg.style_b = Register.Style(DummyRule(2, 3))\n    reg.plain = \"not-a-style\"\n    assert reg.style_a == \"<dummy(1)>\"\n    assert reg.style_b == \"<dummy(2,3)>\"\n\n    reg.set_renderfunc(DummyRule, other_renderer)\n\n    assert reg.renderfuncs == {DummyRule: other_renderer}\n    assert reg.style_a == \"<other(1)>\"\n    assert reg.style_b == \"<other(2,3)>\"\n    assert reg.plain == \"not-a-style\"\n\n\ndef test_set_renderfunc_while_muted_keeps_styles_empty():\n    \"\"\"set_renderfunc must also re-set (empty) styles while muted.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    reg.mystyle = Register.Style(DummyRule(1))\n    assert reg.mystyle == \"<dummy(1)>\"\n\n    reg.mute()\n    assert reg.is_muted is True\n    assert reg.mystyle == \"\"\n\n    # Re-registering a renderfunc while muted re-sets the styles, which\n    # renders them to empty strings (lines 150-156).\n    reg.set_renderfunc(DummyRule, other_renderer)\n\n    assert reg.renderfuncs == {DummyRule: other_renderer}\n    assert reg.mystyle == \"\"\n\n    reg.unmute()\n    assert reg.is_muted is False\n    assert reg.mystyle == \"<other(1)>\"\n```",
