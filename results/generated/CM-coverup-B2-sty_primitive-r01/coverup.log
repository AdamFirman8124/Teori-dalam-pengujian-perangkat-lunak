l_rules` where `original_rules = (DummyRule(1, 2), OtherRule(\"x\"))` captured before? Since tuple equality on custom objects without `__eq__` uses identity, and the same objects are reused, this works. But my type/args assertions are clearer. Keep those.\n\nAlso for test 2: `reg.mystyle.rules[0].args == [7]` \u2014 the rule object is the same `DummyRule(7)` instance created before; its args remain `[7]`. \u2713\n\nDouble-check `other_renderer(7)` \u2192 `\"<other(7)>\"`. \u2713\n\nAnd in test 3: `other_renderer(2, 3)` \u2192 `\"<other(2|3)>\"`. \u2713\n\nFinal code:\n\n```python\n\"\"\"\nTests for `Register.set_renderfunc` in sty/primitive.py.\n\nThe tests only ever mutate *locally created* Register instances, so the\nglobal sty registers (fg, bg, ef, rs) and their renderfuncs are never\ntouched and no cleanup/monkeypatching is required to avoid state pollution.\n\"\"\"\n\nfrom sty.primitive import Register\nfrom sty.rendertype import RenderType\n\n\nclass DummyRule(RenderType):\n    \"\"\"Custom render type; instances store their args like the built-in types.\"\"\"\n\n    def __init__(self, *args):\n        self.args = list(args)\n\n\nclass OtherRule(RenderType):\n    \"\"\"A second custom render type.\"\"\"\n\n    def __init__(self, *args):\n        self.args = list(args)\n\n\ndef dummy_renderer(*args):\n    return \"<dummy({})>\".format(\",\".join(str(a) for a in args))\n\n\ndef other_renderer(*args):\n    return \"<other({})>\".format(\"|\".join(str(a) for a in args))\n\n\ndef test_set_renderfunc_adds_func_and_rerenders_existing_styles():\n    \"\"\"Lines 150-156: a new renderfunc is stored and styles are re-rendered.\"\"\"\n    reg = Register()\n    assert reg.renderfuncs == {}\n\n    # First call: no Style attribute exists yet, so the loop over dir(self)\n    # runs (lines 153-155, isinstance-branch False) but line 156 is not hit.\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    assert reg.renderfuncs == {DummyRule: dummy_renderer}\n\n    # Attach a Style attribute that mixes a registered and an unregistered\n    # rule type; only the registered one contributes to the rendered string.\n    reg.mystyle = Register.Style(DummyRule(1, 2), OtherRule(\"x\"))\n    assert isinstance(reg.mystyle, Register.Style)\n    assert reg.mystyle == \"<dummy(1,2)>\"\n\n    # A plain (non-Style) attribute that set_renderfunc must leave alone.\n    reg.plain = \"keep-me\"\n\n    # Second call: a Style attribute now exists, so line 156 executes and\n    # the style is re-rendered with the newly registered function.\n    reg.set_renderfunc(OtherRule, other_renderer)\n\n    # Line 150: the renderfunc mapping contains both entries.\n    assert reg.renderfuncs == {\n        DummyRule: dummy_renderer,\n        OtherRule: other_renderer,\n    }\n    # Lines 153-156: the style was re-set and re-rendered with both funcs.\n    assert reg.mystyle == \"<dummy(1,2)><other(x)>\"\n    assert isinstance(reg.mystyle, Register.Style)\n    # The styling rules survive the re-render unchanged.\n    assert [type(rule) for rule in reg.mystyle.rules] == [DummyRule, OtherRule]\n    assert reg.mystyle.rules[0].args == [1, 2]\n    assert reg.mystyle.rules[1].args == [\"x\"]\n    # The non-Style attribute is untouched.\n    assert reg.plain == \"keep-me\"\n\n\ndef test_set_renderfunc_replaces_existing_func():\n    \"\"\"Line 150 also covers replacing an already registered renderfunc.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    reg.mystyle = Register.Style(DummyRule(7))\n    assert reg.mystyle == \"<dummy(7)>\"\n\n    # Replace the renderfunc for DummyRule; the existing style must be\n    # re-rendered with the new function (lines 153-156).\n    reg.set_renderfunc(DummyRule, other_renderer)\n\n    assert reg.renderfuncs == {DummyRule: other_renderer}\n    assert reg.mystyle == \"<other(7)>\"\n    assert isinstance(reg.mystyle, Register.Style)\n    assert reg.mystyle.rules[0].args == [7]\n\n\ndef test_set_renderfunc_rerenders_every_style_attribute():\n    \"\"\"Lines 153-156: every Style attribute is re-rendered, others are not.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    reg.style_a = Register.Style(DummyRule(1))\n    reg.style_b = Register.Style(DummyRule(2, 3))\n    reg.plain = \"not-a-style\"\n    assert reg.style_a == \"<dummy(1)>\"\n    assert reg.style_b == \"<dummy(2,3)>\"\n\n    reg.set_renderfunc(DummyRule, other_renderer)\n\n    assert reg.renderfuncs == {DummyRule: other_renderer}\n    assert reg.style_a == \"<other(1)>\"\n    assert reg.style_b == \"<other(2,3)>\"\n    assert reg.plain == \"not-a-style\"\n\n\ndef test_set_renderfunc_while_muted_keeps_styles_empty():\n    \"\"\"set_renderfunc must also re-set (empty) styles while muted.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(DummyRule, dummy_renderer)\n    reg.mystyle = Register.Style(DummyRule(1))\n    assert reg.mystyle == \"<dummy(1)>\"\n\n    reg.mute()\n    assert reg.mystyle == \"\"\n\n    # Re-registering a renderfunc while muted re-sets the styles, which\n    # renders them to empty strings (lines 150-156).\n    reg.set_renderfunc(DummyRule, other_renderer)\n\n    assert reg.renderfuncs == {DummyRule: other_renderer}\n    assert reg.mystyle == \"\"\n\n    reg.unmute()\n    assert reg.mystyle == \"<other(1)>\"\n```\n\nWait, one thing in the muted test: after `reg.mute()`, is `reg.mystyle == \"\"` guaranteed? `mute` sets `is_muted = True` then re-sets styles \u2192 `__setattr__` \u2192 muted branch \u2192 `Style(*value.rules, value=\"\")` \u2192 \"\". Yes.\n\nThen `set_renderfunc` while muted: loop \u2192 `setattr(reg, 'mystyle', val)` \u2192 `__setattr__` \u2192 muted \u2192 \"\". \u2713\n\nThen `unmute()`: `is_muted = False`, loop re-sets \u2192 `__setattr__` \u2192 renders with renderfuncs = {DummyRule: other_renderer} \u2192 `other_renderer(1)` = `\"<other(1)>\"`. \u2713\n\nHmm, but wait \u2014 in `unmute`, the loop does `setattr(self, attr_name, val)` where val