erything defensively:\n\n```python\nimport sty\nfrom sty import Register, Style\nfrom sty.rendertype import Sgr\n```\n\nIf `from sty import Register, Style` fails, the whole test module errors \u2014 but I'm confident it works (they're the core public API).\n\nNow, final test file:\n\n```python\n\"\"\"Coverage tests for sty.primitive.Register.mute (previously uncovered lines 163-168).\n\nThe tests operate exclusively on locally created Register objects, so no global\nsty state (fg, bg, ef, rs) is touched and no cleanup/monkeypatching is required.\n\"\"\"\n\nfrom sty import Register, Style\nfrom sty.rendertype import Sgr\n\n\ndef _render_sgr(*args):\n    \"\"\"Render an Sgr rule into an ANSI escape sequence.\n\n    sty may invoke registered renderfuncs either with the rule object itself\n    or with its unpacked constructor values; support both conventions so the\n    test does not depend on that internal detail.\n    \"\"\"\n    if len(args) == 1 and hasattr(args[0], \"values\"):\n        values = tuple(args[0].values)\n    else:\n        values = args\n    return \"\\x1b[\" + \";\".join(str(v) for v in values) + \"m\"\n\n\ndef _make_register():\n    \"\"\"Build a fresh Register holding two Style attributes.\"\"\"\n    reg = Register()\n    reg.set_renderfunc(Sgr, _render_sgr)\n    red_rule = Sgr(31)\n    bold_rule = Sgr(1)\n    reg.red = Style(red_rule)\n    reg.bold = Style(bold_rule)\n    return reg, red_rule, bold_rule\n\n\ndef test_mute_executes_full_loop_and_blanks_style_attributes():\n    \"\"\"mute() must set is_muted and re-set every Style attribute (lines 163-168).\"\"\"\n    reg, red_rule, bold_rule = _make_register()\n\n    # Pre-conditions: unmuted register with rendering Style attributes.\n    assert reg.is_muted is False\n    assert isinstance(reg.red, Style)\n    assert isinstance(reg.bold, Style)\n    assert reg.red != \"\"\n    assert reg.bold != \"\"\n    assert reg.red.rules == (red_rule,)\n    assert reg.bold.rules == (bold_rule,)\n    assert reg(\"red\") == reg.red\n\n    reg.mute()\n\n    # Line 163: the mute flag is set.\n    assert reg.is_muted is True\n\n    # Lines 165-168: every attribute was inspected; the Style attributes were\n    # re-set through __setattr__, which (while muted) stores them with an\n    # empty string value while preserving their styling rules.\n    assert isinstance(reg.red, Style)\n    assert reg.red == \"\"\n    assert reg.red.rules == (red_rule,)\n\n    assert isinstance(reg.bold, Style)\n    assert reg.bold == \"\"\n    assert reg.bold.rules == (bold_rule,)\n\n    # Non-Style attributes are left untouched by the loop.\n    assert reg.renderfuncs[Sgr] is _render_sgr\n\n    # A muted register renders nothing when called.\n    assert reg(\"red\") == \"\"\n\n\ndef test_mute_on_register_without_style_attributes():\n    \"\"\"The loop in mute() must also handle registers without any Style attribute.\"\"\"\n    reg = Register()\n    reg.mute()\n    assert reg.is_muted is True\n    assert reg(1) == \"\"  # muted registers swallow all calls\n\n\ndef test_mute_then_unmute_restores_rendering():\n    \"\"\"unmute() reverses mute() by re-rendering the preserved rules.\"\"\"\n    reg, _red_rule, _bold_rule = _make_register()\n    reg.mute()\n    assert reg.is_muted is True\n    assert reg.red == \"\"\n\n    reg.unmute()\n\n    assert reg.is_muted is False\n    assert isinstance(reg.red, Style)\n    assert reg.red != \"\"\n    assert reg(\"red\") == reg.red\n```\n\nWait, in `test_mute_on_register_without_style_attributes`, `reg(1)` \u2014 `__call__` \u2192 muted \u2192 ''. \u2713. But hmm, does this test improve coverage of 163-168? It covers 163-167 (loop with only False isinstance branches). The main test covers 168. Together, full coverage. \u2713\n\nHmm, one thing: in test 3, after `reg.unmute()`, `reg.red` is re-rendered. `reg(\"red\") == reg.red` \u2014 `__call__` returns `getattr(reg, 'red')` = reg.red. Trivially equal. It verifies the dispatch works unmuted. OK.\n\nAlso `assert re