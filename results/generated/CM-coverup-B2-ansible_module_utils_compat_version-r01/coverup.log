or maybe a class \u2014 plain functions are fine).\n\n```python\n\"\"\"Tests for StrictVersion._cmp in ansible/module_utils/compat/version.py.\n\nCovers lines 170-203: every branch of the comparison logic, including the\ndefensive \"never get here\" assertion.\n\"\"\"\n\nimport pytest\n\nfrom ansible.module_utils.compat.version import StrictVersion\n\n\ndef test_cmp_coerces_string_operand():\n    # Lines 170-171: a str operand is converted to StrictVersion.\n    assert StrictVersion('1.0')._cmp('1.0') == 0\n    assert StrictVersion('1.0')._cmp('0.9') == 1\n    assert StrictVersion('1.0')._cmp('1.1') == -1\n\n\ndef test_cmp_returns_not_implemented_for_unsupported_type():\n    # Lines 172-173: operand is neither str nor StrictVersion.\n    assert StrictVersion('1.0')._cmp(123) is NotImplemented\n    assert StrictVersion('1.0')._cmp(None) is NotImplemented\n    assert StrictVersion('1.0')._cmp((1, 0)) is NotImplemented\n\n\ndef test_cmp_numeric_version_less_than():\n    # Lines 178-179: numeric versions differ, self < other.\n    assert StrictVersion('1.0')._cmp(StrictVersion('2.0')) == -1\n\n\ndef test_cmp_numeric_version_greater_than():\n    # Line 181: numeric versions differ, self > other.\n    assert StrictVersion('2.0')._cmp(StrictVersion('1.0')) == 1\n\n\ndef test_cmp_equal_versions_without_prerelease():\n    # Lines 189-190: neither side has a prerelease.\n    assert StrictVersion('1.0')._cmp(StrictVersion('1.0')) == 0\n\n\ndef test_cmp_prerelease_against_release_is_older():\n    # Lines 191-192: self has a prerelease, other does not.\n    assert StrictVersion('1.0a1')._cmp(StrictVersion('1.0')) == -1\n\n\ndef test_cmp_release_against_prerelease_is_newer():\n    # Lines 193-194: other has a prerelease, self does not.\n    assert StrictVersion('1.0')._cmp(StrictVersion('1.0a1')) == 1\n\n\ndef test_cmp_identical_prereleases_are_equal():\n    # Lines 196-197: both have the same prerelease.\n    assert StrictVersion('1.0a1')._cmp(StrictVersion('1.0a1')) == 0\n\n\nd