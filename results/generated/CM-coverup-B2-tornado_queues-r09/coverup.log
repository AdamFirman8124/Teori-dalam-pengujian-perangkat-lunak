        "content": "```python\nimport pytest\n\nfrom tornado.concurrent import Future\nfrom tornado.queues import Queue, QueueFull\n\n\ndef test_put_nowait_delivers_item_to_waiting_getter():\n    queue = Queue()\n    getter = queue.get()\n\n    assert not getter.done()\n    assert queue.empty()\n\n    queue.put_nowait(\"item\")\n\n    assert getter.done()\n    assert getter.result() == \"item\"\n    assert queue.empty()\n\n    queue.task_done()\n    assert queue.join().done()\n\n\ndef test_put_nowait_raises_when_queue_is_full():\n    queue = Queue(maxsize=1)\n    queue.put_nowait(\"first\")\n\n    assert queue.full()\n\n    with pytest.raises(QueueFull):\n        queue.put_nowait(\"second\")\n\n    assert queue.qsize() == 1\n    assert queue.get_nowait() == \"first\"\n\n    queue.task_done()\n    assert queue.join().done()\n\n\ndef test_put_nowait_enqueues_item_when_space_is_available():\n    queue = Queue(maxsize=2)\n\n    queue.put_nowait(\"item\")\n\n    assert queue.qsize() == 1\n    assert queue.get_nowait() == \"item\"\n    assert queue.empty()\n\n    queue.task_done()\n    assert queue.join().done()\n\n\ndef test_put_nowait_rejects_nonempty_queue_with_waiting_getter():\n    queue = Queue()\n    queue.put_nowait(\"existing\")\n    getter = Future()\n    queue._getters.append(getter)\n\n    try:\n        with pytest.raises(\n            AssertionError, match=\"queue non-empty, why are getters waiting\"\n        ):\n            queue.put_nowait(\"new\")\n\n        assert queue.qsize() == 1\n        assert not getter.done()\n    finally:\n        if getter in queue._getters:\n            queue._getters.remove(getter)\n        if not getter.done():\n            getter.cancel()\n\n        assert queue.get_nowait() == \"existing\"\n        queue.task_done()\n\n    assert queue.empty()\n    assert queue.join().done()\n```",
