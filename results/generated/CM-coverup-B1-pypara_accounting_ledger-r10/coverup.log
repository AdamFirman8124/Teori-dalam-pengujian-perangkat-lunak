itial one.\"\"\"\n    account = StubAccount(\"200\", \"Sales\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"0\")))\n    ledger = Ledger(account, initial)\n\n    first = ledger.add(_make_posting(account, Direction.DEBIT, Decimal(\"30\")))\n    second = ledger.add(_make_posting(account, Direction.CREDIT, Decimal(\"10\")))\n\n    assert first.balance == Quantity(Decimal(\"30\"))\n    assert second.balance == Quantity(Decimal(\"20\"))\n    assert ledger.entries == [first, second]\n    assert ledger._last_balance == Quantity(Decimal(\"20\"))\n\n\ndef test_add_credit_on_empty_ledger_decreases_initial_balance():\n    \"\"\"A credit posting on an empty ledger must subtract from the initial balance.\"\"\"\n    account = StubAccount(\"300\", \"Payables\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"500\")))\n    ledger = Ledger(account, initial)\n\n    entry = ledger.add(_make_posting(account, Direction.CREDIT, Decimal(\"120\")))\n\n    assert entry.balance == Quantity(Decimal(\"380\"))\n    assert len(ledger.entries) == 1\n    assert ledger._last_balance == Quantity(Decimal(\"380\"))\n```",
