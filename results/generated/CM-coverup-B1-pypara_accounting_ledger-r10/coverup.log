        "content": "```python\nimport datetime\nfrom decimal import Decimal\n\nfrom pypara.accounting.generic import Balance, Ledger\nfrom pypara.accounting.journaling import Direction, JournalEntry, Posting\nfrom pypara.commons.numbers import Amount, Quantity\n\n\nclass StubAccount:\n    \"\"\"Minimal account stub satisfying the Account protocol.\"\"\"\n\n    def __init__(self, code: str, name: str):\n        self.code = code\n        self.name = name\n        self.type = None\n        self.coa = None\n        self.parent = None\n\n\ndef _make_posting(account: StubAccount, direction: Direction, amount: Decimal) -> Posting:\n    journal = JournalEntry(datetime.date(2021, 1, 1), \"Test entry\", None)\n    return Posting(journal, datetime.date(2021, 1, 1), account, direction, Amount(amount))\n\n\ndef test_add_first_entry_uses_initial_balance():\n    \"\"\"An empty ledger must fall back to the initial balance (lines 127-130),\n    and the first added entry must be built and appended (lines 140-146).\"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"100\")))\n    ledger = Ledger(account, initial)\n\n    # Empty ledger: _last_balance falls back to initial.value\n    assert ledger._last_balance == Quantity(Decimal(\"100\"))\n    assert ledger.entries == []\n\n    posting = _make_posting(account, Direction.DEBIT, Decimal(\"50\"))\n    entry = ledger.add(posting)\n\n    # The entry is built from initial balance + amount * direction\n    assert entry.balance == Quantity(Decimal(\"150\"))\n    assert entry.ledger is ledger\n    assert entry.posting is posting\n    # The entry is appended to the ledger buffer\n    assert ledger.entries == [entry]\n    # _last_balance now reflects the last entry's balance\n    assert ledger._last_balance == Quantity(Decimal(\"150\"))\n\n\ndef test_add_subsequent_entry_chains_from_last_balance():\n    \"\"\"A second entry must chain from the previous entry's balance, not the initial one.\"\"\"\n    account = StubAccount(\"200\", \"Sales\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"0\")))\n    ledger = Ledger(account, initial)\n\n    first = ledger.add(_make_posting(account, Direction.DEBIT, Decimal(\"30\")))\n    second = ledger.add(_make_posting(account, Direction.CREDIT, Decimal(\"10\")))\n\n    assert first.balance == Quantity(Decimal(\"30\"))\n    assert second.balance == Quantity(Decimal(\"20\"))\n    assert ledger.entries == [first, second]\n    assert ledger._last_balance == Quantity(Decimal(\"20\"))\n\n\ndef test_add_credit_on_empty_ledger_decreases_initial_balance():\n    \"\"\"A credit posting on an empty ledger must subtract from the initial balance.\"\"\"\n    account = StubAccount(\"300\", \"Payables\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"500\")))\n    ledger = Ledger(account, initial)\n\n    entry = ledger.add(_make_posting(account, Direction.CREDIT, Decimal(\"120\")))\n\n    assert entry.balance == Quantity(Decimal(\"380\"))\n    assert len(ledger.entries) == 1\n    assert ledger._last_balance == Quantity(Decimal(\"380\"))\n```",
