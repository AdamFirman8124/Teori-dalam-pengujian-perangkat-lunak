      "content": "```python\nimport typing\n\nimport pytest\nfrom json.decoder import JSONDecodeError, scanstring\n\nfrom typesystem.base import ParseError\nfrom typesystem.tokenize.tokenize_json import _TokenizingJSONObject, tokenize_json\nfrom typesystem.tokenize.tokens import ScalarToken\n\n\ndef _make_scan_once(content: str) -> typing.Callable[[str, int], typing.Tuple[ScalarToken, int]]:\n    \"\"\"\n    Minimal stand-in for the module's real scanner: it supports JSON strings\n    and non-negative integers, and raises ``StopIteration(idx)`` for anything\n    else (including an out-of-range index), mirroring ``json.scanner``'s\n    contract, which is what ``_TokenizingJSONObject``'s error handling\n    relies on.\n    \"\"\"\n\n    def scan_once(s: str, idx: int) -> typing.Tuple[ScalarToken, int]:\n        try:\n            char = s[idx]\n        except IndexError:\n            raise StopIteration(idx) from None\n        if char == '\"':\n            value, end = scanstring(s, idx + 1, True)\n            return ScalarToken(value, idx, end - 1, content), end\n        if char.isdigit():\n            start = idx\n            end = idx + 1\n            while end < len(s) and s[end].isdigit():\n                end += 1\n            return ScalarToken(int(s[start:end]), start, end - 1, content), end\n        raise StopIteration(idx)\n\n    return scan_once\n\n\ndef _parse_object(s: str, start: int = 1) -> typing.Tuple[dict, int]:\n    # Called exactly the way the module's own scanner calls it (with the\n    # index just past '{').  A fresh memo dict and content string are used\n    # for every call and no global/module state is touched, so the tests\n    # cannot pollute state and no monkeypatching/cleanup is required.\n    return _TokenizingJSONObject((s, start), True, _make_scan_once(s), {}, s)\n\n\ndef _as_pairs(result: dict) -> list:\n    return [(key.value, value.value) for key, value in result.items()]\n\n\ndef test_empty_object_returns_empty_dict_and_end_after_closing_brace():\n    # Covers: nextchar != '\"', nextchar not whitespace, nextchar == '}'.\n    s = \"{}\"\n    result, end = _parse_object(s)\n    assert result == {}\n    assert end == 2\n\n\ndef test_compact_object_fast_paths():\n    # Covers the no-whitespace fast paths: '\"' first char, ':' right after\n    # the key, value right after ':', '}' right after the value.\n    s = '{\"a\":1}'\n    memo = {}\n    result, end = _TokenizingJSONObject((s, 1), True, _make_scan_once(s), memo, s)\n    assert _as_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n    key = next(iter(result))\n    assert key.value == \"a\"\n    assert (key._start_index, key._end_index) == (1, 3)\n    value = result[key]\n    assert value.value == 1\n    assert (value._start_index, value._end_index) == (5, 5)\n    # The key string must have been recorded in the shared memo dict.\n    assert memo == {\"a\": \"a\"}\n\n\ndef test_whitespace_around_key_colon_and_value():\n    # Covers: whitespace before the first key, whitespace before ':',\n    # a single whitespace char after ':', and whitespace before '}'.\n    s = '{ \"a\" : 1 }'\n    result, end = _parse_object(s)\n    assert _as_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n\n\ndef test_repeated_whitespace_after_colon():\n    # Covers the nested \"second whitespace character\" branch after ':'.\n    s = '{\"a\": \\t\\n1}'\n    result, end = _parse_object(s)\n    assert _as_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n\n\ndef test_multiple_pairs_separated_by_comma():\n    # Covers the ',' branch: whitespace skip after the comma, the next\n    # quoted key, and loop termination on the second iteration.\n    s = '{\"a\": 1, \"b\": 2}'\n    result, end = _parse_object(s)\n    assert _as_pairs(result) == [(\"a\", 1), (\"b\", 2)]\n    assert end == len(s)\n\n\ndef test_duplicate_keys_are_memoized_and_last_pair_wins():\n    # Exercises the memo hit (memo.setdefault returning the stored key).\n    s = '{\"a\": 1, \"a\": 2}'\n    result, end = _parse_object(s)\n    assert _as_pairs(result) == [(\"a\", 2)]\n    assert end == len(s)\n\n\ndef test_invalid_property_name_raises():\n    s = \"{1: 2}\"\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting property name enclosed in double quotes\"\n    assert excinfo.value.pos == 1\n\n\ndef test_missing_colon_raises():\n    s = '{\"a\" 1}'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting ':' delimiter\"\n    assert excinfo.value.pos == 5\n\n\ndef test_missing_value_raises_expecting_value():\n    # Triggers both the IndexError guard right after ':' and the\n    # StopIteration -> JSONDecodeError(\"Expecting value\") translation.\n    s = '{\"a\":'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting value\"\n    assert excinfo.value.pos == 5\n\n\ndef test_unterminated_object_raises_expecting_comma():\n    # s[end] after the value raises IndexError -> nextchar = \"\" ->\n    # \"Expecting ',' delimiter\".\n    s = '{\"a\": 1'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting ',' delimiter\"\n    assert excinfo.value.pos == 7\n\n\ndef test_invalid_property_name_after_comma_raises():\n    s = '{\"a\": 1, 2}'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting property name enclosed in double quotes\"\n    assert excinfo.value.pos == 8\n\n\ndef test_tokenize_json_integration_object():\n    # End-to-end check that _TokenizingJSONObject is wired into the real\n    # scanner via the public API.\n    token = tokenize_json('{\"a\": 1}')\n    assert token.value == {\"a\": 1}\n\n\ndef test_tokenize_json_integration_parse_error():\n    # The JSONDecodeError raised by _TokenizingJSONObject must surface as a\n    # typesystem ParseError carrying the failing position.\n    with pytest.raises(ParseError) as excinfo:\n        tokenize_json(\"{1: 2}\")\n    assert excinfo.value.code == \"parse_error\"\n    assert excinfo.value.position.char_index == 1\n```",
