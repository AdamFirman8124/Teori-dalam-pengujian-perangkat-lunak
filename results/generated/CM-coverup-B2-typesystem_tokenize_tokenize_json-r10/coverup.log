be use the real scanner where possible, since it also validates that my understanding of positions is right. But the real scanner's exact behavior for numbers etc. \u2014 typesystem's _scan_once handles numbers via:\n\nActually I recall typesystem's tokenize json code:\n\n```python\ndef _make_scanner(context: json.JSONDecoder, content: str) -> typing.Callable:\n    def _scan_once(string: str, idx: int) -> typing.Tuple[Token, int]:\n        try:\n            nextchar = string[idx]\n        except IndexError:\n            raise StopIteration(idx) from None\n\n        if nextchar == '\"':\n            return _TokenizingString(string, idx, content)\n        elif nextchar == \"{\":\n            return _TokenizingJSONObject(\n                (string, idx + 1), context.strict, _scan_once, context.memo, content\n            )\n        elif nextchar == \"[\":\n            return _TokenizingJSONArray(\n                (string, idx + 1), context.strict, _scan_once, content\n            )\n        elif nextchar.isdigit() or (nextchar == \"-\" and string[idx + 1].isdigit()):\n            return _TokenizingNumber(string, idx, content)\n        elif nextchar == \"t\":\n            return _TokenizingConstant(\"true\", string, idx, content)\n        ...\n        raise StopIteration(idx)\n    return _scan_once\n```\n\nSomething like that. If `_make_scanner` exists with that signature, I can use it. Let me check with get_info.\n\nLet me now make the get_info calls.\n\nAfter getting info, I'll write the final script. Let me draft it now assuming direct-call approach, and adjust after seeing get_info results.\n\nDraft:\n\n```python\nimport typing\n\nimport pytest\nfrom json.decoder import JSONDecodeError, scanstring\n\nfrom typesystem.tokenize.tokenize_json import _TokenizingJSONObject\nfrom typesystem.tokenize.tokens import ScalarToken\n\n\ndef _make_scan_once(content: str) -> typing.Callable[[str, int], typing.Tuple[ScalarToken, int]]:\n    \"\"\"A minimal stand-in for the module's real scanner.\n\n    Supports JSON strings and (non-negative) integers, and raises\n    ``StopIteration(idx)`` for anything else -- mirroring the behaviour of\n    ``json.scanner`` so that ``_TokenizingJSONObject``'s error handling is\n    exercised realistically.\n    \"\"\"\n\n    def scan_once(s: str, idx: int) -> typing.Tuple[ScalarToken, int]:\n        try:\n            char = s[idx]\n        except IndexError:\n            raise StopIteration(idx) from None\n\n        if char == '\"':\n            value, end = scanstring(s, idx + 1, True)\n            return ScalarToken(value, idx, end - 1, content), end\n        if char.isdigit():\n            start = idx\n            end = idx + 1\n            while end < len(s) and s[end].isdigit():\n                end += 1\n            return ScalarToken(int(s[start:end]), start, end - 1, content), end\n        raise StopIteration(idx)\n\n    return scan_once\n\n\ndef _parse_object(s: str, start: int = 1) -> typing.Tuple[dict, int]:\n    \"\"\"Call _TokenizingJSONObject the way the module's own scanner would.\"\"\"\n    return _TokenizingJSONObject(\n        (s, start), True, _make_scan_once(s), {}, s\n    )\n\n\ndef _scalar_pairs(result: dict) -> typing.List[typing.Tuple[typing.Any, typing.Any]]:\n    return [(key.value, value.value) for key, value in result.items()]\n\n\ndef test_empty_object_returns_empty_dict():\n    # Covers: nextchar != '\"', nextchar not whitespace, nextchar == '}'.\n    s = \"{}\"\n    result, end = _parse_object(s)\n    assert result == {}\n    assert end == 2\n\n\ndef test_object_without_any_whitespace():\n    # Covers the fast paths: nextchar == '\"', ':' immediately after key,\n    # value immediately after ':', '}' immediately after value.\n    s = '{\"a\":1}'\n    result, end = _parse_object(s)\n    assert _scalar_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n    key = next(iter(result))\n    assert (key.start, key.end, key.content) == (1, 3, s)\n    value = result[key]\n    assert (value.start, value.end) == (5, 5)\n\n\ndef test_whitespace_around_key_colon_and_value():\n    # Covers: whitespace before the first key, whitespace before ':',\n    # single whitespace after ':', whitespace (then '}') after the value.\n    s = '{ \"a\" : 1 }'\n    result, end = _parse_object(s)\n    assert _scalar_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n\n\ndef test_repeated_whitespace_after_colon():\n    # Covers the nested \"second whitespace character\" branch (line 65-66).\n    s = '{\"a\": \\t\\n1}'\n    result, end = _parse_object(s)\n    assert _scalar_pairs(result) == [(\"a\", 1)]\n    assert end == len(s)\n\n\ndef test_multiple_pairs_and_comma_handling():\n    # Covers the ',' branch: whitespace skip after comma, next key, and\n    # the final '}' terminating the loop on the second iteration.\n    s = '{\"a\": 1, \"b\": 2}'\n    result, end = _parse_object(s)\n    assert _scalar_pairs(result) == [(\"a\", 1), (\"b\", 2)]\n    assert end == len(s)\n\n\ndef test_invalid_first_property_name():\n    s = \"{1: 2}\"\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting property name enclosed in double quotes\"\n    assert excinfo.value.pos == 1\n\n\ndef test_missing_colon_delimiter():\n    s = '{\"a\" 1}'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting ':' delimiter\"\n    assert excinfo.value.pos == 5\n\n\ndef test_missing_value_raises_expecting_value():\n    # Both the IndexError guard after ':' and the StopIteration -> JSONDecodeError\n    # translation are exercised.\n    s = '{\"a\":'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _parse_object(s)\n    assert excinfo.value.msg == \"Expecting value\"\n    assert excinfo.value.pos == 5\n\n\ndef test_unterminated_object_missing_delimiter():\n    # s[end] raises IndexError after the value -> nextchar = \"\" ->\n    # \"Expecting ',' deli