      "content": "```python\nimport pytest\n\nfrom typesystem.base import ParseError\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken\n\n\ndef test_tokenize_bytes_content():\n    token = tokenize_yaml(b'{\"key\": \"value\"}')\n    assert isinstance(token, DictToken)\n    assert token._value == {\"key\": \"value\"}\n    assert token._content == '{\"key\": \"value\"}'\n    assert token._start_index == 0\n    assert token._end_index == len('{\"key\": \"value\"}') - 1\n\n\ndef test_tokenize_str_content():\n    token = tokenize_yaml('{\"key\": \"value\"}')\n    assert isinstance(token, DictToken)\n    assert token._value == {\"key\": \"value\"}\n\n\ndef test_tokenize_empty_string():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(\"   \\n  \")\n    assert exc_info.value.text == \"No content.\"\n    assert exc_info.value.code == \"no_content\"\n    position = exc_info.value.position\n    assert position.line_no == 1\n    assert position.column_no == 1\n    assert position.char_index == 0\n\n\ndef test_tokenize_empty_bytes():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(b\"\")\n    assert exc_info.value.text == \"No content.\"\n    assert exc_info.value.code == \"no_content\"\n\n\ndef test_tokenize_mapping():\n    content = \"key: value\\nother: 1\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    assert token._value == {\"key\": \"value\", \"other\": 1}\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    key_token = token._get_key_token(\"key\")\n    assert key_token._value == \"key\"\n    child_token = token._get_child_token(\"key\")\n    assert child_token._value == \"value\"\n\n\ndef test_tokenize_sequence():\n    content = \"- a\\n- b\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ListToken)\n    assert token._value == [\"a\", \"b\"]\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    child_token = token._get_child_token(0)\n    assert child_token._value == \"a\"\n\n\ndef test_tokenize_scalar_string():\n    content = \"hello\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == \"hello\"\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_int():\n    content = \"123\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 123\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_negative_int():\n    token = tokenize_yaml(\"-42\")\n    assert isinstance(token, ScalarToken)\n    assert token._value == -42\n\n\ndef test_tokenize_float():\n    content = \"1.5\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 1.5\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_true():\n    content = \"true\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is True\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_false():\n    token = tokenize_yaml(\"false\")\n    assert isinstance(token, ScalarToken)\n    assert token._value is False\n\n\ndef test_tokenize_null():\n    content = \"null\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is None\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_nested_structure():\n    content = \"a:\\n  - 1\\n  - b: two\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    value = token._value\n    assert value[\"a\"] == [1, {\"b\": \"two\"}]\n    inner_list = toke