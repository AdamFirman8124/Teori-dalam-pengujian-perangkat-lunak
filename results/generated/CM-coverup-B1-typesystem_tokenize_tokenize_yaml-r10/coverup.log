sert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    child_token = token._get_child_token(0)\n    assert child_token._value == \"a\"\n\n\ndef test_tokenize_scalar_string():\n    content = \"hello\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == \"hello\"\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_int():\n    content = \"123\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 123\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_negative_int():\n    token = tokenize_yaml(\"-42\")\n    assert isinstance(token, ScalarToken)\n    assert token._value == -42\n\n\ndef test_tokenize_float():\n    content = \"1.5\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 1.5\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_true():\n    content = \"true\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is True\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_false():\n    token = tokenize_yaml(\"false\")\n    assert isinstance(token, ScalarToken)\n    assert token._value is False\n\n\ndef test_tokenize_null():\n    content = \"null\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is None\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_nested_structure():\n    content = \"a:\\n  - 1\\n  - b: two\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    value = token._value\n    assert value[\"a\"] == [1, {\"b\": \"two\"}]\n    inner_list = token._get_child_token(\"a\")\n    assert isinstance(inner_list, ListToken)\n    inner_dict = inner_list._get_child_token(1)\n    assert isinstance(inner_dict, DictToken)\n    assert inner_dict._value == {\"b\": \"two\"}\n\n\ndef test_tokenize_parse_error():\n    content = \"key: [unclosed\"\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n    assert exc_info.value.code == \"parse_error\"\n    assert exc_info.value.text.endswith(\".\")\n    position = exc_info.value.position\n    assert position.line_no == 1\n    assert position.column_no >= 1\n    assert position.char_index >= 0\n\n\ndef test_tokenize_parse_error_multiline_position():\n    content = \"a: 1\\nb: [unclosed\"\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n    assert exc_info.value.code == \"parse_error\"\n    position = exc_info.value.position\n    assert position.line_no == 2\n    assert position.char_index == content.index(\"[unclosed\")\n\n\ndef test_tokenize_quoted_scalar_positions():\n    content = 'key: \"quoted value\"'\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    child = token._get_child_token(\"key\")\n    assert child._value == \"quoted value\"\n    assert content[child._start_index : child._end_index + 1] == '\"quoted value\"'\n```",
