d+)\\s*(?:hours?|hrs?|h))?\\s*(?:(?P<minutes>\\d+)\\s*(?:minutes?|mins?|m))?\\s*(?:(?P<seconds>\\d+)\\s*(?:seconds?|secs?|s))?\\s*$', s)\n```\n\nHmm, I recall the units regex approach:\n\n```python\n    m = re.match(\n        r'(?i)(?:(?P<days>\\d+)\\s*(?:days?|d))?\\s*(?:(?P<hours>\\d+)\\s*(?:hours?|hrs?|h))?\\s*(?:(?P<minutes>\\d+)\\s*(?:minutes?|mins?|m))?\\s*(?:(?P<seconds>\\d+)\\s*(?:seconds?|secs?|s))?', s)\n```\n\nEither way, '5 min' \u2192 minutes=5 \u2192 300. '1 hour' \u2192 3600. I'm confident. get_info('parse_duration') will confirm.\n\nOK, making the tool calls now. I'll batch them.\n\nAfter that, I'll write the final answer with the complete test script.\n\nLet me pre-draft the full test script (to be adjusted after tool results):\n\n```python\n# -*- coding: utf-8 -*-\n\"\"\"Coverage tests for youtube_dl.extractor.linuxacademy.LinuxAcademyIE._real_extract.\"\"\"\n\nimport pytest\n\nfrom youtube_dl.extractor.linuxacademy import LinuxAcademyIE\n\n\nCOURSE_URL = 'https://linuxacademy.com/cp/courses/lesson/course/1498/chapter/2/lesson/2'\nLESSON_URL = 'https://linuxacademy.com/lesson/lesson/2152'\n\n\ndef _make_ie():\n    \"\"\"A fresh extractor instance per test; no global state is touched.\"\"\"\n    return LinuxAcademyIE()\n\n\ndef test_course_playlist_full(monkeypatch):\n    ie = _make_ie()\n\n    webpage = u'''\n    <html><body>\n    window.module = {\"title\": \"Test Course\", \"md_desc\": \"Course md description\", \"duration\": \"1 hour\", \"items\": [\"not-a-dict\", {\"type\": {\"name\": \"Section\", \"slug\": \"section\"}, \"course_name\": \"Chapter One\", \"course_module\": \"mod-1\"}, {\"type\": {\"name\": \"Lesson\", \"slug\": \"lesson\"}, \"url\": \"/lesson/lesson/2152\", \"title\": \"Lesson One\", \"md_desc\": \"Lesson one description\", \"date\": \"2019-01-01 10:00:00\", \"duration\": \"5 min\"}, {\"type\": {\"name\": \"Quiz\", \"slug\": \"quiz\"}}, {\"type\": {\"name\": \"Lesson\", \"slug\": \"lesson\"}}, {\"type\": {\"name\": \"Section\", \"slug\": \"section\"}, \"course_name\": \"Chapter Two\", \"course_module\": \"mod-2\"}, {\"type\": {\"name\": \"Lesson\", \"slug\": \"lesson\"}, \"url\": \"https://linuxacademy.com/lesson/lesson/2153\", \"lesson_name\": \"Lesson Three\", \"description\": \"<b>bold desc</b>\", \"created_on\": \"2019-01-02 10:00:00\", \"duration\": \"6 min\"}, {\"type\": {\"name\": \"Lesson\", \"slug\": \"lesson\"}, \"url\": \"/lesson/lesson/2154\", \"text\": \"<i>text desc</i>\", \"duration\": \"7 min\"}]};\n    </body></html>\n    '''\n\n    seen = {}\n\n    def fake_download_webpage(url, video_id, *args, **kwargs):\n        seen['url'] = url\n        seen['video_id'] = video_id\n        return webpage\n\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n\n    result = ie._real_extract(COURSE_URL)\n\n    assert seen['url'] == COURSE_URL\n    assert seen['video_id'] == '1498'\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == '1498'\n    assert result['title'] == 'Test Course'\n    assert result['description'] == 'Course md description'\n    assert result['duration'] == 3600\n\n    entries = result['entries']\n    assert isinstance(entries, list)\n    assert len(entries) == 3\n\n    first, second, third = entries\n\n    assert first['_type'] == 'url_transparent'\n    assert first['ie_key'] == 'LinuxAcademy'\n    assert first['url'] == 'https://linuxacademy.com/lesson/lesson/2152'\n    assert first['title'] == 'Lesson One'\n    assert first['description'] == 'Lesson one description'\n    assert first['chapter'] == 'Chapter One'\n    assert first['chapter_id'] == 'mod-1'\n    assert first['chapter_number'] == 1\n    assert first['timestamp'] == 1546336800\n    assert first['duration'] == 300\n\n    assert second['url'] == 'https://linuxacademy.com/lesson/lesson/2153'\n    assert second['title'] == 'Lesson Three'\n    assert second['description'] == 'bold desc'\n    assert second['chapter'] == 'Chapter Two'\n    assert second['chapter_id'] == 'mod-2'\n    assert second['chapter_number'] == 2\n    assert second['timestamp'] == 1546423200\n    assert second['duration'] == 360\n\n    assert third['url'] == 'https://linuxacademy.com/lesson/lesson/2154'\n    assert third['title'] is None\n    assert third['description'] == 'text desc'\n    assert third['chapter'] == 'Chapter Two'\n    assert third['chapter_id'] == 'mod-2'\n    assert third['chapter_number'] == 2\n    assert third['timestamp'] is None\n    assert third['duration'] == 420\n```\n\nWait \u2014 third['title'] is None: `item.get('title') or item.get('lesson_name')` \u2192 None. OK.\n\nHmm, one thing: in the third item, there's no 'title' and no 'lesson_name' \u2192 title None. Fine.\n\nCourse description fallback test:\n\n```python\ndef test_course_playlist_description_fallback(monkeypatch):\n    ie = _make_ie()\n    webpage = u'''\n    <html><body>\n    window.module = {\"items\": [{\"type\": {\"name\": \"Lesson\", \"slug\": \"lesson\"}, \"url\": \"/lesson/lesson/2152\", \"title\": \"Only Lesson\"}], \"desc\": \"<p>Fallback course description</p>\"};\n    </body></html>\n    '''\n    monkeypatch.setattr(ie, '_download_webpage', lambda url, video_id, *a, **kw: webpage)\n\n    result = ie._real_extract(COURSE_URL)\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == '1498'\n    assert result['title'] is None\n    assert result['description'] == 'Fallback course description'\n    assert result['duration'] is None\n    assert len(result['entries']) == 1\n    entry = result['entries'][0]\n    assert entry['title'] == 'Only Lesson'\n    assert entry['url'] == 'https://linuxacademy.com/lesson/lesson/2152'\n    assert entry['chapter'] is None\n    assert entry['chapter_id'] is None\n    assert entry['chapter_number'] is None\n```\n\nSingle video tests:\n\n```python\ndef test_single_video_with_window_lesson(monkeypatch):\n    ie = _make_ie()\n    webpage = u'''\n    <html><body>\n    player.playlist = [{\"file\": \"https://cdn.example.