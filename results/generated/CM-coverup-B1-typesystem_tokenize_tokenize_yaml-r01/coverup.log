      "message": {
        "content": "```python\nimport pytest\n\nfrom typesystem.base import ParseError, Position\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\n\n\ndef test_tokenize_yaml_str_mapping():\n    token = tokenize_yaml(\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token._start_index == 0\n    assert token._end_index == len(\"key: value\") - 1\n    assert token._value[\"key\"]._value == \"value\"\n    assert token._value[\"key\"]._content == \"key: value\"\n\n\ndef test_tokenize_yaml_bytes_input():\n    token = tokenize_yaml(b\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token._value[\"key\"]._value == \"value\"\n    # Content stored is the decoded string.\n    assert token._value[\"key\"]._content == \"key: value\"\n\n\ndef test_tokenize_yaml_bytes_with_invalid_utf8_ignored():\n    # Invalid bytes are dropped by the \"ignore\" error handler.\n    token = tokenize_yaml(b\"key: val\\xffue\")\n    assert isinstance(token, DictToken)\n    assert token._value[\"key\"]._value == \"value\"\n\n\ndef test_tokenize_yaml_empty_string():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(\"\")\n    assert exc_info.value.text == \"No content.\"\n    assert exc_info.value.code == \"no_content\"\n    assert exc_info.value.position == Position(\n        column_no=1, line_no=1, char_index=0\n    )\n\n\ndef test_tokenize_yaml_whitespace_only_string():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(\"   \\n\\t  \")\n    assert exc_info.value.text == \"No content.\"\n    assert exc_info.value.code == \"no_content\"\n    assert exc_info.value.position == Position(\n        column_no=1, line_no=1, char_index=0\n    )\n\n\ndef test_tokenize_yaml_sequence():\n    content = \"- a\\n- b\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ListToken)\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    assert [item._value for item in token._value] == [\"a\", \"b\"]\n    assert all(item._content == content for item in token._value)\n\n\ndef test_tokenize_yaml_scalar_string():\n    content = \"hello\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == \"hello\"\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    assert token._content == content\n\n\ndef test_tokenize_yaml_int():\n    content = \"123\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 123\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_float():\n    content = \"1.5\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 1.5\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_bool():\n    content = \"true\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is True\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_null():\n    content = \"null\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is None\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_nested_structure():\n    content = \"a:\\n  - 1\\n  - b: true\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    inner_list = token._value[\"a\"]\n    assert isinstance(inner_list, ListToken)\n    assert inner_list._value[0]._value == 1\n    inner_dict = inner_list._value[1]\n    assert isinstance(inner_dict, DictToken)\n    assert inner_dict._value[\"b\"]._value is True\n\n\ndef test_tokenize_yaml_parse_error():\n    # Unterminated quote raises a ScannerError inside yaml.load.\n    content = \"key: 'unclosed\"\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text.endswith(\".\")\n    assert isinstance(error.position, Position)\n    assert error.position.line_no == 1\n    assert error.position.char_index >= 0\n\n\ndef test_tokenize_yaml_parse_error_multiline_position():\n    content = \"a: 1\\nb: 'unclosed\"\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    # The problem mark is on the second line.\n    assert error.position.line_no == 2\n    assert error.position.char_index > 0\n```",
