"No content.\"\n    assert error.code == \"no_content\"\n    assert error.position == Position(column_no=1, line_no=1, char_index=0)\n\n\ndef test_tokenize_yaml_sequence():\n    content = \"- a\\n- b\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ListToken)\n    assert token.value == [\"a\", \"b\"]\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    assert all(isinstance(item, ScalarToken) for item in token._value)\n    assert all(item._content == content for item in token._value)\n\n\ndef test_tokenize_yaml_scalar_string():\n    content = \"hello\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello\"\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n    assert token._content == content\n\n\ndef test_tokenize_yaml_int():\n    content = \"123\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ScalarToken)\n    assert token.value == 123\n    assert type(token.value) is int\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_float():\n    content = \"1.5\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ScalarToken)\n    assert token.value == 1.5\n    assert type(token.value) is float\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_bool():\n    content = \"true\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_null():\n    content = \"null\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_yaml_nested_structure():\n    content = \"a:\\n  - 1\\n  - b: true\\n  - 2.5\\n  - null\"\n    token = tokenize_yaml(content)\n\n    assert isinstance(token, DictToken)\n    assert token.value == {\"a\": [1, {\"b\": True}, 2.5, None]}\n\n    key_token, list_token = next(iter(token._value.items()))\n    assert key_token.value == \"a\"\n    assert isinstance(list_token, ListToken)\n    assert isinstance(list_token._value[0], ScalarToken)\n    assert list_token._value[0].value == 1\n\n    inner_dict = list_token._value[1]\n    assert isinstance(inner_dict, DictToken)\n    inner_key, inner_value = next(iter(inner_dict._value.items()))\n    assert inner_key.value == \"b\"\n    assert inner_value.value is True\n\n    assert list_token._value[2].value == 2.5\n    assert list_token._value[3].value is None\n\n\ndef test_tokenize_yaml_scanner_error():\n    content = \"key: 'unclosed\"\n\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text.endswith(\".\")\n    assert isinstance(error.position, Position)\n    assert error.position.line_no == 1\n    assert error.position.char_index >= 0\n\n\ndef test_tokenize_yaml_parser_error():\n    content = \"[1, 2\"\n\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text.endswith(\".\")\n    assert isinstance(error.position, Position)\n    assert error.position.line_no == 1\n    assert error.position.char_index == len(content)\n\n\ndef test_tokenize_yaml_multiline_error_position():\n    content = \"a: 1\\nb: 'unclosed\"\n\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text.endswith(\".\")\n    assert error.position.line_no == 2\n    assert error.position.char_index == len(content)\n```",
