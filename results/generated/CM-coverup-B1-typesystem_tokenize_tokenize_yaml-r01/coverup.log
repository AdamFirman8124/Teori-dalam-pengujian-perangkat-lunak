        "content": "```python\nimport pytest\n\nfrom typesystem import fields\nfrom typesystem.base import ParseError\nfrom typesystem.schemas import Schema\nfrom typesystem.tokenize.positional_validation import ValidationError\nfrom typesystem.tokenize import tokenize_yaml\n\n\nclass Person(Schema):\n    name = fields.String()\n    age = fields.Integer()\n\n\ndef _unpack(result):\n    # validate_yaml may return either a (value, error) two-tuple or the\n    # bare value, depending on the typesystem version; handle both.\n    if isinstance(result, tuple) and len(result) == 2:\n        return result\n    return result, None\n\n\ndef test_validate_yaml_asserts_pyyaml_installed(monkeypatch):\n    import typesystem.tokenize.tokenize_yaml as module\n\n    monkeypatch.setattr(module, \"yaml\", None)\n    with pytest.raises(AssertionError, match=\"'pyyaml' must be installed.\"):\n        module.validate_yaml(\"name: foo\\nage: 1\", Person)\n\n\ndef test_validate_yaml_valid_string():\n    from typesystem.tokenize.tokenize_yaml import validate_yaml\n\n    result = validate_yaml(\"name: foo\\nage: 1\", Person)\n    value, error = _unpack(result)\n    assert dict(value) == {\"name\": \"foo\", \"age\": 1}\n    assert error is None\n\n\ndef test_validate_yaml_valid_bytes():\n    from typesystem.tokenize.tokenize_yaml import validate_yaml\n\n    result = validate_yaml(b\"name: foo\\nage: 1\", Person)\n    value, error = _unpack(result)\n    assert dict(value) == {\"name\": \"foo\", \"age\": 1}\n    assert error is None\n\n\ndef test_validate_yaml_validation_error_has_positions():\n    from typesystem.tokenize.tokenize_yaml import validate_yaml\n\n    with pytest.raises(ValidationError) as exc_info:\n        validate_yaml(\"name: foo\\nage: not_an_int\", Person)\n\n    messages = exc_info.value.messages()\n    assert messages, \"expected at least one validation message\"\n    message = messages[0]\n    assert message.text  # a human-readable message exists\n    assert message.start_position is not None\n    assert message.start_position.line_index == 1  # error on the 'age' line\n\n\ndef test_validate_yaml_parse_error_propagates():\n    from typesystem.tokenize.tokenize_yaml import validate_yaml\n\n    with pytest.raises(ParseError):\n        validate_yaml(\"foo: [unclosed\", Person)\n```",
