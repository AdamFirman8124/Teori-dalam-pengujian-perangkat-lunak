        "content": "```python\nimport base64\nimport json\n\nimport pytest\n\nfrom youtube_dl.compat import compat_urllib_parse_quote\nfrom youtube_dl.utils import unified_timestamp\nfrom youtube_dl.extractor.fourtube import PornTubeIE\n\n\ndef _make_webpage(video):\n    \"\"\"Build a fake webpage whose INITIALSTATE blob decodes to {'page': {'video': video}}.\"\"\"\n    payload = compat_urllib_parse_quote(json.dumps({'page': {'video': video}}))\n    encoded = base64.b64encode(payload.encode('utf-8')).decode('ascii')\n    return '<html><script>INITIALSTATE = \"%s\";</script></html>' % encoded\n\n\ndef _patch(monkeypatch, ie, video, formats=None):\n    \"\"\"Patch network + format extraction; return a dict capturing the calls.\"\"\"\n    calls = {}\n\n    def fake_download_webpage(url, display_id, *args, **kwargs):\n        calls['download'] = (url, display_id)\n        return _make_webpage(video)\n\n    def fake_extract_formats(url, video_id, media_id, sources):\n        calls['formats'] = (url, video_id, media_id, sources)\n        return formats if formats is not None else [\n            {'url': 'http://example.com/video.mp4', 'format_id': '720p'}]\n\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n    monkeypatch.setattr(ie, '_extract_formats', fake_extract_formats)\n    return calls\n\n\ndef test_porntube_full_metadata(monkeypatch):\n    ie = PornTubeIE()\n    url = 'https://www.porntube.com/videos/teen-couple-doing-anal_7089759'\n    video = {\n        'title': 'Teen couple doing anal',\n        'mediaId': 'media-7089759',\n        'encodings': [\n            {'height': 720, 'url': 'http://example.com/720.mp4'},\n            {'height': 480, 'url': 'http://example.com/480.mp4'},\n        ],\n        'masterThumb': 'http://example.com/thumb.jpg',\n        'user': {'username': 'Alexy', 'id': 91488},\n        'channel': {'name': 'Some Channel', 'id': 12345},\n        'likes': 42,\n        'dislikes': 7,\n        'playsQty': 1000,\n        'durationInSeconds': 5052,\n        'publishedAt': '2015-06-06T12:20:47.000Z',\n    }\n    formats = [{'url': 'http://example.com/720.mp4', 'format_id': '720p'}]\n    calls = _patch(monkeypatch, ie, video, formats)\n\n    info = ie._real_extract(url)\n\n    assert calls['download'] == (url, 'teen-couple-doing-anal')\n    assert calls['formats'] == (url, '7089759', 'media-7089759', ['720', '480'])\n    assert info == {\n        'id': '7089759',\n        'title': 'Teen couple doing anal',\n        'formats': formats,\n        'thumbnail': 'http://example.com/thumb.jpg',\n        'uploader': 'Alexy',\n        'uploader_id': '91488',\n        'channel': 'Some Channel',\n        'channel_id': '12345',\n        'timestamp': 1433595647,\n        'like_count': 42,\n        'dislike_count': 7,\n        'view_count': 1000,\n        'duration': 5052,\n        'age_limit': 18,\n    }\n    assert info['timestamp'] == unified_timestamp('2015-06-06T12:20:47.000Z')\n\n\ndef test_porntube_embed_url_minimal_video(monkeypatch):\n    ie = PornTubeIE()\n    url = 'https://www.porntube.com/embed/7089759'\n    video = {\n        'title': 'Embedded video',\n        'mediaId': 'media-7089759',\n        'encodings': [\n            {'url': 'http://example.com/noheight.mp4'},\n            {'height': None, 'url': 'http://example.com/none.mp4'},\n        ],\n    }\n    calls = _patch(monkeypatch, ie, video)\n\n    info = ie._real_extract(url)\n\n    # embed URL has no display_id group -> None is passed to _download_webpage\n    assert calls['download'] == (url, None)\n    # encodings without a truthy height are filtered out\n    assert calls['formats'] == (url, '7089759', 'media-7089759', [])\n    assert info['id'] == '7089759'\n    assert info['title'] == 'Embedded video'\n    assert info['thumbnail'] is None\n    assert info['uploader'] is None\n    assert info['uploader_id'] is None\n    assert info['channel'] is None\n    assert info['channel_id'] is None\n    assert info['timestamp'] is None\n    assert info['like_count'] is None\n    assert info['dislike_count'] is None\n    assert info['view_count'] is None\n    assert info['duration'] is None\n    assert info['age_limit'] == 18\n\n\ndef test_porntube_channel_fallback_and_invalid_numbers(monkeypatch):\n    ie = PornTubeIE()\n    url = 'https://m.porntube.com/videos/squirting-teen-ballerina-ecg_1331406'\n    video = {\n        'title': 'Squirting Teen Ballerina on ECG',\n        'mediaId': 'media-1331406',\n        'encodings': [{'height': 1080}],\n        'masterThumb': 'not a url',\n        'channel': {'name': 'Exploited College Girls', 'id': 665},\n        'likes': 'not-a-number',\n        'dislikes': None,\n        'playsQty': '12345',\n        'durationInSeconds': '851',\n        'publishedAt': '2013-09-20T18:38:05.000Z',\n    }\n    calls = _patch(monkeypatch, ie, video)\n\n    info = ie._real_extract(url)\n\n    assert calls['download'] == (url, 'squirting-teen-ballerina-ecg')\n    assert calls['formats'] == (url, '1331406', 'media-1331406', ['1080'])\n    # uploader falls back to channel when user info is absent\n    assert info['uploader'] == 'Exploited College Girls'\n    assert info['uploader_id'] == '665'\n    assert info['channel'] == 'Exploited College Girls'\n    assert info['channel_id'] == '665'\n    # invalid / missing values are normalised to None\n    assert info['thumbnail'] is None\n    assert info['like_count'] is None\n    assert info['dislike_count'] is None\n    assert info['view_count'] == 12345\n    assert info['duration'] == 851\n    assert info['timestamp'] == 1379685485\n    assert info['age_limit'] == 18\n```",
