ract(EMBED_URL)\n\n    assert result == {\n        '_type': 'url',\n        'url': 'https://www.youtube.com/watch?v=XYZ123',\n        'ie_key': 'Youtube',\n    }\n    # No per-format webpage downloads must have happened\n    assert len(ie._calls) == 1\n\n\ndef test_mp4_formats_with_height_and_tbr(monkeypatch):\n    video_url = 'http://mediaset.example/video_720p_1000.mp4'\n    page = (\"var options = {'video': {'mp4': '%s', 'empty': ''},\"\n            \" 'title': 'My Title', 'poster': 'http://img.example/p.jpg'};\" % video_url)\n    ie = _make_ie(monkeypatch, page, {video_url: video_url})\n\n    result = ie._real_extract(EMBED_URL)\n\n    assert result['id'] == '3001'\n    assert result['title'] == 'My Title'\n    assert result['thumbnail'] == 'http://img.example/p.jpg'\n    # The empty api_url entry must be skipped (continue branch)\n    assert len(result['formats']) == 1\n    fmt = result['formats'][0]\n    assert fmt['url'] == video_url\n    assert fmt['format_id'] == 'http-mp4'\n    assert fmt['height'] == 720\n    assert fmt['tbr'] == 1000\n    # _sort_formats fills in the extension\n    assert fmt['ext'] == 'mp4'\n    assert ie._calls[1]['url'] == video_url\n    assert ie._calls[1]['note'] == 'retrieve url for mp4 video'\n\n\ndef test_fallback_regex_extraction_and_format_without_metadata(monkeypatch):\n    # 'foo()' cannot be converted to JSON by js_to_json, so _parse_json\n    # fails (fatal=False) and the regex-based fallback branch runs.\n    video_url = 'http://mediaset.example/video.mp4'\n    page = (\"var options = {'video': {'mp4': '%s'}, 'title': 'Fallback Title',\"\n            \" 'poster': 'http://img.example/f.jpg', 'broken': foo()};\" % video_url)\n    ie = _make_ie(monkeypatch, page, {video_url: video_url})\n\n    result = ie._real_extract(EMBED_URL)\n\n    assert result['id'] == '3001'\n    assert result['title'] == 'Fallback Title'\n    assert result['thumbnail'] == 'http://img.example/f.jpg'\n    assert len(result['formats']) == 1\n    fmt = r