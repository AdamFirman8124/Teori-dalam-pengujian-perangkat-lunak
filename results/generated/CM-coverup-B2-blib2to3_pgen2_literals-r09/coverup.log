h'$\"):\n        evalString(\"hello\")\n\n\n# --- Lines 50-51: triple-quote detection, both branches --------------------\n\ndef test_triple_single_quoted_string():\n    assert evalString(\"'''hello'''\") == \"hello\"\n\n\ndef test_triple_double_quoted_string():\n    assert evalString('\"\"\"hello\"\"\"') == \"hello\"\n\n\ndef test_empty_triple_quoted_string():\n    # len(s) == 2 * len(q): boundary of the line-53 assertion.\n    assert evalString('\"\"\"\"\"\"') == \"\"\n\n\ndef test_empty_single_quoted_string():\n    assert evalString(\"''\") == \"\"\n\n\ndef test_triple_quoted_string_with_escapes():\n    assert evalString('\"\"\"a\\\\nb\"\"\"') == \"a\\nb\"\n\n\n# --- Line 52: unterminated string assertion --------------------------------\n\ndef test_unterminated_string_asserts():\n    with pytest.raises(AssertionError, match=r\"o'$\"):\n        evalString(\"'hello\")\n\n\n# --- Line 53: too-short triple-quoted string assertion ---------------------\n\ndef test_too_short_triple_quoted_string_asserts():\n    # \"'''\" is mistaken for a triple-quoted string but is too short.\n    with pytest.raises(AssertionError):\n        evalString(\"'''\")\n\n\n# --- Line 55: escape-sequence substitution (calls `escape`) ----------------\n\ndef test_simple_escapes():\n    assert evalString(r\"'\\a\\b\\f\\n\\r\\t\\v'\") == \"\\a\\b\\f\\n\\r\\t\\v\"\n\n\ndef test_quote_and_backslash_escapes():\n    assert evalString(r\"'\\'x\\\"y\\\\z'\") == \"'x\\\"y\\\\z\"\n\n\ndef test_trailing_escaped_quote_in_single_quoted_string():\n    assert evalString(r\"'\\'\") == \"'\"\n\n\ndef test_hex_escape():\n    assert evalString(r\"'\\x41'\") == \"A\"\n\n\ndef test_hex_escape_is_greedy_up_to_two_digits():\n    # `x.{0,2}` consumes at most two hex digits; the rest stays literal.\n    assert evalString(r\"'\\x411'\") == \"A1\"\n\n\ndef test_octal_escapes():\n    assert evalString(r\"'\\101\\1'\") == \"A\\x01\"\n\n\ndef test_mixed_escapes():\n    assert evalString(r\"'\\x41\\n\\102\\t'\") == \"A\\nB