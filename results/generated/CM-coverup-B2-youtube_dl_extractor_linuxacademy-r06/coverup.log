\n\nAlso \u2014 hmm, `InfoExtractor.__init__` in newer youtube_dl:\n\n```python\ndef __init__(self, downloader=None):\n    self._downloader = downloader\n    self._cookie_jar = None\n```\n\nor just `self._downloader = downloader`. Fine.\n\nLet me make the get_info calls now.\n\nActually one more: I should double check `InfoExtractor._sort_formats` requires `self._downloader.params` \u2014 yes, `self._downloader.params.get('prefer_free_formats')` \u2014 FakeYDL has params. Good.\n\nAnd `_search_regex` requires `self._downloader.params.get('no_color')` \u2014 good.\n\nLet me make the calls.\n\nAlso \u2014 I realize I should double check the exact `_real_extract` source to make sure the prompt matches (e.g., variable names, the exact regexes). get_info('LinuxAcademyIE._real_extract').\n\nLet me go.\n\nAfter the calls, I'll assemble the final test script. Let me draft it fully now, pending confirmation of utils behavior:\n\n```python\n\"\"\"Tests for youtube_dl.extractor.linuxacademy.LinuxAcademyIE._real_extract.\"\"\"\n\nimport json\n\nfrom youtube_dl.extractor.linuxacademy import LinuxAcademyIE\nfrom youtube_dl.utils import parse_duration, unified_timestamp\n\n\nclass FakeYDL(object):\n    \"\"\"Minimal YoutubeDL stand-in exposing only what the extractor touches.\"\"\"\n\n    def __init__(self):\n        self.params = {}\n\n    def report_warning(self, msg):\n        pass\n\n\ndef _make_ie(monkeypatch, webpage, formats=None):\n    \"\"\"Build a LinuxAcademyIE with the network layer stubbed out.\"\"\"\n    ie = LinuxAcademyIE(FakeYDL())\n    monkeypatch.setattr(\n        ie, '_download_webpage', lambda url, video_id, *args, **kwargs: webpage)\n    if formats is None:\n        formats = [{'url': 'https://example.com/video.m3u8', 'ext': 'mp4'}]\n    monkeypatch.setattr(\n        ie, '_extract_m3u8_formats', lambda *args, **kwargs: list(formats))\n    return ie\n\n\ndef test_course_playlist(monkeypatch):\n    module = {\n        'title': 'AWS Certified Cloud Practitioner',\n        'md_desc': '<b>Course description</b>',\n        'duration': '8h',\n        'items': [\n            'not-a-dict',\n            {'type': {'name': 'Section', 'slug': None},\n             'course_name': 'Chapter One', 'course_module': '11'},\n            {'type': {'name': 'Quiz', 'slug': 'quiz'}, 'title': 'Quiz 1'},\n            {'type': {'name': 'Lesson', 'slug': 'lesson'},\n             'url': '/cp/courses/lesson/course/7971/lesson/2',\n             'title': 'Lesson A', 'md_desc': 'Desc A',\n             'date': '2020-12-08 05:18:27', 'duration': '5:04'},\n            {'type': {'name': 'lesson', 'slug': None}, 'url': None,\n             'title': 'Lesson Without Url'},\n            {'type': {'name': None, 'slug': 'LESSON'},\n             'url': 'https://linuxacademy.com/cp/courses/lesson/course/7972/lesson/3',\n             'lesson_name': 'Lesson B', 'description': '<i>Desc B</i>',\n             'created_on': 'Dec 9, 2020'},\n            {'type': {'name': 'lesson', 'slug': 'lesson'},\n             'url': 'relative/lesson/4', 'text': '<p>Desc C</p>'},\n            {'type': {'name': 'Section', 'slug': None},\n             'course_name': 'Chapter Two', 'course_module': '12'},\n            {'type': {'name': 'lesson', 'slug': None},\n             'url': '/cp/courses/lesson/course/7973/lesson/5',\n             'title': 'Lesson D'},\n        ],\n    }\n    ie = _make_ie(monkeypatch, 'window.module = %s;' % json.dumps(module))\n\n    result = ie._real_extract('https://linuxacademy.com/cp/modules/view/id/154')\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == '154'\n    assert result['title'] == 'AWS Certified Cloud Practitioner'\n    assert result['description'] == '<b>Course description</b>'\n    assert result['duration'] == parse_duration('8h')\n    assert result['duration'] == 28800  # pending verification\n\n    entries = result['entries']\n    assert len(entries) == 4\n\n    first, second, third, fourth = entries\n    assert first['_type'