x_length=5, normalize=True)\n    assert result == 'R...ED'\n    assert len(result) == 5\n\n\ndef test_get_shortish_repr_custom_repr_used():\n    class Foo:\n        def __repr__(self):\n            return 'boring default'\n\n    def custom_action(x):\n        return 'custom foo repr'\n\n    result = get_shortish_repr(Foo(), custom_repr=((Foo, custom_action),))\n    assert result == 'custom foo repr'\n\n\ndef test_get_shortish_repr_custom_repr_exception_still_caught():\n    class Bar:\n        pass\n\n    def bad_action(x):\n        raise KeyError('custom repr failed')\n\n    result = get_shortish_repr(Bar(), custom_repr=((Bar, bad_action),))\n    assert result == 'REPR FAILED'\n\n\ndef test_get_shortish_repr_multiline_truncated_normalized():\n    class Multi:\n        def __repr__(self):\n            return 'aaa\\nbbb 0xdeadbeef ccc\\nddd'\n\n    result = get_shortish_repr(Multi(), max_length=12, normalize=True)\n    # Newlines are removed first: 'aaabbb 0xdeadbeef cccddd'\n    # Then the address is normalized away: 'aaabbb  cccddd'\n    # Then truncated to 12 chars.\n    assert '\\n' not in result\n    assert '0x' not in result\n    assert len(result) == 12\n    assert result == 'aaabbb  cccd...'\n```",
