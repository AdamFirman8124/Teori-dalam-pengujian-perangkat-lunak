n 3's urllib.response.addbase subclasses tempfile._TemporaryFileWrapper (this was done in Python 3.1 or so to support context managers). And _TemporaryFileWrapper.__init__(self, file, name, delete=True). And addinfourl.__init__:\n\n```python\ndef __init__(self, fp, headers, url, code=None):\n    if isinstance(headers, email.message.Message):\n        headers = email.message.Message\n    super().__init__(fp, url)  # ??? \n```\n\nHmm, _TemporaryFileWrapper(file, name) \u2014 name would be url! That makes sense actually: the \"name\" of the temp file wrapper is the URL. So addinfourl.__init__ calls super().__init__(fp, url) \u2192 addbase.__init__(fp, url) \u2192 _TemporaryFileWrapper.__init__(fp, url). And HTTPError calls super().__init__(fp, hdrs, url) \u2192 addinfourl.__init__(fp, hdrs, url). Everything lines up! Great, so:\n\n- HTTPError(url, code, msg, hdrs, fp) with fp=None \u2192 fp=BytesIO() \u2192 addinfourl(BytesIO(), hdrs, url) \u2192 works with hdrs=None (just stored).\n\nSo `HTTPError('http://example.com/frag', 404, 'Not Found', None, None)` works. \n\nNow, let me also handle the possibility that `report_retry_fragment`'s real implementation would be called if I forget to patch \u2014 I won't forget.\n\nLet me also think about whether `real_download` accesses `self.params.get('test', False)` \u2014 params is our dict. Good.\n\nNow the get_info calls. Let me do them:\n\n1. get_info('DashSegmentsFD')\n2. get_info('FragmentFD')\n3. get_info('FragmentFD._download_fragment')\n4. get_info('FragmentFD._prepare_and_start_frag_download')\n5. get_info('FragmentFD._append_fragment')\n6. get_info('FragmentFD._finish_frag_download')\n7. get_info('FragmentFD.report_retry_fragment')\n8. get_info('FragmentFD.report_skip_fragment')\n9. get_info('FileDownloader.__init__')\n10. get_info('FileDownloader.report_error')\n11. get_info('urljoin')\n\nAll independent \u2192 one block.\n\nThen finalize the test script.\n\nLet me draft the final test script now (will adjust after tool results):\n\n```python\nimport io\nfrom unittest.mock import MagicMock, call\n\nimport pytest\n\nfrom youtube_dl.compat import compat_urllib_error\nfrom youtube_dl.downloader.dash import DashSegmentsFD\nfrom youtube_dl.utils import DownloadError\n\n\ndef _http_error(url='http://example.com/frag', code=404):\n    \"\"\"Build a real HTTPError instance without touching the network.\"\"\"\n    return compat_urllib_error.HTTPError(\n        url, code, 'Not Found', None, io.BytesIO(b''))\n\n\ndef _make_fd(monkeypatch, params=None, fragment_index=0, download_side_effect=None):\n    \"\"\"Build a DashSegmentsFD with all inherited helpers mocked out.\"\"\"\n    ydl = MagicMock()\n    fd = DashSegmentsFD(ydl, params=params or {})\n\n    def fake_prepare(ctx):\n        ctx['fragment_index'] = fragment_index\n\n    monkeypatch.setattr(fd, '_prepare_and_start_frag_download',\n                        MagicMock(side_effect=fake_prepare))\n    download_mock = MagicMock(return_value=(True, b'frag-data'))\n    if download_side_effect is not None:\n        download_mock.side_effect = download_side_effect\n    monkeypatch.setattr(fd, '_download_fragment', download_mock)\n    monkeypatch.setattr(fd, '_append_fragment', MagicMock())\n    monkeypatch.setattr(fd, '_finish_frag_download', MagicMock())\n    monkeypatch.setattr(fd, 'report_retry_fragment', MagicMock())\n    monkeypatch.setattr(fd, 'report_skip_fragment', MagicMock())\n    monkeypatch.setattr(fd, 'report_error', MagicMock())\n    return fd\n\n\ndef _urls(fd):\n    return [c[0][1] for c in fd._download_fragment.call_args_list]\n\n\ndef _ctx(fd):\n    return fd._prepare_and_start_frag_download.call_args[0][0]\n\n\ndef test_success_downloads_every_fragment(monkeypatch):\n    fd = _make_fd(monkeypatch)\n    info_dict = {\n        'fragments': [\n            {'url': 'http://example.com/seg0.m4s'},\n            {'url': 'http://example.com/seg1.m4s'},\n            {'url': 'http://example.com/seg2.m4s'},\n        ],\n    }\n\n    result = fd.real_download('out.mp4', info_dict)\n\n    assert result is True\n    assert _urls(fd) == [\n        'http://example.com/seg0.m4s',\n        'http://example.com/seg1.m4s',\n        'http://example.com/seg2.m4s',\n    ]\n    assert fd._append_fragment.call_count == 3\n    assert all(c[0][1] == b'frag-data' for c in fd._append_fragment.call_args_list)\n    fd._finish_frag_download.assert_called_once_with(_ctx(fd))\n    assert _ctx(fd)['filename'] == 'out.mp4'\n    assert _ctx(fd)['total_frags'] == 3\n    fd.report_skip_fragment.assert_not_called()\n    fd.report_error.assert_not_called()\n\n\ndef test_test_mode_downloads_only_first_fragment(monkeypatch):\n    fd = _make_fd(monkeypatch, params={'test': True})\n    info_dict = {\n        'fragments': [\n            {'url': 'http://example.com/seg0.m4s'},\n            {'url': 'http://example.com/seg1.m4s'},\n        ],\n    }\n\n    result = fd.real_download('out.mp4', info_dict)\n\n    assert result is True\n    assert _ctx(fd)['total_frags'] == 1\n    assert _urls(fd) == ['http://example.com/seg0.m4s']\n    fd._finish_frag_download.assert_called_once()\n\n\ndef test_fragment_url_built_from_base_url_and_path(monkeypatch):\n    fd = _make_fd(monkeypatch)\n    info_dict = {\n        'fragment_base_url': 'http://example.com/base/',\n        'fragments': [{'path': 'seg0.m4s'}, {'path': 'seg1.m4s'}],\n    }\n\n    result = fd.real_download('out.mp4', info_dict)\n\n    assert result is True\n    assert _urls(fd) == [\n        'http://example.com/base/seg0.m4s',\n        'http://example.com/base/seg1.m4s',\n    ]\n\n\ndef test_missing_base_url_with_path_only_fragment_raises_assertion(monkeypatch):\n    fd = _make_fd(monkeypatch)\n    info_dict = {'fragments': [{'path': 'seg0.m4s'}]}\n\n    with pytest.raises(AssertionError):\n        fd.real_download('out.mp4', info_dict)\n\n    fd._download_fragment.assert_not_called()\n    fd._finish_frag_download.assert_not_called()\n\n\ndef test_resume_skips_fragments_up_to_frag