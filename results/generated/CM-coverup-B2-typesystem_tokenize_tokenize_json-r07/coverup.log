exc_info.value\n    assert exc.code == \"parse_error\"\n    assert exc.text.endswith(\".\")\n    assert isinstance(exc.position.line_no, int)\n    assert isinstance(exc.position.column_no, int)\n    assert isinstance(exc.position.char_index, int)\n\n\ndef test_tokenize_json_parse_error_bytes():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(b\"{invalid}\")\n    assert exc_info.value.code == \"parse_error\"\n    assert exc_info.value.text.endswith(\".\")\n\n\ndef test_tokenize_json_parse_error_position_matches_json_error():\n    from json.decoder import JSONDecodeError\n    import json\n    bad = '{\"a\": }'\n    try:\n        json.loads(bad)\n    except JSONDecodeError as jde:\n        exp_line, exp_col, exp_pos = jde.lineno, jde.colno, jde.pos\n        exp_msg = jde.msg + \".\"\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(bad)\n    exc = exc_info.value\n    assert exc.code == \"parse_error\"\n    assert exc.text == exp_msg\n    assert exc.position.line_no == exp_line\n    assert exc.position.column_no == exp_col\n    assert exc.position.char_index == exp_pos\n```",
