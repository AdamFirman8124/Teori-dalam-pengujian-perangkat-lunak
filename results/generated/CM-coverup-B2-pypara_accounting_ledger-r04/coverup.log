ting.ledger import Ledger, LedgerEntry\nfrom pypara.commons.numbers import Amount, Quantity\n\n\nclass StubAccount:\n    \"\"\"\n    Minimal account stub satisfying the `Account` protocol.\n    \"\"\"\n\n    def __init__(self, code: str, name: str) -> None:\n        self.code = code\n        self.name = name\n        self.type = None\n        self.coa = None\n        self.parent = None\n\n\ndef _make_posting(account, direction, amount, when=None):\n    \"\"\"\n    Helper building a posting (and its journal entry) for the given account.\n    \"\"\"\n    when = when or datetime.date(2021, 1, 2)\n    journal = JournalEntry(when, \"Test journal entry\", None)\n    return Posting(journal, when, account, direction, amount)\n\n\ndef test_last_balance_falls_back_to_initial_balance_when_ledger_is_empty():\n    \"\"\"\n    `_last_balance` must return the initial balance when the ledger has no\n    entries yet (the `IndexError` branch).\n    \"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"1000\")))\n    ledger = Ledger(account=account, initial=initial)\n\n    assert ledger.entries == []\n    assert ledger._last_balance == Quantity(Decimal(\"1000\"))\n\n\ndef test_add_creates_entry_from_initial_balance_and_appends_it():\n    \"\"\"\n    `add` must create a ledger entry whose balance starts from the initial\n    balance (empty-ledger branch of `_last_balance`), append it to the\n    ledger, and return it.\n    \"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"1000\")))\n    ledger = Ledger(account=account, initial=initial)\n\n    assert Direction.INC.value == 1\n    assert Direction.DEC.value == -1\n\n    posting = _make_posting(account, Direction.INC, Amount(Decimal(\"250\")))\n    entry = ledger.add(posting)\n\n    # The returned entry is the one stored in the ledger:\n    assert isinstance(entry, LedgerEntry)\n    assert entry.ledger is ledger\n    assert entry.posting is posting\n    assert entry.balance == Quantity(Decimal(\"1250\"))  # 1000 + 250 * (+1)\n    assert ledger.entries == [entry]\n\n    # Basic delegation post-conditions:\n    assert entry.date == posting.date\n    assert entry.description == posting.journal.description\n    assert entry.amount == posting.amount\n\n\ndef test_add_chains_balances_from_previous_entry():\n    \"\"\"\n    Subsequent `add` calls must base the new balance on the last entry's\n    balance (the non-empty branch of `_last_balance`), respecting the\n    posting direction.\n    \"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"1000\")))\n    ledger = Ledger(account=account, initial=initial)\n\n    posting1 = _make_posting(account, Direction.INC, Amount(Decimal(\"250\")))\n    entry1 = ledger.add(posting1)\n\n    posting2 = _make_posting(account, Direction.DEC, Amount(Decimal(\"400\")))\n    entry2 = ledger.add(posting2)\n\n    assert entry2.ledger is ledger\n    assert entry2.posting is posting2\n    assert entry2.balance == Quantity(Decimal(\"850\"))  # 1250 + 400 * (-1)\n    assert ledger.entries == [entry1, entry2]\n\n    # `_last_balance` now reflects the last entry (non-empty branch):\n    assert ledger._last_balance == Quantity(Decimal(\"850\"))\n```\n\nWait \u2014 `entry.date`, `entry.description`, `entry.amount` \u2014 these are properties on LedgerEntry per get_info. `entry.date == posting.date` \u2014 safe delegation. `entry.description == posting.journal.description` \u2014 safe. `entry.amount == posting.amount` \u2014 safe. OK, keep those.\n\nHmm, one thing: `Quantity(Decimal(\"1250\"))` vs the computed value. `Quantity` is NewType over Decimal, so `Quantity(Decimal(\"1000\")) == Decimal(\"1000\")` \u2192 True. And `entry.balance` is `Quantity(Decimal(...))` which is a Decimal. `Decimal(\"1250\") == Decimal(\"1000\") + Decimal(\"250\") * 1` \u2192 True. Good.\n\nBut careful: `posting.amount * posting.direction.value` \u2014 `Decimal(\"250\") * 1` = `Decimal(\"250\")`. `Decimal(\"1000\") + Decimal(\"250\")` = `Decimal(\"1250\")`. And `Quantity(Decimal(\"1250\")) == Decimal(\"1250\")` \u2192 True. Good.\n\nFor the second: `Decimal(\"1250\") + Decimal(\"400\") * (-1)` = `Decimal(\"1250\") - Decimal(\"400\")` = `Decimal(\"850\")`. Good.\n\nNow, about `initial.value` \u2014 `Balance(datetime.date(2021, 1, 1), Quantity(Decimal(\"1000\")))`. `initial.value` is `Quantity(Decimal(\"1000\"))` = Decimal(\"1000\"). Good.\n\nNow, state pollution: none of these tests modify global state. The `JournalEntry` creates a guid via `makeguid` \u2014 uses uuid4, no global state. So no cleanup needed. The instruction says to clean up \"so as to avoid state pollution; use 'monkeypatch' or 'pytest-mock' if appropriate\" \u2014 it's not appropriate here since there's no global state being touched. I could add a comment noting the tests are self-contained. That's fine.\n\nShould I worry that `Ledger` import path is `pypara.accounting.ledger`? Yes, given the file is pypara/accounting/ledger.py. And `LedgerEntry` is also there.\n\nOne more consideration: the code snippet shows `from pypara.accounting.generic import Balance` \u2014 confirmed by get_info that Balance is in pypara/accounting/generic.py. Good.\n\n`Amount` from `pypara.commons.numbers` \u2014 confirmed (LedgerEntry imports `Amount, Quantity` from there). Good.\n\n`Direction` from `pypara.accounting.journaling` \u2014 Posting references `Direction` in journaling.py, so it's defined/imported there. Good.\n\nNow, is there any chance `JournalEntry(...)` requires more args? Fields: `date, description, source` (init), `postings` (init=False), `guid` (init=False). So `JournalEntry(date, description, source)` works. Good.\n\nIs there any chance `Posting` requires `journal` to have the posting already in it? No \u2014 Posting is just a frozen dataclass; no validation in `__init__` (frozen dataclass generated init). Good.\n\nHmm, wait \u2014 actually, in pypara, `Posting` might have `__post_init__`? It's `@dataclass(frozen=True)` \u2014 I don't think there's post_init. The get_info output shows no `__post_init__`. Good.\n\nAlso, should the test file include a fixture to ensure no state pollution? Not needed. But maybe I'll add a small autouse fixture that does nothing? No \u2014 unnecessary. Keep it clean.\n\nLet me also double check: the uncovered lines are 127-130 and 140-146. Line 127 is `try:`, 128 `return self.entries[-1].balance`, 129 `except IndexError:`, 130 `return self.initial.value`. Lines 140, 143, 146 in `add`. My tests cover:\n\n- Test 1: lines 127, 129, 130 (empty ledger \u2192 IndexError branch).\n- Test 2: lines 127, 129, 130 (first add calls `_last_balance` on empty ledger), 140, 143, 146.\n- Test 3: line 128 (second add calls `_last_balance` with non-empty entries), plus 140/143/146 again.\n\nAll covered. \n\nOne subtlety: in test 2, `assert ledger.entries == [entry]` \u2014 comparing list of LedgerEntry dataclasses with `[entry]` \u2014 equality of dataclass compares fields; `entry.ledger is ledger` \u2014 comparing ledger to itself fine. Actually `LedgerEntry` is a dataclass with eq=True by default, so `ledger.entries == [entry]` compares field-wise: ledger (same object), posting (same), balance (equal). Fine. Alternatively use `ledger.entries == [entry]` or `len(ledger.entries) == 1 and ledger.entries[0] is entry`. The identity check is stronger; let me use:\n\n```python\nassert ledger.entries == [entry]\n```\n\nand also `assert ledger.entries[-1] is entry`. Hmm, both fine. I'll use the identity-based check to be precise:\n\n```python\nassert ledger.entries == [entry]\n```\n\nis fine and readable. Let me keep both forms minimal.\n\nAlso, maybe add a test that directly exercises `_last_balance` after entries exist without going through add? Test 3 does it via assertion after adds. Good enough. But to be thorough, I could also directly append... no, using `add` is the public API.\n\nLet me also think: should I test `add` returning entry identity: `assert ledger.add(posting) is ledger.entries[-1]`? The `add` returns `entry` which was appended, so identity holds. I can assert `entry1 is ledger.entries[0]`. Included via `ledger.entries == [entry1]` (field equality) \u2014 let me make it identity: `assert ledger.entries[0] is entry1`. Stronger. I'll use identity checks.\n\nFinal test file:\n\n```python\n\"\"\"\nTests for :mod:`pypara.accounting.ledger`, specifically targeting the\npreviously uncovered lines:\n\n* ``Ledger._last_balance`` -- both the empty-ledger ``IndexError`` fallback\n  and the last-entry lookup branch;\n* ``Ledger.add`` -- ledger entry creation, buffer append and return.\n\nThe tests are self-contained: they only build local objects and never touch\nmodule-level or global state, so no monkeypatching/cleanup is required.\n\"\"\"\n\nimport datetime\nfrom decimal import Decimal\n\nfrom pypara.accounting.accounts import Account\nfrom pypara.accounting.generic import Balance\nfrom pypara.accounting.journaling import Direction, JournalEntry, Posting\nfrom pypara.accounting.ledger import Ledger, LedgerEntry\nfrom pypara.commons.numbers import Amount, Quantity\n\n\nclass StubAccount:\n    \"\"\"\n    Minimal stand-in satisfying the ``Account`` protocol.\n    \"\"\"\n\n    def __init__(self, code: str, name: str) -> None:\n        self.code = code\n        self.name = name\n        self.type = None\n        self.coa = None\n        self.parent = None\n\n\ndef _make_ledger(initial_value: str = \"1000\") -> Ledger:\n    \"\"\"\n    Creates a ledger for a stub \"Cash\" account with the given initial balance.\n    \"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(initial_value)))\n    return Ledger(account=account, initial=initial)\n\n\ndef _make_posting(account: Account, direction: Direction, amount: str, when: datetime.date = None) -> Posting:\n    \"\"\"\n    Creates a posting (with its backing journal entry) for the given account.\n    \"\"\"\n    when = when or datetime.date(2021, 1, 2)\n    journal = JournalEntry(when, \"Test journal entry\", None)\n    return Posting(journal, when, account, direction, Amount(Decimal(amount)))\n\n\ndef test_last_balance_of_empty_ledger_falls_back_to_initial_balance():\n    \"\"\"\n    ``_last_balance`` must return the initial balance when the ledger has no\n    entries yet, i.e. the ``IndexError`` fallback branch must be taken.\n    \"\"\"\n    ledger = _make_ledger(\"1000\")\n\n    assert ledger.entries == []\n    assert ledger._last_balance == Quantity(Decimal(\"1000\"))\n\n\ndef test_add_creates_first_entry_from_initial_balance():\n    \"\"\"\n    The first ``add`` must base the entry balance on the initial balance\n    (empty-ledger branch of ``_last_balance``), append the entry to the\n    ledger buffer and return it.\n    \"\"\"\n    # Sanity-check the direction values the balance arithmetic relies on:\n    assert Direction.INC.value == 1\n    assert Direction.DEC.value == -1\n\n    ledger = _make_ledger(\"1000\")\n    account = ledger.account\n\n    posting = _make_posting(account, Direction.INC, \"250\")\n    entry = ledger.add(posting)\n\n    # The created entry is returned and stored in the ledger buffer:\n    assert isinstance(entry, LedgerEntry)\n    assert entry.ledger is ledger\n    assert entry.posting is posting\n    assert ledger.entries == [entry]\n    assert ledger.entries[0] is entry\n\n    # Balance = initial (1000) + amount (250) * direction (+1):\n    assert entry.balance == Quantity(Decimal(\"1250\"))\n\n    # Delegation post-conditions:\n    assert entry.date == posting.date\n    assert entry.description == posting.journal.description\n    assert entry.amount == posting.amount\n\n\ndef test_add_chains_balance_from_last_entry():\n    \"\"\"\n    A subsequent ``add`` must base the new entry balance on the last entry's\n    balance (non-empty branch of ``_last_balance``), taking the posting\n    direction into account.\n    \"\"\"\n    ledger = _make_ledger(\"1000\")\n    account = ledger.account\n\n    entry1 = ledger.add(_make_posting(account, Direction.INC, \"250\"))\n    posting2 = _make_posting(account, Direction.DEC, \"400\")\n    entry2 = ledger.add(posting2)\n\n    assert entry2.ledger is ledger\n    assert entry2.posting is posting2\n    # Balance = last balance (1250) + amount (400) * direction (-1):\n    assert entry2.balance == Quantity(Decimal(\"850\"))\n    assert ledger.entries == [entry1, entry2]\n    assert ledger.entries[1] is entry2\n\n    # ``_last_balance`` now resolves through the last entry (line 128):\n    assert ledger._last_balance == entry2.balance\n    assert ledger._last_balance == Quantity(Decimal(\"850\"))\n```\n\nWait \u2014 `when: datetime.date = None` type hint is wrong; use `Optional[datetime.date]`. Or just default inside. Let me fix: `def _make_posting(account, direction, amount, when=None):` without annotation, or with Optional. I'll use `Optional[datetime.date]` and import Optional. Fine.\n\nAlso `Ledger(account=account, initial=initial)` \u2014 dataclass init with keyword args works.\n\nOne more check: `entry.description == posting.journal.description` \u2014 LedgerEntry.description returns `self.posting.journal.description` presumably. Safe.\n\nHmm, actually wait \u2014 is `LedgerEntry.description` maybe returning something else? get_info shows it exists but not its body. In pypara ledger.py:\n\n```python\n    @property\n    def description(self) -> str:\n        \"\"\"\n        Returns the description of the ledger entry.\n        \"\"\"\n        return self.posting.journal.description\n```\n\nI'm fairly confident. And `date` returns `self.posting.date`. And `amount` returns `self.posting.amount`. These are natural delegations. Risk is low. But to be extra safe, should I drop them? The task says include assertions verifying applicable postconditions. The core postconditions are covered. The delegation ones add value and are very likely correct. I'll keep them \u2014 they're standard pypara behavior.\n\nActually, let me reconsider `entry.date`: could it be `self.posting.journal.date`? In pypara, postings have their own date, and journal entries have a date too. LedgerEntry.date \u2014 hmm. In pypara's ledger.py:\n\n```python\n    @property\n    def date(self) -> datetime.date:\n        \"\"\"\n        Returns the date of the ledger entry.\n        \"\"\"\n        return self.posting.date\n```\n\nI believe it's posting.date. Since I set both journal date and posting date to the same `when`, either implementation gives the same result. That makes the assertion robust. \n\nSimilarly `description` \u2014 journal description; posting has no description. Safe.\n\n`amount` \u2014 posting.amount. Safe.\n\nOK. Also, should I verify `entry.balance` type is Quantity? `isinstance(entry.balance, Decimal)` \u2014 since Quantity is NewType of Decimal, isinstance(entry.balance, Decimal) is True. Could add but not necessary.\n\nNow, about \"clean up after the test\" \u2014 I'll add a note in the docstring that no global state is touched. Alternatively, I could add an autouse fixture that snapshots nothing... unnecessary. The instruction says \"use 'monkeypatch' or 'pytest-mock' if appropriate\" \u2014 it's not appropriate here; I'll state that in the module docstring.\n\nHmm, one thing though \u2014 is there any chance that importing these modules has side effects or that `Ledger` uses a module-level cache? No.\n\nAlso, potential issue: `from pypara.accounting.ledger import Ledger, LedgerEntry` \u2014 the snippet shows `LedgerEntry` used in `add` and in the `entries` type; it must be defined in the same module (either defined there or imported). The get_info for \"LedgerEntry\" returned a dataclass with `ledger: 'Ledger[_T]'` and imports from ledger-related modules \u2014 it says \"in pypara/accounting/ledger.py\"? Actually the get_info output for LedgerEntry didn't specify the file... Let me re-read: the first output says `in pypara/accounting/ledger.py`? It just shows the code block. The Ledger output also didn't show a file path. The Posting output showed \"in pypara/accounting/journaling.py\". The Account output showed \"in pypara/accounting/accounts.py\". The Balance output showed \"in pypara/accounting/generic.py\". For Ledger and LedgerEntry, no path shown, but given the user's snippet is from pypara/accounting/ledger.py and references `LedgerEntry`, it's defined in ledger.py. Good.\n\nAlso `Quantity` import in ledger.py is from `pypara.commons.numbers` \u2014 confirmed.\n\nEdge case: `Ledger` is `Generic[_T]` \u2014 instantiating `Ledger(account=..., initial=...)` without type params is fine at runtime.\n\nOne more: `_last_balance` is a private property; accessing it in tests is fine (needed to cover line 128 directly, though it's also covered via `add`). Accessing private members in tests is acceptable for coverage purposes.\n\nLet me also consider adding a test where the ledger has entries and we call `_last_balance` \u2014 done in test 3.\n\nI think the file is complete. Let me also double check the arithmetic once more:\n\n- initial = 1000\n- posting1: INC, 250 \u2192 balance = 1000 + 250*1 = 1250 \u2713\n- posting2: DEC, 400 \u2192 balance = 1250 + 400*(-1) = 850 \u2713\n\n`Quantity(Decimal(\"850\"))` == Decimal(\"850\") \u2713.\n\nNote: `Decimal(\"1250\") + Decimal(\"400\") * -1` \u2014 `Decimal * int` works in Python's decimal module. Yes, Decimal supports multiplication with int. Good.\n\nAlso `self._last_balance + posting.amount * posting.direction.value` \u2014 `_last_balance` returns `self.initial.value` which is `Quantity(Decimal(\"1000\"))` = Decimal. Good.\n\nFinal check on imports: `Account` is imported but only used in the type hint of `_make_posting`. That's fine (used). Actually I use `Account` in the annotation `account: Account` \u2014 fine.\n\n`Amount` used in `_make_posting`. `Quantity` used. `Balance`, `JournalEntry`, `Posting`, `Direction`, `Ledger`, `LedgerEntry` used. `datetime`, `Decimal` used. `Optional` \u2014 I'll import from typing for the annotation.\n\nLet me write the final version cleanly.\n\n```python\n\"\"\"\nTests for :mod:`pypara.accounting.ledger`, targeting the previously uncovered\nlines:\n\n* ``Ledger._last_balance`` -- both branches: the empty-ledger ``IndexError``\n  fallback to the initial balance, and the last-entry lookup;\n* ``Ledger.add`` -- ledger entry creation, append to the entry buffer, and\n  return of the new entry.\n\nThe tests only build local objects and never mutate module-level or global\nstate, hence no monkeypatching/teardown is required to avoid state pollution.\n\"\"\"\n\nimport datetime\nfrom decimal import Decimal\nfrom typing import Optional\n\nfrom pypara.accounting.accounts import Account\nfrom pypara.accounting.generic import Balance\nfrom pypara.accounting.journaling import Direction, JournalEntry, Posting\nfrom pypara.accounting.ledger import Ledger, LedgerEntry\nfrom pypara.commons.numbers import Amount, Quantity\n\n\nclass StubAccount:\n    \"\"\"Minimal stand-in satisfying the ``Account`` protocol.\"\"\"\n\n    def __init__(self, code: str, name: str) -> None:\n        self.code = code\n        self.name = name\n        self.type = None\n        self.coa = None\n        self.parent = None\n\n\ndef _make_ledger(initial_value: str = \"1000\") -> Ledger:\n    \"\"\"Creates a ledger for a stub \"Cash\" account with the given initial balance.\"\"\"\n    account = StubAccount(\"100\", \"Cash\")\n    initial = Balance(datetime.date(2021, 1, 1), Quantity(Decimal(initial_value)))\n    return Ledger(account=account, initial=initial)\n\n\ndef _make_posting(account: Account, direction: Direction, amount: str,\n                  when: Optional[datetime.date] = None) -> Posting:\n    \"\"\"Creates a posting (with its backing journal entry) for the given account.\"\"\"\n    when = when if when is not None else datetime.date(2021, 1, 2)\n    journal = JournalEntry(when, \"Test journal entry\", None)\n    return Posting(journal, when, account, direction, Amount(Decimal(amount)))\n\n\ndef test_last_balance_of_empty_ledger_falls_back_to_initial_balance():\n    \"\"\"``_last_balance`` returns the initial balance when there are no entries.\"\"\"\n    ledger = _make_ledger(\"1000\")\n\n    assert ledger.entries == []\n    # Exercises the ``except IndexError`` branch:\n    assert ledger._last_balance == Quantity(Decimal(\"1000\"))\n\n\ndef test_add_creates_first_entry_from_initial_balance():\n    \"\"\"The first ``add`` bases the balance on the initial balance and stores/returns the entry.\"\"\"\n    # The balance arithmetic relies on these direction values:\n    assert Direction.INC.value == 1\n    assert Direction.DEC.value == -1\n\n    ledger = _make_ledger(\"1000\")\n    account = ledger.account\n\n    posting = _make_posting(account, Direction.INC, \"250\")\n    entry = ledger.add(posting)\n\n    # The new entry is returned and appended to the ledger buffer:\n    assert isinstance(entry, LedgerEntry)\n    assert entry.ledger is ledger\n    assert entry.posting is posting\n    assert ledger.entries == [entry]\n    assert ledger.entries[0] is entry\n\n    # Balance = initial (1000) + amount (250) * direction (+1):\n    assert entry.balance == Quantity(Decimal(\"1250\"))\n\n    # Delegation post-conditions:\n    assert entry.date == posting.date\n    assert entry.description == posting.journal.description\n    assert entry.amount == posting.amount\n\n\ndef test_add_chains_balance_from_last_entry():\n    \"\"\"Subsequent ``add`` calls chain on the last entry's balance, honoring the direction.\"\"\"\n    ledger = _make_ledger(\"1000\")\n    account = ledger.account\n\n    entry1 = ledger.add(_make_posting(account, Direction.INC, \"250\"))\n    posting2 = _make_posting(account, Direction.DEC, \"400\")\n    entry2 = ledger.add(posting2)\n\n    assert entry2.ledger