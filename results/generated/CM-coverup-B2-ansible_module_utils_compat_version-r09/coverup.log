t but not needed for coverage.\n\nLet me also double-check `StrictVersion(\"1.0\") == \"1.0.0\"`: _cmp(\"1.0.0\") \u2192 coerce \u2192 StrictVersion(\"1.0.0\").version = (1,0,0); self.version = (1,0,0) \u2192 equal; both prerelease None \u2192 return 0 \u2192 eq True. \u2713\n\nAnd `StrictVersion(\"1.0a1\") < \"1.0\"`: coerce other \u2192 version (1,0,0) == self (1,0,0); self.prerelease=('a',1) truthy, other None \u2192 cond2 \u2192 return -1 \u2192 lt True. \u2713\n\nNow assemble the full test file:\n\n```python\n\"\"\"Tests for StrictVersion._cmp in ansible/module_utils/compat/version.py.\"\"\"\n\nimport pytest\n\nfrom ansible.module_utils.compat.version import StrictVersion\n\n\ndef test_cmp_coerces_string_operand():\n    \"\"\"Lines 170-171: a str operand is converted to StrictVersion.\"\"\"\n    assert StrictVersion(\"1.0\") == \"1.0\"\n    assert StrictVersion(\"1.0\") == \"1.0.0\"\n    assert not (StrictVersion(\"1.0\") == \"2.0\")\n\n\ndef test_cmp_non_version_non_str_returns_not_implemented():\n    \"\"\"Lines 172-173: operands that are neither str nor StrictVersion yield NotImplemented.\"\"\"\n    v = StrictVersion(\"1.0\")\n    assert v._cmp(object()) is NotImplemented\n    assert v._cmp(42) is NotImplemented\n    assert v._cmp(None) is NotImplemented\n    # Rich comparison falls back to TypeError when both sides return NotImplemented.\n    with pytest.raises(TypeError):\n        v < 42\n\n\ndef test_cmp_numeric_less_than():\n    \"\"\"Lines 175, 178-179: self.version < other.version -> -1.\"\"\"\n    assert StrictVersion(\"1.0\")._cmp(StrictVersion(\"2.0\")) == -1\n    assert StrictVersion(\"1.0\") < StrictVersion(\"1.0.1\")\n    assert StrictVersion(\"1.0\") <= StrictVersion(\"2.0\")\n\n\ndef test_cmp_numeric_greater_than():\n    \"\"\"Lines 175, 180-181: self.version > other.version -> 1.\"\"\"\n    assert StrictVersion(\"2.0\")._cmp(StrictVersion(\"1.0\")) == 1\n    assert StrictVersion(\"1.0.1\") > StrictVersion(\"1.0\")\n    assert StrictVersion(\"2