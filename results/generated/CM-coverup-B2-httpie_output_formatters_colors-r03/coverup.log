xtend([subtype_name, subtype_suffix])\n        mime_types.extend([\n            '%s/%s' % (type_, subtype_name),\n            '%s/%s' % (type_, subtype_suffix)\n        ])\n\n    # As a last resort, if no lexer feels responsible, and\n    # the subtype contains 'json', take the JSON lexer\n    if 'json' in subtype:\n        lexer_names.append('json')\n\n    # Try to resolve the right lexer.\n    lexer = None\n    for mime_type in mime_types:\n        try:\n            lexer = pygments.lexers.get_lexer_for_mimetype(mime_type)\n            break\n        except ClassNotFound:\n            pass\n    else:\n        for name in lexer_names:\n            try:\n                lexer = pygments.lexers.get_lexer_by_name(name)\n            except ClassNotFound:\n                pass\n\n    if explicit_json and body and (not lexer or isinstance(lexer, TextLexer)):\n        # JSON response with an incorrect Content-Type?\n        try:\n            json.loads(body)  # FIXME: the body also gets parsed in json.py\n        except ValueError:\n            pass  # Nope\n        else:\n            lexer = pygments.lexers.get_lexer_by_name('json')\n\n    return lexer\n```\n\nYes, this matches httpie's actual code. The module imports `pygments.lexers` somewhere (maybe `import pygments.lexers` \u2014 the snippet shows `import pygments.lexer` which might be a typo in the extraction, but the actual code has `import pygments.lexers`).\n\nNow, for the tests, I need to be careful about state pollution. The function is pure (no global state modification), so cleanup isn't really needed. But the instructions say to clean up after tests and use monkeypatch/pytest-mock if appropriate. Since get_lexer is pure, no monkeypatching needed. However, maybe I could use monkeypatch to make tests robust against pygments version differences? E.g., monkeypatch `pygments.lexers.get_lexer_for_mimetype`? But the function references `pygments.lexers.get_lexer_for_mimetype` via the module attribute `pygments.lexe