strftime('%s')))`` which can never be ``''`` nor start with\n``'%'``, so only its false branch can ever be taken.\n\"\"\"\n\nimport datetime\nimport types\n\nimport ansible.module_utils.facts.system.date_time as date_time_module\nfrom ansible.module_utils.facts.system.date_time import DateTimeFactCollector\n\n# The real datetime class, captured before any test patching takes place.\n_REAL_DATETIME = datetime.datetime\n\n# Fixed timestamp used by the fakes: 2017-07-14 02:40:00.123456 UTC.\n_EPOCH_TS = 1500000000.123456\n\n_ALL_DATE_TIME_KEYS = {\n    'year', 'month', 'weekday', 'weekday_number', 'weeknumber', 'day',\n    'hour', 'minute', 'second', 'epoch', 'epoch_int', 'date', 'time',\n    'iso8601_micro', 'iso8601', 'iso8601_basic', 'iso8601_basic_short',\n    'tz', 'tz_dst', 'tz_offset',\n}\n\n\ndef _make_fake_datetime_class(epoch_strftime_results):\n    \"\"\"Build a stand-in for ``datetime.datetime``.\n\n    ``strftime('%s')`` returns the given values in sequence, which simulates\n    platforms where the ``%s`` directive is unsupported; once the sequence is\n    exhausted it returns ``str(int(ts))``.  Every other format is delegated to\n    the real datetime implementation for the very same timestamp so tests can\n    compute the expected values independently.\n    \"\"\"\n    epoch_results = list(epoch_strftime_results)\n\n    class FakeDateTime(object):\n        def __init__(self, ts, utc=False):\n            self._ts = ts\n            self._utc = utc\n\n        @classmethod\n        def fromtimestamp(cls, ts):\n            return cls(ts)\n\n        @classmethod\n        def utcfromtimestamp(cls, ts):\n            return cls(ts, utc=True)\n\n        def strftime(self, fmt):\n            if fmt == '%s':\n                if epoch_results:\n                    return epoch_results.pop(0)\n                return str(int(self._ts))\n            if self._utc:\n                return _REAL_DATETIME.fromtimestamp(\n                    self._ts, datetime.timezone.utc).strftime(fmt)\n            return _REAL_DATETIME.fromtimestamp(self._ts).strftime(fmt)\n\n    return FakeDateTime\n\n\ndef _install_fakes(monkeypatch, epoch_strftime_results):\n    \"\"\"Point the module under test at deterministic datetime/time fakes.\"\"\"\n    fake_datetime_cls = _make_fake_datetime_class(epoch_strftime_results)\n    fake_datetime_module = types.SimpleNamespace(datetime=fake_datetime_cls)\n    fake_time_module = types.SimpleNamespace(\n        time=lambda: _EPOCH_TS,\n        strftime=lambda fmt: {'%Z': 'CET', '%z': '+0100'}[fmt],\n        tzname=('CET', 'CEST'),\n    )\n    monkeypatch.setattr(date_time_module, 'datetime', fake_datetime_module)\n    monkeypatch.setattr(date_time_module, 'time', fake_time_module)\n\n\ndef _local_now():\n    return _REAL_DATETIME.fromtimestamp(_EPOCH_TS)\n\n\ndef _utc_now():\n    return _REAL_DATETIME.fromtimestamp(_EPOCH_TS, datetime.timezone.utc)\n\n\ndef test_collect_returns_all_date_time_facts(monkeypatch):\n    \"\"\"Happy path: %s is supported, so neither fallback branch is taken.\"\"\"\n    _install_fakes(monkeypatch, [])\n\n    facts = DateTimeFactCollector().collect()\n\n    assert set(facts) == {'date_time'}\n    dt = facts['date_time']\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert all(isinstance(value, str) for value in dt.values())\n\n    now = _local_now()\n    utcnow = _utc_now()\n    assert dt['year'] == now.strftime('%Y')\n    assert dt['month'] == now.strftime('%m')\n    assert dt['weekday'] == now.strftime('%A')\n    assert dt['weekday_number'] == now.strftime('%w')\n    assert dt['weeknumber'] == now.strftime('%W')\n    assert dt['day'] == now.strftime('%d')\n    assert dt['hour'] == now.strftime('%H')\n    assert dt['minute'] == now.strftime('%M')\n    assert dt['second'] == now.strftime('%S')\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert dt['date'] == now.strftime('%Y-%m-%d')\n    assert dt['time'] == now.strftime('%H:%M:%S')\n    assert dt['iso8601_micro'] == utcnow.strftime('%Y-%m-%dT%H:%M:%S.%fZ')\n    assert dt['iso8601'] == utcnow.strftime('%Y-%m-%dT%H:%M:%SZ')\n    assert dt['iso8601_basic'] == now.strftime('%Y%m%dT%H%M%S%f')\n    assert dt['iso8601_basic_short'] == now.strftime('%Y%m%dT%H%M%S')\n    assert dt['tz'] == 'CET'\n    assert dt['tz_dst'] == 'CEST'\n    assert dt['tz_offset'] == '+0100'\n\n\ndef test_collect_epoch_falls_back_when_strftime_returns_empty_string(monkeypatch):\n    \"\"\"The first %s lookup returns '' (first operand of the fallback test).\"\"\"\n    # The second %s lookup must return a valid integer string, otherwise the\n    # int() conversion for 'epoch_int' would raise before the collector ends.\n    _install_fakes(monkeypatch, ['', str(int(_EPOCH_TS))])\n\n    facts = DateTimeFactCollector().collect()\n\n    dt = facts['date_time']\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert dt['date'] == _local_now().strftime('%Y-%m-%d')\n    assert dt['time'] == _local_now().strftime('%H:%M:%S')\n\n\ndef test_collect_epoch_falls_back_when_strftime_echoes_directive(monkeypatch):\n    \"\"\"The first %s lookup returns '%s' (second operand of the fallback test).\"\"\"\n    _install_fakes(monkeypatch, ['%s', str(int(_EPOCH_TS))])\n\n    facts = DateTimeFactCollector().collect(module=None, collected_facts=None)\n\n    dt = facts['date_time']\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert dt['iso8601'] == _utc_now().strftime('%Y-%m-%dT%H:%M:%SZ')\n    assert dt['iso8601_micro'] == _utc_now().strftime('%Y-%m-%dT%H:%M:%S.%fZ')\n```\n\nWait \u2014 in test 2 and 3, `str(int(_EPOCH_TS))` is '1500000000'. The fake's second result is '1500000000'. Line 54: `str(int('1500000000'))` = '1500000000'. \u2713 And dt['epoch_int'] == '1500000000' == str(int(_EPOCH_TS)). \u2713\n\nHmm, one thing: in test 2/3, `dt['epoch'] == str(int(_EPOCH_TS))` \u2014 the fallback sets epoch = str(int(epoch_ts)) where epoch_ts = 1500000000.123456 \u2192 '1500000000'. \u2713\n\nAlso double check `set(facts) == {'date_time'}` \u2014 facts_dict only gets 'date_time'. \u2713\n\nNow, is there any risk that `DateTimeFactCollector().collect()` signature requires positional args? Snippet: `def collect(self, module=None, collected_facts=None)`. \u2713\n\nI think we're good. Let me do the get_info calls first to confirm, then output.\n\nActually \u2014 one more consideration about `get_info`: the tool description says it \"Returns information about a symbol\" with names like 'f' or 'C.foo'. I'll call:\n- get_info('DateTimeFactCollector.collect')\n- get_info('BaseFactCollector')\n\nBoth independent \u2192 single block.\n\nThen final answer: only the code block.",
