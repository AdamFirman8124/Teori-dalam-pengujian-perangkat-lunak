xpected values can be computed independently in the tests.\n    \"\"\"\n    epoch_results = list(epoch_strftime_results)\n\n    class FakeDateTime:\n        def __init__(self, ts, utc=False):\n            self._ts = ts\n            self._utc = utc\n\n        @classmethod\n        def fromtimestamp(cls, ts):\n            return cls(ts)\n\n        @classmethod\n        def utcfromtimestamp(cls, ts):\n            return cls(ts, utc=True)\n\n        def strftime(self, fmt):\n            if fmt == '%s':\n                if epoch_results:\n                    return epoch_results.pop(0)\n                return str(int(self._ts))\n            if self._utc:\n                return _REAL_DATETIME.fromtimestamp(\n                    self._ts, datetime.timezone.utc).strftime(fmt)\n            return _REAL_DATETIME.fromtimestamp(self._ts).strftime(fmt)\n\n    return FakeDateTime\n\n\ndef _install_fakes(monkeypatch, epoch_strftime_results):\n    \"\"\"Patch the module under test to use deterministic datetime/time fakes.\"\"\"\n    fake_datetime_cls = _make_fake_datetime_class(epoch_strftime_results)\n    fake_datetime_module = types.SimpleNamespace(datetime=fake_datetime_cls)\n    fake_time_module = types.SimpleNamespace(\n        time=lambda: _EPOCH_TS,\n        strftime=lambda fmt: {'%Z': 'CET', '%z': '+0100'}[fmt],\n        tzname=('CET', 'CEST'),\n    )\n    monkeypatch.setattr(date_time_module, 'datetime', fake_datetime_module)\n    monkeypatch.setattr(date_time_module, 'time', fake_time_module)\n    return fake_datetime_cls\n\n\ndef _local_now():\n    return _REAL_DATETIME.fromtimestamp(_EPOCH_TS)\n\n\ndef _utc_now():\n    return _REAL_DATETIME.fromtimestamp(_EPOCH_TS, datetime.timezone.utc)\n\n\ndef test_collect_returns_all_date_time_facts(monkeypatch):\n    _install_fakes(monkeypatch, [])\n\n    facts = DateTimeFactCollector().collect()\n\n    assert set(facts) == {'date_time'}\n    dt = facts['date_time']\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert all(isinstance(value, str) for value in dt.values())\n\n    now = _local_now()\n    utcnow = _utc_now()\n    assert dt['year'] == now.strftime('%Y')\n    assert dt['month'] == now.strftime('%m')\n    assert dt['weekday'] == now.strftime('%A')\n    assert dt['weekday_number'] == now.strftime('%w')\n    assert dt['weeknumber'] == now.strftime('%W')\n    assert dt['day'] == now.strftime('%d')\n    assert dt['hour'] == now.strftime('%H')\n    assert dt['minute'] == now.strftime('%M')\n    assert dt['second'] == now.strftime('%S')\n    # %s is supported by the fake, so no fallback happens for epoch/epoch_int.\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert dt['date'] == now.strftime('%Y-%m-%d')\n    assert dt['time'] == now.strftime('%H:%M:%S')\n    assert dt['iso8601_micro'] == utcnow.strftime('%Y-%m-%dT%H:%M:%S.%fZ')\n    assert dt['iso8601'] == utcnow.strftime('%Y-%m-%dT%H:%M:%SZ')\n    assert dt['iso8601_basic'] == now.strftime('%Y%m%dT%H%M%S%f')\n    assert dt['iso8601_basic_short'] == now.strftime('%Y%m%dT%H%M%S')\n    assert dt['tz'] == 'CET'\n    assert dt['tz_dst'] == 'CEST'\n    assert dt['tz_offset'] == '+0100'\n\n\ndef test_collect_epoch_falls_back_when_strftime_returns_empty_string(monkeypatch):\n    # First %s lookup (the 'epoch' fact) returns '' as on platforms where the\n    # directive is unsupported; the second lookup returns a valid value so the\n    # epoch_int conversion does not raise and the collector can finish.\n    _install_fakes(monkeypatch, ['', str(int(_EPOCH_TS))])\n\n    facts = DateTimeFactCollector().collect()\n\n    dt = facts['date_time']\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert dt['date'] == _local_now().strftime('%Y-%m-%d')\n    assert dt['time'] == _local_now().strftime('%H:%M:%S')\n\n\ndef test_collect_epoch_falls_back_when_strftime_echoes_directive(monkeypatch):\n    # First %s lookup returns the literal '%s' (second operand of the\n    # fallback condition); the second lookup returns a valid value.\n    _install_fakes(monkeypatch, ['%s', str(int(_EPOCH_TS))])\n\n    facts = DateTimeFactCollector().collect(module=None, collected_facts=None)\n\n    dt = facts['date_time']\n    assert dt['epoch'] == str(int(_EPOCH_TS))\n    assert dt['epoch_int'] == str(int(_EPOCH_TS))\n    assert set(dt) == _ALL_DATE_TIME_KEYS\n    assert dt['iso8601'] == _utc_now().strftime('%Y-%m-%dT%H:%M:%SZ')\n    assert dt['iso8601_micro'] == _utc_now().strftime('%Y-%m-%dT%H:%M:%S.%fZ')\n```\n\nWait \u2014 in test 3, I call `collect(module=None, collected_facts=None)` to also exercise explicit-arg invocation. Fine.\n\nHmm, one issue: in test 2 and 3, `str(int(_EPOCH_TS))` = str(int(1500000000.123456)) = '1500000000'. And the fake's second '%s' result I pass as `str(int(_EPOCH_TS))` = '1500000000'. Then line 54: int('1500000000') \u2192 1500000000 \u2192 str \u2192 '1500000000'. Condition false. Good.\n\nAlso, in test 2/3, the fake's epoch_results list has exactly 2 entries; both consumed by `now`'s two '%s' calls. utcnow never calls '%s'. Good.\n\nNow \u2014 potential problem: `monkeypatch.setattr(date_time_module, 'datetime', fake_datetime_module)`. The module under test also might use `datetime` elsewhere (no, only in collect). And `time` \u2014 only in collect. Good.\n\nAnother potential problem: does `ansible.module_utils.facts.system.date_time` import cleanly? It imports `from ansible.module_utils.facts.collector import BaseFactCollector`. Should be fine in an env with ansible installed. The task presumes the module exists since coverage was measured on it.\n\nDo I need `pytest` import? I use monkeypatch fixture (no import needed) \u2014 but I don't use pytest.raises, so `import pytest` is unused. Remove it? Unused import is harmless but let me keep the file clean \u2014 actually, I might keep it in case... no, remove. Actually wait \u2014 should I add a t