 lazy ``from ansible.utils.display import Display`` picks up the fake.\"\"\"\n    fake = _FakeDisplay()\n    stub_module = types.ModuleType(u'ansible.utils.display')\n    stub_module.Display = lambda *args, **kwargs: fake\n    monkeypatch.setitem(sys.modules, u'ansible.utils.display', stub_module)\n    return fake\n\n\ndef test_unsafe_proxy_wraps_text_and_deprecates(fake_display):\n    \"\"\"Lines 88-91, 100-102: a text string is wrapped in AnsibleUnsafeText.\"\"\"\n    result = UnsafeProxy(u'foo')\n\n    assert type(result) is AnsibleUnsafeText\n    assert result == u'foo'\n    assert result.__UNSAFE__ is True\n    assert fake_display.deprecated_calls == [{\n        'msg': DEPRECATION_MSG,\n        'version': u'2.13',\n        'removed': False,\n        'collection_name': u'ansible.builtin',\n    }]\n\n\ndef test_unsafe_proxy_converts_bytes_to_text(fake_display):\n    \"\"\"Lines 100-101: bytes input is converted with to_text before wrapping.\"\"\"\n    result = UnsafeProxy(b'foo')\n\n    assert type(result) is AnsibleUnsafeText\n    assert result == u'foo'\n    assert result.__UNSAFE__ is True\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_returns_existing_unsafe_text_unchanged(fake_display):\n    \"\"\"Lines 97-98: an already-unsafe object short-circuits and is returned as-is.\"\"\"\n    obj = AnsibleUnsafeText(u'foo')\n    result = UnsafeProxy(obj)\n\n    assert result is obj\n    assert isinstance(result, AnsibleUnsafe)\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_returns_existing_unsafe_bytes_unchanged(fake_display):\n    \"\"\"Lines 97-98: unsafe bytes are not re-wrapped into AnsibleUnsafeText.\"\"\"\n    obj = AnsibleUnsafeBytes(b'foo')\n    result = UnsafeProxy(obj)\n\n    assert result is obj\n    assert isinstance(result, AnsibleUnsafe)\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_passes_through_non_string_objects(fake_display):\n    \"\"\"Line 102: non-string, non-unsafe objects are returned unchanged.\"\"\"\n    passthrough_objects = [[u'foo'], {u'key': u'value'}, 42, None]\n\n    for obj in passthrough_objects:\n        result = UnsafeProxy(obj)\n        assert result is obj\n        assert not isinstance(result, AnsibleUnsafe)\n\n    assert len(fake_display.deprecated_calls) == len(passthrough_objects)\n```\n\nWait \u2014 one issue with `test_unsafe_proxy_passes_through_non_string_objects` and `None`: `UnsafeProxy(None)` \u2014 `isinstance(None, AnsibleUnsafe)` False, `isinstance(None, string_types)` False \u2192 return None. Good.\n\nHmm, but wait: `UnsafeProxy(42)` \u2014 `__new__` returns 42, not an instance of UnsafeProxy, so no `__init__`. Good.\n\nOne concern about the `removed` kwarg: in some ansible versions, `Display.deprecated` signature is `deprecated(self, msg, version=None, removed=False, collection_name='ansible.builtin')`. In even newer ones (post 2.13?), it might be different, but since our fake defines its own signature and the call site only passes msg, version, collection_name as keywords, our fake handles it regardless of the real Display's signature. Good.\n\nAnother consideration: should the fixture also handle the case where `ansible.utils.display` real module import is needed by other machinery? No.\n\nAlso, is there a risk that `UnsafeProxy.__new__`'s `from ansible.utils.display import Display` fails because `ansible.utils` package's `__init__` does something? `ansible.utils` is already imported (we import unsafe_proxy from it). The from-import with sys.modules hit doesn't re-execute package code. Good.\n\nActually, hold on \u2014 let me reconsider `monkeypatch.setitem(sys.modules, ...)`. If `ansible.utils.display` is NOT in sys.modules initially, monkeypatch.setitem will add it and remove it after. If it IS present, it will restore the original. Both fine.\n\nBut one more subtlety: after `monkeypatch.setitem(sys.modules, 'ansible.utils.display', stub)`, if some other import during the tes