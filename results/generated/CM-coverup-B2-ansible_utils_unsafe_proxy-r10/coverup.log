place Display inside ansible.utils.display (imported lazily by __new__).\"\"\"\n    fake = _FakeDisplay()\n    monkeypatch.setattr('ansible.utils.display.Display', lambda *a, **kw: fake)\n    return fake\n\n\ndef test_unsafe_proxy_deprecation_and_text_wrap(fake_display):\n    \"\"\"Lines 88-91, 100-102: str input is wrapped in AnsibleUnsafeText and deprecation fires.\"\"\"\n    result = UnsafeProxy(u'foo')\n    assert type(result) is AnsibleUnsafeText\n    assert isinstance(result, text_type)\n    assert result == u'foo'\n    assert result.__UNSAFE__ is True\n    assert fake_display.deprecated_calls == [{\n        'msg': DEPRECATION_MSG,\n        'version': u'2.13',\n        'removed': False,\n        'collection_name': u'ansible.builtin',\n    }]\n\n\ndef test_unsafe_proxy_bytes_converted_to_text(fake_display):\n    \"\"\"Line 100-101: bytes input goes through to_text and is wrapped.\"\"\"\n    result = UnsafeProxy(b'foo')\n    assert type(result) is AnsibleUnsafeText\n    assert result == u'foo'\n    assert result.__UNSAFE__ is True\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_passthrough_ansible_unsafe_text(fake_display):\n    \"\"\"Lines 97-98: an already-unsafe object is returned unchanged.\"\"\"\n    obj = AnsibleUnsafeText(u'foo')\n    result = UnsafeProxy(obj)\n    assert result is obj\n    assert isinstance(result, AnsibleUnsafe)\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_passthrough_ansible_unsafe_bytes(fake_display):\n    \"\"\"Lines 97-98: unsafe bytes are returned unchanged, not re-wrapped as text.\"\"\"\n    obj = AnsibleUnsafeBytes(b'foo')\n    result = UnsafeProxy(obj)\n    assert result is obj\n    assert isinstance(result, AnsibleUnsafe)\n    assert len(fake_display.deprecated_calls) == 1\n\n\ndef test_unsafe_proxy_non_string_passthrough(fake_display):\n    \"\"\"Line 102: non-string, non-unsafe objects are returned as-is.\"\"\"\n    for obj in ([u'foo'], {u'k': u'v'}, 42, None):