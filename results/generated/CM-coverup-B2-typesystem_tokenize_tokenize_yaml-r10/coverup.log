== {\"key\": \"value\"}\n    (key_token,) = list(token.value.keys())\n    assert isinstance(key_token, ScalarToken)\n    assert key_token.to_string() == \"key\"\n    value_token = token.value[key_token]\n    assert isinstance(value_token, ScalarToken)\n    assert value_token.to_string() == \"value\"\n\n\ndef test_tokenize_yaml_bytes_content():\n    token = tokenize_yaml(b\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.get_value() == {\"key\": \"value\"}\n\n\ndef test_tokenize_yaml_sequence():\n    token = tokenize_yaml(\"- a\\n- b\")\n    assert isinstance(token, ListToken)\n    assert token.content == \"- a\\n- b\"\n    assert token.start_index == 0\n    assert token.end_index == 6\n    assert token.get_value() == [\"a\", \"b\"]\n    assert all(isinstance(item, ScalarToken) for item in token.value)\n\n\ndef test_tokenize_yaml_scalar_string():\n    token = tokenize_yaml('\"hello world\"')\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello world\"\n    assert token.to_string() == '\"hello world\"'\n    assert token.start_index == 0\n    assert token.end_index == 12\n\n\ndef test_tokenize_yaml_int():\n    token = tokenize_yaml(\"123\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 123\n    assert token.to_string() == \"123\"\n\n\ndef test_tokenize_yaml_float():\n    token = tokenize_yaml(\"1.5\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 1.5\n    assert token.to_string() == \"1.5\"\n\n\ndef test_tokenize_yaml_bool():\n    token = tokenize_yaml(\"true\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n    assert token.to_string() == \"true\"\n\n\ndef test_tokenize_yaml_null():\n    token = tokenize_yaml(\"null\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n    assert token.to_string() == \"null\"\n\n\ndef test_tokenize_yaml_parse_error():\n    with pytest.raises(