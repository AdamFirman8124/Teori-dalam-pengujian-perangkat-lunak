s DictToken(Token):\n    def _get_value(self):\n        return {\n            key if isinstance(key, str) else key.to_string(): value._get_value()\n            for key, value in self.value.items()\n        }\n\n    def get_value_for_key(self, key):\n        return self.value.get(key)  # hmm\n```\n\nHmm, actually:\n\n```python\nclass DictToken(Token):\n    def get_value_for_key(self, key: Token):\n        return self.value[key]\n```\n\nI'm not sure. Let me just use get_info to check all these.\n\nOK, plan: call get_info for:\n- `tokenize_yaml`\n- `_get_position`\n- `Token`\n- `ScalarToken`\n- `DictToken`\n- `ListToken`\n- `ParseError`\n- `Position`\n\nThese are all independent, so I can batch them.\n\nThen write the tests.\n\nLet me draft the tests now (to be refined after get_info):\n\n```python\nimport pytest\n\nimport typesystem.tokenize.tokenize_yaml as tokenize_yaml_module\nfrom typesystem.base import ParseError, Position\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken\n\n\ndef test_tokenize_yaml_requires_pyyaml(monkeypatch):\n    monkeypatch.setattr(tokenize_yaml_module, \"yaml\", None)\n    with pytest.raises(AssertionError) as exc_info:\n        tokenize_yaml(\"{}\")\n    assert \"'pyyaml' must be installed.\" in str(exc_info.value)\n\n\ndef test_tokenize_yaml_empty_string():\n    for content in (\"\", \"   \", b\"\", b\"  \\n \"):\n        with pytest.raises(ParseError) as exc_info:\n            tokenize_yaml(content)\n        error = exc_info.value\n        assert error.text == \"No content.\"\n        assert error.code == \"no_content\"\n        assert error.position == Position(column_no=1, line_no=1, char_index=0)\n\n\ndef test_tokenize_yaml_mapping():\n    token = tokenize_yaml(\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.start_index == 0\n    assert token.end_index == 9\n    assert token.get_value() == {\"key\": \"value\"}\n    (key_token,) = list(token.value.keys())\n    assert isinstance(key_token, ScalarToken)\n    assert key_token.to_string() == \"key\"\n    value_token = token.value[key_token]\n    assert isinstance(value_token, ScalarToken)\n    assert value_token.to_string() == \"value\"\n\n\ndef test_tokenize_yaml_bytes_content():\n    token = tokenize_yaml(b\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.get_value() == {\"key\": \"value\"}\n\n\ndef test_tokenize_yaml_sequence():\n    token = tokenize_yaml(\"- a\\n- b\")\n    assert isinstance(token, ListToken)\n    assert token.content == \"- a\\n- b\"\n    assert token.start_index == 0\n    assert token.end_index == 6\n    assert token.get_value() == [\"a\", \"b\"]\n    assert all(isinstance(item, ScalarToken) for item in token.value)\n\n\ndef test_tokenize_yaml_scalar_string():\n    token = tokenize_yaml('\"hello world\"')\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello world\"\n    assert token.to_string() == '\"hello world\"'\n    assert token.start_index == 0\n    assert token.end_index == 12\n\n\ndef test_tokenize_yaml_int():\n    token = tokenize_yaml(\"123\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 123\n    assert token.to_string() == \"123\"\n\n\ndef test_tokenize_yaml_float():\n    token = tokenize_yaml(\"1.5\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 1.5\n    assert token.to_string() == \"1.5\"\n\n\ndef test_tokenize_yaml_bool():\n    token = tokenize_yaml(\"true\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n    assert token.to_string() == \"true\"\n\n\ndef test_tokenize_yaml_null():\n    token = tokenize_yaml(\"null\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n    assert token.to_string() == \"null\"\n\n\ndef test_tokenize_yaml_parse_error():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(\"a: b\\nc: 'd\")\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text == \"found unexpected end of stream.\"\n    assert error.position.line_no == 2\n    assert error.position.char_index == 10\n    assert error.position.column_no == 6\n```\n\nWait, for the parse error test, let me double-check the problem message. For `a: 'd` unclosed single quote:\n\n```\nyaml.scanner.ScannerError: while scanning a quoted scalar\n  in \"<unicode string>\", line 2, column 5\nfound unexpected end of stream\n  in \"<unicode string>\", line 2, column 11\n```\n\nThe `problem` is \"found unexpected end of stream\" and `problem_mark` is at line 2, column 11 \u2192 index 10. So:\n- text = \"found unexpected end of stream.\"\n- position = _get_position(\"a: b\\nc: 'd\", index=10)\n  - line_no = content.count(\"\\n\", 0, 10) + 1 = 1 + 1 = 2\n  - column_no = 10 - content.rfind(\"\\n\", 0, 10) = 10 - 4 = 6\n  - char_index = 10\n\nGood.\n\nHmm, but wait \u2014 is `exc.problem` guaranteed to be \"found unexpected end of stream\"? In PyYAML's `scan_flow_scalar`:\n\n```python\ndef scan_flow_scalar(self, token_class):\n    ...\n    while True:\n        ...\n        if self.index == 5 ... \n```\n\nActually:\n\n```python\n            # Check if we are at the end of the stream.\n            if self.peek() == '':\n                raise ScannerError(\"while scanning a quoted scalar\", start_mark,\n                        \"found unexpected end of stream\", self.get_mark())\n```\n\nYes, that's the message. Stable across PyYAML versions (3.x through 6.x). Good.\n\nBut hold on \u2014 is the problem_mark the end of stream or the start? In `scan_flow_scalar`, the error is raised with `self.get_mark()` as the problem mark \u2014 the current position, which is the end of stream (index 10 for our content). Yes.\n\nHmm, wait. Let me re-check: `a: b\\nc: 'd` \u2014 length: \"a: b\" = 4 chars (indices 0-3), \"\\n\" at index 4, \"c: 'd\" = 5 chars (indices 5-9). Total length 10. End of stream index = 10. Yes.\n\nActually hmm, one more consideration: does the scanner reach the end of stream while scanning the quoted scalar? The quoted scalar starts at index 8 (`'`). It scans `d` then hits end of stream at index 10. Yes, problem_mark.index = 10.\n\nOK. But to be extra safe against version differences, maybe I should relax the position assertions slightly? The task says assertions should verify postconditions. I think asserting exact values is fine given stable PyYAML behavior. But let me hedge a little: assert `error.position.line_no == 2` and `error.position.char_index == 10`. These should be stable.\n\nAlternatively, I could use a simpler error input where I'm more certain. Let me think about `\"{\"`:\n\n```\n>>> yaml.load(\"{\", Loader=SafeLoader)\n```\nScanner: `{` \u2192 FlowMappingStartToken. Then end of stream. Parser: parse_flow_mapping_key: token is not `}` and not key... it calls parse_flow_node... which sees no token \u2192 ParserError \"while parsing a flow mapping ... expected '<document start>'...\"? Hmm, I don't remember. \n\nLet me stick with the unclosed quote.\n\nActually, you know what \u2014 let me also consider using `yaml.load` failure via a different route. The except clause catches `yaml.scanner.ScannerError` and `yaml.parser.ParserError`. The unclosed quote gives ScannerError. Good enough for the branch.\n\nNow, about `token.get_value()` for DictToken \u2014 I need to check what it returns. If DictToken._get_value converts keys via to_string and values via _get_value, then `token.get_value() == {\"key\": \"value\"}`. Let me verify with get_info.\n\nAlso for ListToken: `token.get_value() == [\"a\", \"b\"]`.\n\nFor the sequence `- a\\n- b`: content length 6. The ListToken: start=0, end = end_mark.index - 1. The block sequence end mark: after \"b\" at index 6? The end mark of the sequence node is at index 6 (end of stream). So end-1 = 5. Hmm wait: `- a\\n- b` \u2014 indices: `-`=0, ` `=1, `a`=2, `\\n`=3, `-`=4, ` `=5, `b`=6. Length 7. End of stream index = 7. So ListToken end = 6.\n\nHmm, let me recount: \"- a\\n- b\" \u2192 characters: '-', ' ', 'a', '\\n', '-', ' ', 'b' \u2192 7 characters, indices 0..6. End of stream mark index = 7. So end_index = 7 - 1 = 6.\n\nAnd the scalar `a`: start=2, end_mark=3 \u2192 ScalarToken(\"a\", 2, 2). Scalar `b`: start=6, end=7 \u2192 ScalarToken(\"b\", 6, 6).\n\nSo assertions: token.start_index == 0, token.end_index == 6, token.content == \"- a\\n- b\", token.get_value() == [\"a\", \"b\"].\n\nFor the mapping \"key: value\": length 10, end of stream = 10, DictToken end = 9. Key \"key\": start=0, end=3 \u2192 (0, 2). Value \"value\": start=5, end=10 \u2192 (5, 9).\n\nFor scalar '\"hello world\"': length 13, end of stream = 13, ScalarToken end = 12. to_string() = content[0:13] = '\"hello world\"'. value = \"hello world\".\n\nFor \"123\": length 3, end=2, to_string()=\"123\", value=123.\n\nFor \"1.5\": length 3, end=2, value=1.5, to_string()=\"1.5\".\n\nFor \"true\": length 4, end=3, value=True, to_string()=\"true\".\n\nFor \"null\": length 4, end=3, value=None, to_string()=\"null\".\n\nHmm wait, for \"null\" \u2014 the resolver resolves `null` to tag:yaml.org,2002:null. construct_null calls `loader.construct_yaml_null(node)` which returns None. ScalarToken(None, 0, 3, content=\"null\"). to_string() = \"null\". Good.\n\nBut wait \u2014 there's a subtlety with the DEFAULT_SCALAR_TAG constructor. The resolver resolves plain scalars to specific tags (int, float, bool, null, str, etc.). The `tag:yaml.org,2002:str` tag IS the DEFAULT_SCALAR_TAG (`yaml.resolver.BaseResolver.DEFAULT_SCALAR_TAG = 'tag:yaml.org,2002:str'`). So plain strings like `hello` resolve to str tag \u2192 construct_scalar. Quoted strings also resolve to str tag. So `tokenize_yaml(\"hello\")` \u2192 ScalarToken(\"hello\", 0, 4).\n\nHmm wait, but what about other resolved tags like timestamp (`tag:yaml.org,2002:timestamp`)? E.g. `2021-01-01` resolves to timestamp tag, which has no constructor in CustomSafeLoader \u2192 would raise ConstructorError (not caught). But we don't need to test that.\n\nAlso note: for implicit resolution, `123` resolves to int tag \u2192 construct_int. Good.\n\nNow, one important consideration: does `construct_scalar` get called for the str tag? Yes: `add_constructor(DEFAULT_SCALAR_TAG, construct_scalar)` where DEFAULT_SCALAR_TAG = \"tag:yaml.org,2002:str\".\n\nNow, about the `assert yaml is not None` test with monkeypatch: the module does `try: import yaml ... except ImportError: yaml = None`. Actually wait, looking at the given code snippet, it starts with `import yaml` directly (the snippet shows `import yaml` at the top). But the real typesystem source has the try/except. Either way, monkeypatching `module.yaml = None` tests line 26's assert branch.\n\nHmm, but actually \u2014 is that a branch worth testing? Line 26 is just the assert; it's covered by any call. The \"branch\" of the assert failing is an exception path. Coverage-wise, line 26 is covered by any successful call. But adding the monkeypatch test makes the suite more thorough and covers the assert failure message. I'll include it \u2014 it's cheap and safe (monkeypatch reverts after test).\n\nWait, one concern: `monkeypatch.setattr(tokenize_yaml_module, \"yaml\", None)` \u2014 then `tokenize_yaml(\"{}\")` hits the assert. But note the function references the global `yaml` in its module namespace, so this works. Good.\n\nNow, about cleanup/state pollution: The CustomSafeLoader is defined inside the function, so no global state pollution. The monkeypatch is auto-reverted. Good.\n\nOne more consideration: importing `tokenize_yaml` \u2014 should I import from `typesystem.tokenize.tokenize_yaml` or `typesystem.tokenize`? The former is safer. Also for monkeypatching I need the module object: `import typesystem.tokenize.tokenize_yaml as tokenize_yaml_module`.\n\nHmm, wait. There's a potential issue: `typesystem/tokenize/__init__.py` might import tokenize_json which requires... no, tokenize_json doesn't require anything extra. Fine.\n\nAlso, pyyaml must be installed for the tests to pass (the module asserts it). The test environment presumably has pyyaml since the code under test requires it. I could add a pytest.importorskip(\"yaml\") guard, but that might skip tests unnecessarily. Actually, adding `pytest.importorskip` at module level would be defensive but if pyyaml is installed it's a no-op. Hmm, but if pyyaml is NOT installed, the import of the module itself succeeds (yaml=None fallback) and all tests would fail with AssertionError. Adding importorskip(\"yaml\") would skip gracefully. But the task says tests must be correct and improve coverage \u2014 presumably pyyaml is installed. I'll not add importorskip; actually, let me add it as a safety? Hmm. If pyyaml is missing, `tokenize_yaml` raises AssertionError for every call, and tests fail. With importorskip, they'd skip. I think it's cleaner without; the environment for coverage testing must have pyyaml. Actually, let me include `pytest.importorskip(\"yaml\")` \u2014 no wait, that could mask a real problem... The task is about covering lines 26-109, which requires pyyaml. I'll skip the importorskip and just import yaml normally in the test? No \u2014 I don't even need to import yaml in the test file. Let me keep it simple.\n\nHmm, actually, one thing: for the monkeypatch test, if pyyaml is not installed, `module.yaml` is already None and the assert fires anyway \u2014 the test would still pass! Interesting. But other tests would fail. Whatever \u2014 assume pyyaml installed.\n\nNow let me also think about whether to test `tokenize_yaml` with a nested structure to exercise more paths, e.g. `tokenize_yaml(\"key:\\n  - a\\n  - 1\")`. That would exercise construct_mapping, construct_sequence, construct_scalar, construct_int in one go. But separate tests are clearer.\n\nLet me also double check the DictToken value structure: `construct_mapping` returns `DictToken(mapping, start, end - 1, content=str_content)` where `mapping = loader.construct_mapping(node)`. Since the custom constructors are registered, the nested values are Tokens (ScalarToken etc.), not plain Python values. So `token.value` is `{ScalarToken(\"key\",0,2): ScalarToken(\"value\",5,9)}`.\n\nWait, is that right? `loader.construct_mapping(node)` \u2192 for each key/value node, calls `self.construct_object(key_node, ...)` which uses the registered constructor \u2192 returns ScalarToken. So yes, the dict keys/values are Tokens.\n\nHmm, but wait: `construct_mapping` in SafeLoader \u2014 does it deep-construct? `construct_mapping(self, node, deep=False)`: \n\n```python\ndef construct_mapping(self, node, deep=False):\n    if not isinstance(node, MappingNode):\n        raise ConstructorError(...)\n    mapping = {}\n    for key_node, value_node in node.value:\n        key = self.construct_object(key_node, deep=deep)\n        if not isinstance(key, collections.abc.Hashable):\n            raise ConstructorError(...)\n        value = self.construct_object(value_node, deep=deep)\n        mapping[key] = value\n    return mapping\n```\n\nSo yes, keys and values are constructed objects \u2014 with our custom constructors, they're Tokens. So `token.value` = {ScalarToken: ScalarToken}.\n\nAnd `DictToken._get_value()` (if it exists) converts to plain dict. Let me check via get_info.\n\nAlso `DictToken.get_value_for_key(key)` \u2014 I recall:\n\n```python\nclass DictToken(Token):\n    def get_value_for_key(self, key):\n        return self.value[key]\n```\n\nHmm, not sure it exists. Let me check.\n\nActually, from the typesystem source (v0.4.1), typesystem/tokenize/tokens.py:\n\n```python\nimport typing\nfrom typesystem.base import Position\n\n\nclass Token:\n    def __init__(self, value, start_index, end_index, content=None):\n        self.value = value\n        self.start_index = start_index\n        self.end_index = end_index\n        self.content = content\n\n    def _get_value(self):\n        if isinstance(self.value, dict):\n            return {\n                key if isinstance(key, str) else key.to_string(): value\n                for key, value in self.value.items()\n            }\n        elif isinstance(self.value, list):\n            return [\n                value._get_value() if isinstance(value, Token) else value\n                for value in self.value\n            ]\n        return self.value\n\n    def get_value(self):\n        return self._get_value()\n\n    @property\n    def start(self) -> Position:\n        line_no = self.content.count(\"\\n\", 0, self.start_index) + 1\n        column_no = self.start_index\n        if \"\\n\" in self.content[: self.start_index]:\n            column_no -= self.content.rfind(\"\\n\", 0, self.start_index) + 1\n        char_index = self.start_index\n        return Position(line_no, column_no, char_index)\n\n    @property\n    def end(self) -> Position:\n        line_no = self.content.count(\"\\n\", 0, self.end_index) + 1\n        column_no = self.end_index\n        if \"\\n\" in self.content[: self.end_index]:\n            column_no -= self.content.rfind(\"\\n\", 0, self.end_index) + 1\n        char_index = self.end_index\n        return Position(line_no, column_no, char_index)\n\n\nclass ScalarToken(Token):\n    def to_string(self) -> str:\n        return self.content[self.start_index : self.end_index + 1]\n\n\nclass DictToken(Token):\n    def _get_value(self):\n        return {\n            key if isinstance(key, str) else key.to_string(): value._get_value()\n            for key, value in self.value.items()\n        }\n\n    def get_value_for_key(self, key: Token) -> typing.Any:\n        return self.value[key]\n\n    def get_key_for_value(self, value: Token) -> typing.Any:\n        for key, item in self.value.items():\n            if item == value:\n                return key\n\n\nclass ListToken(Token):\n    def _get_value(self):\n        return [\n            value._get_value() if isinstance(value, Token) else value\n            for value in self.value\n        ]\n\n    def get_value_for_index(self, index: Token) -> typing.Any:\n        return self.value[index.value]\n```\n\nSomething like that. I'll verify with get_info.\n\nNow, Position equality: `Position.__eq__` compares line_no, column_no, char_index. So `error.position == Position(1, 1, 0)` works if attribute order matches: `Position(line_no, column_no, char_index)`. In the code under test: `Position(column_no=1, line_no=1, char_index=0)`. So `Position(line_no=1, column_no=1, char_index=0)`.\n\nLet me now write the get_info calls. I'll batch:\n\n1. get_info(\"tokenize_yaml\")\n2. get_info(\"_get_position\")\n3. get_info(\"Token\")\n4. get_info(\"ScalarToken\")\n5. get_info(\"DictToken\")\n6. get_info(\"ListToken\")\n7. get_info(\"ParseError\")\n8. get_info(\"Position\")\n\nThen finalize the test code.\n\nLet me also think about whether there might be an issue with `tokenize_yaml(\"key: value\")` and the `end` property vs `end_index`. I'll assert on `start_index`/`end_index` if those are the attribute names, or `start`/`end` if they're properties returning Position. Need get_info to confirm.\n\nAlso, one more test consideration: the `bytes` branch with non-UTF8 bytes: `tokenize_yaml(b\"\\xff\\xfe\")` \u2192 decode with \"ignore\" \u2192 \"\" \u2192 empty \u2192 ParseError \"No content.\" That exercises the decode-ignore path. Nice addition: `tokenize_yaml(b\"key: \\xffvalue\")` \u2192 decodes to \"key: value\". Let me include that in the bytes test or a separate one. Actually `b\"key: \\xffvalue\".decode(\"utf-8\", \"ignore\")` = \"key: value\". That's a nice test of the \"ignore\" error handler. I'll add it.\n\nHmm wait, careful: `b\"key: \\xffvalue\"` \u2014 the \\xff byte is ignored, giving \"key: value\". Then tokenize \u2192 DictToken. Good.\n\nNow, about the empty-content test with bytes: `tokenize_yaml(b\"\")` \u2192 decode \u2192 \"\" \u2192 ParseError. Good.\n\nLet me also think about whether `str_content.strip()` check: `\"  \\n  \"` \u2192 strip \u2192 \"\" \u2192 ParseError. Good.\n\nNow the ParseError assertions. Let me check ParseError's attributes via get_info. ParseError likely has `.text`, `.code`, `.position`, and maybe `.message` property. In typesystem/base.py:\n\n```python\nclass Message:\n    def __init__(self, text, code=None, index=0, position=None):\n        if position is None:\n            class Info:\n                line_no = index\n                column_no = index\n                char_index = index\n            position = Info()\n        self.text = text\n        self.code = code\n        self.position = position\n        self.start = position.column_no\n        self.end = position.column_no\n\n    def __eq__(self, other):\n        if self.__class__ != other.__class__:\n            return False\n        return (\n            self.text == other.text\n            and self.code == other.code\n            and self.index == other.index\n            and self.position == other.position\n        )\n\n    def __repr__(self):\n        return \"%s(text=%r, code=%r, index=%r, position=%r)\" % (\n            self.__class__.__name__,\n            self.text,\n            self.code,\n            self.index,\n            self.position,\n        )\n\n    def __str__(self):\n        if self.position.line_no == 1:\n            suffix = \"(line 1 column %d, char %d)\" % (self.position.column_no, self.position.char_index)\n        else:\n            suffix = \"(line %d column %d, char %d)\" % (...)\n        return f\"{self.text} {suffix}\"\n\n\nclass ParseError(Message, BaseException):\n    def __str__(self):\n        ...\n```\n\nHmm, I recall `Message` has `index` property? Let me check via get_info. Actually in newer typesystem:\n\n```python\nclass Message:\n    def __init__(self, text, code=None, index=0, position=None):\n        if position is None:\n            class Info:\n                line_no = index\n                column_no = index\n                char_index = index\n            position = Info()\n        self.text = text\n        self.code = code\n        self.position = position\n        self.start = position.column_no\n        self.end = position.column_no\n```\n\nI'm not sure about `index`. Let me just check with get_info and then write assertions using `.text`, `.code`, `.position` which definitely exist.\n\nLet me now also consider: should tests use `pytest.raises(ParseError, match=...)`? ParseError is a BaseException subclass \u2014 pytest.raises works with any exception class. `match` uses str(excinfo.value). ParseError.__str__ might produce something like \"No content. (line 1 column 1, char 0)\". Using match is fragile; better to inspect attributes.\n\nOK, let me make the get_info calls now.\n\nActually, one more thought on test for line 26 assert: `monkeypatch.setattr(module, \"yaml\", None)`. But wait \u2014 what if the module does `from yaml.loader import SafeLoader` at top and the function references `SafeLoader` global? The assert on yaml happens first, so we never reach SafeLoader usage. Fine.\n\nAlso, what about `yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG` etc. \u2014 those are used inside the function; covered by any successful parse.\n\nLet me also think about covering `construct_scalar` via a plain (unquoted) string: `tokenize_yaml(\"hello\")` \u2192 ScalarToken(\"hello\", 0, 4). Both quoted and unquoted go through construct_scalar (str tag). I'll use unquoted \"hello\" \u2014 simpler. Actually wait: does `hello` resolve to str tag? The resolver's implicit resolver checks regexes for null/bool/int/float/merge/timestamp/value/etc.; \"hello\" doesn't match any, so it resolves to the default scalar tag (str). Yes.\n\nHmm, but careful: first resolution happens via `resolve(SimpleKey, plain, start_mark, end_mark)`:\n\n```python\ndef resolve(self, kind, value, implicit):\n    ...\n    if implicit:\n        ...\n        for resolvers in (self.yaml_implicit_resolvers, ...):\n            for tag in ...:\n                if tag is None: continue\n                if regexp match: return tag\n    if kind == ScalarNode:\n        implicit_tag = self.DEFAULT_SCALAR_TAG  # actually returns self.DEFAULT_SCALAR_TAG\n```\n\nYes, returns DEFAULT_SCALAR_TAG = \"tag:yaml.org,2002:str\". Good.\n\nNow \u2014 one subtle thing about `construct_scalar` for the str tag: `loader.construct_scalar(node)` returns the scalar value as str. Good.\n\nNow let me also double check `tokenize_yaml(\"123\")`: resolver matches int regex \u2192 tag \"tag:yaml.org,2002:int\" \u2192 construct_int \u2192 `loader.construct_yaml_int(node)` \u2192 123. ScalarToken(123, 0, 2, content=\"123\"). to_string() = \"123\". Good.\n\n`tokenize_yaml(\"1.5\")` \u2192 float tag \u2192 construct_yaml_float \u2192 1.5. Good.\n\n`tokenize_yaml(\"true\")` \u2192 bool tag \u2192 construct_yaml_bool \u2192 True. Good.\n\n`tokenize_yaml(\"null\")` \u2192 null tag \u2192 construct_yaml_null \u2192 None. Good.\n\nHmm, wait: is it \"null\" or should I use \"~\"? Both resolve to null tag. \"null\" is fine.\n\nNow, one potential gotcha: in PyYAML, `construct_yaml_float` for \"1.5\" returns 1.5. Good.\n\nAnother gotcha: for \"123\", the resolver's int regex in PyYAML 6 handles \"123\" fine.\n\nNow, the ListToken test: `tokenize_yaml(\"- a\\n- b\")`. Actually, hmm \u2014 wait. Let me reconsider: does the block sequence node's end_mark.index equal 7 (end of stream)? The parser creates the SequenceNode with start_mark at the first `-` (index 0) and end_mark after the last item. The end mark for the block sequence... In `parse_block_sequence_entry`, when BlockEndToken is found, `node.end_mark = token.end_mark`. The BlockEnd token's end_mark is at the end of stream (index 7). So end = 7 - 1 = 6. Good.\n\nSimilarly for the mapping \"key: value\": BlockEnd token at end of stream (index 10) \u2192 end = 9. Good.\n\nAnd for scalar \"hello\": the ScalarNode's end_mark is at index 5 (after \"hello\") \u2192 end = 4. Good.\n\nNow, `token.get_value()` for ListToken: `_get_value` converts nested tokens. For `- a\\n- b`, value = [ScalarToken(\"a\",2,2), ScalarToken(\"b\",6,6)] \u2192 get_value() = [\"a\", \"b\"]. Good.\n\nFor DictToken \"key: value\": get_value() = {\"key\": \"value\"}. Good.\n\nNow, let me also add a test that exercises `get_value_for_key` / `get_value_for_index`? Not necessary for coverage of tokenize_yaml.py. Keep tests focused but with meaningful assertions.\n\nLet me also think about whether to test `tokenize_yaml` returning the token for a nested structure to exercise multiple constructors in one call \u2014 e.g.:\n\n```python\ntoken = tokenize_yaml(\"key:\\n  - 1\\n  - true\")\n```\n\nThis exercises construct_mapping, construct_sequence, construct_int, construct_bool. But individual tests already cover each. I'll keep separate tests for clarity.\n\nNow, about the \"no top-level code calling pytest.main\" requirement \u2014 fine, just test functions.\n\nLet me also consider: the tests import `from typesystem.tokenize.tokenize_yaml import tokenize_yaml`. For the monkeypatch test, I need the module: `import typesystem.tokenize.tokenize_yaml as yaml_tokenize_module`. \n\nHmm, one concern: `typesystem.tokenize.__init__` might import `tokenize_json` which imports `json` \u2014 fine.\n\nWait, actually there's another consideration: does `typesystem/tokenize/__init__.py` exist and import things? In typesystem 0.4.x:\n\n```python\n# typesystem/tokenize/__init__.py\nfrom typesystem.tokenize.tokenize_json import tokenize_json\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\n\n__all__ = [\"tokenize_json\", \"tokenize_yaml\"]\n```\n\nImporting `typesystem.tokenize.tokenize_yaml` triggers `typesystem.tokenize.__init__` which imports tokenize_json \u2014 fine, no heavy deps.\n\nAlso `typesystem/__init__.py` imports various things \u2014 fine.\n\nNow, let me write the get_info calls.\n\nActually, let me reconsider the exact attribute names on Token. I'll call get_info for Token, ScalarToken, DictToken, ListToken, ParseError, Position, tokenize_yaml, _get_position. That's 8 calls in one block.\n\nAfter getting info, I'll write the final test script.\n\nLet me draft the final test script now (subject to adjustment):\n\n```python\nimport pytest\n\nimport typesystem.tokenize.tokenize_yaml as tokenize_yaml_module\nfrom typesystem.base import ParseError, Position\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken\n\n\ndef test_tokenize_yaml_asserts_pyyaml_installed(monkeypatch):\n    monkeypatch.setattr(tokenize_yaml_module, \"yaml\", None)\n    with pytest.raises(AssertionError) as exc_info:\n        tokenize_yaml(\"key: value\")\n    assert \"'pyyaml' must be installed.\" in str(exc_info.value)\n\n\n@pytest.mark.parametrize(\"content\", [\"\", \"   \", \" \\n\\t \", b\"\", b\" \\n \"])\ndef test_tokenize_yaml_no_content(content):\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(content)\n    error = exc_info.value\n    assert error.text == \"No content.\"\n    assert error.code == \"no_content\"\n    assert error.position == Position(line_no=1, column_no=1, char_index=0)\n\n\ndef test_tokenize_yaml_bytes_are_decoded():\n    token = tokenize_yaml(b\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.get_value() == {\"key\": \"value\"}\n\n\ndef test_tokenize_yaml_bytes_invalid_utf8_ignored():\n    token = tokenize_yaml(b\"key: \\xffvalue\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.get_value() == {\"key\": \"value\"}\n\n\ndef test_tokenize_yaml_mapping():\n    token = tokenize_yaml(\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.content == \"key: value\"\n    assert token.start_index == 0\n    assert token.end_index == 9\n    assert token.get_value() == {\"key\": \"value\"}\n    (key_token,) = token.value.keys()\n    assert isinstance(key_token, ScalarToken)\n    assert key_token.to_string() == \"key\"\n    value_token = token.value[key_token]\n    assert isinstance(value_token, ScalarToken)\n    assert value_token.to_string() == \"value\"\n\n\ndef test_tokenize_yaml_sequence():\n    token = tokenize_yaml(\"- a\\n- b\")\n    assert isinstance(token, ListToken)\n    assert token.content == \"- a\\n- b\"\n    assert token.start_index == 0\n    assert token.end_index == 6\n    assert token.get_value() == [\"a\", \"b\"]\n    assert all(isinstance(item, ScalarToken) for item in token.value)\n\n\ndef test_tokenize_yaml_string_scalar():\n    token = tokenize_yaml(\"hello\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello\"\n    assert token.to_string() == \"hello\"\n    assert token.start_index == 0\n    assert token.end_index == 4\n    assert token.content == \"hello\"\n\n\ndef test_tokenize_yaml_int_scalar():\n    token = tokenize_yaml(\"123\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 123\n    assert token.to_string() == \"123\"\n    assert token.start_index == 0\n    assert token.end_index == 2\n\n\ndef test_tokenize_yaml_float_scalar():\n    token = tokenize_yaml(\"1.5\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 1.5\n    assert token.to_string() == \"1.5\"\n    assert token.start_index == 0\n    assert token.end_index == 2\n\n\ndef test_tokenize_yaml_bool_scalar():\n    token = tokenize_yaml(\"true\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n    assert token.to_string() == \"true\"\n    assert token.start_index == 0\n    assert token.end_index == 3\n\n\ndef test_tokenize_yaml_null_scalar():\n    token = tokenize_yaml(\"null\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n    assert token.to_string() == \"null\"\n    assert token.start_index == 0\n    assert token.end_index == 3\n\n\ndef test_tokenize_yaml_parse_error():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_yaml(\"a: b\\nc: 'd\")\n    error = exc_info.value\n    assert error.code == \"parse_error\"\n    assert error.text == \"found unexpected end of stream.\"\n    assert error.position.line_no == 2\n    assert error.position.column_no == 6\n    assert error.position.char_index == 10\n```\n\nWait \u2014 for the parse error test, I should double check `error.text`. `text = exc.problem + \".\"` \u2192 \"found unexpected end of stream\" + \".\" = \"found unexpected end of stream.\". Good.\n\nHmm, but is the problem message exactly \"found unexpected end of stream\"? In PyYAML's scan_flow_scalar:\n\n```python\n                if self.peek() == '':\n                    raise ScannerError(\"while scanning a quoted scalar\", start_mark,\n                            \"found unexpected end of stream\", self.get_mark())\n```\n\nYes. And this has been stable since PyYAML 3.x. Good.\n\nBut wait \u2014 actually, I want to double-check the flow for `a: b\\nc: 'd`:\n- Scanner: plain scalar `a` (simple key), `:` value token, plain scalar `b`, then line break, plain scalar `c` (simple key), `:` value token, then `'` starts single-quoted scalar at index 8. Scans `d` (index 9), then index 10 is end of stream \u2192 ScannerError(\"while scanning a quoted scalar\", start_mark=index 8, \"found unexpected end of stream\", mark=index 10).\n\nSo `exc.problem = \"found unexpected end of stream\"`, `exc.problem_mark.index = 10`. \n\n_get_position(\"a: b\\nc: 'd\", 10):\n- line_no = \"a: b\\nc: 'd\".count(\"\\n\", 0, 10) + 1 = 1 + 1 = 2\n- column_no = 10 - \"a: b\\nc: 'd\".rfind(\"\\n\", 0, 10) = 10 - 4 = 6\n- char_index = 10\n\nGood.\n\nHmm, wait \u2014 I need to double check `_get_position`'s implementation. Let me recall from typesystem/tokenize/tokenize_yaml.py... Actually, `_get_position` might be defined in tokenize_yaml.py itself:\n\n``