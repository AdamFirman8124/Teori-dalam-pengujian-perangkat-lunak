        "content": "```python\nimport os\nimport sys\nimport io\n\nimport pytest\n\nfrom pytutils.files import islurp, LINEMODE\n\n\ndef test_islurp_by_line(tmp_path):\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"line1\\nline2\\n\")\n    assert list(islurp(str(p))) == [\"line1\\n\", \"line2\\n\"]\n\n\ndef test_islurp_linemode_string(tmp_path):\n    # Covers lines 23-24: iter_by == 'LINEMODE' -> LINEMODE\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"a\\nb\\n\")\n    assert list(islurp(str(p), iter_by='LINEMODE')) == [\"a\\n\", \"b\\n\"]\n\n\ndef test_islurp_by_bytes(tmp_path):\n    # Covers functools.partial(fh.read, iter_by) branch\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"abcdef\")\n    assert list(islurp(str(p), iter_by=2)) == [\"ab\", \"cd\", \"ef\"]\n\n\ndef test_islurp_binary_mode(tmp_path):\n    p = tmp_path / \"f.bin\"\n    p.write_bytes(b\"\\x00\\x01\\x02\")\n    assert list(islurp(str(p), mode='rb', iter_by=2)) == [b\"\\x00\\x01\", b\"\\x02\"]\n\n\ndef test_islurp_stdin(monkeypatch):\n    # Covers lines 28-29: filename == '-' and allow_stdin\n    fake_stdin = io.StringIO(\"from stdin\\nsecond\\n\")\n    monkeypatch.setattr(sys, 'stdin', fake_stdin)\n    assert list(islurp('-')) == [\"from stdin\\n\", \"second\\n\"]\n    # stdin must not be closed\n    assert not fake_stdin.closed\n\n\ndef test_islurp_stdin_disallowed(tmp_path):\n    # Covers the else branch when filename == '-' but allow_stdin is False\n    p = tmp_path / \"dash\"\n    p.write_text(\"dashfile\\n\")\n    assert list(islurp('-', allow_stdin=False, expanduser=False, expandvars=False)) == [\"dashfile\\n\"]\n\n\ndef test_islurp_expanduser_expandvars(tmp_path, monkeypatch):\n    # Covers lines 31-34: expanduser and expandvars\n    monkeypatch.setenv('HOME', str(tmp_path))\n    monkeypatch.setenv('ISLURP_TEST_VAR', 'x')\n    (tmp_path / \"tilde.txt\").write_text(\"tilde\\n\")\n    (tmp_path / \"x.txt\").write_text(\"vars\\n\")\n\n    assert list(islurp('~/tilde.txt')) == [\"tilde\\n\"]\n    assert list(islurp('$ISLURP_TEST_VAR.txt')) == [\"vars\\n\"]\n\n\ndef test_islurp_no_expansion(tmp_path, monkeypatch):\n    # Covers expanduser=False / expandvars=False branches\n    monkeypatch.setenv('ISLURP_TEST_VAR', 'SHOULD_NOT_APPEAR')\n    p = tmp_path / \"literal$ISLURP_TEST_VAR.txt\"\n    p.write_text(\"literal\\n\")\n    assert list(islurp(str(p), expanduser=False, expandvars=False)) == [\"literal\\n\"]\n\n\ndef test_islurp_closes_file(tmp_path):\n    # Covers lines 45-46: fh closed in finally\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"data\\n\")\n    gen = islurp(str(p))\n    next(gen)\n    gen.close()\n    assert not os.path.exists(str(p) + \".lock\")  # sanity\n    # Reopening for write proves the handle was released\n    p.write_text(\"rewritten\\n\")\n    assert p.read_text() == \"rewritten\\n\"\n\n\ndef test_islurp_empty_file(tmp_path):\n    # Covers EOF break (lines 41-42) with no yields\n    p = tmp_path / \"empty.txt\"\n    p.write_text(\"\")\n    assert list(islurp(str(p))) == []\n```",
