      code=\"no_content\",\n        position=Position(column_no=1, line_no=1, char_index=0),\n    )\n\n\ndef test_tokenize_json_whitespace_only_string():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(\"   \\n\\t  \")\n    _assert_parse_error(\n        exc_info.value,\n        text=\"No content.\",\n        code=\"no_content\",\n        position=Position(column_no=1, line_no=1, char_index=0),\n    )\n\n\ndef test_tokenize_json_empty_bytes():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(b\"\")\n    _assert_parse_error(\n        exc_info.value,\n        text=\"No content.\",\n        code=\"no_content\",\n        position=Position(column_no=1, line_no=1, char_index=0),\n    )\n\n\ndef test_tokenize_json_invalid_json():\n    content = '{\"a\": 1,}'\n    with pytest.raises(json.JSONDecodeError) as json_exc_info:\n        json.loads(content)\n    jexc = json_exc_info.value\n\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(content)\n    _assert_parse_error(\n        exc_info.value,\n        text=jexc.msg + \".\",\n        code=\"parse_error\",\n        position=Position(\n            column_no=jexc.colno, line_no=jexc.lineno, char_index=jexc.pos\n        ),\n    )\n\n\ndef test_tokenize_json_invalid_json_multiline():\n    content = '{\\n  \"a\": 1,\\n  \"b\": oops\\n}'\n    with pytest.raises(json.JSONDecodeError) as json_exc_info:\n        json.loads(content)\n    jexc = json_exc_info.value\n\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(content)\n    _assert_parse_error(\n        exc_info.value,\n        text=jexc.msg + \".\",\n        code=\"parse_error\",\n        position=Position(\n            column_no=jexc.colno, line_no=jexc.lineno, char_index=jexc.pos\n        ),\n    )\n\n\ndef test_tokenize_json_invalid_json_bytes():\n    content = b'{\"a\": }'\n    with pytest.raises(json.JSONDecodeError) as json_exc_info:\n        json.loads(content.decode(\"utf-8\", \"ignor