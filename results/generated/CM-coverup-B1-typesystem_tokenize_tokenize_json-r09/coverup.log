on('{\"name\": \"Tom\"}', validator=Person)\n    except Exception as exc:\n        messages = _validation_messages(exc)\n        assert messages\n        assert any(\"required\" in text for text in _texts(messages))\n        return\n\n    value, errors = result\n\n    assert value is None\n    assert len(errors) >= 1\n    assert any(\"required\" in text for text in _texts(errors))\n\n\ndef test_validate_json_invalid_json():\n    try:\n        result = validate_json(\"{\", validator=Integer())\n    except Exception as exc:\n        messages = _validation_messages(exc)\n        assert messages\n        assert any(str(message) for message in messages)\n        return\n\n    value, errors = result\n\n    assert value is None\n    assert len(errors) >= 1\n    assert any(str(error) for error in errors)\n```",
