        "content": "```python\nimport urllib.error\nimport pytest\nfrom youtube_dl import YoutubeDL\nfrom youtube_dl.downloader.hls import HlsFD\nfrom youtube_dl.downloader.external import FFmpegFD\nfrom youtube_dl.compat import compat_urllib_error\nimport youtube_dl.downloader.hls as hls_mod\n\n\nclass _FakeHandle:\n    def __init__(self, url, data):\n        self._url = url\n        self._data = data\n    def geturl(self):\n        return self._url\n    def read(self):\n        return self._data\n\n\ndef _make_ydl_fd(params):\n    ydl = YoutubeDL({'quiet': True, 'no_warnings': True})\n    fd = HlsFD(ydl, params)\n    return ydl, fd\n\n\ndef _patch_frag(monkeypatch, prepare_index=0, download_map=None, append_list=None, finish_flag=None, prepare_capture=None):\n    if append_list is None:\n        append_list = []\n    if finish_flag is None:\n        finish_flag = []\n    if prepare_capture is None:\n        prepare_capture = []\n\n    def fake_prepare(self, ctx):\n        prepare_capture.append(dict(ctx))\n        ctx['fragment_index'] = prepare_index\n        ctx['_test_prepare_called'] = True\n\n    def fake_finish(self, ctx):\n        finish_flag.append(True)\n\n    def fake_append(self, ctx, content):\n        append_list.append(content)\n\n    monkeypatch.setattr(HlsFD, '_prepare_and_start_frag_download', fake_prepare)\n    monkeypatch.setattr(HlsFD, '_finish_frag_download', fake_finish)\n    monkeypatch.setattr(HlsFD, '_append_fragment', fake_append)\n    return append_list, finish_flag, prepare_capture\n\n\ndef test_delegate_no_hooks(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg1.ts\\n'\n    man_url = 'http://example.com/pl.m3u8'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    called = {}\n    def fake_ff(self, filename, info_dict):\n        called['filename'] = filename\n        called['info'] = dict(info_dict)\n        return True\n    monkeypatch.setattr(FFmpegFD, 'real_download', fake_ff)\n    out = str(tmp_path / 'out.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is True\n    assert called['filename'] == out\n    assert called['info']['url'] == man_url\n\n\ndef test_delegate_with_hooks(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg1.ts\\n'\n    man_url = 'http://example.com/pl2.m3u8'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    seen = []\n    def myhook(d):\n        seen.append(d)\n    fd.add_progress_hook(myhook)\n    fwd = []\n    orig_add = FFmpegFD.add_progress_hook\n    def fake_add(self, ph):\n        fwd.append(ph)\n        return orig_add(self, ph)\n    monkeypatch.setattr(FFmpegFD, 'add_progress_hook', fake_add)\n    monkeypatch.setattr(FFmpegFD, 'real_download', lambda self, fn, info: (fwd, True)[1])\n    out = str(tmp_path / 'out2.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is True\n    assert len(fwd) == 1\n    assert fwd[0] is myhook\n\n\ndef test_pycrypto_missing_extra_param(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg1.ts\\n'\n    man_url = 'http://example.com/pl3.m3u8'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    out = str(tmp_path / 'out3.mp4')\n    res = fd.real_download(out, {'url': man_url, 'extra_param_to_segment_url': 'token=abc'})\n    assert res is False\n\n\ndef test_pycrypto_missing_key_url(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg1.ts\\n'\n    man_url = 'http://example.com/pl4.m3u8'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    out = str(tmp_path / 'out4.mp4')\n    res = fd.real_download(out, {'url': man_url, '_decryption_key_url': 'http://example.com/k'})\n    assert res is False\n\n\ndef test_simple_ad_filtering(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    man_url = 'http://example.com/playlist.m3u8'\n    manifest = (\n        '#EXTM3U\\n'\n        '#EXT-X-TARGETDURATION:10\\n'\n        '\\n'\n        '#ANVATO-SEGMENT-INFO type=ad\\n'\n        'ad1.ts\\n'\n        '#ANVATO-SEGMENT-INFO type=master\\n'\n        '#UPLYNK-SEGMENT foo,ad\\n'\n        'ad2.ts\\n'\n        '#UPLYNK-SEGMENT foo,segment\\n'\n        'seg1.ts\\n'\n        'http://cdn.example.com/seg2.ts\\n'\n        '#EXT-X-ENDLIST\\n'\n        '\\n'\n    )\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, prepared = _patch_frag(monkeypatch, prepare_index=0)\n    urls = []\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        urls.append(frag_url)\n        return (True, b'data:' + frag_url.encode('utf-8'))\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    out = str(tmp_path / 'a.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is True\n    assert prepared[0]['total_frags'] == 2\n    assert prepared[0]['ad_frags'] == 2\n    assert len(urls) == 2\n    assert urls[0] == 'http://example.com/seg1.ts'\n    assert urls[1] == 'http://cdn.example.com/seg2.ts'\n    assert len(appended) == 2\n    assert finished == [True]\n\n\ndef test_extra_query_byterange_media_sequence_resume(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    man_url = 'http://example.com/v/playlist.m3u8'\n    manifest = (\n        '#EXTM3U\\n'\n        '#EXT-X-MEDIA-SEQUENCE:10\\n'\n        '#EXT-X-BYTERANGE:100@0\\n'\n        'seg1.ts\\n'\n        '\\n'\n        '#EXT-X-BYTERANGE:200\\n'\n        'seg2.ts\\n'\n        '#EXT-X-ENDLIST\\n'\n    )\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, prepared = _patch_frag(monkeypatch, prepare_index=1)\n    urls = []\n    hdrs = []\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        urls.append(frag_url)\n        hdrs.append(dict(headers or {}))\n        return (True, b'x')\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    out = str(tmp_path / 'b.mp4')\n    res = fd.real_download(out, {'url': man_url, 'extra_param_to_segment_url': 'tok=abc&x=1'})\n    assert res is True\n    # first frag skipped due to resume, only second downloaded\n    assert len(urls) == 1\n    assert 'tok=abc' in urls[0] or 'tok' in urls[0]\n    assert 'seg2.ts' in urls[0]\n    # byte range without @ uses previous end (100) -> start 100 end 300 -> Range 100-299\n    assert hdrs[0].get('Range') == 'bytes=100-299'\n    assert len(appended) == 1\n    assert prepared[0]['total_frags'] == 2\n\n\ndef test_retry_then_success(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({'fragment_retries': 2})\n    man_url = 'http://example.com/r.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\n'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    calls = {'n': 0}\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        calls['n'] += 1\n        if calls['n'] == 1:\n            raise compat_urllib_error.HTTPError(frag_url, 404, 'Not Found', {}, None)\n        return (True, b'ok')\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    out = str(tmp_path / 'r.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is True\n    assert calls['n'] == 2\n    assert appended == [b'ok']\n\n\ndef test_skip_unavailable(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({'fragment_retries': 0, 'skip_unavailable_fragments': True})\n    man_url = 'http://example.com/s.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\nseg2.ts\\n'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        if 'seg1.ts' in frag_url:\n            raise compat_urllib_error.HTTPError(frag_url, 404, 'NF', {}, None)\n        return (True, b'seg2data')\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    out = str(tmp_path / 's.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is True\n    assert appended == [b'seg2data']\n    assert finished == [True]\n\n\ndef test_giveup_no_skip(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({'fragment_retries': 0, 'skip_unavailable_fragments': False})\n    man_url = 'http://example.com/g.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\n'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        raise compat_urllib_error.HTTPError(frag_url, 500, 'Err', {}, None)\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    out = str(tmp_path / 'g.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is False\n    assert appended == []\n    assert finished == []\n\n\ndef test_fragment_not_success(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({})\n    man_url = 'http://example.com/f.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\n'\n    monkeypatch.setattr(ydl, 'urlopen', lambda req, *a, **k: _FakeHandle(man_url, manifest.encode('utf-8')))\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    monkeypatch.setattr(HlsFD, '_download_fragment', lambda self, ctx, url, info, headers=None: (False, None))\n    out = str(tmp_path / 'f.mp4')\n    res = fd.real_download(out, {'url': man_url})\n    assert res is False\n\n\ndef test_aes128_with_iv_relative_caching(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({'test': False})\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    man_url = 'http://example.com/hls/pl.m3u8'\n    manifest = (\n        '#EXTM3U\\n'\n        '#EXT-X-KEY:METHOD=AES-128,URI=\"key.key\",IV=0x00000000000000000000000000000001\\n'\n        'seg1.ts\\n'\n        'seg2.ts\\n'\n        '#EXT-X-KEY:METHOD=AES-128,URI=\"key.key\",IV=0x00000000000000000000000000000001\\n'\n        'seg3.ts\\n'\n        '#EXT-X-KEY:METHOD=NONE\\n'\n        'seg4.ts\\n'\n    )\n    key_url = 'http://example.com/hls/key.key?tok=1'\n    key_data = b'0123456789abcdef'\n    def fake_urlopen(req, *a, **k):\n        u = req.get_full_url() if hasattr(req, 'get_full_url') else req\n        if u == man_url or 'pl.m3u8' in u:\n            return _FakeHandle(man_url, manifest.encode('utf-8'))\n        assert 'key.key' in u\n        assert 'tok=1' in u\n        return _FakeHandle(u, key_data)\n    monkeypatch.setattr(ydl, 'urlopen', fake_urlopen)\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    dl_urls = []\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        dl_urls.append(frag_url)\n        return (True, b'fragdata')\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    dec_calls = []\n    class FakeCipher:\n        def __init__(self, key, iv):\n            self.key = key\n            self.iv = iv\n        def decrypt(self, data):\n            dec_calls.append((self.key, self.iv, data))\n            return b'DEC:' + data\n    class FakeAES:\n        MODE_CBC = 1\n        @staticmethod\n        def new(key, mode, iv):\n            assert key == key_data\n            return FakeCipher(key, iv)\n    monkeypatch.setattr(hls_mod, 'AES', FakeAES)\n    out = str(tmp_path / 'k.mp4')\n    res = fd.real_download(out, {'url': man_url, 'extra_param_to_segment_url': 'tok=1'})\n    assert res is True\n    assert len(dl_urls) == 4\n    assert all('tok=1' in u for u in dl_urls)\n    # first three encrypted, last NONE plain\n    assert len(dec_calls) == 3\n    assert dec_calls[0][1] == bytes.fromhex('00000000000000000000000000000001')\n    assert appended[0] == b'DEC:fragdata'\n    assert appended[3] == b'fragdata'\n\n\ndef test_aes128_no_iv_absolute_testmode_keyurl(monkeypatch, tmp_path):\n    ydl, fd = _make_ydl_fd({'test': True})\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    man_url = 'http://example.com/a/pl.m3u8'\n    manifest = (\n        '#EXTM3U\\n'\n        '#EXT-X-MEDIA-SEQUENCE:5\\n'\n        '#EXT-X-KEY:METHOD=AES-128,URI=\"http://example.com/key.key\"\\n'\n        'seg1.ts\\n'\n        'seg2.ts\\n'\n    )\n    dec_key = b'0123456789abcdef'\n    def fake_urlopen(req, *a, **k):\n        u = req.get_full_url() if hasattr(req, 'get_full_url') else req\n        if 'pl.m3u8' in u:\n            return _FakeHandle(man_url, manifest.encode('utf-8'))\n        assert u == 'http://example.com/dec.key'\n        return _FakeHandle(u, dec_key)\n    monkeypatch.setattr(ydl, 'urlopen', fake_urlopen)\n    appended, finished, _ = _patch_frag(monkeypatch, prepare_index=0)\n    dl_urls = []\n    def fake_dl(self, ctx, frag_url, info_dict, headers=None):\n        dl_urls.append(frag_url)\n        return (True, b'rawfrag')\n    monkeypatch.setattr(HlsFD, '_download_fragment', fake_dl)\n    # ensure decrypt not called in test mode\n    class ExplodeAES:\n        MODE_CBC = 1\n        @staticmethod\n        def new(*a, **k):\n            raise AssertionError('AES should not be used in test mode')\n    monkeypatch.setattr(hls_mod, 'AES', ExplodeAES)\n    out = str(tmp_path / 't.mp4')\n    res = fd.real_download(out, {'url': man_url, '_decryption_key_url': 'http://example.com/dec.key'})\n    assert res is True\n    # test mode downloads only first fragment\n    assert len(dl_urls) == 1\n    assert appended == [b'rawfrag']\n    assert finished == [True]\n```",
