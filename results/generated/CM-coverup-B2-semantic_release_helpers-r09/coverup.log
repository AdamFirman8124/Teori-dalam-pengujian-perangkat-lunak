== 1\n    # default retry configuration mounted on both http and https\n    for prefix in (\"http://\", \"https://\"):\n        adapter = session.get_adapter(prefix + \"example.com\")\n        assert isinstance(adapter, HTTPAdapter)\n        assert isinstance(adapter.max_retries, Retry)\n\n\ndef test_raise_for_status_hook_invoked(sessions):\n    session = sessions(build_requests_session())\n    hook = session.hooks[\"response\"][0]\n    response = Response()\n    response.status_code = 500\n    with pytest.raises(requests.HTTPError):\n        hook(response, timeout=1, stream=True)\n\n\ndef test_no_raise_for_status(sessions):\n    session = sessions(build_requests_session(raise_for_status=False))\n    assert isinstance(session, Session)\n    # no hook installed: default empty hook list\n    assert session.hooks.get(\"response\", []) == []\n    # retry still defaults to True\n    adapter = session.get_adapter(\"https://example.com\")\n    assert isinstance(adapter.max_retries, Retry)\n\n\ndef test_retry_bool_true(sessions):\n    session = sessions(build_requests_session(retry=True))\n    adapter = session.get_adapter(\"https://example.com\")\n    assert isinstance(adapter.max_retries, Retry)\n\n\ndef test_retry_int(sessions):\n    session = sessions(build_requests_session(retry=3))\n    adapter = session.get_adapter(\"https://example.com\")\n    assert adapter.max_retries.total == 3\n\n\ndef test_retry_instance(sessions):\n    retry = Retry(total=7, backoff_factor=0.5)\n    session = sessions(build_requests_session(retry=retry))\n    adapter = session.get_adapter(\"https://example.com\")\n    assert adapter.max_retries is retry\n\n\ndef test_retry_invalid_type():\n    with pytest.raises(ValueError, match=\"retry should be a bool, int or Retry instance.\"):\n        build_requests_session(retry=\"not-a-retry\")\n\n\ndef test_retry_false_no_custom_adapter(sessions):\n    session = sessions(build_requests_session(retry=False))\n    assert isinstance(session, Session)\n  