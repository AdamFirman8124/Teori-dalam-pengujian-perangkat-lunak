rt token._start_index == 0\n    assert token._end_index == len(content) - 1\n    child_token = token._get_child_token(0)\n    assert child_token._value == \"a\"\n\n\ndef test_tokenize_scalar_string():\n    content = \"hello\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == \"hello\"\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_int():\n    content = \"123\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 123\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_negative_int():\n    token = tokenize_yaml(\"-42\")\n    assert isinstance(token, ScalarToken)\n    assert token._value == -42\n\n\ndef test_tokenize_float():\n    content = \"1.5\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value == 1.5\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_true():\n    content = \"true\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is True\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_bool_false():\n    token = tokenize_yaml(\"false\")\n    assert isinstance(token, ScalarToken)\n    assert token._value is False\n\n\ndef test_tokenize_null():\n    content = \"null\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ScalarToken)\n    assert token._value is None\n    assert token._start_index == 0\n    assert token._end_index == len(content) - 1\n\n\ndef test_tokenize_nested_structure():\n    content = \"a:\\n  - 1\\n  - b: two\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    value = token._value\n    assert value[\"a\"] == [1, {\"b\": \"two\"}]\n    inner_list = toke