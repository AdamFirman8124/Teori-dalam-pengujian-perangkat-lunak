ounted.\n    assert fizz_buzz(1) == 0\n\n\ndef test_condition_false_branch():\n    # i == 1 satisfies neither `i % 11 == 0` nor `i % 13 == 0`,\n    # exercising the False branch of the condition.\n    assert fizz_buzz(2) == 0\n\n\ndef test_divisible_by_13_only():\n    # 13 is divisible by 13 but not by 11, exercising the second\n    # operand of the `or` after the first one is False.\n    assert fizz_buzz(14) == 0  # s == \"013\" -> no '7'\n\n\ndef test_divisible_by_11_only():\n    # 11 is divisible by 11 but not by 13, exercising the first\n    # operand of the `or` being True (short-circuit).\n    assert fizz_buzz(12) == 0  # s == \"011\" -> no '7'\n\n\ndef test_counts_sevens():\n    # Multiples of 11 or 13 below 78: 0, 11, 13, 22, 26, 33, 39, 44,\n    # 52, 55, 65, 66, 77 -> \"01113223339445255656677\" has two '7's.\n    assert fizz_buzz(78) == 2\n\n\ndef test_counts_sevens_includes_78():\n    # 78 (divisible by 13) adds one more '7' -> three in total.\n    assert fizz_buzz(79) == 3\n\n\ndef test_larger_input():\n    # Known reference value for HumanEval #36.\n    assert fizz_buzz(100) == 3\n    assert fizz_buzz(200) == 6\n    assert fizz_buzz(4000) == 192\n    assert fizz_buzz(10000) == 639\n```\n\nWait, let me double check fizz_buzz(4000) == 192 and fizz_buzz(10000) == 639. These are from the HumanEval test suite, so they should be correct. Let me verify manually-ish.\n\nActually, let me compute fizz_buzz(4000). Numbers < 4000 divisible by 11 or 13. The concatenation of these numbers, count '7's.\n\nHmm, this is tedious but let me try to verify with a different approach. Actually, the HumanEval canonical solution:\n\n```python\ndef fizz_buzz(n: int):\n    ns = []\n    for i in range(n):\n        if i % 11 == 0 or i % 13 == 0:\n            ns.append(i)\n    s = ''.join(list(map(str, ns)))\n    ans = 0\n    for c in s:\n        ans += (c == '7')\n    return ans\n```\n\nAnd the tests in HumanEval:\n```\nfizz_buzz(50) == 0\nfizz_buzz(78) == 2\nfizz_buzz(79) == 3\nf