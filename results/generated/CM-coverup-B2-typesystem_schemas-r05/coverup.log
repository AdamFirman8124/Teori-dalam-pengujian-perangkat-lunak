ace...\n    assert \"name\" not in vars(Example)\n    assert Example.not_a_field == 123\n    # ...and collected into ``fields`` instead.\n    assert set(Example.fields) == {\"name\"}\n    assert isinstance(Example.fields[\"name\"], Field)\n    assert Example.fields[\"name\"] is not None\n\n\ndef test_fields_are_inherited_from_base_schemas():\n    \"\"\"Lines 70-71: fields of base schemas are copied into the subclass.\"\"\"\n\n    class Base(Schema):\n        name = String()\n\n    class Child(Base):\n        age = String()\n\n    assert set(Child.fields) == {\"name\", \"age\"}\n    assert Child.fields[\"name\"] is Base.fields[\"name\"]\n    assert Child.fields[\"age\"] is not Base.fields[\"name\"]\n\n\ndef test_overridden_fields_are_not_reinherited():\n    \"\"\"Line 70 (false branch): a field redefined in the subclass wins.\"\"\"\n\n    class Base(Schema):\n        name = String(default=\"base\")\n\n    class Child(Base):\n        name = String(default=\"child\")\n\n    assert set(Child.fields) == {\"name\"}\n    assert Child.fields[\"name\"] is not Base.fields[\"name\"]\n    assert Child.fields[\"name\"].default == \"child\"\n\n\ndef test_definitions_are_registered_and_passed_to_fields(monkeypatch):\n    \"\"\"Lines 75-76 and 88: with ``definitions`` given, every field is passed\n    to ``set_definitions`` and the new class is stored under its name.\"\"\"\n\n    recorded = []\n\n    def fake_set_definitions(field, definitions):\n        recorded.append((field, definitions))\n\n    monkeypatch.setattr(\n        typesystem.schemas, \"set_definitions\", fake_set_definitions\n    )\n\n    definitions = SchemaDefinitions()\n\n    class Example(Schema, definitions=definitions):\n        name = String()\n        title = String()\n\n    # Line 75-76: set_definitions called once per field.\n    assert sorted(field.name for field, _ in recorded) == [\"name\", \"title\"]\n    assert all(defs is definitions for _, defs in recorded)\n    # Line 88: the class is registered in t