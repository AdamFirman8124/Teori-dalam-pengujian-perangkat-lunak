esponses.append(FakeResponse(b'c\\nd'))\n\n    result = lookup.run(['http://one.example.com/', 'http://two.example.com/'])\n\n    assert result == ['a', 'b', 'c', 'd']\n    assert [term for term, kwargs in open_url_mock.calls] == ['http://one.example.com/', 'http://two.example.com/']\n```\n\n```python\ndef test_run_http_error(lookup, open_url_mock):\n    open_url_mock.responses.append(HTTPError('http://ansible.example.com/', 500, 'Internal Server Error', None, io.BytesIO(b'oops')))\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['http://ansible.example.com/'])\n\n    assert 'Received HTTP error for http://ansible.example.com/' in to_native(excinfo.value)\n```\n\nHmm, the message format: `\"Received HTTP error for %s : %s\" % (term, to_native(e))`. So the message is 'Received HTTP error for http://... : HTTP Error 500: Internal Server Error'. Assert 'Received HTTP error for' in message and term in message.\n\n```python\ndef test_run_url_error(lookup, open_url_mock):\n    open_url_mock.responses.append(URLError('connection refused'))\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['http://ansible.example.com/'])\n\n    assert 'Failed lookup url for http://ansible.example.com/' in to_native(excinfo.value)\n```\n\n```python\ndef test_run_ssl_validation_error(lookup, open_url_mock):\n    open_url_mock.responses.append(SSLValidationError('certificate verify failed'))\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['https://ansible.example.com/'])\n\n    assert \"Error validating the server's certificate for https://ansible.example.com/\" in to_native(excinfo.value)\n```\n\n```python\ndef test_run_connection_error(lookup, open_url_mock):\n    open_url_mock.responses.append(ConnectionError('timed out'))\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['http://ansible.example.com/'])\n\n    assert 'Error connecting to http://ansible.example.com/' in to_native(excinfo.value)\n``