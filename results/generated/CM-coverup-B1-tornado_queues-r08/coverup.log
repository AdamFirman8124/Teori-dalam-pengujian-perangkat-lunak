        "content": "```python\nimport pytest\n\nfrom tornado.queues import Queue, QueueFull\n\n\ndef test_put_nowait_wakes_waiting_getter():\n    \"\"\"Covers lines 215-219: put_nowait with a getter waiting on an empty queue.\"\"\"\n    q = Queue(maxsize=1)\n\n    # Queue is empty, so get() cannot resolve immediately; its future is\n    # appended to q._getters.\n    getter = q.get()\n    assert q.empty()\n    assert len(q._getters) == 1\n    assert not getter.done()\n\n    # put_nowait should hand the item directly to the waiting getter.\n    q.put_nowait(\"item\")\n\n    assert getter.done()\n    assert not getter.cancelled()\n    assert getter.result() == \"item\"\n    # The item was consumed by the getter, so the queue is empty again\n    # and no getters remain waiting.\n    assert q.empty()\n    assert len(q._getters) == 0\n\n\ndef test_put_nowait_full_raises_queue_full():\n    \"\"\"Covers lines 220-221: put_nowait on a full queue raises QueueFull.\"\"\"\n    q = Queue(maxsize=1)\n    q.put_nowait(\"first\")\n    assert q.full()\n    assert not q._getters  # ensure the full branch is taken, not the getter branch\n\n    with pytest.raises(QueueFull):\n        q.put_nowait(\"second\")\n\n    # The rejected item must not have been enqueued.\n    assert q.qsize() == 1\n    assert q._queue[0] == \"first\"\n\n\ndef test_put_nowait_else_branch_enqueues_item():\n    \"\"\"Covers lines 222-223: put_nowait on a non-full queue with no getters.\"\"\"\n    q = Queue(maxsize=2)\n    assert q.empty()\n    assert not q._getters\n\n    q.put_nowait(\"a\")\n\n    assert q.qsize() == 1\n    assert q._queue[0] == \"a\"\n    assert not q.full()\n\n    # A second item still fits (maxsize=2), exercising the else branch again.\n    q.put_nowait(\"b\")\n    assert q.qsize() == 2\n    assert list(q._queue) == [\"a\", \"b\"]\n    assert q.full()\n```",
