 assert m3u8_url == 'http://example.com/video.m3u8'\n        assert kw.get('m3u8_id') == 'hls'\n        return [{'url': 'http://example.com/hls1.mp4', 'format_id': 'hls-m3u8', 'ext': 'mp4'}]\n\n    geo = {}\n\n    def fake_geo(bypass):\n        geo.update(bypass)\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_extract_f4m_formats', fake_f4m)\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', fake_m3u8)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', fake_geo)\n\n    res = ie._real_extract(url)\n\n    assert geo == {'countries': ['LV']}\n    assert res['id'] == '418113'\n    assert res['title'] == 'Test Title'\n    assert res['description'] == 'Test desc'\n    assert res['series'] == 'Test Series'\n    assert res['episode_number'] == 7\n    assert res['season'] == 'Season 2 title'\n    assert res['season_number'] == 2\n    assert res['duration'] == 1257\n    assert res['timestamp'] is not None\n    assert res['view_count'] == 1234\n    assert res['age_limit'] == 18\n    # subtitles lang extracted from sami_path\n    assert 'en' in res['subtitles']\n    assert res['subtitles']['en'][0]['url'] == 'http://example.com/subs_en.xml'\n    # formats: f4m(1) + m3u8(1) + http mp4(1) + rtmp valid(1) = 4; invalid/empty skipped\n    urls = [f.get('url') for f in res['formats']]\n    assert 'http://example.com/hds.mp4' in urls\n    assert 'http://example.com/hls1.mp4' in urls\n    assert 'http://example.com/video.mp4' in urls\n    # rtmp split into url/app/play_path\n    rtmp_fmts = [f for f in res['formats'] if f.get('app') == 'myapp']\n    assert len(rtmp_fmts) == 1\n    assert rtmp_fmts[0]['url'] == 'rtmp://example.com/myapp'\n    assert rtmp_fmts[0]['play_path'] == 'myplaypath'\n    assert rtmp_fmts[0]['ext'] == 'flv'\n    assert rtmp_fmts[0]['preference'] == -1\n    # http fmt has quality/ext\n    http_fmts = [f for f in res['formats'] if f.get('url') == 'http://example.com/video.mp4']\n    assert len(http_fmts) == 1\n    assert http_fmts[0]['ext'] == 'mp4'\n    assert http_fmts[0]['format_id'] == 'medium'\n    # invalid rtmp and empty skipped: no format with hostonly\n    assert not any('hostonly' in (f.get('url') or '') for f in res['formats'])\n\n\ndef test_no_geo_country_and_fallback_lang(monkeypatch):\n    url = 'mtg:418113'\n    ie = _make_ie()\n    video = _base_video(sami_path='http://example.com/subs.xml')\n    streams = {'streams': {'high': 'http://example.com/v2.mp4'}}\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            return streams\n        return video\n\n    called = {'geo': False}\n    orig_geo = ie._initialize_geo_bypass\n\n    def fake_geo(*a, **kw):\n        called['geo'] = True\n        return orig_geo(*a, **kw)\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', fake_geo)\n    # avoid real m3u8/f4m, not needed here\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', lambda *a, **k: [])\n    monkeypatch.setattr(ie, '_extract_f4m_formats', lambda *a, **k: [])\n\n    res = ie._real_extract(url)\n    assert called['geo'] is False\n    # fallback lang: netloc of mtg:418113 has no dot -> whole netloc? urlparse('mtg:418113').netloc == '' -> rsplit gives ''\n    # just verify subtitles has single key with sami url\n    assert len(res['subtitles']) == 1\n    lang = list(res['subtitles'].keys())[0]\n    assert res['subtitles'][lang][0]['url'] == 'http://example.com/subs.xml'\n    assert res['formats'][0]['url'] == 'http://example.com/v2.mp4'\n\n\ndef test_fallback_lang_from_http_netloc(monkeypatch):\n    url = 'http://www.tvplay.lv/parraides/vinas-melo-labak/418113?autostart=true'\n    ie = _make_ie()\n    video = _base_video(sami_path='http://cdn.example.com/path/subs.xml')\n    streams = {'streams': {'medium': 'http://example.com/a.mp4'}}\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            return streams\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda *a, **k: None)\n    res = ie._real_extract(url)\n    # sami_path has no _xx.xml so default = netloc.rsplit('.',1)[-1] of page url = 'lv'\n    assert 'lv' in res['subtitles']\n    assert res['subtitles']['lv'][0]['url'] == 'http://cdn.example.com/path/subs.xml'\n\n\ndef test_403_forbidden_raises_expected(monkeypatch):\n    url = 'http://www.tvplay.lv/parraides/vinas-melo-labak/418113?autostart=true'\n    ie = _make_ie()\n    video = _base_video()\n\n    fp = io.BytesIO(b'{\"msg\": \"Not available\"}')\n    cause = compat_HTTPError(url, 403, 'Forbidden', {}, fp)\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            raise ExtractorError('Forbidden', cause=cause)\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda *a, **k: None)\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._real_extract(url)\n    assert 'Not available' in str(excinfo.value)\n    assert excinfo.value.expected is True\n\n\ndef test_reraise_http_non403(monkeypatch):\n    url = 'http://www.tvplay.lv/parraides/vinas-melo-labak/418113?autostart=true'\n    ie = _make_ie()\n    video = _base_video()\n    fp = io.BytesIO(b'{\"msg\": \"oops\"}')\n    cause = compat_HTTPError(url, 404, 'Not Found', {}, fp)\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            raise ExtractorError('404', cause=cause)\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda *a, **k: None)\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._real_extract(url)\n    assert '404' in str(excinfo.value)\n\n\ndef test_reraise_non_http_cause(monkeypatch):\n    url = 'mtg:418113'\n    ie = _make_ie()\n    video = _base_video()\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            raise ExtractorError('plain failure', cause=ValueError('bad'))\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._real_extract(url)\n    assert 'plain failure' in str(excinfo.value)\n\n\ndef test_geo_restricted_when_no_formats(monkeypatch):\n    url = 'http://www.tvplay.lv/parraides/vinas-melo-labak/418113?autostart=true'\n    ie = _make_ie()\n    video = _base_video(sami_path=None, is_geo_blocked=True)\n    streams = {'streams': {'empty': None}}\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            return streams\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda *a, **k: None)\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._real_extract(url)\n    assert 'copyright' in str(excinfo.value).lower() or 'country' in str(excinfo.value).lower()\n\n\ndef test_missing_streams_key_no_geo_block_no_subtitles(monkeypatch):\n    url = 'http://www.tvplay.lv/parraides/vinas-melo-labak/418113?autostart=true'\n    ie = _make_ie()\n    video = {\n        'title': 'T',\n        'description': None,\n        'is_geo_blocked': False,\n        'sami_path': None,\n    }\n\n    def fake_dl(url_or_request, video_id, note=None, errnote=None, **kw):\n        if '/stream/' in url_or_request:\n            return {}\n        return video\n\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda *a, **k: None)\n    res = ie._real_extract(url)\n    assert res['id'] == '418113'\n    assert res['title']