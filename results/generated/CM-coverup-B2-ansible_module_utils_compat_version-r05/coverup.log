_ComparableVersion(\"1.2.3\")) == \"_ComparableVersion ('1.2.3')\"\n    assert repr(_ComparableVersion()) == \"_ComparableVersion ('')\"\n\n\n@pytest.mark.parametrize(\n    (\"op\", \"cmp_result\", \"expected\"),\n    [\n        (operator.eq, -1, False),\n        (operator.eq, 0, True),\n        (operator.eq, 1, False),\n        (operator.lt, -1, True),\n        (operator.lt, 0, False),\n        (operator.lt, 1, False),\n        (operator.le, -1, True),\n        (operator.le, 0, True),\n        (operator.le, 1, False),\n        (operator.gt, -1, False),\n        (operator.gt, 0, False),\n        (operator.gt, 1, True),\n        (operator.ge, -1, False),\n        (operator.ge, 0, True),\n        (operator.ge, 1, True),\n    ],\n)\ndef test_rich_comparisons_route_to_cmp(op, cmp_result, expected):\n    left = _ComparableVersion(cmp_result=cmp_result)\n    right = _ComparableVersion()\n    assert op(left, right) is expected\n\n\n@pytest.mark.parametrize(\"dunder\", [\"__eq__\", \"__lt__\", \"__le__\", \"__gt__\", \"__ge__\"])\ndef test_comparisons_propagate_not_implemented(dunder):\n    v = _ComparableVersion()\n    assert getattr(v, dunder)(object()) is NotImplemented\n\n\ndef test_eq_against_unsupported_type_falls_back():\n    v = _ComparableVersion()\n    other = object()\n    assert (v == other) is False\n\n\ndef test_loose_version_uses_inherited_comparisons():\n    assert LooseVersion(\"1.0\") < LooseVersion(\"1.1\")\n    assert LooseVersion(\"1.0\") <= LooseVersion(\"1.0\")\n    assert LooseVersion(\"2.0\") > LooseVersion(\"1.9\")\n    assert LooseVersion(\"1.0\") >= LooseVersion(\"1.0\")\n    assert LooseVersion(\"1.0\") == LooseVersion(\"1.0\")\n    assert LooseVersion(\"1.0\") == \"1.0\"\n    assert (LooseVersion(\"1.0\") == LooseVersion(\"2.0\")) is False\n```\n\nWait \u2014 `LooseVersion(\"1.0\") == \"1.0\"`: `_cmp` converts \"1.0\" to LooseVersion, versions [1, 0] == [1, 0] \u2192 0 \u2192 True. Good.\n\nHmm, but does ansible's compat LooseVersion handle str