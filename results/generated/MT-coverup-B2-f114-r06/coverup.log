        "content": "```python\nimport pytest\n\nfrom f114 import minSubArraySum\n\n\ndef test_all_positive_hits_reset_and_fallback_branches():\n    # Every element is positive, so the running sum `s` always drops below 0\n    # and is reset to 0 (line 8, true branch of line 7); max_sum therefore\n    # stays 0, so the fallback on line 11 executes.\n    assert minSubArraySum([2, 3, 4, 1, 2, 4]) == 1\n\n\ndef test_single_positive_element():\n    # Covers lines 3-9, the max_sum == 0 branch (line 10) and line 11.\n    assert minSubArraySum([5]) == 5\n\n\ndef test_all_negative_skips_fallback_branch():\n    # `s` never goes negative (false branch of line 7) and max_sum != 0,\n    # so the fallback on line 11 is skipped.\n    assert minSubArraySum([-1, -2, -3]) == -6\n\n\ndef test_mixed_values():\n    # s resets to 0 after 2, then accumulates 3 from -3, then resets after 4.\n    # Minimum subarray sum is the single element -3.\n    assert minSubArraySum([2, -3, 4]) == -3\n\n\ndef test_both_branches_of_reset_condition_in_one_run():\n    # [1, -1]: first iteration resets s to 0 (s < 0 true), second iteration\n    # keeps s = 1 (s < 0 false); max_sum != 0 so line 11 is skipped.\n    assert minSubArraySum([1, -1]) == -1\n\n\ndef test_empty_input_raises_value_error():\n    # With no elements the loop body never runs, max_sum stays 0, and\n    # max() over the empty generator on line 11 raises ValueError.\n    with pytest.raises(ValueError):\n        minSubArraySum([])\n```",
