_mapping():\n    token = tokenize_yaml(\"key: value\")\n    assert isinstance(token, DictToken)\n    assert token.value == {\"key\": \"value\"}\n\n\ndef test_tokenize_yaml_nested_mapping_and_sequence():\n    token = tokenize_yaml(\"a: [1, 2]\")\n    assert isinstance(token, DictToken)\n    assert token.value == {\"a\": [1, 2]}\n\n\ndef test_tokenize_yaml_sequence():\n    token = tokenize_yaml(\"- a\\n- b\")\n    assert isinstance(token, ListToken)\n    assert token.value == [\"a\", \"b\"]\n    assert token.string == \"- a\\n- b\"\n\n\ndef test_tokenize_yaml_string_scalar():\n    token = tokenize_yaml(\"hello\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello\"\n    assert token.string == \"hello\"\n\n\ndef test_tokenize_yaml_int_scalar():\n    token = tokenize_yaml(\"123\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 123\n    assert token.string == \"123\"\n\n\ndef test_tokenize_yaml_float_scalar():\n    token = tokenize_yaml(\"1.5\")\n    assert isinstance(token, ScalarToken)\n    assert token.value == 1.5\n\n\ndef test_tokenize_yaml_bool_scalar():\n    token = tokenize_yaml(\"true\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n\n\ndef test_tokenize_yaml_null_scalar():\n    token = tokenize_yaml(\"null\")\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n```\n\nParse errors:\n\n```python\ndef test_tokenize_yaml_parse_error_on_first_line():\n    with pytest.raises(ParseError) as excinfo:\n        tokenize_yaml(\"@invalid\")\n    message = excinfo.value.messages()[0]\n    assert message.code == \"parse_error\"\n    assert message.text == \"found character '@' that cannot start any token.\"\n    assert message.position == Position(line_no=1, column_no=1, char_index=0)\n\n\ndef test_tokenize_yaml_parse_error_on_later_line():\n    with pytest.raises(ParseError) as excinfo:\n        tokenize_yaml(\"key: value\\n@invalid\")\n    message = excinfo.value.message