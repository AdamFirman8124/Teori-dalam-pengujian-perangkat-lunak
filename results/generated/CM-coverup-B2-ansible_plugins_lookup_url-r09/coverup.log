s(obj.__class__, binary_type):\n        return to_text(obj, encoding, errors)\n    else:\n        return obj\n```\n\nSame result. OK.\n\nNow \u2014 potential issue: `HTTPError` construction with `hdrs={}` and `fp=None`. `HTTPError.__init__`:\n\n```python\nclass HTTPError(URLError, urllib.response.addinfourl):\n    def __init__(self, url, code, msg, hdrs, fp):\n        self.url = url\n        self.code = code\n        self.msg = msg\n        self.hdrs = hdrs\n        self.fp = fp\n        self.args = (url, code, msg, hdrs, fp)\n```\n\nHmm, in Python 3, `HTTPError` is `urllib.error.HTTPError(URLError, urllib.response.addinfourl)`. `addinfourl.__init__` might need stuff... Actually `HTTPError.__init__` in Python 3:\n\n```python\nclass HTTPError(URLError, urllib.response.addinfourl):\n    \"\"\"Unified Error subclass for HTTP errors.\"\"\"\n    def __init__(self, url, code, msg, hdrs, fp):\n        self.url = url\n        self.code = code\n        self.msg = msg\n        self.hdrs = hdrs\n        self.fp = fp\n        self.args = (url, code, msg, hdrs, fp)\n        # Currently, keep the exception in the HTTPError instance\n        # ...\n```\n\nHmm, in newer Pythons (3.9+?), HTTPError.__init__ also calls `super().__init__(url, msg, hdrs, fp)`? Let me recall:\n\nPython 3.11 `urllib/error.py`:\n\n```python\nclass HTTPError(URLError, urllib.response.addinfourl):\n    \"\"\"Unified Error subclass for HTTP errors.\"\"\"\n    def __init__(self, url, code, msg, hdrs, fp):\n        self.url = url\n        self.code = code\n        self.msg = msg\n        self.hdrs = hdrs\n        self.fp = fp\n        self.args = (url, code, msg, hdrs, fp)\n        # Currently a subclass of OSError, but ...\n        super().__init__(url, msg, hdrs, fp)  # hmm?\n```\n\nHmm, actually:\n\n```python\n    def __init__(self, url, code, msg, hdrs, fp):\n        self.url = url\n        self.code = code\n        self.msg = msg\n        self.hdrs = hdrs\n        self.fp = fp\n        self.args = (url, co