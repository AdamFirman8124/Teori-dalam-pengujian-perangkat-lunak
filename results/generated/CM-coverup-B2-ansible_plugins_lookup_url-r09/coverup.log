y.\n- `set_options` needs `_load_name` (set manually if missing) and uses the config manager + plugin loader to find DOCUMENTATION for 'url' lookup.\n\nTest file:\n\n```python\n# -*- coding: utf-8 -*-\n\"\"\"Tests for ansible.plugins.lookup.url.LookupModule.run covering lines 190-224.\"\"\"\n\nimport pytest\n\nfrom ansible.errors import AnsibleError\nfrom ansible.module_utils.six.moves.urllib.error import HTTPError, URLError\nfrom ansible.module_utils.urls import ConnectionError, SSLValidationError\nfrom ansible.plugins.lookup import url as url_lookup_plugin\nfrom ansible.plugins.lookup.url import LookupModule\n\n\nclass FakeResponse(object):\n    \"\"\"Minimal stand-in for the file-like object returned by open_url.\"\"\"\n    def __init__(self, body=b''):\n        self._body = body\n\n    def read(self):\n        return self._body\n\n\n@pytest.fixture\ndef lookup():\n    lm = LookupModule()\n    # ``_load_name`` is normally set by the PluginLoader; set it so that\n    # ``set_options`` can resolve the plugin's option definitions.\n    if not hasattr(lm, '_load_name'):\n        lm._load_name = 'url'\n    return lm\n\n\ndef test_run_split_lines_default(lookup, monkeypatch):\n    \"\"\"split_lines defaults to True: response body is split into lines.\"\"\"\n    captured = {}\n\n    def fake_open_url(term, **kwargs):\n        captured['term'] = term\n        captured['kwargs'] = kwargs\n        return FakeResponse(b'line1\\nline2\\nline3\\n')\n\n    monkeypatch.setattr(url_lookup_plugin, 'open_url', fake_open_url)\n\n    result = lookup.run(['http://ansible.example.com/'])\n\n    assert result == ['line1', 'line2', 'line3']\n    assert captured['term'] == 'http://ansible.example.com/'\n    # options resolved by set_options/get_option are forwarded to open_url\n    assert captured['kwargs']['validate_certs'] is True\n    assert captured['kwargs']['timeout'] == 10\n    assert captured['kwargs']['http_agent'] == 'ansible-httpget'\n    assert 'split_lines' not in captured['kwargs']\n\n\ndef test_run_no_split_lines(lookup, monkeypatch):\n    \"\"\"split_lines=False: whole body is returned as a single string.\"\"\"\n\n    def fake_open_url(term, **kwargs):\n        return FakeResponse(b'line1\\nline2')\n\n    monkeypatch.setattr(url_lookup_plugin, 'open_url', fake_open_url)\n\n    result = lookup.run(['http://ansible.example.com/'], split_lines=False)\n\n    assert result == ['line1\\nline2']\n\n\ndef test_run_multiple_terms(lookup, monkeypatch):\n    bodies = {\n        'http://one.example.com/': b'a\\nb',\n        'http://two.example.com/': b'c\\nd',\n    }\n    seen = []\n\n    def fake_open_url(term, **kwargs):\n        seen.append(term)\n        return FakeResponse(bodies[term])\n\n    monkeypatch.setattr(url_lookup_plugin, 'open_url', fake_open_url)\n\n    result = lookup.run(['http://one.example.com/', 'http://two.example.com/'])\n\n    assert result == ['a', 'b', 'c', 'd']\n    assert seen == ['http://one.example.com/', 'http://two.example.com/']\n\n\ndef test_run_http_error(lookup, monkeypatch):\n    def fake_open_url(term, **kwargs):\n        raise HTTPError(term, 500, 'Internal Server Error', {}, None)\n\n    monkeypatch.setattr(url_lookup_plugin, 'open_url', fake_open_url)\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['http://ansible.example.com/'])\n\n    assert 'Received HTTP error for http://ansible.example.com/' in str(excinfo.value)\n\n\ndef test_run_url_error(lookup, monkeypatch):\n    def fake_open_url(term, **kwargs):\n        raise URLError('name resolution failure')\n\n    monkeypatch.setattr(url_lookup_plugin, 'open_url', fake_open_url)\n\n    with pytest.raises(AnsibleError) as excinfo:\n        lookup.run(['http://ansible.example.com/'])\n\n    assert 'Failed lookup url for http://ansible.example.com/' in str(excinfo.value)\n\n\ndef test_run_ssl_validation_error(lookup, monkeypatch):\n    def fake_open_url(term, **kwargs):\n        raise SSLValidationError('certificate verify failed')\