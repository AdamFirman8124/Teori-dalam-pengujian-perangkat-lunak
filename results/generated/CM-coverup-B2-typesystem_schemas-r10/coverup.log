        "content": "```python\nimport pytest\n\nfrom typesystem.fields import Array, Object, String\nfrom typesystem.schemas import SchemaDefinitions, set_definitions\nfrom typesystem.unique_list import UniqueList  # noqa: F401  (ensure module import works)\n\n\ndef test_set_definitions_reference_gets_definitions():\n    definitions = SchemaDefinitions({\"name\": String()})\n    field = Reference(to=\"name\")\n    assert field.definitions is None\n\n    set_definitions(field, definitions)\n\n    assert field.definitions is definitions\n\n\ndef test_set_definitions_reference_already_set_is_not_overwritten():\n    definitions = SchemaDefinitions({\"name\": String()})\n    existing = SchemaDefinitions({\"other\": String()})\n    field = Reference(to=\"name\", definitions=existing)\n\n    set_definitions(field, definitions)\n\n    assert field.definitions is existing\n\n\ndef test_set_definitions_array_with_single_item():\n    definitions = SchemaDefinitions({\"name\": String()})\n    child = Reference(to=\"name\")\n    field = Array(items=child)\n\n    set_definitions(field, definitions)\n\n    assert child.definitions is definitions\n\n\ndef test_set_definitions_array_with_list_of_items():\n    definitions = SchemaDefinitions({\"name\": String(), \"age\": String()})\n    child_a = Reference(to=\"name\")\n    child_b = Reference(to=\"age\")\n    field = Array(items=[child_a, child_b])\n\n    set_definitions(field, definitions)\n\n    assert child_a.definitions is definitions\n    assert child_b.definitions is definitions\n\n\ndef test_set_definitions_array_without_items_is_noop():\n    definitions = SchemaDefinitions({\"name\": String()})\n    field = Array(items=None)\n\n    set_definitions(field, definitions)  # should not raise\n\n    assert field.items is None\n\n\ndef test_set_definitions_object_properties():\n    definitions = SchemaDefinitions({\"name\": String(), \"age\": String()})\n    child_a = Reference(to=\"name\")\n    child_b = Reference(to=\"age\")\n    field = Object(properties={\"a\": child_a, \"b\": child_b})\n\n    set_definitions(field, definitions)\n\n    assert child_a.definitions is definitions\n    assert child_b.definitions is definitions\n\n\ndef test_set_definitions_nested_structure():\n    definitions = SchemaDefinitions({\"name\": String(), \"tags\": String()})\n    ref = Reference(to=\"name\")\n    inner_array = Array(items=Reference(to=\"tags\"))\n    inner_object = Object(properties={\"ref\": ref})\n    outer = Object(\n        properties={\n            \"array\": Array(items=[inner_array, inner_object]),\n            \"single\": Array(items=ref),\n        }\n    )\n\n    set_definitions(outer, definitions)\n\n    assert ref.definitions is definitions\n    assert inner_array.items.definitions is definitions\n    assert inner_object.properties[\"ref\"].definitions is definitions\n    assert outer.properties[\"array\"].items[0].items.definitions is definitions\n    assert outer.properties[\"array\"].items[1].properties[\"ref\"].definitions is definitions\n    assert outer.properties[\"single\"].items.definitions is definitions\n\n\ndef test_set_definitions_non_recursive_field_is_noop():\n    definitions = SchemaDefinitions({\"name\": String()})\n    field = String()\n\n    set_definitions(field, definitions)  # should not raise\n\n    assert not hasattr(field, \"definitions\") or field.definitions is not definitions\n\n\n# Import placed at the bottom to avoid a top-level dependency issue if\n# Reference lives in typesystem.schemas rather than typesystem.fields.\ntry:\n    from typesystem.fields import Reference\nexcept ImportError:  # pragma: no cover\n    from typesystem.schemas import Reference\n```",
