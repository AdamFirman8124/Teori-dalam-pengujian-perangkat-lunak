make the tool calls.\n\nActually, let me reduce the number of calls a bit \u2014 the most important:\n\n1. ITVIE (class def, _VALID_URL)\n2. InfoExtractor._match_id\n3. InfoExtractor.geo_verification_headers\n4. InfoExtractor._sort_formats\n5. InfoExtractor._search_json_ld\n6. InfoExtractor._json_ld\n7. InfoExtractor._download_json (signature)\n8. InfoExtractor._extract_m3u8_formats (signature)\n9. JSON_LD_RE\n10. merge_dicts\n11. parse_duration\n12. InfoExtractor._html_search_meta\n13. InfoExtractor._search_regex\n14. InfoExtractor._get_geo_proxy\n\n14 calls in one block. OK.\n\nThen write the test.\n\nLet me think about what the final test file will look like, assuming typical results:\n\n```python\n# -*- coding: utf-8 -*-\n\"\"\"Tests exercising ITVIE._real_extract (youtube_dl/extractor/itv.py, lines 55-150).\"\"\"\n\nimport json\n\nfrom youtube_dl.extractor.itv import ITVIE\n\n\nHUB_URL = 'https://www.itv.com/hub/a-test-show/2a1234a'\nVIDEO_ID = '2a1234a'\n\n\ndef _webpage(video_attrs, json_ld_scripts=(), title='Test Episode Title',\n             synopsis='A test synopsis'):\n    attrs = ' '.join('%s=\"%s\"' % (k, v) for k, v in sorted(video_attrs.items()))\n    lines = [\n        '<!DOCTYPE html><html><head>',\n        '<meta property=\"og:title\" content=\"%s\">' % title,\n        '</head><body>',\n        '<div id=\"video\" %s></div>' % attrs,\n    ]\n    if synopsis is not None:\n        lines.append('<div class=\"episode-info__synopsis\">%s</div>' % synopsis)\n    for script in json_ld_scripts:\n        lines.append('<script type=\"application/ld+json\">%s</script>' % script)\n    lines.append('</body></html>')\n    return '\\n'.join(lines)\n\n\nclass _Recorder(object):\n    def __init__(self):\n        self.webpage_urls = []\n        self.playlist_requests = []\n        self.m3u8_calls = []\n        self.search_json_ld_calls = []\n        self.json_ld_calls = []\n        self.sort_calls = []\n\n\ndef _make_ie(monkeypatch, webpage, playlist, search_json_ld_result=None,\n             json_ld_result=None, m3u8_formats=None):\n    \"\"\"Build an ITVIE whose network/JSON-LD helpers are stubbed out.\"\"\"\n    rec = _Recorder()\n\n    def fake_download_webpage(url, video_id, *args, **kwargs):\n        rec.webpage_urls.append(url)\n        return webpage\n\n    def fake_download_json(url, video_id, *args, **kwargs):\n        rec.playlist_requests.append({\n            'url': url,\n            'video_id': video_id,\n            'data': kwargs.get('data'),\n            'headers': kwargs.get('headers'),\n        })\n        return playlist\n\n    def fake_extract_m3u8(url, video_id, ext=None, *args, **kwargs):\n        rec.m3u8_calls.append((url, video_id, ext, kwargs))\n        if m3u8_formats is not None:\n            return list(m3u8_formats)\n        return [{'url': url, 'ext': ext or 'mp4',\n                 'format_id': kwargs.get('m3u8_id')}]\n\n    def fake_search_json_ld(html, video_id, *args, **kwargs):\n        rec.search_json_ld_calls.append((html, video_id))\n        return {} if search_json_ld_result is None else search_json_ld_result\n\n    def fake_json_ld(json_ld, video_id, *args, **kwargs):\n        rec.json_ld_calls.append(json_ld)\n        return json_ld_result\n\n    def fake_sort_formats(formats, *args, **kwargs):\n        rec.sort_calls.append(list(formats))\n\n    ie = ITVIE()\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n    monkeypatch.setattr(ie, '_download_json', fake_download_json)\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', fake_extract_m3u8)\n    monkeypatch.setattr(ie, '_search_json_ld', fake_search_json_ld)\n    monkeypatch.setattr(ie, '_json_ld', fake_json_ld)\n    monkeypatch.setattr(ie, '_sort_formats', fake_sort_formats)\n    return ie, rec\n```\n\nWait \u2014 `monkeypatch.setattr(ie, '_sort_formats', ...)` \u2014 hmm, do I want to mock sort? Decided yes. But hmm, let me reconsider AGAIN whether real sort is safe... I'll see the source. If the source sh