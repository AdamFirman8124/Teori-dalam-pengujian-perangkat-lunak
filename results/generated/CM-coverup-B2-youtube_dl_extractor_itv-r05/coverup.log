 == 'AABBCCDD'\n    assert req['headers']['Accept'] == 'application/vnd.itv.vod.playlist.v2+json'\n    assert req['headers']['Content-Type'] == 'application/json'\n    payload = json.loads(req['data'].decode('utf-8'))\n    assert payload['user'] == {'itvUserId': '', 'entitlements': [], 'token': ''}\n    assert payload['device'] == {\n        'manufacturer': 'Safari', 'model': '5',\n        'os': {'name': 'Windows NT', 'version': '6.1', 'type': 'desktop'}}\n    assert payload['client'] == {'version': '4.1', 'id': 'browser'}\n    assert payload['variantAvailability'] == {\n        'featureset': {'min': ['hls', 'aes', 'outband-webvtt'],\n                       'max': ['hls', 'aes', 'outband-webvtt']},\n        'platformTag': 'dotcom'}\n\n    # Lines 100-115: media files, base prefix, m3u8 vs plain, empty Href skipped.\n    assert rec.m3u8_calls == [\n        ('https://base.example.com/video.m3u8', VIDEO_ID, 'mp4',\n         {'entry_protocol': 'm3u8_native', 'm3u8_id': 'hls', 'fatal': False}),\n    ]\n    assert result['formats'] == [\n        {'url': 'https://base.example.com/video.m3u8', 'ext': 'mp4',\n         'format_id': 'hls'},\n        {'url': 'https://base.example.com/video.mp4'},\n    ]\n    assert rec.sort_calls == [result['formats']]\n\n    # Lines 117-127: subtitles; non-dict and Href-less entries skipped.\n    assert result['subtitles'] == {\n        'en': [{'url': 'https://subs.example.com/en.vtt', 'ext': 'vtt'}]}\n\n    # Lines 130-141: JSON-LD fallback via BreadcrumbList/TVEpisode.\n    assert rec.search_json_ld_calls == [(webpage, VIDEO_ID)]\n    assert rec.json_ld_calls == [\n        {'@type': 'TVEpisode', 'name': 'Episode Name',\n         '@context': 'http://schema.org'}]\n\n    # Lines 143-150: merged result.\n    assert result['title'] == 'Test Episode Title'\n    assert result['description'] == 'A test synopsis'\n    assert result['duration'] == 3723\n    assert result['series'] == 'Test Series'\n```\n\nWait \u2014 `rec.sort_calls == [result['formats']]` \u2014 the fake appends `list(formats)` \u2014 a copy. `result['formats']` is the same list object that was passed. `list(formats)` == result['formats'] element-wise. Since dicts are compared by value, equality holds. OK.\n\nHmm, one issue: `rec.m3u8_calls` \u2014 the fake signature `fake_extract_m3u8(url, video_id, ext=None, *args, **kwargs)`. The real call: `self._extract_m3u8_formats(href, video_id, 'mp4', entry_protocol='m3u8_native', m3u8_id='hls', fatal=False)`. So url=href, video_id=video_id, ext='mp4', kwargs={'entry_protocol':..., 'm3u8_id':..., 'fatal': False}. Recorded tuple matches. Good.\n\nBut wait \u2014 `fatal=False` \u2014 in kwargs. Yes.\n\nTest 2:\n\n```python\ndef test_real_extract_data_video_id_without_base(monkeypatch):\n    url = 'https://www.itv.com/hub/another-show/2b5678b'\n    webpage = _webpage(\n        {'data-video-id': '2b5678b', 'data-video-hmac': 'ddeeff00'},\n        title='Second Title', synopsis=None)\n    playlist = {\n        'Playlist': {\n            'Video': {\n                'Duration': '153',\n                'MediaFiles': [{'Href': 'https://cdn.example.com/video.mp4'}],\n            },\n        },\n    }\n    ie, rec = _make_ie(monkeypatch, webpage, playlist)\n\n    result = ie._real_extract(url)\n\n    assert result['id'] == '2b5678b'\n    # data-video-playlist missing -> data-video-id used as playlist URL (line 60).\n    assert rec.playlist_requests[0]['url'] == '2b5678b'\n    # No 'Base' -> Href used verbatim (line 104); non-m3u8 -> plain format.\n    assert result['formats'] == [{'url': 'https://cdn.example.com/video.mp4'}]\n    assert rec.m3u8_calls == []\n    # No 'Subtitles' key -> empty subtitle dict (line 118).\n    assert result['subtitles'] == {}\n    # No JSON-LD script -> default '{}' -> falsy json_ld (line 135).\n    assert rec.json_ld_calls == []\n    assert result['title'] == 'Second Title'\n    assert result['description'] is None\n    assert result['duration'] == 153\n```\n\nWait \u2014 `data-vide