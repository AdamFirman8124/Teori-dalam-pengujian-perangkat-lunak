?P<kind>www|m)\\.)?`). Hmm, wait \u2014 actually I now recall the real fourtube.py more concretely. Let me recall from youtube-dl repo (I've seen this file):\n\n```python\nfrom __future__ import unicode_literals\n\nimport re\n\nfrom .common import InfoExtractor\nfrom ..compat import (\n    compat_urllib_parse_unquote,\n    compat_urllib_parse_urlparse,\n)\nfrom ..utils import (\n    parse_duration,\n    parse_iso8601,\n    str_to_int,\n    urlencode_postdata,\n)\n\n\nclass FourTubeBaseIE(InfoExtractor):\n    _URL_TEMPLATE = 'https://www.fourtube.com/videos/%s'\n\n    def _extract_formats(self, url, video_id, media_id, sources):\n        token = self._download_json(\n            'https://tkn.fourtube.com/token/%s/1' % media_id,\n            video_id, data=urlencode_postdata({\n                'auth': '1',\n                ...\n            }), headers={...})\n        ...\n        formats = [{\n            'url': ...,\n            'format_id': '%sP' % quality,\n            'resolution': '%dx%d' % (...),\n            ...\n        } for quality, ... in ...]\n        self._sort_formats(formats)\n        return formats\n\n    def _real_extract(self, url):\n        mobj = re.match(self._VALID_URL, url)\n        kind, video_id, display_id = mobj.group('kind', 'id', 'display_id')\n\n        if kind == 'm' or not display_id:\n            url = self._URL_TEMPLATE % video_id\n\n        webpage = self._download_webpage(url, video_id)\n\n        title = self._html_search_meta('name', webpage)\n        timestamp = parse_iso8601(self._html_search_meta(\n            'uploadDate', webpage))\n        thumbnail = self._html_search_meta('thumbnailUrl', webpage)\n        uploader_id = self._html_search_regex(\n            r'<a class=\"item-to-subscribe\" href=\"[^\"]+/(?:channel|user)s?/([^/\"]+)\" title=\"Go to [^\"]+ page\">',\n            webpage, 'uploader id', fatal=False)\n        uploader = self._html_search_regex(\n            r'<a class=\"item-to-subscribe\" href=\"[^\"]+/(?:channel|user)s?/[^/\"]+\" title=\"Go to ([^\"]+) page\">',\n            webpage, 'uploader', fatal=False)\n\n        categories_html = self._search_regex(\n            r'(?s)><i class=\"icon icon-tag\"></i>\\s*Categories / Tags\\s*.*?<ul class=\"[^\"]*?list[^\"]*?\">(.*?)</ul>',\n            webpage, 'categories', fatal=False)\n        categories = None\n        if categories_html:\n            categories = [\n                c.strip() for c in re.findall(\n                    r'(?s)<li><a.*?>(.*?)</a>', categories_html)]\n\n        view_count = str_to_int(self._search_regex(\n            r'<meta[^>]+itemprop=\"interactionCount\"[^>]+content=\"UserPlays:([0-9,]+)\">',\n            webpage, 'view count', default=None))\n        like_count = str_to_int(self._search_regex(\n            r'<meta[^>]+itemprop=\"interactionCount\"[^>]+content=\"UserLikes:([0-9,]+)\">',\n            webpage, 'like count', default=None))\n        duration = parse_duration(self._html_search_meta('duration', webpage))\n\n        media_id = self._search_regex(\n            r'<button[^>]+data-id=([\"\\'])(?P<id>\\d+)\\1[^>]+data-quality=', webpage,\n            'media id', default=None, group='id')\n        sources = [\n            quality\n            for _, quality in re.findall(r'<button[^>]+data-quality=([\"\\'])(.+?)\\1', webpage)]\n        if not (media_id and sources):\n            player_js = self._download_webpage(\n                self._search_regex(\n                    r'<script[^>]id=([\"\\'])playerembed\\1[^>]+src=([\"\\'])(?P<url>.+?)\\2',\n                    webpage, 'player JS', group='url'),\n                video_id, 'Downloading player JS')\n            params_js = self._search_regex(\n                r'\\$\\.ajax\\(url,\\ opts\\);\\s*\\}\\s*\\}\\)\\(([0-9,\\[\\] ]+)\\)',\n                player_js, 'initialization parameters')\n            params = self._parse_json('[%s]' % params_js, video_id)\n            media_id = params[0]\n            sources = ['%s' % p for p in params[2]]\n\n        formats = self._extract_formats(url, video_id, media_id, sources)\n\n        return {\n            'id': video_id,\n            'title': title,\n            'formats': formats,\n            'categories': categories,\n            'thumbnail': thumbnail,\n            'uploader': uploader,\n            'uploader_id': uploader_id,\n            'timestamp': timestamp,\n            'like_count': like_count,\n            'view_count': view_count,\n            'duration': duration,\n            'age_limit': 18,\n        }\n\n\nclass FourTubeIE(FourTubeBaseIE):\n    IE_NAME = 'fourtube'\n    _VALID_URL = r'https?://(?:(?P<kind>www|m)\\.)?(?P<tld>fourtube|faptube)\\.com/(?:videos|embed)/(?P<id>\\d+)(?:/(?P<display_id>[^/?#]+))?'\n    _TLD = 'fourtube'\n    ...\n```\n\nHmm, I'm not sure about `_TLD`. Actually I recall:\n\n```python\nclass FourTubeIE(FourTubeBaseIE):\n    IE_NAME = 'fourtube'\n    _VALID_URL = r'https?://(?:(?P<kind>www|m)\\.)?(?P<tld>fourtube|faptube)\\.com/(?:videos|embed)/(?P<id>\\d+)(?:/(?P<display_id>[^/?#]+))?'\n```\n\nHmm, but then `_URL_TEMPLATE` for FourTubeIE... The base template is 'https://www.fourtube.com/videos/%s'. For faptube URLs, the template would be wrong... unless FourTubeIE overrides `_URL_TEMPLATE` based on tld. Hmm, actually I think in the real code:\n\n```python\nclass FourTubeIE(FourTubeBaseIE):\n    IE_NAME = 'fourtube'\n    _VALID_URL = r'https?://(?:(?P<kind>www|m)\\.)?(?P<tld>fourtube|faptube)\\.com/(?:videos|embed)/(?P<id>\\d+)(?:/(?P<display_id>[^/?#]+))?'\n    _URL_TEMPLATE = 'https://www.%%s.com/videos/%s'  # no...\n```\n\nI don't think so. Let me just check with get_info. The tool will give the actual definitions in this codebase.\n\nOK \u2014 making the calls now. I'll batch all of them.\n\nActually, let me reconsider which names to query. get_info takes \"class, function or method name\". Let me query:\n\n1. `FourTubeBaseIE` \u2014 class def\n2. `FourTubeBaseIE._URL_TEMPLATE` \u2014 attribute? Might not be supp