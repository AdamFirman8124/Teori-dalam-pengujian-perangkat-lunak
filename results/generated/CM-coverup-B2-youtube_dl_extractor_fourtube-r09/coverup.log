ories'] == ['One', 'Two']\n    assert result['thumbnail'] == 'https://img.example.com/thumb.jpg'\n    assert result['uploader'] == 'Uploader One'\n    assert result['uploader_id'] == 'uploader1'\n    assert result['timestamp'] == EXPECTED_TIMESTAMP\n    assert result['like_count'] == 567\n    assert result['view_count'] == 1234\n    assert result['duration'] == 330\n    assert result['age_limit'] == 18\n    assert format_calls == [(url, '12345', '12345', ['360', '720'])]\n\n\ndef test_real_extract_mobile_url_rewrites_to_template(monkeypatch):\n    ie = FourTubeIE()\n    format_calls = []\n    downloaded = _install_stubs(monkeypatch, ie, [FULL_WEBPAGE], format_calls)\n\n    url = 'https://m.fourtube.com/videos/12345/some-display-title'\n    result = ie._real_extract(url)\n\n    template_url = FourTubeBaseIE._URL_TEMPLATE % '12345'  # or ie._URL_TEMPLATE\n    assert downloaded == [template_url]\n    assert result['id'] == '12345'\n    assert format_calls[0][0] == template_url\n\n\ndef test_real_extract_without_display_id_rewrites_to_template(monkeypatch):\n    ie = FourTubeIE()\n    ...\n    url = 'https://www.fourtube.com/videos/12345'\n    result = ie._real_extract(url)\n    assert downloaded == [FourTubeBaseIE._URL_TEMPLATE % '12345']\n\n\ndef test_real_extract_falls_back_to_player_js(monkeypatch):\n    ie = FourTubeIE()\n    format_calls = []\n    downloaded = _install_stubs(monkeypatch, ie, [FALLBACK_WEBPAGE, PLAYER_JS], format_calls)\n\n    url = 'https://www.fourtube.com/videos/99999/fallback-title'\n    result = ie._real_extract(url)\n\n    assert downloaded == [url, 'https://static.example.com/player.js']\n    assert result['id'] == '99999'\n    assert result['title'] == 'Fallback Video Title'\n    assert result['categories'] is None\n    assert result['timestamp'] is None\n    assert result['thumbnail'] is None\n    assert result['uploader'] is None\n    assert result['uploader_id'] is None\n    assert result['view_count'] is None\n    assert result['like_count'] is None\n    assert result['duration'] is None\n    assert result['age_limit'] == 18\n    assert format_calls == [(url, '99999', 12345, ['360', '720'])]\n```\n\nWait \u2014 in the fallback test, media_id = params[0] = 12345 (int). So format_calls[0][2] == 12345. Good \u2014 this also documents the int behavior.\n\nHmm, but hold on: in the fallback test, `sources = ['%s' % p for p in params[2]]` \u2192 ['360', '720'] as strings. Good.\n\nNow \u2014 one issue: in test 2 (fallback), the webpage has no `<meta name=\"duration\">` \u2192 `_html_search_meta` returns None \u2192 parse_duration(None) \u2192 None. Good.\n\nBut wait \u2014 `_html_search_meta('name', webpage)` returns 'Fallback Video Title'. Good.\n\nNow, about `mobj.group('kind', 'id', 'display_id')` for URL 'https://www.fourtube.com/videos/12345' \u2014 display_id group didn't participate \u2192 None. `not display_id` \u2192 True \u2192 rewrite. Good.\n\nNow \u2014 the 'm' URL: 'https://m.fourtube.com/videos/12345/some-display-title' \u2014 kind='m' \u2192 rewrite even though display_id present. Good, covers short-circuit.\n\nNow, potential problem: does FourTubeIE._VALID_URL actually have kind group with 'm'? If the real pattern is different (e.g., kind matches 'member'), I'll adapt after get_info.\n\nAnother potential problem: `_URL_TEMPLATE` \u2014 if FourTubeIE overrides it (e.g., to include tld), the expected rewritten URL differs. I'll use `ie._URL_TEMPLATE % '12345'` computed from the instance/class rather than hardcoding, but also assert it equals the base template if appropriate. Actually better: assert `downloaded[0] == ie._URL_TEMPLATE % '12345'` \u2014 this verifies the rewrite behavior regardless of the template's exact value. But to make the test stronger, also assert the template contains the video id. Hmm, `ie._URL_TEMPLATE % '12345'` \u2014 if the template is 'https://www.fourtube.com/videos/%s', result 'https://www.fourtube.com/videos/12345'. I'll assert equality with the computed valu