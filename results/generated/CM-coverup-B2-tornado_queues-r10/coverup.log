        "content": "```python\nimport datetime\n\nimport pytest\n\nfrom tornado.queues import Queue\nfrom tornado.testing import gen_test\nfrom tornado.util import TimeoutError\n\n\n@gen_test\nasync def test_put_success_immediately():\n    # Covers the else branch: put_nowait succeeds, future.set_result(None).\n    q = Queue(maxsize=1)\n    future = q.put(1)\n    assert future.done()\n    assert await future is None\n    assert q.qsize() == 1\n    assert len(q._putters) == 0\n    assert q.get_nowait() == 1\n    assert q.qsize() == 0\n\n\n@gen_test\nasync def test_put_blocks_when_full():\n    # Covers the QueueFull branch: item and future queued in _putters,\n    # future resolves once a getter consumes room.\n    q = Queue(maxsize=1)\n    q.put_nowait(1)\n    future = q.put(2)\n    assert not future.done()\n    assert len(q._putters) == 1\n    assert q._putters[0][0] == 2\n    assert q._putters[0][1] is future\n\n    item = await q.get()\n    assert item == 1\n    await future\n    assert future.done()\n    assert future.result() is None\n    assert len(q._putters) == 0\n    assert q.qsize() == 1\n    assert q.get_nowait() == 2\n\n\n@gen_test\nasync def test_put_timeout_numeric():\n    # Covers _set_timeout with a numeric absolute deadline.\n    q = Queue(maxsize=1)\n    q.put_nowait(1)\n    with pytest.raises(TimeoutError):\n        await q.put(2, timeout=0.05)\n    assert q.qsize() == 1\n    assert q.get_nowait() == 1\n    assert q.qsize() == 0\n\n\n@gen_test\nasync def test_put_timeout_timedelta():\n    # Covers _set_timeout with a datetime.timedelta relative timeout.\n    q = Queue(maxsize=1)\n    q.put_nowait(1)\n    with pytest.raises(TimeoutError):\n        await q.put(2, timeout=datetime.timedelta(seconds=0.05))\n    assert q.qsize() == 1\n    assert q.get_nowait() == 1\n    assert q.qsize() == 0\n```",
