        "content": "```python\nimport io\nimport pytest\nfrom youtube_dl.extractor.tvplay import TVPlayIE\nfrom youtube_dl.utils import ExtractorError, GeoRestrictedError\nfrom youtube_dl.compat import compat_HTTPError\n\n\nclass FakeYDL(object):\n    def __init__(self):\n        self.params = {\n            'no_color': True,\n            'geo_bypass': True,\n            'verbose': False,\n        }\n\n    def report_warning(self, *args, **kwargs):\n        pass\n\n    def to_screen(self, *args, **kwargs):\n        pass\n\n\ndef _make_ie():\n    ydl = FakeYDL()\n    ie = TVPlayIE(ydl)\n    try:\n        ie._x_forwarded_for_ip\n    except AttributeError:\n        ie._x_forwarded_for_ip = None\n    return ie, ydl\n\n\ndef _base_video(sami_path='http://example.com/subs_en.xml', geo_blocked=False):\n    return {\n        'title': 'Test Title',\n        'description': 'Test Desc',\n        'format_title': 'Series Title',\n        'format_position': {'episode': '5', 'season': '2'},\n        '_embedded': {'season': {'title': 'Season 2'}},\n        'duration': '3600',\n        'created_at': '2020-01-02T03:04:05+00:00',\n        'views': {'total': 1234},\n        'age_limit': '15',\n        'sami_path': sami_path,\n        'is_geo_blocked': geo_blocked,\n    }\n\n\ndef _mixed_streams():\n    return {\n        'streams': {\n            'hls': 'http://example.com/playlist.m3u8',\n            'high': 'http://example.com/manifest.f4m',\n            'medium': 'http://example.com/video.mp4',\n            'rtmp_valid': 'rtmp://example.com/app/playpath123',\n            'rtmp_invalid': 'rtmp://invalid',\n            'empty': None,\n            'blank': '',\n        }\n    }\n\n\ndef test_mixed_formats_geo_and_sami_lang(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    called = {}\n    def fake_geo(ctx):\n        called['ctx'] = ctx\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', fake_geo)\n    video = _base_video(sami_path='http://example.com/subs_en.xml')\n    streams = _mixed_streams()\n    def fake_dl(url, video_id, note=None, *a, **k):\n        assert video_id == 'vid123'\n        if '/stream/' in url:\n            return streams\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    def fake_f4m(manifest_url, video_id, f4m_id=None, fatal=False, *a, **k):\n        assert 'hdcore' in manifest_url\n        assert f4m_id == 'hds'\n        return [{'url': 'http://example.com/hds.flv', 'format_id': 'hds', 'ext': 'flv'}]\n    def fake_m3u8(m3u8_url, video_id, *a, **k):\n        assert m3u8_url == 'http://example.com/playlist.m3u8'\n        return [{'url': 'http://example.com/hls.mp4', 'format_id': 'hls-low', 'ext': 'mp4'}]\n    monkeypatch.setattr(ie, '_extract_f4m_formats', fake_f4m)\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', fake_m3u8)\n    url = 'https://www.tvplay.se/video/vid123'\n    res = ie._real_extract(url)\n    assert called['ctx'] == {'countries': ['SE']}\n    assert res['id'] == 'vid123'\n    assert res['title'] == 'Test Title'\n    assert res['description'] == 'Test Desc'\n    assert res['series'] == 'Series Title'\n    assert res['episode_number'] == 5\n    assert res['season'] == 'Season 2'\n    assert res['season_number'] == 2\n    assert res['duration'] == 3600\n    assert res['timestamp'] is not None\n    assert res['view_count'] == 1234\n    assert res['age_limit'] == 15\n    assert 'en' in res['subtitles']\n    assert res['subtitles']['en'][0]['url'] == 'http://example.com/subs_en.xml'\n    fmts = res['formats']\n    assert len(fmts) >= 4\n    urls = [f.get('url') for f in fmts]\n    assert 'http://example.com/hds.flv' in urls\n    assert 'http://example.com/hls.mp4' in urls\n    assert 'http://example.com/video.mp4' in urls\n    rtmp_fmts = [f for f in fmts if f.get('play_path') == 'playpath123']\n    assert len(rtmp_fmts) == 1\n    assert rtmp_fmts[0]['app'] == 'app'\n    assert rtmp_fmts[0]['ext'] == 'flv'\n    assert rtmp_fmts[0]['preference'] == -1\n    # invalid rtmp and empty urls must be skipped\n    for f in fmts:\n        assert f.get('url') != 'rtmp://invalid'\n        assert f.get('url') not in (None, '')\n\n\ndef test_no_geo_fallback_lang(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    called = []\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: called.append(ctx))\n    video = _base_video(sami_path='http://example.com/subs.xml')\n    streams = {'streams': {'medium': 'http://example.com/video.mp4'}}\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            return streams\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    monkeypatch.setattr(ie, '_extract_f4m_formats', lambda *a, **k: [])\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', lambda *a, **k: [])\n    url = 'http://localhost/12345'\n    res = ie._real_extract(url)\n    assert called == []\n    # sami_path has no _xx.xml so fallback to netloc part\n    assert 'localhost' in res['subtitles']\n    assert res['subtitles']['localhost'][0]['url'] == 'http://example.com/subs.xml'\n    assert len(res['formats']) == 1\n    assert res['formats'][0]['url'] == 'http://example.com/video.mp4'\n\n\ndef test_no_sami_path(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video(sami_path=None)\n    # remove optional fields to cover .get defaults\n    video.pop('format_title', None)\n    video.pop('_embedded', None)\n    video['format_position'] = {}\n    video.pop('views', None)\n    video.pop('age_limit', None)\n    video.pop('duration', None)\n    video.pop('created_at', None)\n    streams = {'streams': {'medium': 'http://example.com/video.mp4'}}\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            return streams\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    res = ie._real_extract('https://www.tvplay.se/x')\n    assert res['subtitles'] == {}\n    assert res['series'] is None\n    assert res['episode_number'] is None\n    assert res['season'] is None\n    assert res['season_number'] is None\n    assert res['duration'] is None\n    assert res['timestamp'] is None\n    assert res['view_count'] is None\n    assert res['age_limit'] is None\n    assert len(res['formats']) == 1\n\n\ndef test_geo_blocked_no_formats(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video(sami_path=None, geo_blocked=True)\n    streams = {'streams': {'empty': None, 'blank': ''}}\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            return streams\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(GeoRestrictedError):\n        ie._real_extract('https://www.tvplay.se/x')\n\n\ndef test_empty_not_blocked_sort_error(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video(sami_path=None, geo_blocked=False)\n    streams = {'streams': {}}\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            return streams\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(ExtractorError, match='No video formats found'):\n        ie._real_extract('http://localhost/1')\n\n\ndef test_403_expected_error(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video()\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            fp = io.BytesIO(b'{\"msg\": \"Blocked message\"}')\n            cause = compat_HTTPError(url, 403, 'Forbidden', {}, fp)\n            raise ExtractorError('403', cause=cause)\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._real_extract('https://www.tvplay.se/x')\n    assert 'Blocked message' in str(excinfo.value)\n    assert excinfo.value.expected is True\n\n\ndef test_reraise_non403_http(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video()\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            fp = io.BytesIO(b'not found')\n            cause = compat_HTTPError(url, 404, 'Not Found', {}, fp)\n            raise ExtractorError('404 error', cause=cause)\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(ExtractorError, match='404 error'):\n        ie._real_extract('https://www.tvplay.se/x')\n\n\ndef test_reraise_non_http_cause(monkeypatch):\n    ie, _ = _make_ie()\n    monkeypatch.setattr(ie, '_match_id', lambda url: 'vid123')\n    monkeypatch.setattr(ie, '_initialize_geo_bypass', lambda ctx: None)\n    video = _base_video()\n    def fake_dl(url, video_id, *a, **k):\n        if '/stream/' in url:\n            raise ExtractorError('other failure', cause=ValueError('bad'))\n        return video\n    monkeypatch.setattr(ie, '_download_json', fake_dl)\n    with pytest.raises(ExtractorError, match='other failure'):\n        ie._real_extract('http://localhost/1')\n```\n",
