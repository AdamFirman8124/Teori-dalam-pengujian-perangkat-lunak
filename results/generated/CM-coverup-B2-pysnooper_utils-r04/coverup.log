kind in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD):\n                    break\n                else:\n                    args.append(100)\n            return (True, func(*args))\n    except Exception:\n        return (False, None)\n    return (False, None)\n\n\ndef test_normalize_repr_direct_removes_address():\n    func = _direct_normalize_repr()\n    if func is None:\n        pytest.skip(\"normalize_repr not exposed at module level\")\n    result = func(\"<object object at 0x7f8b8c0d5e00>\")\n    assert result == \"<object object>\"\n    assert \"0x\" not in result\n    assert \"at 0x\" not in result\n\n\ndef test_normalize_repr_direct_leaves_plain_repr():\n    func = _direct_normalize_repr()\n    if func is None:\n        pytest.skip(\"normalize_repr not exposed at module level\")\n    assert func(\"<object object>\") == \"<object object>\"\n    assert func(\"hello\") == \"hello\"\n    assert func(\"\") == \"\"\n    # Regex requires at least 4 hex digits, so short address stays.\n    assert func(\"foo at 0x12\") == \"foo at 0x12\"\n    # Upper/lower hex, multiple occurrences.\n    assert func(\"<A at 0xABCDEF> and <B at 0x123456>\") == \"<A> and <B>\"\n\n\ndef test_normalize_repr_via_outer_helpers():\n    class WithAddress:\n        def __repr__(self):\n            return \"<WithAddress at 0x1234ABCD>\"\n\n    exercised = False\n    # Try well-known helper names first.\n    for helper_name in (\n        \"get_shortish_repr\",\n        \"get_repr\",\n        \"shortish_repr\",\n        \"get_local_reprs\",\n        \"normalize_repr\",\n    ):\n        helper = getattr(utils_module, helper_name, None)\n        if not callable(helper):\n            continue\n        if helper_name == \"normalize_repr\":\n            ok, res = True, helper(\"<X at 0xDEADBEEF>\")\n            assert res == \"<X>\"\n            exercised = True\n            continue\n        ok, res = _try_call_outer(helper, WithAddress())\n        if not ok:\n            continue\n        exercised = True\n        if isinstance(res, str):\n            assert \"at 0x\" not in res\n            assert \"0x1234ABCD\" not in res\n            assert \"WithAddress\" in res\n        elif isinstance(res, dict):\n            for v in res.values():\n                if isinstance(v, str):\n                    assert \"at 0x\" not in v\n        elif isinstance(res, (list, tuple)):\n            for v in res:\n                if isinstance(v, str):\n                    assert \"at 0x\" not in v\n    # Also try auto-discovered candidates so nested definition is always hit.\n    for _, func in _collect_outer_candidates():\n        if getattr(func, \"__name__\", \"\") == \"normalize_repr\":\n            continue\n        ok, res = _try_call_outer(func, WithAddress())\n        if not ok:\n            continue\n        exercised = True\n        if isinstance(res, str):\n            assert \"at 0x\" not in res\n    if _direct_normalize_repr() is None and not exercised:\n        pytest.skip(\"no outer helper found to exercise normalize_repr\")\n    assert exercised\n\n\ndef test_normalize_repr_matches_default_repr_re(monkeypatch):\n    # Verify postcondition against the actual compiled regex, without polluting state.\n    expected_re = getattr(utils_module, \"DEFAULT_REPR_RE\", re.compile(\" at 0x[a-f0-9A-F]{4,}\"))\n    func = _direct_normalize_repr()\n    sample = \"<MyClass object at 0x00abCD12>\"\n    expected = expected_re.sub(\"\", sample)\n    assert expected == \"<MyClass object>\"\n    if func is not None:\n        assert func(sample) == expected\n    else:\n        # Exercise through outer to still hit line 64.\n        candidates = _collect_outer_candidates()\n        assert len(candidates) > 0, \"expected at least one function using normalize_repr\"\n        hit = False\n        for _, outer in candidates:\n            if getattr(outer, \"__name__\", \"\") == \"normalize_repr\":\n                continue\n            ok, _ = _try_call_outer(outer, 