        "content": "```python\nfrom tornado.ioloop import IOLoop\nfrom tornado.queues import Queue\n\n\ndef run(coro):\n    return IOLoop.current().run_sync(coro)\n\n\ndef test_format_empty_queue():\n    q = Queue()\n    assert q._format() == \"maxsize=0\"\n    assert str(q) == \"<Queue maxsize=0>\"\n    rendered = repr(q)\n    assert rendered.startswith(\"<Queue at 0x\")\n    assert rendered.endswith(\" maxsize=0>\")\n\n\ndef test_format_with_queued_items():\n    q = Queue(maxsize=3)\n    q.put_nowait(\"a\")\n    q.put_nowait(\"b\")\n    assert q._format() == \"maxsize=3 queue=deque(['a', 'b'])\"\n    assert \"queue=deque(['a', 'b'])\" in str(q)\n    assert q.qsize() == 2\n\n\ndef test_format_with_pending_getters():\n    async def main():\n        q = Queue()\n        futures = [q.get() for _ in range(2)]\n        try:\n            assert q._format() == \"maxsize=0 getters[2]\"\n            assert \"getters[2]\" in str(q)\n            assert len(q._getters) == 2\n        finally:\n            for future in futures:\n                future.cancel()\n        assert all(f.cancelled() for f in futures)\n\n    run(main)\n\n\ndef test_format_with_pending_putters():\n    async def main():\n        q = Queue(maxsize=1)\n        q.put_nowait(1)\n        putter = q.put(2)\n        try:\n            assert q._format() == \"maxsize=1 queue=deque([1]) putters[1]\"\n            assert \"putters[1]\" in str(q)\n            assert q.get_nowait() == 1\n            await putter\n            assert putter.done() and not putter.cancelled()\n            assert q.qsize() == 1\n        finally:\n            if not putter.done():\n                putter.cancel()\n\n    run(main)\n\n\ndef test_format_with_unfinished_tasks():\n    q = Queue()\n    q.put_nowait(1)\n    assert q.get_nowait() == 1\n    assert q._format() == \"maxsize=0 tasks=1\"\n    assert \"tasks=1\" in str(q)\n    q.task_done()\n    assert q._format() == \"maxsize=0\"\n    assert \"tasks=\" not in str(q)\n\n\ndef test_format_getters_and_unfinished_tasks():\n    async def main():\n        q = Queue()\n        q.put_nowait(1)\n        assert q.get_nowait() == 1\n        getter = q.get()\n        try:\n            assert q._format() == \"maxsize=0 getters[1] tasks=1\"\n            q.put_nowait(2)\n            assert await getter == 2\n        finally:\n            if not getter.done():\n                getter.cancel()\n        assert q._format() == \"maxsize=0 tasks=2\"\n        q.task_done()\n        q.task_done()\n        assert q._format() == \"maxsize=0\"\n\n    run(main)\n\n\ndef test_format_all_fields_together():\n    async def main():\n        q = Queue(maxsize=1)\n        q.put_nowait(\"a\")\n        putter = q.put(\"b\")\n        try:\n            assert q._format() == \"maxsize=1 queue=deque(['a']) putters[1]\"\n            assert q.get_nowait() == \"a\"\n            await putter\n            assert q._format() == \"maxsize=1 queue=deque(['b']) tasks=2\"\n            assert q.get_nowait() == \"b\"\n        finally:\n            if not putter.done():\n                putter.cancel()\n        assert q._format() == \"maxsize=1 tasks=2\"\n        q.task_done()\n        q.task_done()\n        assert q._format() == \"maxsize=1\"\n        assert q.empty()\n\n    run(main)\n```",
