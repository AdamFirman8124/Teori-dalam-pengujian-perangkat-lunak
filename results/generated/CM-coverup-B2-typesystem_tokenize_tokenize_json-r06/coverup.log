```python\nclass Token:\n    def __init__(self, value, start_position, end_position, content):\n        self._value = value\n        self.start_position = start_position\n        self.end_position = end_position\n        self.content = content\n\n    def __repr__(self):\n        class_name = self.__class__.__name__\n        return \"%s(%r)\" % (class_name, self.get_value())\n\n    def __eq__(self, other):\n        return isinstance(other, Token) and self.get_value() == other.get_value()\n\n    def __hash__(self):\n        return hash(self.get_value())\n\n    @property\n    def value(self):\n        return self.get_value()\n\n    @property\n    def kind(self):\n        return self.__class__.__name__.replace(\"Token\", \"\").lower()\n\n    def get_value(self):\n        raise NotImplementedError()\n\n    def get_key_value_pairs(self):\n        raise NotImplementedError()\n\n    def lookup(self, index):\n        raise NotImplementedError()\n\n    def contains(self, index):\n        raise NotImplementedError()\n\n\nclass ScalarToken(Token):\n    def get_value(self):\n        return self._value\n\n\nclass DictToken(Token):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, **kwargs)\n        self._value = {k.get_value(): v for k, v in self._value.items()}\n\n    def get_value(self):\n        return {key: value.get_value() for key, value in self._value.items()}\n\n    def get_key_value_pairs(self):\n        return [KeyValuePair(key, value) for key, value in self._value.items()]\n\n    def lookup(self, index):\n        return self._value[index]\n\n    def contains(self, index):\n        return index in self._value\n\n\nclass ListToken(Token):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, **kwargs)\n        self._value = list(self._value)\n\n    def get_value(self):\n        return [value.get_value() for value in self._value]\n\n    def lookup(self, index):\n        return self._value[index]\n\n    def contains(self, index