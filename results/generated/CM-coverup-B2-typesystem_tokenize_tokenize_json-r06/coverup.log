rseError(text=message, code=\"invalid_json\", position=index)\n```\n\nHmm, I'm not 100% sure about the exact `_Scanner` implementation. Let me check the actual typesystem source code from GitHub (encode/typesystem, version 0.4.x):\n\nActually, from the typesystem repository (I recall this from the actual codebase):\n\n```python\nimport json\nimport re\nimport typing\nfrom json.decoder import JSONDecodeError, scanstring\nfrom json.scanner import py_make_scanner\n\nfrom typesystem.exceptions import ParseError\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken, Token\n\nWHITESPACE = re.compile(r\"[ \\t\\n\\r]*(?![ \\t\\n\\r])\")\nWHITESPACE_STR = \" \\t\\n\\r\"\n\n\ndef _TokenizingJSONObject(\n    s_and_end: typing.Tuple[str, int],\n    strict: bool,\n    scan_once: typing.Callable[[str, int], typing.Tuple[Token, int]],\n    memo: dict,\n    content: str,\n    _w: typing.Callable = WHITESPACE.match,\n    _ws: str = WHITESPACE_STR,\n) -> typing.Tuple[dict, int]:\n    ...\n\n\ndef _TokenizingJSONArray(...):\n    ...\n\n\ndef _make_scanner(content: str) -> typing.Callable:\n    return py_make_scanner(_ScannerContext(content))\n\n\nclass _ScannerContext:\n    def __init__(self, content: str) -> None:\n        self.memo = {}\n        self.content = content\n        self.scan_once = py_make_scanner(self)\n\n    def __call__(self, *args, **kwargs) -> Token:\n        return self.scan_once(*args, **kwargs)\n\n    def parse_object(self, *args, **kwargs) -> Token:\n        return DictToken(\n            *_TokenizingJSONObject(*args, content=self.content, **kwargs)\n        )\n\n    def parse_array(self, *args, **kwargs) -> Token:\n        return ListToken(\n            *_TokenizingJSONArray(*args, content=self.content, **kwargs)\n        )\n\n    def parse_string(self, *args, **kwargs) -> Token:\n        return self.memo.get(kwargs[\"s\"], None) or self.parse_scalar(*args, **kwargs)\n\n    def parse_scalar(self, *args, **kwargs) -> Token:\n        token, in