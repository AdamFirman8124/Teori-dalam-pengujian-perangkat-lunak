('{\"a\":1}')\n    assert token.value == {\"a\": 1}\n\n\ndef test_tokenize_object_empty():\n    # Covers the trivial empty object branch.\n    token = tokenize_json(\"{}\")\n    assert token.value == {}\n    assert token.kind == \"dict\"\n\n\ndef test_tokenize_object_empty_with_whitespace():\n    # Covers whitespace skipping before the (empty) object body.\n    token = tokenize_json('{ \\n\\t }')\n    assert token.value == {}\n\n\ndef test_tokenize_object_whitespace_around_key_and_value():\n    # Covers whitespace before ':' (slow path) and after the value.\n    token = tokenize_json('{ \"a\" : 1 }')\n    assert token.value == {\"a\": 1}\n\n\ndef test_tokenize_object_multiple_whitespace_after_colon():\n    # Covers the second whitespace check after ':'.\n    token = tokenize_json('{\"a\": \\n\\t 1}')\n    assert token.value == {\"a\": 1}\n\n\ndef test_tokenize_object_nested_and_multiple_pairs():\n    token = tokenize_json('{\"a\": {\"b\": 2}, \"c\": [true, null]}')\n    assert token.value == {\"a\": {\"b\": 2}, \"c\": [True, None]}\n\n\ndef test_tokenize_object_duplicate_keys_hit_memo():\n    token = tokenize_json('{\"a\": 1, \"a\": 2}')\n    assert token.value == {\"a\": 2}\n\n\ndef test_tokenize_object_key_token_positions():\n    token = tokenize_json('{\"a\": 1}')\n    pair = token.get_key_value_pairs()[0]\n    assert pair.key.value == \"a\"\n    assert pair.key.start_position == 1\n    assert pair.key.end_position == 3\n    assert pair.value.value == 1\n    assert pair.value.start_position == 6\n    assert pair.value.end_position == 6\n\n\n# Error branches -------------------------------------------------------------\n\n\ndef test_tokenize_object_invalid_first_key():\n    # First char after '{' is neither whitespace, '}' nor '\"'.\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json(\"{1: 2}\")\n    assert \"Expecting property name enclosed in double quotes\" in str(exc_info.value)\n\n\ndef test_tokenize_object_missing_colon():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\" 1}')\n    assert \"Expecting ':' delimiter\" in str(exc_info.value)\n\n\ndef test_tokenize_object_missing_value():\n    # IndexError after ':' followed by StopIteration from scan_once.\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\":')\n    assert \"Expecting value\" in str(exc_info.value)\n\n\ndef test_tokenize_object_missing_value_before_close():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\": }')\n    assert \"Expecting value\" in str(exc_info.value)\n\n\ndef test_tokenize_object_unterminated():\n    # IndexError when looking for the delimiter after the value.\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\": 1')\n    assert \"Expecting ',' delimiter\" in str(exc_info.value)\n\n\ndef test_tokenize_object_missing_comma():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\": 1 \"b\": 2}')\n    assert \"Expecting ',' delimiter\" in str(exc_info.value)\n\n\ndef test_tokenize_object_trailing_comma():\n    with pytest.raises(ParseError) as exc_info:\n        tokenize_json('{\"a\": 1,}')\n    assert \"Expecting property name enclosed in double quotes\" in str(exc_info.value)\n\n\n# ---------------------------------------------------------------------------\n# Direct tests of _TokenizingJSONObject's contract.\n# ---------------------------------------------------------------------------\n\n\ndef test_tokenizing_object_direct_call():\n    content = '{\"a\": 1}'\n\n    def scan_once(s, idx):\n        assert s[idx] == \"1\"\n        return ScalarToken(1, idx, idx, content), idx + 1\n\n    result, end = _TokenizingJSONObject((content, 1), True, scan_once, {}, content)\n    assert end == len(content)\n    (key, value), = list(result.items())\n    assert isinstance(key, ScalarToken)\n    assert key.value == \"a\"\n    assert key.start_position == 1\n    assert key.end_position == 3\n    asse