n = start_position\n        self.end_position = end_position\n        self.content = content\n\n    def __eq__(self, other):\n        return self.value == other\n\n    @property\n    def value(self):\n        return self._value\n\n    @property\n    def kind(self):\n        return self.__class__.__name__.lower().replace(\"token\", \"\")\n\n    def get_value(self):\n        raise NotImplementedError()\n\n    def get_key_value_pairs(self):\n        ...\n\n\nclass ScalarToken(Token):\n    def get_value(self):\n        return self._value\n\n\nclass DictToken(Token):\n    def __init__(self, *args, **kwargs):\n        super().__init__(*args, **kwargs)\n        self._value = {k.get_value(): v for k, v in self._value.items()}\n\n    def get_value(self):\n        return {k.get_value(): v.get_value() for k, v in self._value.items()}  # hmm\n```\n\nI don't remember exactly. Let me check with get_info: `DictToken`, `ScalarToken`, `Token`.\n\nActually, for the tests, the simplest assertions: `token.value == {\"a\": 1}` or `token.get_value() == {\"a\": 1}`. I need to check the API.\n\nLet me now think about which lines/branches each test covers:\n\nTest 1: `tokenize_json('{\"a\": 1}')`\n- nextchar == '\"' \u2192 line 37 False branch.\n- line 56: s[end:end+1] == ':' \u2192 False branch (skip 57-59).\n- line 63: s[end] = ' ' in _ws \u2192 True; end += 1; line 65: s[end] = '1' not in _ws \u2192 False.\n- scan_once returns ScalarToken for 1.\n- line 76: nextchar = '}' not in _ws \u2192 skip 77-79.\n- line 84: nextchar == '}' \u2192 break.\n- return dict(pairs), end.\n\nCovers: 29-37(False), 48-56(False), 62-65(True then False), 70-74, 75-76, 82, 84(True), 95.\n\nTest 2: `tokenize_json('{}')`\n- nextchar = '}' \u2192 line 37 True; line 38: '}' in _ws? No \u2192 False; line 42: '}' == '}' \u2192 True \u2192 return {}, end+1.\nCovers 37(True), 38(False), 42(True), 43.\n\nTest 3: `tokenize_json('{ \"a\": 1 }')` \u2014 wait, `{ ` then `\"a\"`: nextchar = ' ' in _ws \u2192 line 38 True; en