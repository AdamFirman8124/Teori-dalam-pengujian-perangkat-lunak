        "content": "```python\nimport pytest\n\nfrom youtube_dl.compat import compat_urllib_error\nfrom youtube_dl.downloader.hls import HlsFD\n\n\nMAN_URL = 'http://example.com/manifest.m3u8'\nREDIRECTED_URL = 'http://example.com/dir/manifest.m3u8'\nKEY_BYTES = b'0123456789abcdef'\nFRAG_BYTES = b'\\x00' * 16\n\n\nclass _FakeResponse(object):\n    def __init__(self, data, url):\n        self._data = data\n        self._url = url\n\n    def geturl(self):\n        return self._url\n\n    def read(self):\n        return self._data\n\n\nclass _FakeYDL(object):\n    def __init__(self, manifest, key=KEY_BYTES):\n        self._manifest = manifest.encode('utf-8') if isinstance(manifest, str) else manifest\n        self._key = key\n        self._manifest_served = False\n        self.calls = []\n\n    def urlopen(self, url):\n        self.calls.append(url)\n        if not self._manifest_served:\n            self._manifest_served = True\n            return _FakeResponse(self._manifest, REDIRECTED_URL)\n        return _FakeResponse(self._key, url)\n\n\ndef _http_error():\n    return compat_urllib_error.HTTPError(\n        'http://example.com/frag.ts', 404, 'Not Found', {}, None)\n\n\ndef _make_fd(monkeypatch, manifest, params=None, can_download=True,\n             fragment_index=0, download=None):\n    records = {\n        'screen': [],\n        'warnings': [],\n        'errors': [],\n        'retries': [],\n        'skips': [],\n        'appended': [],\n        'finished': [],\n        'downloads': [],\n        'started_ctx': [],\n    }\n    fd = object.__new__(HlsFD)\n    fd.ydl = _FakeYDL(manifest)\n    fd.params = dict(params or {})\n    fd._progress_hooks = []\n\n    fd.to_screen = lambda *args, **kwargs: records['screen'].append(args)\n    fd.report_warning = lambda *args, **kwargs: records['warnings'].append(args)\n    fd.report_error = lambda *args, **kwargs: records['errors'].append(args)\n    fd.report_retry_fragment = lambda *args, **kwargs: records['retries'].append(args)\n    fd.report_skip_fragment = lambda *args, **kwargs: records['skips'].append(args)\n    fd._prepare_url = lambda info_dict, url: url\n\n    def _prepare_and_start(ctx):\n        records['started_ctx'].append(dict(ctx))\n        ctx['fragment_index'] = fragment_index\n\n    fd._prepare_and_start_frag_download = _prepare_and_start\n\n    def _default_download(ctx, frag_url, info_dict, headers=None):\n        records['downloads'].append((frag_url, dict(headers or {})))\n        return True, FRAG_BYTES\n\n    fd._download_fragment = download if download is not None else _default_download\n    fd._append_fragment = lambda ctx, content: records['appended'].append(content)\n    fd._finish_frag_download = lambda ctx: records['finished'].append(dict(ctx))\n\n    monkeypatch.setattr(\n        HlsFD, 'can_download',\n        staticmethod(lambda manifest_text, info_dict: can_download))\n    return fd, records\n\n\ndef test_delegates_to_ffmpeg_when_unsupported(monkeypatch):\n    import youtube_dl.downloader.hls as hls_module\n\n    created = {}\n\n    class FakeFFmpegFD(object):\n        def __init__(self, ydl, params):\n            created['ydl'] = ydl\n            created['params'] = params\n            created['hooks'] = []\n            created['download_args'] = None\n\n        def add_progress_hook(self, hook):\n            created['hooks'].append(hook)\n\n        def real_download(self, filename, info_dict):\n            created['download_args'] = (filename, info_dict)\n            return 'ffmpeg-result'\n\n    monkeypatch.setattr(hls_module, 'FFmpegFD', FakeFFmpegFD)\n    manifest = '#EXTM3U\\nhttp://example.com/frag.ts\\n'\n    fd, records = _make_fd(monkeypatch, manifest, can_download=False)\n    hook1, hook2 = object(), object()\n    fd._progress_hooks = [hook1, hook2]\n    info = {'url': MAN_URL}\n\n    result = fd.real_download('out.mp4', info)\n\n    assert result == 'ffmpeg-result'\n    assert created['ydl'] is fd.ydl\n    assert created['params'] == fd.params\n    assert created['hooks'] == [hook1, hook2]\n    assert created['download_args'] == ('out.mp4', info)\n    assert records['warnings'] and 'ffmpeg' in records['warnings'][0][0]\n    assert records['errors'] == []\n    assert records['finished'] == []\n\n\ndef test_unsupported_with_extra_param_to_segment_url_errors(monkeypatch):\n    manifest = '#EXTM3U\\nhttp://example.com/frag.ts\\n'\n    fd, records = _make_fd(monkeypatch, manifest, can_download=False)\n    info = {'url': MAN_URL, 'extra_param_to_segment_url': 'token=abc'}\n\n    result = fd.real_download('out.mp4', info)\n\n    assert result is False\n    assert records['errors'] == [('pycrypto not found. Please install it.',)]\n    assert records['warnings'] == []\n    assert records['finished'] == []\n\n\ndef test_unsupported_with_decryption_key_url_errors(monkeypatch):\n    manifest = '#EXTM3U\\nhttp://example.com/frag.ts\\n'\n    fd, records = _make_fd(monkeypatch, manifest, can_download=False)\n    info = {'url': MAN_URL, '_decryption_key_url': 'http://example.com/key.key'}\n\n    result = fd.real_download('out.mp4', info)\n\n    assert result is False\n    assert records['errors'] == [('pycrypto not found. Please install it.',)]\n    assert records['warnings'] == []\n\n\ndef test_full_download_ads_byterange_sequence_extra_query_and_skip(monkeypatch):\n    manifest = '\\n'.join([\n        '#EXTM3U',\n        '',\n        '   ',\n        '#EXT-X-MEDIA-SEQUENCE:7',\n        '#EXT-X-BYTERANGE:100@10',\n        'http://cdn.example.com/frag1.ts',\n        '#EXT-X-BYTERANGE:50',\n        'frag2.ts',\n        '#ANVATO-SEGMENT-INFO:type=ad',\n        'ad-anvato.ts',\n        '#ANVATO-SEGMENT-INFO:type=master',\n        '#UPLYNK-SEGMENT:123,ad',\n        'ad-uplynk.ts',\n        '#UPLYNK-SEGMENT:123,segment',\n        'frag3.ts',\n        '#EXT-X-ENDLIST',\n    ])\n    fd, records = _make_fd(\n        monkeypatch, manifest, fragment_index=1)\n    info = {\n        'url': MAN_URL,\n        'extra_param_to_segme