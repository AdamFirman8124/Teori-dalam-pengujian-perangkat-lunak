: {}, 'downloaded': [], 'm3u8_calls': []}\n\n    def fake_download_webpage(self, url, video_id, *args, **kwargs):\n        state['downloaded'].append((url, video_id))\n        try:\n            return state['webpages'][url]\n        except KeyError:\n            raise AssertionError('unexpected webpage request: %s' % url)\n\n    def fake_extract_m3u8_formats(self, m3u8_url, video_id, ext=None,\n                                  *args, **kwargs):\n        state['m3u8_calls'].append({\n            'url': m3u8_url, 'id': video_id, 'ext': ext, 'kwargs': kwargs})\n        return [{\n            'url': m3u8_url,\n            'format_id': 'hls-0',\n            'ext': ext or 'mp4',\n            'protocol': 'm3u8_native',\n            'preference': 1,\n        }]\n\n    monkeypatch.setattr(LinuxAcademyIE, '_download_webpage', fake_download_webpage)\n    monkeypatch.setattr(LinuxAcademyIE, '_extract_m3u8_formats', fake_extract_m3u8_formats)\n    extractor._test_state = state\n    return extractor\n\n\ndef set_webpage(ie, url, html):\n    ie._test_state['webpages'][url] = html\n```\n\nHmm, storing state on the instance is a bit hacky but works and is cleaned up with the instance. Alternatively return a dict from the fixture via a second fixture. Let me make the fixture yield both:\n\n```python\n@pytest.fixture\ndef stub(monkeypatch):\n    state = {...}\n    ...\n    yield state\n```\n\nand create the IE inside each test? Hmm. Let me do:\n\n```python\n@pytest.fixture\ndef stubbed_ie(monkeypatch):\n    \"\"\"Yield (extractor, state) with network access stubbed out.\"\"\"\n    state = {'webpages': {}, 'downloaded': [], 'm3u8_calls': []}\n    extractor = LinuxAcademyIE()\n    ...\n    return extractor, state\n```\n\nTests: `ie, state = stubbed_ie`. That's clean.\n\nNow test 1: course playlist.\n\n```python\ndef test_course_playlist(stubbed_ie):\n    ie, state = stubbed_ie\n    module = {\n        'title': 'AWS Certified SysOps Administrator',\n        'md_desc': 'Course **markdown** description',\n        'duration': '1:02:03',\n        'items': [\n            'not-a-dict',  # non-dict items are skipped\n            {\n                'type': {'name': 'Section', 'slug': 'section'},\n                'course_name': 'Chapter One',\n                'course_module': 'module-1',\n            },\n            {\n                'type': {'slug': 'section'},  # no 'name' -> type_field falls back to ''\n                'course_name': 'Chapter Two',\n                'course_module': 'module-2',\n            },\n            {'type': {'name': 'Quiz'}},  # non-lesson items are skipped\n            {'type': {'name': 'lesson'}},  # lessons without a url are skipped\n            {\n                'type': {'name': 'Lesson', 'slug': 'lesson'},\n                'url': '/cp/courses/lesson/101',\n                'title': 'Lesson One',\n                'md_desc': 'Lesson one description',\n                'date': '2019-01-02T03:04:05',\n                'duration': '5:30',\n            },\n            {\n                'type': {'name': 'lesson'},\n                'url': 'lesson-102',\n                'lesson_name': 'Lesson Two',\n                'description': '<p>Lesson <b>two</b> description</p>',\n                'created_on': '2019-02-03T04:05:06',\n            },\n            {\n                'type': {'slug': 'lesson'},\n                'url': '/lesson-103',\n                'text': '<i>Lesson three text</i>',\n            },\n        ],\n    }\n    state['webpages'][COURSE_URL] = '<script>window.module = %s;</script>' % json.dumps(module)\n\n    result = ie._real_extract(COURSE_URL)\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == '3421'\n    assert result['title'] == 'AWS Certified SysOps Administrator'\n    assert result['description'] == 'Course **markdown** description'\n    assert result['duration'] == 3723\n\n    entries = result['entries']\n    assert len(entries) == 3\n\n    first, second, third = entries\n\n    assert first['_type'] == 'url_transparent'\n    assert first['ie_key'] == LinuxAcademyIE.ie_key()\n    assert first['url'] == 'https://linuxacademy.com/cp/courses/lesson/101'\n    assert first['title'] == 'Lesson One'\n    assert first['description'] == 'Lesson one description'\n    assert first['timestamp'] == unified_timestamp('2019-01-02T03:04:05')\n    assert first['duration'] == 330\n    assert first['chapter'] == 'Chapter One'\n    assert first['chapter_id'] == 'module-1'\n    assert first['chapter_number'] == 1\n\n    assert second['url'] == 'https://linuxacademy.com/cp/modules/view/lesson-102'\n    assert second['title'] == 'Lesson Two'\n    assert second['description'] == 'Lesson two description'\n    assert second['timestamp'] == unified_timestamp('2019-02-03T04:05:06')\n    assert second['duration'] is None\n    assert second['chapter'] == 'Chapter Two'\n    assert second['chapter_id'] == 'module-2'\n    assert second['chapter_number'] == 2\n\n    assert third['url'] == 'https://linuxacademy.com/lesson-103'\n    assert third['title'] is None\n    assert third['description'] == 'Lesson three text'\n    assert third['timestamp'] is None\n    assert third['duration'] is None\n    assert third['chapter_number'] == 2\n\n    # the webpage was requested once, with the derived item id\n    assert state['downloaded'] == [(COURSE_URL, '3421')]\n```\n\nWait \u2014 `unified_timestamp('2019-01-02T03:04:05')` \u2014 need to confirm it parses. If it returns None, then `first['timestamp']` would be None and the assertion `== unified_timestamp(...)` still passes (None == None) but doesn't prove much. I'll check the source. If unsure, I could use a definitely-parseable format like 'Jan 2, 2019' or a unix timestamp string? unified_timestamp('1546387200')? Hmm, unified_timestamp doesn't parse bare unix timestamps I think. Let me check the source via get_info and pick a format that definitely works. Common formats in youtube-dl tests: '2019-01-02T03:04:05' should work \u2014 unified_timestamp handles ISO 8601. Actually, I recall unified_timestamp's implementation:\n\n```python\ndef unified_timestamp(date_str, day_first=True):\n    if date_str is None:\n        return None\n    date_str = re.sub(r'(?i)[,\\t\\s]+', ' ', date_str)\n    date_str = re.sub(r'(?i)(\\d+)(?:st|nd|rd|th)', r'\\1', date_str)\n    ...\n    for expr in (...)\n```\n\nHmm no. The real one:\n\n```python\ndef unified_timestamp(date_str, day_first=True):\n    if date_str is None:\n        return None\n\n    date_str = re.sub(r'\\s+', ' ', date_str)\n    date_str = date_str.replace('|', ' ')\n    date_str = re.sub(r'(?i)([ap]m)\\s*(?:[.\\s]m\\.)?$', r'\\1', date_str)\n    ...\n    # ...\n    for expr in _DATE_FORMATS...:\n```\n\nI'll check. Anyway, ISO 'YYYY-MM-DDTHH:MM:SS' is definitely supported (there's a dedicated branch: `unified_timestamp` uses `datetime` parsing? no...). Actually I recall:\n\n```python\ndef unified_timestamp(date_str, day_first=True):\n    ...\n    try:\n        dt = datetime.datetime.strptime(date_str, ...)  \n```\n\nNo. OK \u2014 get_info.\n\nTest 2: course description fallback:\n\n```python\ndef test_course_playlist_description_and_duration_fallback(stubbed_ie):\n    ie, state = stubbed_ie\n    module = {\n        'title': 'Second Course',\n        'desc': '<p>Second <em>course</em> description</p>',\n        'items': [],\n    }\n    state['webpages'][COURSE_URL] = '<script>window.module = %s;</script>' % json.dumps(module)\n\n    result = ie._real_extract(COURSE_URL)\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == '3421'\n    assert result['title'] == 'Second Course'\n    assert result['description'] == 'Second course description'\n    assert result['duration'] is None\n    assert list(result['entries']) == []\n```\n\nTest 3: single video with window.lesson:\n\n```python\ndef test_single_video_with_lesson(stubbed_ie):\n    ie, state = stubbed_ie\n    lesson = {\n        'lesson_name': 'Managing EC2 Instances',\n        'md_desc': 'Le