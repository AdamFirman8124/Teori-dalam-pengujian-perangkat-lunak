actor\n\n\ndef test_largest_prime_factor_returns_largest_prime_divisor():\n    assert largest_prime_factor(15) == 5\n    assert largest_prime_factor(27) == 3\n    assert largest_prime_factor(63) == 7\n    assert largest_prime_factor(13195) == 29\n    assert largest_prime_factor(330) == 11\n\n\ndef test_largest_prime_factor_prime_and_composite_divisors():\n    # n = 4: j=2 hits is_prime(2) whose range(2, 1) is empty -> True;\n    #        j=3 is not a divisor (short-circuit, is_prime not called);\n    #        j=4 hits is_prime(4) -> 4 % 2 == 0 -> False.\n    assert largest_prime_factor(4) == 2\n    # n = 9: j=3 hits is_prime(3) whose range(2, 2) is empty -> True.\n    assert largest_prime_factor(9) == 3\n    assert largest_prime_factor(2) == 2\n    assert largest_prime_factor(3) == 3\n\n\ndef test_largest_prime_factor_no_iterations_for_n_below_two():\n    # The outer loop range(2, n + 1) is empty for n <= 1.\n    assert largest_prime_factor(1) == 1\n    assert largest_prime_factor(0) == 1\n\n\ndef test_largest_prime_factor_is_prime_guard_for_k_below_two(monkeypatch):\n    \"\"\"The nested is_prime is only ever called with j >= 2 by the outer loop,\n    so its ``k < 2`` early return is unreachable through plain calls.  A\n    temporary patch of the built-in ``range`` makes the outer loop visit\n    j = 1 for n = 1, driving is_prime(1) into the guard.  The observable\n    result for n = 1 is unchanged (1), so the assertion stays valid.\"\"\"\n    real_range = range\n    fired = {\"outer\": False}\n\n    def fake_range(start, stop=None, step=None):\n        if stop is not None and step is None and (start, stop) == (2, 2) and not fired[\"outer\"]:\n            fired[\"outer\"] = True\n            return iter([1])\n        if stop is None:\n            return real_range(start)\n        if step is None:\n            return real_range(start, stop)\n        return real_range(start, stop, step)\n\n    monkeypatch.setattr(builtins, \"range\", fake_range)\n    assert largest_p