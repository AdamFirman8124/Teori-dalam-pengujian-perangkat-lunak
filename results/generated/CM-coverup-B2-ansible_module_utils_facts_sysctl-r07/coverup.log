ith side_effect.\n\nLet me write the tests:\n\n```python\nimport pytest\nfrom ansible.module_utils.facts.sysctl import get_sysctl\n\n\nclass FakeModule:\n    def __init__(self, run_command_result=None, run_command_raises=None):\n        self.warnings = []\n        self._run_command_result = run_command_result or (0, '', '')\n        self._run_command_raises = run_command_raises\n\n    def get_bin_path(self, name):\n        return '/sbin/%s' % name\n\n    def run_command(self, cmd):\n        self.last_cmd = cmd\n        if self._run_command_raises is not None:\n            raise self._run_command_raises\n        return self._run_command_result\n\n    def warn(self, message):\n        self.warnings.append(message)\n\n\ndef test_get_sysctl_basic():\n    out = 'kernel.hostname = myhost\\nkernel.os = Linux\\n'\n    module = FakeModule(run_command_result=(0, out, ''))\n    result = get_sysctl(module, ['kernel.hostname', 'kernel.os'])\n    assert module.last_cmd == ['/sbin/sysctl', 'kernel.hostname', 'kernel.os']\n    assert result == {'kernel.hostname': 'myhost', 'kernel.os': 'Linux'}\n    assert module.warnings == []\n\n\ndef test_get_sysctl_multiline_value():\n    # covers lines 44-48 (multiline), 51-52 (flush on new key), 59-60 (final flush)\n    out = ('kernel.some = first\\n'\n           '  continued line 1\\n'\n           '  continued line 2\\n'\n           'kernel.other = second\\n'\n           '  tail continuation\\n')\n    module = FakeModule(run_command_result=(0, out, ''))\n    result = get_sysctl(module, ['kernel.some', 'kernel.other'])\n    assert result == {\n        'kernel.some': 'first\\n  continued line 1\\n  continued line 2',\n        'kernel.other': 'second\\n  tail continuation',\n    }\n    assert module.warnings == []\n```\n\nWait, careful with the multiline value and `.strip()`. value = 'first' then value += '\\n' + '  continued line 1' \u2192 'first\\n  continued line 1', then value += '\\n' + '  continued line 2' \u2192 'first\\n  continued line