lf):\n        return isinstance(self, ScalarToken)\n\n    def is_dict(self):\n        return isinstance(self, DictToken)\n\n    def is_list(self):\n        return isinstance(self, ListToken)\n\n    def to_string(self):\n        return self._content[self._start_index : self._end_index + 1]\n```\n\nI'm fairly confident about this. But let me verify with get_info.\n\nAlso ParseError: \n\n```python\nclass Message:\n    def __init__(self, *, text, code, position=None):\n        self.text = text\n        self.code = code\n        self.position = position\n\n    def __eq__(self, other):\n        if not isinstance(other, Message):\n            return False\n        return self.text == other.text and self.code == other.code and self.position == other.position\n\n    def __str__(self):\n        if self.position is None:\n            return f\"{self.code}: {self.text}\"\n        return f\"{self.code} ({self.position.line_no}:{self.position.column_no}) {self.text}\"\n\n\nclass ParseError(BaseError):\n    ...\n```\n\nBaseError:\n\n```python\nclass BaseError(Exception):\n    def __init__(self, *, text=None, code=None, position=None, messages=None):\n        ...\n        self._messages = messages if messages else [Message(text=text, code=code, position=position)]\n        ...\n\n    @property\n    def messages(self):\n        return self._messages\n\n    def __str__(self):\n        ...\n```\n\nHmm, does ParseError expose .text, .code, .position directly? In typesystem.base:\n\n```python\nclass BaseError(Exception):\n    def __init__(self, *args, **kwargs):\n        ...\n```\n\nLet me recall the actual typesystem base.py:\n\n```python\nclass Position:\n    def __init__(self, line_no: int, column_no: int, char_index: int) -> None:\n        self.line_no = line_no\n        self.column_no = column_no\n        self.char_index = char_index\n\n    def __eq__(self, other: typing.Any) -> bool:\n        if not isinstance(other, Position):\n            return False\n        return (\n            self.line_no == other.line_no\n            and self.column_no == other.column_no\n            and self.char_index == other.char_index\n        )\n\n    def __repr__(self) -> str:\n        classname = self.__class__.__name__\n        arguments = \", \".join([\n            f\"line_no={self.line_no!r}\",\n            f\"column_no={self.column_no!r}\",\n            f\"char_index={self.char_index!r}\",\n        ])\n        return f\"{classname}({arguments})\"\n\n\nclass Message:\n    def __init__(self, *, text: str, code: str, position: Position = None) -> None:\n        self.text = text\n        self.code = code\n        self.position = position\n\n    def __eq__(self, other: typing.Any) -> bool:\n        if not isinstance(other, Message):\n            return False\n        return (\n            self.text == other.text\n            and self.code == other.code\n            and self.position == other.position\n        )\n\n    def __str__(self) -> str:\n        if self.position is None:\n            return f\"{self.code}: {self.text}\"\n        return f\"{self.code} ({self.position.line_no}:{self.position.column_no}) {self.text}\"\n\n\nclass BaseError(Exception):\n    def __init__(\n        self,\n        *,\n        text: str = None,\n        code: str = None,\n        position: Position = None,\n        messages: typing.List[Message] = None,\n    ) -> None:\n        if messages is None:\n            messages = [Message(text=text, code=code, position=position)]\n        self._messages = messages\n\n    @property\n    def messages(self) -> typing.List[Message]:\n        return self._messages\n\n    def __iter__(self) -> typing.Iterator[Message]:\n        return iter(self._messages)\n\n    def __len__(self) -> int:\n        return len(self._messages)\n\n    def __getitem__(self, index: int) -> Message:\n        return self._messages[index]\n\n    def __eq__(self, other: typing.Any) -> bool:\n        if not isinstance(other, BaseError):\n            return False\n      