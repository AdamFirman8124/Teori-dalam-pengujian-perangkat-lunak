lf.line_no == other.line_no\n            and self.column_no == other.column_no\n            and self.char_index == other.char_index\n        )\n\n    def __repr__(self) -> str:\n        classname = self.__class__.__name__\n        arguments = \", \".join([\n            f\"line_no={self.line_no!r}\",\n            f\"column_no={self.column_no!r}\",\n            f\"char_index={self.char_index!r}\",\n        ])\n        return f\"{classname}({arguments})\"\n\n\nclass Message:\n    def __init__(self, *, text: str, code: str, position: Position = None) -> None:\n        self.text = text\n        self.code = code\n        self.position = position\n\n    def __eq__(self, other: typing.Any) -> bool:\n        if not isinstance(other, Message):\n            return False\n        return (\n            self.text == other.text\n            and self.code == other.code\n            and self.position == other.position\n        )\n\n    def __str__(self) -> str:\n        if self.position is None:\n            return f\"{self.code}: {self.text}\"\n        return f\"{self.code} ({self.position.line_no}:{self.position.column_no}) {self.text}\"\n\n\nclass BaseError(Exception):\n    def __init__(\n        self,\n        *,\n        text: str = None,\n        code: str = None,\n        position: Position = None,\n        messages: typing.List[Message] = None,\n    ) -> None:\n        if messages is None:\n            messages = [Message(text=text, code=code, position=position)]\n        self._messages = messages\n\n    @property\n    def messages(self) -> typing.List[Message]:\n        return self._messages\n\n    def __iter__(self) -> typing.Iterator[Message]:\n        return iter(self._messages)\n\n    def __len__(self) -> int:\n        return len(self._messages)\n\n    def __getitem__(self, index: int) -> Message:\n        return self._messages[index]\n\n    def __eq__(self, other: typing.Any) -> bool:\n        if not isinstance(other, BaseError):\n            return False\n        return self._messages == other._messages\n\n    def __hash__(self) -> int:\n        ident = tuple(hash(m) for m in self._messages)\n        return hash(ident)\n\n    def __str__(self) -> str:\n        if len(self._messages) == 1:\n            return self._messages[0].__str__()\n        return str(self._messages)\n\n    def __repr__(self) -> str:\n        classname = self.__class__.__name__\n        return f\"{classname}({str(self)!r})\"\n\n\nclass ParseError(BaseError):\n    pass\n\n\nclass ValidationError(BaseError):\n    ...\n```\n\nSo ParseError doesn't have .text directly \u2014 it has .messages, and iterating gives Message objects with .text, .code, .position. Hmm! So `error.text` would raise AttributeError.\n\nWait, but the snippet does `raise ParseError(text=text, code=\"parse_error\", position=position)`. And in typesystem's own tests (tests/test_tokenize_yaml.py? or test_json), they do:\n\n```python\ndef test_parse_error():\n    with pytest.raises(ParseError):\n        tokenize_yaml(\"{\")\n```\n\nHmm. Let me check how typesystem tests assert. From typesystem repo, tests/test_yaml_validate.py? Hmm.\n\nActually, I recall in typesystem there's `tests/test_tokenize_yaml.py`:\n\n```python\nimport pytest\n\nfrom typesystem.base import ParseError\nfrom typesystem.tokenize.tokenize_yaml import tokenize_yaml\n\n\ndef test_tokenize_yaml():\n    token = tokenize_yaml(\"{a: 1}\")\n    assert token.value == {\"a\": 1}\n    assert token.start.char_index == 0\n    ...\n```\n\nI don't remember exactly. To be safe, I should access error messages via `error.messages[0].text` etc. But wait \u2014 maybe BaseError does expose text/code/position. Let me check with get_info(\"ParseError\") and get_info(\"BaseError\").\n\nHmm, actually I now recall that in typesystem base.py, BaseError might have:\n\n```python\nclass BaseError(Exception):\n    def __init__(self, *, text=None, code=None, position=None, messages=None):\n        if messages is None:\n            messages = [Message(text