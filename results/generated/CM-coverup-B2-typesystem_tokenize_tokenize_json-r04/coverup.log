      "content": "```python\nimport pytest\nfrom typesystem.tokenize.tokenize_json import _TokenizingDecoder, _make_scanner\nfrom typesystem.tokenize.tokens import DictToken, ListToken, ScalarToken\n\n\ndef _make(text):\n    decoder = _TokenizingDecoder(content=text)\n    scanner = _make_scanner(decoder, text)\n    return decoder, scanner\n\n\ndef test_scan_string():\n    text = '\"hello\"'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == \"hello\"\n    assert end == len(text)\n    assert token.start == 0\n    assert token.end == end - 1\n    assert token.content == text\n    assert decoder.memo == {}\n\n\ndef test_scan_object():\n    text = '{\"a\": 1}'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, DictToken)\n    assert end == len(text)\n    assert token.start == 0\n    assert token.end == end - 1\n    assert token.content == text\n    assert token.value == {\"a\": 1}\n    assert decoder.memo == {}\n\n\ndef test_scan_array():\n    text = '[1, 2]'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ListToken)\n    assert end == len(text)\n    assert token.start == 0\n    assert token.end == end - 1\n    assert token.content == text\n    assert list(token.value) == [1, 2]\n    assert decoder.memo == {}\n\n\ndef test_scan_null():\n    text = 'null'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value is None\n    assert end == 4\n    assert token.start == 0\n    assert token.end == 3\n    assert decoder.memo == {}\n\n\ndef test_scan_true():\n    text = 'true'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value is True\n    assert end == 4\n    assert token.start == 0\n    assert token.end == 3\n    assert decoder.memo == {}\n\n\ndef test_scan_false():\n    text = 'false'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value is False\n    assert end == 5\n    assert token.start == 0\n    assert token.end == 4\n    assert decoder.memo == {}\n\n\ndef test_scan_integer_uses_parse_int(monkeypatch):\n    text = '42'\n    decoder = _TokenizingDecoder(content=text)\n    seen = {}\n    orig = decoder.parse_int\n    def fake_parse_int(v):\n        seen[\"v\"] = v\n        return orig(v)\n    monkeypatch.setattr(decoder, \"parse_int\", fake_parse_int)\n    scanner = _make_scanner(decoder, text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == 42\n    assert end == 2\n    assert seen == {\"v\": \"42\"}\n    assert decoder.memo == {}\n\n\ndef test_scan_negative_integer():\n    text = '-7'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == -7\n    assert end == len(text)\n    assert decoder.memo == {}\n\n\ndef test_scan_float_frac_uses_parse_float(monkeypatch):\n    text = '3.14'\n    decoder = _TokenizingDecoder(content=text)\n    seen = {}\n    orig = decoder.parse_float\n    def fake_parse_float(v):\n        seen[\"v\"] = v\n        return orig(v)\n    monkeypatch.setattr(decoder, \"parse_float\", fake_parse_float)\n    scanner = _make_scanner(decoder, text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == pytest.approx(3.14)\n    assert end == len(text)\n    assert seen == {\"v\": \"3.14\"}\n    assert decoder.memo == {}\n\n\ndef test_scan_float_exp_only():\n    text = '1e10'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == pytest.approx(1e10)\n    assert end == len(text)\n    assert decoder.memo == {}\n\n\ndef test_scan_float_frac_and_exp():\n    text = '1.5E-3'\n    decoder, scanner = _make(text)\n    token, end = scanner(text, 0)\n    assert isinstance(token, ScalarToken)\n    assert token.value == pytest.approx(0.0015)\n    assert end == len(text)\n    assert decoder.memo == {}\n\n\ndef test_scan_empty_raises_stop_iteration():\n    text = ''\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 0)\n    assert decoder.memo == {}\n\n\ndef test_scan_index_out_of_range_raises_stop_iteration():\n    text = 'true'\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 100)\n    assert decoder.memo == {}\n\n\ndef test_scan_invalid_char_raises_stop_iteration():\n    text = '!'\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 0)\n    assert decoder.memo == {}\n\n\ndef test_scan_truncated_null_raises():\n    text = 'nul'\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 0)\n    assert decoder.memo == {}\n\n\ndef test_scan_truncated_true_raises():\n    text = 'tru'\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 0)\n    assert decoder.memo == {}\n\n\ndef test_scan_truncated_false_raises():\n    text = 'fals'\n    decoder, scanner = _make(text)\n    with pytest.raises(StopIteration):\n        scanner(text, 0)\n    assert decoder.memo == {}\n\n\ndef test_scan_single_n_t_f_letters_raise():\n    for text in [\"n\", \"t\", \"f\", \"x\"]:\n        decoder, scanner = _make(text)\n        with pytest.raises(StopIteration):\n            scanner(text, 0)\n        assert decoder.memo == {}\n\n\ndef test_memo_cleared_on_success():\n    text = '\"abc\"'\n    decoder, scanner = _make(text)\n    decoder.memo[\"pollution\"] = \"value\"\n    token, end = scanner(text, 0)\n    assert token.value == \"abc\"\n    assert decoder.memo == {}\n\n\ndef test_memo_cl