        "content": "```python\nfrom unittest.mock import Mock\n\nfrom ansible.module_utils.facts.sysctl import get_sysctl\n\n\ndef test_get_sysctl_parses_values_blank_lines_and_multiline_output():\n    module = Mock()\n    module.get_bin_path.return_value = \"/usr/sbin/sysctl\"\n    module.run_command.return_value = (\n        0,\n        (\n            \"net.ipv4.ip_forward = 1\\n\"\n            \"\\n\"\n            \"kernel.example: first line\\n\"\n            \" second line\\n\"\n            \" third line\\n\"\n            \"vm.swappiness=60\\n\"\n        ),\n        \"\",\n    )\n    prefixes = [\"net.ipv4\", \"kernel.example\", \"vm.swappiness\"]\n\n    result = get_sysctl(module, prefixes)\n\n    assert result == {\n        \"net.ipv4.ip_forward\": \"1\",\n        \"kernel.example\": \"first line\\n second line\\n third line\",\n        \"vm.swappiness\": \"60\",\n    }\n    assert prefixes == [\"net.ipv4\", \"kernel.example\", \"vm.swappiness\"]\n    module.get_bin_path.assert_called_once_with(\"sysctl\")\n    module.run_command.assert_called_once_with(\n        [\n            \"/usr/sbin/sysctl\",\n            \"net.ipv4\",\n            \"kernel.example\",\n            \"vm.swappiness\",\n        ]\n    )\n    module.warn.assert_not_called()\n\n\ndef test_get_sysctl_warns_and_returns_empty_dict_for_malformed_line():\n    module = Mock()\n    module.get_bin_path.return_value = \"/sbin/sysctl\"\n    module.run_command.return_value = (0, \"malformed line without delimiter\\n\", \"\")\n\n    result = get_sysctl(module, [\"kernel\"])\n\n    assert result == {}\n    module.run_command.assert_called_once_with([\"/sbin/sysctl\", \"kernel\"])\n    module.warn.assert_called_once()\n    warning = module.warn.call_args.args[0]\n    assert warning.startswith(\n        \"Unable to split sysctl line (malformed line without delimiter): \"\n    )\n\n\ndef test_get_sysctl_returns_empty_dict_when_command_fails():\n    module = Mock()\n    module.get_bin_path.return_value = \"/sbin/sysctl\"\n    module.run_command.return_value = (1, \"kernel.hostname = ignored\", \"failed\")\n\n    result = get_sysctl(module, [])\n\n    assert result == {}\n    module.get_bin_path.assert_called_once_with(\"sysctl\")\n    module.run_command.assert_called_once_with([\"/sbin/sysctl\"])\n    module.warn.assert_not_called()\n\n\ndef test_get_sysctl_warns_and_returns_empty_dict_when_command_raises_oserror():\n    module = Mock()\n    module.get_bin_path.return_value = \"/sbin/sysctl\"\n    module.run_command.side_effect = OSError(\"permission denied\")\n\n    result = get_sysctl(module, [\"net\"])\n\n    assert result == {}\n    module.get_bin_path.assert_called_once_with(\"sysctl\")\n    module.run_command.assert_called_once_with([\"/sbin/sysctl\", \"net\"])\n    module.warn.assert_called_once_with(\n        \"Unable to read sysctl: permission denied\"\n    )\n```",
