p'}]\n\n    def fake_download(self, url, video_id, *args, **kwargs):\n        calls['download'].append((url, video_id, args))\n        if player_js is not None and url == 'https://example.com/player.js':\n            return player_js\n        return webpage\n\n    def fake_extract(self, url, video_id, media_id, sources):\n        calls['formats'].append((url, video_id, media_id, list(sources)))\n        return list(fake_formats)\n\n    monkeypatch.setattr(FourTubeIE, '_download_webpage', fake_download)\n    monkeypatch.setattr(FourTubeIE, '_extract_formats', fake_extract)\n    return calls, fake_formats\n\n\ndef test_real_extract_www_with_display_id_and_buttons(monkeypatch):\n    calls, fake_formats = _install_mocks(monkeypatch, _full_webpage())\n    ie = FourTubeIE()\n    url = 'http://www.4tube.com/videos/209733/hot-babe-title'\n    result = ie._real_extract(url)\n\n    assert calls['download'] == [(url, '209733', ())]\n    assert calls['formats'] == [(url, '209733', '12345', ['720', '480'])]\n    assert result == {\n        'id': '209733',\n        'title': 'Test Title',\n        'formats': fake_formats,\n        'categories': ['Alpha', 'Beta'],\n        'thumbnail': 'https://example.com/thumb.jpg',\n        'uploader': 'WCP Club',\n        'uploader_id': 'wcp-club',\n        'timestamp': parse_iso8601('2013-10-31T12:34:56Z'),\n        'like_count': 678,\n        'view_count': 12345,\n        'duration': 600,\n        'age_limit': 18,\n    }\n    assert isinstance(result['timestamp'], int)\n\n\ndef test_real_extract_mobile_kind_rewrites_url(monkeypatch):\n    calls, fake_formats = _install_mocks(monkeypatch, _full_webpage())\n    ie = FourTubeIE()\n    result = ie._real_extract(\n        'http://m.4tube.com/videos/209733/hot-babe-title')\n\n    rewritten = 'https://www.4tube.com/videos/209733/video'\n    assert calls['download'] == [(rewritten, '209733', ())]\n    assert calls['formats'] == [(rewritten, '209733', '12345', ['720', '480'])]\n    assert result['id'] == '209733'\n    assert result['title'] == 'Test Title'\n    assert result['formats'] == fake_formats\n    assert result['categories'] == ['Alpha', 'Beta']\n    assert result['age_limit'] == 18\n\n\ndef test_real_extract_no_display_id_rewrites_and_no_categories(monkeypatch):\n    webpage = _minimal_webpage(\n        '<button data-id=\"777\" data-quality=\"360\">360</button>')\n    calls, fake_formats = _install_mocks(monkeypatch, webpage)\n    ie = FourTubeIE()\n    result = ie._real_extract('http://www.4tube.com/embed/209733')\n\n    rewritten = 'https://www.4tube.com/videos/209733/video'\n    assert calls['download'] == [(rewritten, '209733', ())]\n    assert calls['formats'] == [(rewritten, '209733', '777', ['360'])]\n    assert result == {\n        'id': '209733',\n        'title': 'Minimal Title',\n        'formats': fake_formats,\n        'categories': None,\n        'thumbnail': 'https://example.com/min.jpg',\n        'uploader': None,\n        'uploader_id': None,\n        'timestamp': parse_iso8601('2013-10-31T12:34:56Z'),\n        'like_count': 5,\n        'view_count': 100,\n        'duration': 600,\n        'age_limit': 18,\n    }\n\n\ndef test_real_extract_player_js_fallback_no_buttons(monkeypatch):\n    webpage = _minimal_webpage(\n        '<script id=\"playerembed\" src=\"https://example.com/player.js\"></script>')\n    player_js = 'var x=1; $.ajax(url, opts); } })(999, [], [720, 360])'\n    calls, fake_formats = _install_mocks(\n        monkeypatch, webpage, player_js=player_js)\n    ie = FourTubeIE()\n    url = 'http://www.4tube.com/videos/209733/some-title'\n    result = ie._real_extract(url)\n\n    assert calls['download'] == [\n        (url, '209733', ()),\n        ('https://example.com/player.js', '209733', ('Downloading player JS',)),\n    ]\n    assert calls['formats'] == [(url, '209733', 999, ['720', '360'])]\n    assert result['id'] == '209733'\n    assert result['title'] == 'Minimal Title'\n    assert result['formats'] == fake_formats\n    assert result['categories'] is None\n    assert result['uploader'] is None\n    assert result['uploader_id'] is None\n    assert result['view_count'] == 100\n    assert result['like_count'] == 5\n    assert result['duration'] == 600\n    assert result['age_limit'] == 18\n\n\ndef test_real_extract_player_js_fallback_sources_without_media_id(monkeypatch):\n    webpage = _full_webpage().replace(\n        '<button data-id=\"12345\" data-quality=\"720\">720</button>'\n        '<button data-id=\"12345\" data-quality=\"480\">480</button>',\n        '<button data-quality=\"240\">240</button>'\n        '<script id=\"playerembed\" src=\"https://example.com/player.js\"></script>')\n    player_js = '$.ajax(url, opts); } })(555, [], [240])'\n    calls, fake_formats = _install_mocks(\n        monkeypatch, webpage, player_js=player_js)\n    ie = FourTubeIE()\n    url = 'http://www.4tube.com/videos/209733/some-title'\n    result = ie._real_extract(url)\n\n    assert calls['download'][1] == (\n        'https://example.com/player.js', '209733', ('Downloading player JS',))\n    assert calls['formats'] == [(url, '209733', 555, ['240'])]\n    assert result['formats'] == fake_formats\n    assert result['categories'] == ['Alpha', 'Beta']\n    assert result['uploader_id'] == 'wcp-club'\n    assert result['uploader'] == 'WCP Club'\n    assert result['thumbnail'] == 'https://example.com/thumb.jpg'\n    assert result['age_limit'] == 18\n```",
