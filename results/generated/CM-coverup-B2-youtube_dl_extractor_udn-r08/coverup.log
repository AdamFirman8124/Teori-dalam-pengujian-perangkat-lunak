equest]\n\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n    return calls\n```\n\nWait \u2014 careful: `_download_webpage` is called as `self._download_webpage(url, video_id, note='retrieve url for %s video' % video_type)` for the API URLs and `self._download_webpage(url, video_id)` for the page. My fake signature handles both.\n\nTest 1: full extraction with options branch:\n\n```python\ndef test_full_extraction_all_format_types(monkeypatch):\n    ie = _make_ie()\n\n    embed_page = (\n        '<html><body><script>'\n        \"var options = {\"\n        \"video: {\"\n        \"'mp4': '/api/video/mp4/300040',\"\n        \"'hls': '/api/video/hls/300040.m3u8',\"\n        \"'hds': '/api/video/hds/300040.f4m',\"\n        \"'empty': ''\"\n        \"},\"\n        \"title: 'Test Video Title',\"\n        \"poster: 'https://static.udn.com/poster.jpg'\"\n        \"};\"\n        '</script></body></html>'\n    )\n\n    pages = {\n        EMBED_URL: embed_page,\n        'https://video.udn.com/api/video/mp4/300040':\n            'https://cdn.udn.com/video/300040_720p_1000.mp4',\n        'https://video.udn.com/api/video/hls/300040.m3u8':\n            'https://cdn.udn.com/hls/300040/master.m3u8',\n        'https://video.udn.com/api/video/hds/300040.f4m':\n            'https://cdn.udn.com/hds/300040/manifest.f4m',\n    }\n    calls = _patch_downloads(monkeypatch, ie, pages)\n\n    m3u8_calls = []\n\n    def fake_m3u8(m3u8_url, video_id, ext=None, m3u8_id=None, **kwargs):\n        m3u8_calls.append((m3u8_url, video_id, ext, m3u8_id))\n        return [{'url': m3u8_url, 'format_id': 'hls-x', 'ext': 'mp4', 'height': 1080, 'tbr': 2000}]\n\n    f4m_calls = []\n\n    def fake_f4m(manifest_url, video_id, f4m_id=None, **kwargs):\n        f4m_calls.append((manifest_url, video_id, f4m_id))\n        return [{'url': manifest_url, 'format_id': 'hds-x', 'ext': 'flv', 'height': 480, 'tbr': 800}]\n\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', fake_m3u8)\n    monkeypatch.setattr(ie, '_extract_f4m_formats', fake_f4m)\n\n    info = ie._real_extract(EMBED_URL)\n\n    assert info['id'] == VIDEO_ID\n    assert info['title'] == 'Test Video Title'\n    assert info['thumbnail'] == 'https://static.udn.com/poster.jpg'\n\n    formats = info['formats']\n    by_id = {f['format_id']: f for f in formats}\n    assert 'http-mp4' in by_id\n    assert by_id['http-mp4']['url'] == 'https://cdn.udn.com/video/300040_720p_1000.mp4'\n    assert by_id['http-mp4']['height'] == 720\n    assert by_id['http-mp4']['tbr'] == 1000\n    assert 'hls-x' in by_id\n    assert 'hds-x' in by_id\n    assert len(formats) == 3  # 'empty' skipped\n\n    # sorted ascending by quality\n    heights = [f.get('height') for f in formats]\n    assert heights == sorted(heights)  # hmm, need to be careful\n```\n\nHmm, the sort assertion: youtube-dl sorts worst to best. With heights 480 (hds), 720 (mp4), 1080 (hls) \u2014 sorted ascending. But the sort key is complex; asserting exact order might be fragile. Let me instead assert that `_sort_formats` was effectively applied by checking the order matches what the real sort would produce... Actually simpler: assert heights == sorted(heights) \u2014 if the real sort produces that, fine. With distinct heights, the sort should order by height ascending (youtube-dl sorts worst first, i.e., ascending quality). I think that's safe. But to be even safer, I could mock `_sort_formats` and assert it was called with the formats list. Hmm, but then line 95 executes via the mock. The instruction is to execute lines 42-101 \u2014 mocking `_sort_formats` still executes line 95 (the call). But letting the real one run is better coverage. Let me check the real implementation first.\n\nActually, let me reconsider: maybe I shouldn't mock `_extract_m3u8_formats`/`_extract_f4m_formats` either, and instead have `_download_webpage` return real m3u8/f4m manifest content. That would exercise more real code but adds fragility. The task focuses on lines 42-101 of udn.py. Mocking the extract helpers is fine and keeps the test focused. I'll mock them but assert call args (ext='mp4', m3u8_id='hls', f4m_id='hds').\n\nTest 2: youtube redirect:\n\n```python\ndef test_youtube_redirect(monkeypatch):\n    ie = _make_ie()\n    embed_page = (\n        \"var options = {\"\n        \"video: {'youtube': 'https://www.youtube.com/watch?v=xyz'},\"\n        \"title: 'YT Title'\"\n        \"};\"\n    )\n    _patch_downloads(monkeypatch, ie, {EMBED_URL: embed_page})\n    result = ie._real_extract(EMBED_URL)\n    assert result['_type'] == 'url'\n    assert result['ie_key'] == 'Youtube'\n    assert result['url'] == 'https://www.youtube.com/watch?v=xyz'\n```\n\nTest 3: else branch (JSON parse failure -> regex fallback), plain mp4 without height/tbr pattern:\n\n```python\ndef test_fallback_regex_parsing(monkeypatch):\n    ie = _make_ie()\n    embed_page = (\n        \"var options = {\"\n        \"video: {'mp4': '/api/video/mp4/300040'},\"\n        \"title: 'Fallback Title',\"\n        \"poster: 'https://static.udn.com/fallback.jpg',\"\n        \"broken: undefined\"\n        \"};\"\n    )\n    pages = {\n        EMBED_URL: embed_page,\n        'https://video.udn.com/api/video/mp4/300040':\n            'https://cdn.udn.com/video/300040.mp4',  # no _NNNp_NNN.mp4 pattern\n    }\n    _patch_downloads(monkeypatch, ie, pages)\n    info = ie._real_extract(EMBED_URL)\n    assert info['id'] == VIDEO_ID\n    assert info['title'] == 'Fallback Title'\n    assert info['thumbnail'] == 'https://static.udn.com/fallback.jpg'\n    assert len(info['formats']) == 1\n    f = info['formats'][0]\n    assert f['format_id'] == 'http-mp4'\n    assert f['url'] == 'https://cdn.udn.com/video/300040.mp4'\n    assert 'height' not in f\n    assert 'tbr' not in f\n```\n\nWait \u2014 but will js_to_json leave `undefined` broken? Need to check. If js_to_json converts `undefined` to `null`, then the JSON parses fine and we'd be in the options branch, and `options['video']` etc. would work \u2014 the test would fail because title would come from options (same value though) \u2014 hmm, actually the assertions would still pass since values are the same! But the else branch wouldn't be covered. I need to verify js_to_json's behavior on `undefined`.\n\nAlternative: make the JSON invalid in a way js_to_json definitely doesn't fix. E.g., include a bare unquoted value: `extra: someBareWord`. js_to_json only quotes keys, not values (I believe). So `{..., extra: someBareWord}` -> `{..., \"extra\": someBareWord}` -> invalid JSON. \n\nBut wait \u2014 would js_to_json's key-quoting regex treat `someBareWord` followed by `}` ... no, it's a value. js_to_json's regex for keys is something like `(\\w+)\\s*:` hmm, but that could also match inside strings... The implementation uses a regex over the whole code with a callback. Let me fetch it and see exactly.\n\nAlso, another approach for making _parse_json fail: the title contains an unescaped double quote inside single quotes: `title: 'Say \"Hi\"'`. js_to_json converts the single quotes to double quotes: `\"title\": \"Say \"Hi\"\"` \u2014 invalid JSON! And this matches the real-world scenario (the test case title is \u751f\u7269\u8001\u5e2b\u7537\u8b8a\u5973 \u5168\u6821\u633a\"\u505a\u81ea\u5df1\" \u2014 contains double quotes!). And the expected_warnings mention 'Failed to parse JSON Expecting value'. So the real-world trigger is exactly this: title with embedded double quotes.\n\nSo for the else-branch test:\n\n```python\nembed_page = (\n    \"var options = {\"\n    \"video: {'mp4': '/api/video/mp4/300040'},\"\n    'title: \\'Say \"Hi\" Now\\','\n    \"poster: 'https://static.udn.com/fallback.jpg'\"\n    \"};\"\n)\n```\n\nAfter js_to_json: `\"title\": \"Say \"Hi\" Now\"` \u2014 invalid JSON -> parse fails -> else branch. \n\nBut wait \u2014 does js_to_json escape inner double quotes when converting single-quoted strings? Let me check the implementation... In youtube-dl's js_to_json:\n\n```python\ndef js_to_json(code):\n    def fix_kv(m):\n        v = m.group(0)\n        v = re.sub(r'^([\"\\'])', r'\"', v)  # ...\n```\n\nI recall there's handling: `v = re.sub(r'(?s)\\\\(.)', ...)` hmm. Actually I remember there was a fix for embedded quotes at some point... In newer youtube-dl:\n\n```python\ndef js_to_json(code):\n    def fix_kv(m):\n        v = m.group(0)\n        v = re.sub(r'^([\"\\'])', '', v)  # NO\n```\n\nFETCH IT. OK, I'm going to make the calls now and then finalize.\n\nAlso for the else branch, the regex `\"video\"\\s*:\\s*({.+?})\\s*,` requires a trailing comma after the video object. So in my options string, `video: {...},` must have a comma after it. In my draft above: `video: {'mp4': '/api/video/mp4/300040'},` \u2014 yes, trailing comma. After js_to_json: `\"video\": {\"mp4\": \"/api/video/mp4/300040\"},` \u2014 the regex matches `{\"mp4\": \"/api/video/mp4/300040\"}`. Then `_parse_json` on that succeeds. Good.\n\nAnd title regex `title\\s*:\\s*'(.+?)'\\s*,` on options_str (the ORIGINAL string, not transformed): `title: 'Say \"Hi\" Now',` \u2014 matches `Say \"Hi\" Now`. Good, needs trailing comma \u2014 present.\n\nAnd poster regex `poster\\s*:\\s*'(.+?)'\\s*,` \u2014 `poster: 'https://static.udn.com/fallback.jpg'` \u2014 needs trailing comma after! In my draft, poster is the last property before `}`: `poster: 'https://static.udn.com/fallback.jpg'}` \u2014 no trailing comma -> regex fails -> default=None -> poster None. Hmm, that covers the default=None path but I also want to cover poster found. Let me do two else-branch tests, or put poster before another property. Let me add another property after poster so the comma exists:\n\n```\n\"video: {'mp4': '/api/video/mp4/300040'},\"\n\"title: 'Say \\\"Hi\\\" Now',\"\n\"poster: 'https://static.udn.com/fallback.jpg',\"\n\"other: 'x'\"\n```\n\nThen poster regex matches. And in a second test (or same test with different page), omit poster to cover default=None. Actually the `default=None` path: line 59-60 executes in both cases; the branch difference is whether the regex matches. For branch coverage of the `default` mechanism... the lines are the same. I'll include a no-poster variant in one test to be thorough. Actually, let me combine: one else-branch test with poster present, and in the same test file another else-branch test without poster (also covering the no-mobj mp4 URL). Hmm, let me structure:\n\nTest 3: else branch, poster present, mp4 URL WITH pattern (mobj true):\n- covers lines 54-60, 82-93 with mobj.\n\nWait, but test 1 already covers mobj-true via the options branch. Fine, redundancy OK.\n\nTest 4: else branch, poster absent (default=None), mp4 URL WITHOUT pattern (mobj false):\n- covers default=None path and mobj-false path.\n\nHmm, but wait: in test 4, if poster is absent from options_str, the regex `poster\\s*:\\s*'(.+?)'\\s*,` doesn't match -> returns None (default). Good.\n\nBut hold on \u2014 for the JSON parse to fail in test 4, I still need invalid JSON. Use the embedded-double-quote title trick again, or a bare word. Let me use the embedded quote trick in both.\n\nActually wait, I realize I should double check: does js_to_json handle the embedded double quotes? If js_to_json escapes them (newer versions do handle this: `v = re.sub(r'\"', r'\\\\\"', ...)` for single-quoted strings?), then the JSON would be valid and we'd be in the options branch. The youtube-dl version matters. The code shown is from youtube_dl (lowercase, old project). Let me check js_to_json in this codebase via get_info.\n\nLet me also double check `_parse_json` fatal=False behavior and `report_warning`.\n\nOne more consideration: `_html_search_regex` \u2014 how does it handle `default=None`? \n\n```python\ndef _html_search_regex(self, pattern, string, name, default=NO_DEFAULT, fatal=True, flags=0, group=None):\n    ...\n    if default is NO_DEFAULT:\n        raise ExtractorError(...)\n    else:\n        return default\n```\n\nHmm, actually `_search_regex`:\n\n```python\ndef _search_regex(self, pattern, string, name, default=NO_DEFAULT, fatal=True, flags=0, group=None):\n    ...\n    if m:\n        ...\n    elif default is not NO_DEFAULT:\n        return default\n    elif fatal:\n        raise ExtractorError(...)\n    else:\n        warning...\n```\n\nSomething like that. With default=None passed explicitly, it returns None. Good.\n\nNow \u2014 the `_match_id` for 'https://video.udn.com/embed/news/300040': `_VALID_URL = 'https?:' + '//video\\.udn\\.com/(?:embed|play)/news/(?P<id>\\d+)'`. So `https://video.udn.com/embed/news/300040` matches, id='300040'. Good.\n\nAlso, should I test the protocol-relative URL? `_match_id` handles `(?:https?:)?` if _PROTOCOL_RELATIVE_VALID_URL is used... The `_match_id` implementation:\n\n```python\n@classmethod\ndef _match_id(cls, url):\n    if cls._PROTOCOL_RELATIVE_VALID_URL is not None:\n        m = re.match(r'(?:https?:)?%s$' % cls._PROTOCOL_RELATIVE_VALID_URL, url)\n    else:\n        m = re.match(cls._VALID_URL, url)\n    assert m\n    return m.group('id')\n```\n\nHmm, not sure about the exact form. Either way 'https://...' works. I'll use https URLs.\n\nNow about `urljoin`: `compat_urlparse.urljoin('https://video.udn.com/embed/news/300040', '/api/video/mp4/300040')` -> 'https://video.udn.com/api/video/mp4/300040'. Good. What if api_url is a full URL? urljoin handles it. Not needed.\n\nEdge: in the loop, dict iteration order \u2014 Python 3.7+ preserves insertion order; the options dict from JSON parse preserves order too (json.loads preserves order in dicts). So the calls happen in order: mp4, hls, hds, empty. My fake download asserts each URL is in pages. Fine regardless of order.\n\nNow, `_sort_formats` real behavior \u2014 let me make sure my formats sort cleanly. Let me fetch it.\n\nAlso `int_or_none`:\n\n```python\ndef int_or_none(v, scale=1, default=None, get_attr=None, **kwargs):\n    try:\n        v = float(v)  # no...\n```\n\nActually:\n\n```python\ndef int_or_none(v, scale=1, default=None, get_attr=None, **kwargs):\n    if get_attr and v is not None:\n        v = getattr(v, get_attr, None)\n    try:\n        return default if v is None else int(round(float(v) / scale))\n    except (ValueError, TypeError):\n        return default\n```\n\nHmm, something like that. For '720' -> 720. Good.\n\nNow let me also think about whether `_real_extract` might call `self._downloader` stuff via `_download_webpage` \u2014 I'm mocking that, so no.\n\n`_parse_json` fatal=False -> on failure calls `self.report_warning(errmsg)`. Let me check report_warning's implementation to ensure FakeDownloader satisfies it.\n\nOK let me make the get_info calls now. I'll batch:\n\n- js_to_json\n- determine_ext\n- int_or_none\n- InfoExtractor._parse_json\n- InfoExtractor._sort_formats\n- InfoExtractor.report_warning\n- InfoExtractor.to_screen\n- InfoExtractor._match_id\n- InfoExtractor.url_result\n- InfoExtractor._html_search_regex\n- InfoExtractor.set_downloader\n\nThat's 11 calls. Let me do them.\n\nAfter getting the info, I'll finalize the test code.\n\nLet me pre-draft the final test file structure:\n\n```python\n\"\"\"Tests for youtube_dl.extractor.udn.UDNEmbedIE._real_extract (lines 42-101).\"\"\"\n\nimport pytest\n\nfrom youtube_dl.extractor.udn import UDNEmbedIE\n\n\nEMBED_URL = 'https://video.udn.com/embed/news/300040'\nVIDEO_ID = '300040'\n\n\nclass FakeDownloader(object):\n    def __init__(self):\n        self.params = {}\n        self.messages = []\n\n    def to_screen(self, msg, *args, **kwargs):\n        self.messages.append(msg)\n\n    def report_warning(self, msg, *args, **kwargs):\n        self.messages.append(msg)\n\n\ndef _make_ie():\n    return UDNEmbedIE(FakeDownloader())\n\n\ndef _patch_webpage_downloads(monkeypatch, ie, pages):\n    served = []\n\n    def fake_download_webpage(url_or_request, video_id, note=None, **kwargs):\n        served.append((url_or_request, video_id, note))\n        if url_or_request not in pages:\n            raise AssertionError('unexpected _download_webpage call: %r' % (url_or_request,))\n        return pages[url_or_request]\n\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n    return served\n```\n\nHmm wait, one issue: `monkeypatch.setattr(ie, '_download_webpage', fake)` \u2014 since `_download_webpage` is a method of the class, setting an instance attribute shadows it. On teardown, monkeypatch will delete the instance attribute (since it didn't exist before). Good.\n\nBut careful: `fake_download_webpage` receives `self`? No \u2014 instance attribute functions are not descriptors... wait, actually functions ARE descriptors, but when stored as instance attributes, they are NOT bound (binding happens via the class descriptor protocol on attribute lookup through the class). When you look up `ie._download_webpage` and it's an instance attribute, Python returns the plain function without binding. So calling `self._download_webpage(url, video_id, note=...)` calls `fake(url, video_id, note=...)` \u2014 no self. Correct.\n\nTest 1 (options branch, all format types):\n\n```python\ndef test_extract_with_parseable_options(monkeypatch):\n    ie = _make_ie()\n\n    embed_page = (\n        '<html><script>'\n        \"var options = {\"\n        \"video: {\"\n        \"'mp4': '/api/video/mp4/300040',\"\n        \"'hls': '/api/video/hls/300040.m3u8',\"\n        \"'hds': '/api/video/hds/300040.f4m',\"\n        \"'skipped': ''\"\n        \"},\"\n        \"title: 'Options Title',\"\n        \"poster: 'https://static.udn.com/poster.jpg'\"\n        \"};\"\n        '</script></html>'\n    )\n\n    pages = {\n        EMBED_URL: embed_page,\n        'https://video.udn.com/api/video/mp4/300040':\n            'https://cdn.udn.com/video/300040_720p_1000.mp4',\n        'https://video.udn.com/api/video/hls/300040.m3u8':\n            'https://cdn.udn.com/hls/300040/master.m3u8',\n        'https://video.udn.com/api/video/hds/300040.f4m':\n            'https://cdn.udn.com/hds/300040/manifest.f4m',\n    }\n    served = _patch_webpage_downloads(monkeypatch, ie, pages)\n\n    m3u8_calls = []\n\n    def fake_m3u8(m3u8_url, video_id, ext=None, m3u8_id=None, **kwargs):\n        m3u8_calls.append((m3u8_url, video_id, ext, m3u8_id))\n        return [{'url': m3u8_url, 'format_id': 'hls-fake', 'ext': 'mp4',\n                 'height': 1080, 'tbr': 2000}]\n\n    f4m_calls = []\n\n    def fake_f4m(manifest_url, video_id, f4m_id=None, **kwargs):\n        f4m_calls.append((manifest_url, video_id, f4m_id))\n        return [{'url': manifest_url, 'format_id': 'hds-fake', 'ext': 'flv',\n                 'height': 480, 'tbr': 800}]\n\n    monkeypatch.setattr(ie, '_extract_m3u8_formats', fake_m3u8)\n    monkeypatch.setattr(ie, '_extract_f4m_formats', fake_f4m)\n\n    info = ie._real_extract(EMBED_URL)\n\n    # page + one request per non-empty video url\n    assert [c[0] for c in served] == [\n        EMBED_URL,\n        'https://video.udn.com/api/video/mp4/300040',\n        'https://video.udn.com/api/video/hls/300040.m3u8',\n        'https://video.udn.com/api/video/hds/300040.f4m',\n    ]\n    assert served[0][1] == VIDEO_ID\n    assert 'retrieve url for mp4 video' in served[1][2]\n\n    assert m3u8_calls == [('https://cdn.udn.com/hls/300040/master.m3u8', VIDEO_ID, 'mp4', 'hls')]\n    assert f4m_calls == [('https://cdn.udn.com/hds/300040/manifest.f4m', VIDEO_ID, 'hds')]\n\n    assert info['id'] == VIDEO_ID\n    assert info['title'] == 'Options Title'\n    assert info['thumbnail'] == 'https://static.udn.com/poster.jpg'\n\n    formats = info['formats']\n    assert len(formats) == 3\n    by_id = dict((f['format_id'], f) for f in formats)\n    assert by_id['http-mp4']['url'] == 'https://cdn.udn.com/video/300040_720p_1000.mp4'\n    assert by_id['http-mp4']['height'] == 720\n    assert by_id['http-mp4']['tbr'] == 1000\n    assert by_id['hls-fake']['url'] == 'https://cdn.udn.com/hls/300040/master.m3u8'\n    assert by_id['hds-fake']['url'] == 'https://cdn.udn.com/hds/300040/manifest.f4m'\n\n  