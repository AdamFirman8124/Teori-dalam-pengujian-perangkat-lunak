ERR_COMMAND_NOT_SUPPORTED = 0x07\n    ERR_ADDRESS_TYPE_NOT_SUPPORTED = 0x08\n\n    def __init__(self, code, msg=None):\n        if msg is None:\n            msg = self.error_to_string(code)  # ???\n```\n\nI don't remember exactly. Let me just use get_info for Socks5Error, _check_response_version, _recv_bytes, recvall, _resolve_address, _socks5_auth, _len_and_data, and the module-level constants.\n\nLet me make the get_info calls now. I'll batch them:\n\n1. `sockssocket._setup_socks5`\n2. `sockssocket._resolve_address`\n3. `sockssocket._socks5_auth`\n4. `sockssocket._recv_bytes`\n5. `sockssocket._check_response_version`\n6. `sockssocket._len_and_data`\n7. `sockssocket.recvall`\n8. `Socks5Error`\n9. `Socks5AddressType`\n10. `Socks5Command`\n11. `SOCKS5_VERSION`\n\nThat's a lot of calls but they're independent, so I can batch them all in one block.\n\nAfter getting the info, I'll write the test script.\n\nLet me draft the test script now (to refine after get_info):\n\n```python\nimport socket\n\nimport pytest\n\nfrom youtube_dl.compat import compat_struct_pack\nfrom youtube_dl.socks import (\n    SOCKS5_VERSION,\n    Socks5AddressType,\n    Socks5Command,\n    Socks5Error,\n    sockssocket,\n)\n\n\nclass FakeRecv(object):\n    \"\"\"Callable that mimics socket.recv by consuming a preloaded buffer.\"\"\"\n\n    def __init__(self, data):\n        self._buffer = bytearray(data)\n        self._pos = 0\n        self.sizes = []\n\n    def __call__(self, bufsize):\n        self.sizes.append(bufsize)\n        if self._pos >= len(self._buffer):\n            raise AssertionError(\n                'fake recv exhausted: requested %d more bytes' % bufsize)\n        chunk = bytes(self._buffer[self._pos:self._pos + bufsize])\n        self._pos += bufsize\n        return chunk\n\n    @property\n    def remaining(self):\n        return len(self._buffer) - self._pos\n\n\n@pytest.fixture\ndef socks():\n    sock = sockssocket()\n    yield sock\n    sock.close()\n\n\ndef prepare(sock, monkeypatch, response, ipaddr=None):\n    \"\"\"Patch out all external interactions of _setup_socks5.\"\"\"\n    sent = []\n\n    monkeypatch.setattr(sock, 'recv', FakeRecv(response))\n    monkeypatch.setattr(sock, 'sendall', sent.append)\n    monkeypatch.setattr(\n        sock, '_resolve_address',\n        lambda destaddr, default, use_remote_dns=True: ipaddr)\n    monkeypatch.setattr(sock, '_socks5_auth', lambda: None)\n    return sent\n```\n\nWait \u2014 `monkeypatch.setattr(sock, 'sendall', sent.append)` \u2014 sent.append returns None, fine.\n\nHmm, one issue: `monkeypatch.setattr(sock, '_resolve_address', ...)` \u2014 the lambda signature: called as `self._resolve_address(destaddr, None, use_remote_dns=True)`. Since we set it on the instance, no self is passed. So lambda needs (destaddr, default, use_remote_dns=True). Good.\n\nNow the tests:\n\n```python\ndef test_socks5_domainname_roundtrip(socks, monkeypatch):\n    destaddr = 'example.com'\n    port = 8080\n    response = (\n        compat_struct_pack('!BBBB', SOCKS5_VERSION, Socks5Error.ERR_SUCCESS, 0,\n                           Socks5AddressType.ATYP_DOMAINNAME)\n        + compat_struct_pack('!B', len(b'localhost'))\n        + b'localhost'\n        + compat_struct_pack('!H', 9090))\n    sent = prepare(socks, monkeypatch, response, ipaddr=None)\n\n    result = socks._setup_socks5((destaddr, port))\n\n    assert result == (b'localhost', 9090)\n    expected_packet = (\n        compat_struct_pack('!BBB', SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + compat_struct_pack('!B', Socks5AddressType.ATYP_DOMAINNAME)\n        + compat_struct_pack('!B', len(b'example.com'))\n        + b'example.com'\n        + compat_struct_pack('!H', port))\n    assert sent == [expected_packet]\n```\n\nWait \u2014 `_len_and_data(destaddr)` \u2014 need to check its implementation. Probably `compat_struct_pack('!B', len(data)) + data`. So the packet includes length byte + data. My expected packet matches if _len_and_data is as I think. Let me verify with get_info.\n\n```python\ndef test_socks5_ipv4_roundtrip(socks, monkeypatch):\n    ipaddr = b'\\x7f\\x00\\x00\\x01'\n    response = (\n        compat_struct_pack('!BBBB', SOCKS5_VERSION, Socks5Error.ERR_SUCCESS, 0,\n                           Socks5AddressType.ATYP_IPV4)\n        + b'\\x0a\\x00\\x00\\x01'\n        + compat_struct_pack('!H', 443))\n    sent = prepare(socks, monkeypatch, response, ipaddr=ipaddr)\n\n    result = socks._setup_socks5(('127.0.0.1', 443))\n\n    assert result == (b'\\x0a\\x00\\x00\\x01', 443)\n    expected_packet = (\n        compat_struct_pack('!BBB', SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + compat_struct_pack('!B', Socks5AddressType.ATYP_IPV4)\n        + ipaddr\n        + compat_struct_pack('!H', 443))\n    assert sent == [expected_packet]\n```\n\n```python\ndef test_socks5_ipv6_bound_address(socks, monkeypatch):\n    bound_addr = bytes(range(16))\n    response = (\n        compat_struct_pack('!BBBB', SOCKS5_VERSION, Socks5Error.ERR_SUCCESS, 0,\n                           Socks5AddressType.ATYP_IPV6)\n        + bound_addr\n        + compat_struct_pack('!H', 1080))\n    prepare(socks, monkeypatch, response, ipaddr=None)\n\n    result = socks._setup_socks5(('example.org', 1080))\n\n    assert result == (bound_addr, 1080)\n```\n\n```python\ndef test_socks5_error_closes_socket_and_raises(socks, monkeypatch):\n    response = compat_struct_pack(\n        '!BBBB', SOCKS5_VERSION, Socks5Error.ERR_CONNECTION_REFUSED, 0,\n        Socks5AddressType.ATYP_IPV4)\n    prepare(socks, monkeypatch, response, ipaddr=None)\n\n    with pytest.raises(Socks5Error) as excinfo:\n        socks._setup_socks5(('example.com', 80))\n\n    assert excinfo.value... == Socks5Error.ERR_CONNECTION_REFUSED\n    assert socks.fileno() == -1  # socket was closed\n```\n\nHmm, what does Socks5Error look like? `raise Socks5Error(status)`. If Socks5Error.__init__ takes code and sets self.code or uses it as args[0]... Need get_info. If it's a