 sock.close()\n\n\ndef patch_io(monkeypatch, sock, response, ipaddr=None):\n    \"\"\"Replace all external I/O of ``_setup_socks5`` with in-memory fakes.\"\"\"\n    sent = []\n    fake_recv = FakeRecv(response)\n    monkeypatch.setattr(sock, 'recv', fake_recv)\n    monkeypatch.setattr(sock, 'sendall', sent.append)\n    monkeypatch.setattr(\n        sock, '_resolve_address',\n        lambda destaddr, default, use_remote_dns=True: ipaddr)\n    monkeypatch.setattr(sock, '_socks5_auth', lambda: None)\n    return sent, fake_recv\n\n\ndef socks5_response(status, atype, payload=b''):\n    return (compat_struct_pack('!BBBB', SOCKS5_VERSION, status, 0, atype)\n            + payload)\n\n\ndef test_socks5_connect_domainname(sock, monkeypatch):\n    \"\"\"ipaddr is None -> ATYP_DOMAINNAME request; server replies with a domain name.\"\"\"\n    sent, fake_recv = patch_io(\n        monkeypatch, sock,\n        socks5_response(Socks5Error.ERR_SUCCESS,\n                        Socks5AddressType.ATYP_DOMAINNAME,\n                        compat_struct_pack('!B', len(b'proxy.example'))\n                        + b'proxy.example'\n                        + compat_struct_pack('!H', 9090)),\n        ipaddr=None)\n\n    result = sock._setup_socks5(('example.com', 8080))\n\n    assert result == (b'proxy.example', 9090)\n    assert sent == [(\n        compat_struct_pack('!BBB', SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + compat_struct_pack('!B', Socks5AddressType.ATYP_DOMAINNAME)\n        + compat_struct_pack('!B', len(b'example.com')) + b'example.com'\n        + compat_struct_pack('!H', 8080))]\n    assert fake_recv.remaining == 0\n```\n\netc.\n\nWait, one thing: in the domainname test, the response's domain name \u2014 the code does `destaddr = self.recvall(alen)` \u2014 returns bytes. So result[0] == b'proxy.example'. Good.\n\nNow, about asserting the sent packet \u2014 this verifies the request construction (lines 223-231). Good postcondition.\n\nFor the IPv4 test:\n\n```pyth