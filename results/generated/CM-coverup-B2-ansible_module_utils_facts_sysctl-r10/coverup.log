def __init__(self, run_command_result=None, run_command_exc=None, bin_path='/sbin/sysctl'):\n        self._run_command_result = run_command_result\n        self._run_command_exc = run_command_exc\n        self._bin_path = bin_path\n        self.warnings = []\n        self.run_command_calls = []\n\n    def get_bin_path(self, name):\n        assert name == 'sysctl'\n        return self._bin_path\n\n    def run_command(self, cmd):\n        self.run_command_calls.append(list(cmd))\n        if self._run_command_exc is not None:\n            raise self._run_command_exc\n        return self._run_command_result\n\n    def warn(self, message):\n        self.warnings.append(message)\n\n\ndef test_get_sysctl_success():\n    out = 'kernel.hostname = host1\\nkernel.osrelease = 4.1\\n'\n    module = FakeModule(run_command_result=(0, out, ''))\n    result = get_sysctl(module, ['-a'])\n    assert result == {'kernel.hostname': 'host1', 'kernel.osrelease': '4.1'}\n    assert module.run_command_calls == [['/sbin/sysctl', '-a']]\n    assert module.warnings == []\n\n\ndef test_get_sysctl_blank_lines_skipped():\n    out = '\\n   \\nkernel.hostname = host1\\n\\n'\n    module = FakeModule(run_command_result=(0, out, ''))\n    result = get_sysctl(module, ['-a'])\n    assert result == {'kernel.hostname': 'host1'}\n    assert module.warnings == []\n\n\ndef test_get_sysctl_multiline_value():\n    out = 'kern.clockrate: hz 1000\\n\\ttick 1000\\n'\n    module = FakeModule(run_command_result=(0, out, ''))\n    result = get_sysctl(module, ['-a'])\n    assert result == {'kern.clockrate': 'hz 1000\\n\\ttick 1000'}\n    assert module.warnings == []\n\n\ndef test_get_sysctl_unsplittable_line_warns_and_continues():\n    out = 'kernel.a = 1\\nnot a splittable... wait\n```\n\nHold on \u2014 \"not a splittable\" \u2014 does it contain ': '? No. Does it contain '='? No. But wait, it contains spaces \u2014 the pattern is `\\s?=\\s?|: ` \u2014 requires '=' or ': '. \"not a splittable\" has no '=' and no ': '