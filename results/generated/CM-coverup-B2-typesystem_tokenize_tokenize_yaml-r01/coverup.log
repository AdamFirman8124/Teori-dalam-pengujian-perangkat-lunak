tent):\n    with pytest.raises(ParseError) as excinfo:\n        tokenize_yaml(content)\n    assert excinfo.value.text == \"No content.\"\n    assert excinfo.value.code == \"no_content\"\n    position = excinfo.value.position\n    assert position.line_no == 1\n    assert position.column_no == 1\n    assert position.char_index == 0\n\n\ndef test_tokenize_yaml_mapping():\n    content = \"a: 1\\nb: two\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    assert token.value == {\"a\": 1, \"b\": \"two\"}\n    assert token.string == content\n    assert token.start.char_index == 0\n\n    one = token.lookup([\"a\"])\n    assert isinstance(one, ScalarToken)\n    assert one.value == 1\n    assert one.string == \"1\"\n\n    two = token.lookup([\"b\"])\n    assert isinstance(two, ScalarToken)\n    assert two.value == \"two\"\n    assert two.string == \"two\"\n\n\ndef test_tokenize_yaml_sequence():\n    content = \"- 1\\n- two\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, ListToken)\n    assert token.value == [1, \"two\"]\n    assert token.string == content\n    assert token.start.char_index == 0\n\n    first = token.lookup([0])\n    assert isinstance(first, ScalarToken)\n    assert first.value == 1\n    assert first.string == \"1\"\n\n    second = token.lookup([1])\n    assert isinstance(second, ScalarToken)\n    assert second.value == \"two\"\n    assert second.string == \"two\"\n\n\ndef test_tokenize_yaml_nested_containers():\n    content = \"a: [1, 2]\\nb: {c: 3}\"\n    token = tokenize_yaml(content)\n    assert isinstance(token, DictToken)\n    assert token.value == {\"a\": [1, 2], \"b\": {\"c\": 3}}\n    assert token.string == content\n\n    sequence = token.lookup([\"a\"])\n    assert isinstance(sequence, ListToken)\n    assert sequence.string == \"[1, 2]\"\n    assert sequence.value == [1, 2]\n    assert token.lookup([\"a\", 0]).string == \"1\"\n    assert token.lookup([\"a\", 1]).string == \"2\"\n\n    mapping = token.