ct()) is le\n    assert (v > object()) is gt\n    assert (v >= object()) is ge\n\n\ndef test_rich_comparisons_with_real_versions():\n    low = StrictVersion(\"1.0\")\n    high = StrictVersion(\"2.0\")\n    assert (low == high) is False\n    assert (low < high) is True\n    assert (low <= high) is True\n    assert (low > high) is False\n    assert (low >= high) is False\n    assert (low == StrictVersion(\"1.0\")) is True\n    assert (low <= StrictVersion(\"1.0\")) is True\n    assert (low >= StrictVersion(\"1.0\")) is True\n```",
