ith GitHub handle \"felix-hilden\"? Actually I think the handle is \"felix-hilden\" for \"hilden\"? Not important.\n\nThe actual sty/primitive.py (v1.0.0):\n\n```python\nfrom typing import Callable, Dict, List, Type, Union\n\nfrom .rendertype import RenderType\n\n\nclass Style:\n    def __init__(self, value: str, rules: list) -> None:\n        self.rules = rules\n        self.value = value\n\n    def __str__(self) -> str:\n        return self.value\n\n    def __call__(self, *codes, override=False):\n        if override:\n            return \"\".join((str(x) for x in codes))\n        else:\n            return \"\".join((str(x) for x in codes)) + self.value\n\n\nclass Register:\n    def __init__(self, escape_code: str) -> None:\n        self.escape_code = escape_code\n        self.renderfuncs: Dict[Type[RenderType], Callable] = {}\n        self.is_muted = False\n        self.eightbit_call = lambda x: x\n        self.rgb_call = lambda x: x\n\n        self.style_names: List[str] = []\n        self.rules: List[Callable] = []\n\n    def __getattr__(self, name: str) -> Any:\n        if name in self.style_names:\n            return Style(self.escape_code, name)\n        raise AttributeError(f\"Register has no attribute '{name}'.\")\n\n    def __call__(self, *codes, override=False):\n        if override:\n            return \"\".join((str(x) for x in codes))\n        else:\n            return \"\".join((str(x) for x in codes)) + self.escape_code\n\n    def set_renderfunc(self, rendertype: Type[RenderType], func: Callable) -> None:\n        \"\"\"\n        With this method you can add or replace render-functions for a given register-object:\n\n        :param rendertype: The render func is used.\n        :param func: The new render function.\n        \"\"\"\n        # Save new render-func in register\n        self.renderfuncs.update({rendertype: func})\n\n        # Update style atributes and styles with the new renderfunc.\n        for attr_name in dir(self):\n            val 