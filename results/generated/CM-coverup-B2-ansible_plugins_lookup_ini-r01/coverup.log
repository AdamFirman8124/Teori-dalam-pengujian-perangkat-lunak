ms doesn't validate. OK.\n\nLet me now actually make the calls. Enough deliberation.\n\nOne more: I should double check `LookupBase` import path for the test \u2014 I don't need LookupBase directly. I need LookupModule and maybe _parse_params (not directly needed either, since run calls it). I'll import LookupModule and the module itself (for display patching).\n\nFinal script skeleton:\n\n```python\n\"\"\"Tests for ansible.plugins.lookup.ini LookupModule.run (lines 138-204).\"\"\"\n\nfrom unittest import mock\n\nimport pytest\n\nfrom ansible.errors import AnsibleLookupError, AnsibleOptionsError\nfrom ansible.plugins.lookup import ini as ini_lookup\nfrom ansible.plugins.lookup.ini import LookupModule\n\nBASE_OPTIONS = {\n    'file': 'test.ini',\n    'allow_no_value': False,\n    'allow_none': False,\n    'section': 'section1',\n    'key': None,\n    'default': None,\n    'case_sensitive': False,\n    'encoding': 'utf-8',\n    're': False,\n    'type': 'ini',\n}\n\n\ndef make_lookup(contents=b'', overrides=None):\n    lookup = LookupModule()\n\n    options = dict(BASE_OPTIONS)\n    if overrides:\n        options.update(overrides)\n\n    # Deterministic option handling (set_options/get_options need the plugin\n    # loader machinery, which is irrelevant for the code under test).\n    lookup.set_options = lambda var_options=None, direct=None: None\n    lookup.get_options = lambda: dict(options)\n\n    loader = mock.MagicMock(name='DataLoader')\n    loader._get_file_contents.return_value = (contents, False)\n    lookup._loader = loader\n\n    lookup.find_file_in_search_path = mock.MagicMock(return_value='/fake/test.ini')\n    return lookup\n\n\n@pytest.fixture(autouse=True)\ndef quiet_display(monkeypatch):\n    \"\"\"Silence deprecation warnings triggered by inline key=value terms.\"\"\"\n    monkeypatch.setattr(ini_lookup, 'display', mock.MagicMock(), raising=False)\n\n\ndef test_simple_lookup():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\nkey2=value2\\n')\n    assert lookup.run(['key1']) == ['value1']\n    lookup.find_file_in_search_path.assert_called_once_with(None, 'files', 'test.ini')\n    lookup._loader._get_file_contents.assert_called_once_with('/fake/test.ini')\n\n\ndef test_case_insensitive_lookup():\n    lookup = make_lookup(b'[section1]\\nKey=Value\\n')\n    assert lookup.run(['KEY']) == ['Value']\n\n\ndef test_case_sensitive_lookup():\n    lookup = make_lookup(b'[Sect]\\nKey=Value\\n', overrides={'case_sensitive': True, 'section': 'Sect'})\n    assert lookup.run(['Key']) == ['Value']\n    assert lookup.run(['key']) == []  # exact case required -> value is None\n\n\ndef test_properties_type():\n    lookup = make_lookup(b'key1=value1\\nkey2 = value2\\n', overrides={'type': 'properties'})\n    assert lookup.run(['key1']) == ['value1']\n\n\ndef test_default_value_used_when_key_missing():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n', overrides={'default': 'fallback'})\n    assert lookup.run(['missing']) == ['fallback']\n\n\ndef test_missing_key_without_default_returns_nothing():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    assert lookup.run(['missing']) == []\n\n\ndef test_regex_lookup_returns_all_matches():\n    lookup = make_lookup(b'[section1]\\nkey1=a\\nkey2=b\\nother=c\\n', overrides={'re': True})\n    assert sorted(lookup.run(['key'])) == ['a', 'b']\n\n\ndef test_regex_lookup_no_match_uses_default():\n    lookup = make_lookup(b'[section1]\\nother=c\\n', overrides={'re': True, 'default': 'fallback'})\n    assert lookup.run(['nomatch']) == ['fallback']\n\n\ndef test_inline_params():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    assert lookup.run(['key1 file=test.ini']) == ['value1']\n\n\ndef test_inline_params_only_first_key_is_used():\n    lookup = make_lookup(b'[section1]\\nkey1=first\\nkey2=second\\n')\n    assert lookup.run(['key1 key2 file=test.ini']) == ['first']\n\n\ndef test_inline_params_invalid_option_name():\n    lookup = make_lookup(b'[section1]\\nkey