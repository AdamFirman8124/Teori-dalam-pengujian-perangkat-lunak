  assert lookup.run(['key1']) == ['value1']\n    lookup.find_file_in_search_path.assert_called_once_with(None, 'files', 'test.ini')\n    lookup._loader._get_file_contents.assert_called_once_with('/fake/test.ini')\n\n\ndef test_case_insensitive_lookup():\n    lookup = make_lookup(b'[section1]\\nKey=Value\\n')\n    assert lookup.run(['KEY']) == ['Value']\n\n\ndef test_case_sensitive_lookup():\n    lookup = make_lookup(b'[Sect]\\nKey=Value\\n', overrides={'case_sensitive': True, 'section': 'Sect'})\n    assert lookup.run(['Key']) == ['Value']\n    assert lookup.run(['key']) == []  # exact case required -> value is None\n\n\ndef test_properties_type():\n    lookup = make_lookup(b'key1=value1\\nkey2 = value2\\n', overrides={'type': 'properties'})\n    assert lookup.run(['key1']) == ['value1']\n\n\ndef test_default_value_used_when_key_missing():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n', overrides={'default': 'fallback'})\n    assert lookup.run(['missing']) == ['fallback']\n\n\ndef test_missing_key_without_default_returns_nothing():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    assert lookup.run(['missing']) == []\n\n\ndef test_regex_lookup_returns_all_matches():\n    lookup = make_lookup(b'[section1]\\nkey1=a\\nkey2=b\\nother=c\\n', overrides={'re': True})\n    assert sorted(lookup.run(['key'])) == ['a', 'b']\n\n\ndef test_regex_lookup_no_match_uses_default():\n    lookup = make_lookup(b'[section1]\\nother=c\\n', overrides={'re': True, 'default': 'fallback'})\n    assert lookup.run(['nomatch']) == ['fallback']\n\n\ndef test_inline_params():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    assert lookup.run(['key1 file=test.ini']) == ['value1']\n\n\ndef test_inline_params_only_first_key_is_used():\n    lookup = make_lookup(b'[section1]\\nkey1=first\\nkey2=second\\n')\n    assert lookup.run(['key1 key2 file=test.ini']) == ['first']\n\n\ndef test_inline_params_invalid_option_name():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    with pytest.raises(AnsibleLookupError, match='bogus is not a valid option'):\n        lookup.run(['key1 bogus=x file=test.ini'])\n\n\ndef test_inline_params_unsplittable_value():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    with pytest.raises(AnsibleLookupError, match=\"Could not use 'file=a=b'\"):\n        lookup.run(['key1 file=a=b'])\n\n\ndef test_inline_params_without_key():\n    lookup = make_lookup(b'[section1]\\nkey1=value1\\n')\n    with pytest.raises(AnsibleOptionsError, match='No key to lookup'):\n        lookup.run(['file=test.ini'])\n\n\ndef test_duplicate_option_raises():\n    lookup = make_lookup(b'[section1]\\nkey1=a\\nkey1=b\\n')\n    with pytest.raises(AnsibleLookupError, match=\"Duplicate option in 'test.ini'\"):\n        lookup.run(['key1'])\n\n\ndef test_missing_section_raises():\n    lookup = make_lookup(b'[other]\\nkey1=value1\\n')\n    with pytest.raises(AnsibleLookupError, match=\"No section 'section1' in test.ini\"):\n        lookup.run(['key1'])\n```\n\nWait \u2014 test_case_sensitive_lookup calls run twice on the same lookup. Second run: cp is recreated in run() (line 141) \u2014 yes, `self.cp = configparser.ConfigParser(...)` each run. So no state leak. Good. But find_file_in_search_path called twice \u2014 fine, not asserting call counts there.\n\nHmm, in test_case_sensitive second call: key 'key' with case_sensitive \u2192 cp has 'Key' only \u2192 has_option('Sect','key') False \u2192 dvalue None \u2192 return None \u2192 ret []. Good \u2014 covers 198 False.\n\nBut wait \u2014 I need to double check get_value's non-regex path handles missing option by returning None rather than raising NoOptionError. If it raises NoOptionError, run() would propagate it (not caught) \u2192 test fails. I'll verify with get_info. If it raises, I'll adjust (e.g., use allow_no_value or drop that assertion). Actually, hmm, let me think about what the real code is. I'm now recalling more concretely from ansible-core ini.py:\