islurp(\"$PYTUTILS_ISLURP_DIR/expanded.txt\")) == [\"expanded content\\n\"]\n\n\ndef test_islurp_expansion_disabled(tmp_path, monkeypatch):\n    \"\"\"expanduser=False / expandvars=False leave the path untouched.\"\"\"\n    monkeypatch.chdir(tmp_path)\n    monkeypatch.setenv(\"PYTUTILS_SHOULD_NOT_EXPAND\", \"elsewhere\")\n\n    # Literal '~' directory and '$VAR' file that expansion would hijack.\n    os.makedirs(os.path.join(str(tmp_path), \"~\"))\n    with open(os.path.join(str(tmp_path), \"~\", \"inner.txt\"), \"w\") as fh:\n        fh.write(\"literal tilde\\n\")\n    with open(os.path.join(str(tmp_path), \"$PYTUTILS_SHOULD_NOT_EXPAND.txt\"), \"w\") as fh:\n        fh.write(\"literal dollar\\n\")\n\n    assert list(islurp(\"~/inner.txt\", expanduser=False, expandvars=False)) == [\"literal tilde\\n\"]\n    assert list(islurp(\"$PYTUTILS_SHOULD_NOT_EXPAND.txt\", expandvars=False)) == [\"literal dollar\\n\"]\n\n\ndef test_islurp_dash_with_allow_stdin_false_reads_literal_file(tmp_path, monkeypatch):\n    \"\"\"filename='-' but allow_stdin=False falls through to open('-') (short-circuit).\"\"\"\n    dash = tmp_path / \"-\"\n    dash.write_text(\"dash file content\\n\")\n    monkeypatch.chdir(tmp_path)\n\n    assert list(islurp(\"-\", allow_stdin=False)) == [\"dash file content\\n\"]\n\n\ndef test_islurp_stdin_selection(monkeypatch, tmp_path):\n    \"\"\"\n    filename='-' with allow_stdin=True selects sys.stdin (lines 28-29).\n\n    NOTE: the current implementation never assigns ``fh_next`` on the stdin\n    path, so the first ``next()`` raises NameError. This test documents that\n    behavior while executing the stdin-selection lines and the\n    ``fh != sys.stdin`` guard in the finally block (stdin is left open).\n    \"\"\"\n    fake_stdin = io.StringIO(\"stdin line 1\\nstdin line 2\\n\")\n    monkeypatch.setattr(sys, \"stdin\", fake_stdin)\n    monkeypatch.chdir(tmp_path)  # ensure no literal '-' file could be opened instead\n\n    gen = islurp(\"-\")\n    with pyt