est as of 2023). From GitHub feluxe/sty, `sty/primitive.py`:\n\n```python\n\"\"\"\nThis module contains the primitive types used by sty.\n\"\"\"\nimport re\nfrom typing import (\n    Callable,\n    Iterable,\n    Iterator,\n    List,\n    Literal,\n    NamedTuple,\n    Optional,\n    Sequence,\n    Set,\n    Tuple,\n    TypeVar,\n    Union,\n)\nfrom weakref import WeakSet\n\nT = TypeVar(\"T\")\n\n\ndef valid(value: object) -> bool:\n    return isinstance(value, int) and value >= 0\n\n\ndef valid_rgb(value: object) -> bool:\n    return valid(value) and value <= 255\n\n\nclass RenderingTarget:\n    def __init__(self, name: str, renderer: Callable[..., str]) -> None:\n        self.name = name\n        self.renderer = renderer\n\n\nclass BaseStyle:\n    _rendering_targets: WeakSet[RenderingTarget] = WeakSet()\n\n    def __init__(\n        self,\n        *rules: Union[int, str],\n        rendering_target_name: str = \"default\",\n    ) -> None:\n        self.rules = rules\n        self.rendering_target_name = rendering_target_name\n\n    def __str__(self) -> str:\n        return self.render()\n\n    def render(\n        self, *values: object, rendering_target_name: Optional[str] = None\n    ) -> str:\n        rendering_target_name = (\n            rendering_target_name or self.rendering_target_name\n        )\n        rendering_target = self.get_rendering_target(rendering_target_name)\n        rendered = rendering_target.renderer(*self.rules, *values)\n        return rendered\n\n    @classmethod\n    def register_rendering_target(cls, renderer: Callable[..., str]) -> None:\n        cls._rendering_targets.add(RenderingTarget(\"default\", renderer))\n\n    @classmethod\n    def get_rendering_target(cls, rendering_target_name: str) -> RenderingTarget:\n        for target in cls._rendering_targets:\n            if target.name == rendering_target_name:\n                return target\n        raise ValueError(f\"Unknown rendering target {rendering_target_name}\")\n\n\nclass Style(BaseStyle):\n    def __and__(self, other: \"Style\") -> \"Style\":\n        rules = self.rules + other.rules\n        return Style(*rules)\n\n    def __add__(self, other: object) -> str:\n        return self.render(str(other))\n\n    def __radd__(self, other: object) -> str:\n        return self.render(str(other))\n\n    def __call__(self, *values: object) -> str:\n        return self.render(*values)\n\n    def __iter__(self) -> Iterator[str]:\n        return iter(self.render())\n\n    def __getitem__(self, item: Any) -> str:\n        return self.render()[item]\n\n    def __len__(self) -> int:\n        return len(self.render())\n\n    def __repr__(self) -> str:\n        return f\"<Style(rules={self.rules})>\"\n\n\nclass Register:\n    def mute(self) -> None:\n        \"\"\"\n        Sometimes it is useful to disable the formatting for a register-object. You can\n        do so by invoking this method.\n        \"\"\"\n        self.is_muted = True\n\n        for attr_name in dir(self):\n            val = getattr(self, attr_name)\n            if isinstance(val, Style):\n                setattr(self, attr_name, val)\n```\n\nHmm wait, that mute implementation looks weird \u2014 `setattr(self, attr_name, val)` with the same val. Maybe in the real code it's different, like `setattr(self, attr_name, val.mute())`? But the user gave us the exact code, so I'll trust it. Actually, I recall in older sty versions (0.x), `Register.mute` did:\n\n```python\ndef mute(self) -> None:\n    self.is_muted = True\n    for attr_name in dir(self):\n        val = getattr(self, attr_name)\n        if isinstance(val, Style):\n            setattr(self, attr_name, val)\n```\n\nHmm, and how does muting actually take effect? In `Style.render`? There's a `Register` check... Actually I remember in sty 0.x, `mute` set `is_muted` and the `Style.__call__` checked `self.register.is_muted`? Not sure. Whatever \u2014 the given code is authoritative.\n\nGiven the code, the test just needs to call `mute(