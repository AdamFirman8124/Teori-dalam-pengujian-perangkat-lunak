est as of 2023). From GitHub feluxe/sty, `sty/primitive.py`:\n\n```python\n\"\"\"\nThis module contains the primitive types used by sty.\n\"\"\"\nimport re\nfrom typing import (\n    Callable,\n    Iterable,\n    Iterator,\n    List,\n    Literal,\n    NamedTuple,\n    Optional,\n    Sequence,\n    Set,\n    Tuple,\n    TypeVar,\n    Union,\n)\nfrom weakref import WeakSet\n\nT = TypeVar(\"T\")\n\n\ndef valid(value: object) -> bool:\n    return isinstance(value, int) and value >= 0\n\n\ndef valid_rgb(value: object) -> bool:\n    return valid(value) and value <= 255\n\n\nclass RenderingTarget:\n    def __init__(self, name: str, renderer: Callable[..., str]) -> None:\n        self.name = name\n        self.renderer = renderer\n\n\nclass BaseStyle:\n    _rendering_targets: WeakSet[RenderingTarget] = WeakSet()\n\n    def __init__(\n        self,\n        *rules: Union[int, str],\n        rendering_target_name: str = \"default\",\n    ) -> None:\n        self.rules = rules\n        self.rendering_target_name = rendering_target_name\n\n    def __str__(self) -> str:\n        return self.render()\n\n    def render(\n        self, *values: object, rendering_target_name: Optional[str] = None\n    ) -> str:\n        rendering_target_name = (\n            rendering_target_name or self.rendering_target_name\n        )\n        rendering_target = self.get_rendering_target(rendering_target_name)\n        rendered = rendering_target.renderer(*self.rules, *values)\n        return rendered\n\n    @classmethod\n    def register_rendering_target(cls, renderer: Callable[..., str]) -> None:\n        cls._rendering_targets.add(RenderingTarget(\"default\", renderer))\n\n    @classmethod\n    def get_rendering_target(cls, rendering_target_name: str) -> RenderingTarget:\n        for target in cls._rendering_targets:\n            if target.name == rendering_target_name:\n                return target\n        raise ValueError(f\"Unknown rendering target {rendering_target_name}\")\n\n\nclass Style(BaseStyle):\n    def __and__(self, other: \"Style\") -> \"Style\":\n        rules = self.rules + other.rules\n        return Style(*rules)\n\n    def __add__(self, other: object) -> str:\n        return self.render(str(other))\n\n    def __radd__(self, other: object) -> str:\n        return self.render(str(other))\n\n    def __call__(self, *values: object) -> str:\n        return self.render(*values)\n\n    def __iter__(self) -> Iterator[str]:\n        return iter(self.render())\n\n    def __getitem__(self, item: Any) -> str:\n        return self.render()[item]\n\n    def __len__(self) -> int:\n        return len(self.render())\n\n    def __repr__(self) -> str:\n        return f\"<Style(rules={self.rules})>\"\n\n\nclass Register:\n    def mute(self) -> None:\n        \"\"\"\n        Sometimes it is useful to disable the formatting for a register-object. You can\n        do so by invoking this method.\n        \"\"\"\n        self.is_muted = True\n\n        for attr_name in dir(self):\n            val = getattr(self, attr_name)\n            if isinstance(val, Style):\n                setattr(self, attr_name, val)\n```\n\nHmm wait, that mute implementation looks weird \u2014 `setattr(self, attr_name, val)` with the same val. Maybe in the real code it's different, like `setattr(self, attr_name, val.mute())`? But the user gave us the exact code, so I'll trust it. Actually, I recall in older sty versions (0.x), `Register.mute` did:\n\n```python\ndef mute(self) -> None:\n    self.is_muted = True\n    for attr_name in dir(self):\n        val = getattr(self, attr_name)\n        if isinstance(val, Style):\n            setattr(self, attr_name, val)\n```\n\nHmm, and how does muting actually take effect? In `Style.render`? There's a `Register` check... Actually I remember in sty 0.x, `mute` set `is_muted` and the `Style.__call__` checked `self.register.is_muted`? Not sure. Whatever \u2014 the given code is authoritative.\n\nGiven the code, the test just needs to call `mute()` on an object with at least one Style attribute.\n\nNow, about `get_info`: The instructions say \"Use the get_info tool function as necessary.\" I should call it to confirm the API of `Register` and `Style` \u2014 e.g., constructor signature of `Style`, existence of `Register.mute`. Let me call:\n\n- `get_info(\"Register\")`\n- `get_info(\"Style\")`\n- `get_info(\"Register.mute\")`\n\nThese are independent, so per instructions, make all independent calls in the same block.\n\nThen possibly follow-ups depending on results (e.g., if `Style.__init__` signature differs). Let me do that first.\n\nAfter getting info, write the final test file.\n\nTest file draft:\n\n```python\n\"\"\"Tests for sty.primitive.Register.mute (lines 163-168).\"\"\"\n\nimport pytest\n\nfrom sty.primitive import Register, Style\n\n\nclass DemoRegister(Register):\n    \"\"\"Minimal register with a mix of Style and non-Style attributes.\"\"\"\n\n    FG_BLUE = Style(34)\n    EFFECT = Style(1, 22)\n    LABEL = \"not-a-style\"\n    COUNT = 42\n\n\n@pytest.fixture()\ndef demo_register():\n    \"\"\"Fresh register instance per test; nothing global is touched.\"\"\"\n    return DemoRegister()\n\n\ndef test_mute_sets_is_muted(demo_register):\n    reg = demo_register\n\n    # Precondition: the register is not muted yet.\n    assert not getattr(reg, \"is_muted\", False)\n\n    result = reg.mute()\n\n    # Line 163 executed: the flag is now set, and mute() returns None.\n    assert reg.is_muted is True\n    assert result is None\n\n\ndef test_mute_rebinds_style_attributes(demo_register):\n    reg = demo_register\n\n    reg.mute()\n\n    # Lines 165-168 executed: each Style attribute was visited and re-set.\n    # The re-binding keeps the very same Style objects reachable.\n    assert reg.FG_BLUE is DemoRegister.FG_BLUE\n    assert reg.EFFECT is DemoRegister.EFFECT\n    assert isinstance(reg.FG_BLUE, Style)\n    assert isinstance(reg.EFFECT, Style)\n\n    # Attributes that are not Style instances take the false branch of\n    # line 167 and are left completely untouched.\n    assert reg.LABEL == \"not-a-style\"\n    assert reg.COUNT == 42\n\n\ndef test_mute_covers_true_and_false_branches(demo_register):\n    reg = demo_register\n    reg.mute()\n\n    style_names = [\n        name\n        for name in dir(reg)\n        if isinstance(getattr(reg, name), Style)\n    ]\n    non_style_names = [\n        name\n        for name in dir(reg)\n        if not name.startswith(\"__\")\n        and not callable(getattr(reg, name))\n        and not isinstance(getattr(reg, name), Style)\n    ]\n\n    # Both outcomes of the isinstance branch were exercised during mute().\n    assert \"FG_BLUE\" in style_names\n    assert \"EFFECT\" in style_names\n    assert \"LABEL\" in non_style_names\n```\n\nHmm, third test is somewhat redundant. Maybe merge. Also consider testing mute on a bare `Register()` instance (no Style attrs) \u2014 covers lines 163-167 but not 168; combined with the above, everything covered. Could add:\n\n```python\ndef test_mute_on_plain_register_without_styles():\n    reg = Register()\n    reg.mute()\n    assert reg.is_muted is True\n```\n\nThis exercises the loop with zero Style matches (only false branch). Combined with DemoRegister test (true branch), full branch coverage. Nice.\n\nAlso, should I test with a real sty register (like `sty.ef`) using monkeypatch for cleanup? It demonstrates integration and uses monkeypatch as suggested. Let me include it carefully:\n\n```python\ndef test_mute_on_library_register(monkeypatch):\n    \"\"\"Muting a real register (sty.ef) also works; state is restored after.\"\"\"\n    from sty import ef\n\n    # Remember which attributes existed on the instance before the test.\n    original_instance_attrs = dict(vars(ef))\n\n    # monkeypatch removes 'is_muted' again on teardown (it did not exist before).\n    monkeypatch.setattr(ef, \"is_muted\", False, raising=False)\n\n    ef.mute()\n\n    assert ef.is_muted is True\n    # The effects 