.open\n    opened = []\n\n    def tracking_open(file, mode='r', *args, **kwargs):\n        fh = real_open(file, mode, *args, **kwargs)\n        opened.append(fh)\n        return fh\n\n    monkeypatch.setattr(builtins, 'open', tracking_open)\n    return opened\n\n\ndef test_islurp_default_reads_lines_and_closes_file(tmp_path, monkeypatch):\n    opened = _track_open(monkeypatch)\n    path = tmp_path / 'f.txt'\n    path.write_text('line1\\nline2\\n')\n\n    assert list(islurp(str(path))) == ['line1\\n', 'line2\\n']\n    assert len(opened) == 1\n    assert opened[0].closed\n\n\ndef test_islurp_accepts_linemode_sentinel_as_string(tmp_path):\n    path = tmp_path / 'f.txt'\n    path.write_text('a\\nb\\n')\n\n    # Passing the literal string 'LINEMODE' must be translated into the\n    # LINEMODE sentinel, i.e. iteration must happen by line.\n    assert list(islurp(str(path), iter_by='LINEMODE')) == ['a\\n', 'b\\n']\n\n\ndef test_islurp_iterates_by_chunks(tmp_path):\n    path = tmp_path / 'f.txt'\n    path.write_text('abcdefgh')\n\n    assert list(islurp(str(path), iter_by=3)) == ['abc', 'def', 'gh']\n\n\ndef test_islurp_empty_file_yields_nothing(tmp_path):\n    path = tmp_path / 'empty.txt'\n    path.write_text('')\n\n    assert list(islurp(str(path))) == []\n\n\ndef test_islurp_reads_stdin_and_leaves_it_open(monkeypatch):\n    fake_stdin = io.StringIO('from stdin\\n')\n    monkeypatch.setattr(sys, 'stdin', fake_stdin)\n\n    assert list(islurp('-')) == ['from stdin\\n']\n    # sys.stdin must not be closed by islurp.\n    assert not fake_stdin.closed\n```\n\n(if stdin works)\n\n```python\ndef test_islurp_dash_without_allow_stdin_tries_to_open_file(tmp_path, monkeypatch):\n    monkeypatch.chdir(tmp_path)\n\n    with pytest.raises(FileNotFoundError):\n        list(islurp('-', allow_stdin=False))\n```\n\nHmm wait \u2014 one issue: if the stdin branch is broken (UnboundLocalError), then `list(islurp('-'))` raises UnboundLocalError, and my test asserting `== ['from stdin\\n']` f