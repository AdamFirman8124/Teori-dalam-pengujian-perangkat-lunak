nal test file will look like in full, so I can adapt quickly.\n\nFull draft (scenario A \u2014 stdin works):\n\n```python\nimport builtins\nimport io\nimport os\nimport sys\n\nimport pytest\n\nfrom pytutils.files import islurp\n\n\ndef _track_open(monkeypatch):\n    real_open = builtins.open\n    opened = []\n\n    def tracking_open(file, mode='r', *args, **kwargs):\n        fh = real_open(file, mode, *args, **kwargs)\n        opened.append(fh)\n        return fh\n\n    monkeypatch.setattr(builtins, 'open', tracking_open)\n    return opened\n\n\ndef test_islurp_reads_lines_and_closes_file(tmp_path, monkeypatch):\n    opened = _track_open(monkeypatch)\n    path = tmp_path / 'lines.txt'\n    path.write_text('line1\\nline2\\n')\n\n    assert list(islurp(str(path))) == ['line1\\n', 'line2\\n']\n    assert len(opened) == 1\n    assert opened[0].closed\n\n\ndef test_islurp_accepts_linemode_string(tmp_path):\n    path = tmp_path / 'lines.txt'\n    path.write_text('a\\nb\\n')\n\n    assert list(islurp(str(path), iter_by='LINEMODE')) == ['a\\n', 'b\\n']\n\n\ndef test_islurp_reads_by_chunks(tmp_path):\n    path = tmp_path / 'chunks.txt'\n    path.write_text('abcdefgh')\n\n    assert list(islurp(str(path), iter_by=3)) == ['abc', 'def', 'gh']\n\n\ndef test_islurp_empty_file_yields_nothing(tmp_path):\n    path = tmp_path / 'empty.txt'\n    path.write_text('')\n\n    assert list(islurp(str(path))) == []\n\n\ndef test_islurp_reads_stdin_without_closing_it(monkeypatch):\n    fake_stdin = io.StringIO('from stdin\\n')\n    monkeypatch.setattr(sys, 'stdin', fake_stdin)\n\n    assert list(islurp('-')) == ['from stdin\\n']\n    assert not fake_stdin.closed\n\n\ndef test_islurp_dash_without_stdin_permission_opens_literal_path(tmp_path, monkeypatch):\n    monkeypatch.chdir(tmp_path)\n\n    with pytest.raises(FileNotFoundError):\n        list(islurp('-', allow_stdin=False))\n\n\ndef test_islurp_expands_user(tmp_path, monkeypatch):\n    path = tmp_path / 'home.txt'\n    path.write_text('hom