/ 'plain.txt'\n    path.write_text('plain\\n')\n    assert list(islurp(str(path), expanduser=False, expandvars=False)) == ['plain\\n']\n    assert calls == []\n```\n\nNeed to import functools in the test file, or use closures. I'll use simple defs.\n\nTest 9 \u2014 expansion enabled (both called):\n\n```python\ndef test_islurp_expansion_enabled(tmp_path, monkeypatch):\n    calls = []\n    def fake_expanduser(p):\n        calls.append('expanduser')\n        return p\n    def fake_expandvars(p):\n        calls.append('expandvars')\n        return p\n    monkeypatch.setattr(os.path, 'expanduser', fake_expanduser)\n    monkeypatch.setattr(os.path, 'expandvars', fake_expandvars)\n    path = tmp_path / 'plain.txt'\n    path.write_text('plain\\n')\n    assert list(islurp(str(path))) == ['plain\\n']\n    assert calls == ['expanduser', 'expandvars']\n```\n\nTest 10 \u2014 file closed after consumption:\n\n```python\ndef test_islurp_closes_opened_file(tmp_path, monkeypatch):\n    real_open = builtins.open\n    opened = []\n\n    def tracking_open(file, mode='r', *args, **kwargs):\n        fh = real_open(file, mode, *args, **kwargs)\n        opened.append(fh)\n        return fh\n\n    monkeypatch.setattr(builtins, 'open', tracking_open)\n    path = tmp_path / 'f.txt'\n    path.write_text('data\\n')\n    assert list(islurp(str(path))) == ['data\\n']\n    assert len(opened) == 1\n    assert opened[0].closed\n```\n\nTest 11 \u2014 early close:\n\n```python\ndef test_islurp_close_on_early_exit(tmp_path, monkeypatch):\n    real_open = builtins.open\n    opened = []\n    def tracking_open(file, mode='r', *args, **kwargs):\n        fh = real_open(file, mode, *args, **kwargs)\n        opened.append(fh)\n        return fh\n    monkeypatch.setattr(builtins, 'open', tracking_open)\n    path = tmp_path / 'f.txt'\n    path.write_text('l1\\nl2\\n')\n    gen = islurp(str(path))\n    assert next(gen) == 'l1\\n'\n    gen.close()\n    assert opened and opened[0].closed\n```\n\nTest 12 \u2014 st