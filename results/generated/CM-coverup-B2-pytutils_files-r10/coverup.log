        "content": "```python\nimport io\nimport sys\n\nimport pytest\n\nfrom pytutils.files import islurp, LINEMODE\n\n\ndef test_islurp_lines_default(tmp_path):\n    \"\"\"Default LINEMODE iteration yields lines and closes the file at EOF.\"\"\"\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"a\\nb\\nc\\n\")\n    assert list(islurp(str(p))) == [\"a\\n\", \"b\\n\", \"c\\n\"]\n\n\ndef test_islurp_string_linemode_sentinel(tmp_path):\n    \"\"\"iter_by='LINEMODE' (string sentinel) is converted to LINEMODE.\"\"\"\n    assert LINEMODE == 0\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"x\\ny\\n\")\n    assert list(islurp(str(p), iter_by='LINEMODE')) == [\"x\\n\", \"y\\n\"]\n\n\ndef test_islurp_iter_by_bytes(tmp_path):\n    \"\"\"iter_by=N reads fixed-size chunks instead of lines.\"\"\"\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"abcdef\")\n    assert list(islurp(str(p), iter_by=2)) == [\"ab\", \"cd\", \"ef\"]\n\n\ndef test_islurp_binary_mode(tmp_path):\n    \"\"\"Binary mode with chunked iteration works.\"\"\"\n    p = tmp_path / \"f.bin\"\n    p.write_bytes(b\"\\x00\\x01\\x02\\x03\")\n    assert list(islurp(str(p), mode='rb', iter_by=2)) == [b\"\\x00\\x01\", b\"\\x02\\x03\"]\n\n\ndef test_islurp_reads_stdin(monkeypatch):\n    \"\"\"filename='-' with allow_stdin=True reads sys.stdin and does not close it.\"\"\"\n    fake_stdin = io.StringIO(\"line1\\nline2\\n\")\n    monkeypatch.setattr(sys, \"stdin\", fake_stdin)\n    assert list(islurp(\"-\")) == [\"line1\\n\", \"line2\\n\"]\n    # Postcondition: stdin must NOT be closed by the finally block.\n    assert not fake_stdin.closed\n\n\ndef test_islurp_stdin_disallowed(tmp_path):\n    \"\"\"allow_stdin=False makes '-' be treated as a literal filename.\"\"\"\n    p = tmp_path / \"-\"\n    p.write_text(\"dash\\n\")\n    assert list(islurp(str(p), allow_stdin=False)) == [\"dash\\n\"]\n\n\ndef test_islurp_no_expansion(tmp_path, monkeypatch):\n    \"\"\"expanduser=False and expandvars=False leave the filename literal.\"\"\"\n    monkeypatch.setenv(\"ISLURP_TEST_VAR\", \"ignored\")\n    name = \"f~oo$ISLURP_TEST_VAR\"\n    p = tmp_path / name\n    p.write_text(\"literal\\n\")\n    assert list(islurp(str(p), expanduser=False, expandvars=False)) == [\"literal\\n\"]\n\n\ndef test_islurp_expandvars(tmp_path, monkeypatch):\n    \"\"\"expandvars=True expands environment variables in the filename.\"\"\"\n    monkeypatch.setenv(\"ISLURP_TEST_VAR\", \"sub\")\n    target = tmp_path / \"sub\"\n    target.write_text(\"expanded\\n\")\n    assert list(islurp(str(tmp_path / \"$ISLURP_TEST_VAR\"))) == [\"expanded\\n\"]\n\n\ndef test_islurp_expanduser(tmp_path, monkeypatch):\n    \"\"\"expanduser=True expands a leading '~' to the home directory.\"\"\"\n    monkeypatch.setenv(\"HOME\", str(tmp_path))\n    monkeypatch.setenv(\"USERPROFILE\", str(tmp_path))\n    target = tmp_path / \"exp.txt\"\n    target.write_text(\"home\\n\")\n    assert list(islurp(\"~/exp.txt\")) == [\"home\\n\"]\n\n\ndef test_islurp_closes_file_on_exit(tmp_path, monkeypatch):\n    \"\"\"The finally block closes the opened file handle (not stdin).\"\"\"\n    p = tmp_path / \"f.txt\"\n    p.write_text(\"data\\n\")\n    real_open = open\n    opened = []\n\n    def tracking_open(*args, **kwargs):\n        fh = real_open(*args, **kwargs)\n        opened.append(fh)\n        return fh\n\n    monkeypatch.setattr(\"builtins.open\", tracking_open)\n\n    gen = islurp(str(p))\n    assert next(gen) == \"data\\n\"\n    gen.close()  # triggers the finally clause\n\n    # Postcondition: the handle islurp opened has been closed.\n    assert len(opened) == 1\n    assert opened[0].closed\n```",
