t YoutubeDL\nfrom youtube_dl.downloader import hls as hls_mod\nfrom youtube_dl.downloader.hls import HlsFD\nfrom youtube_dl.compat import compat_urllib_error, compat_struct_pack\n\n\nclass FakeResponse(object):\n    def __init__(self, url, data):\n        self._url = url\n        self._data = data\n\n    def geturl(self):\n        return self._url\n\n    def read(self):\n        return self._data\n\n\ndef make_hls(ydl, manifest, responses=None):\n    \"\"\"Create an HlsFD with urlopen patched to serve the manifest.\"\"\"\n    responses = dict(responses or {})\n\n    def fake_urlopen(url):\n        if url in responses:\n            data = responses[url]\n        else:\n            data = manifest\n        if isinstance(data, Exception):\n            raise data\n        return FakeResponse(url, data)\n\n    ydl.urlopen = fake_urlopen\n    return HlsFD(ydl, ydl.params)\n\n\ndef patch_fragment_methods(dl, fragments, fragment_index=0):\n    \"\"\"Patch out the FragmentFD machinery, recording calls.\"\"\"\n    calls = {'start': [], 'download': [], 'append': [], 'finish': 0}\n\n    def fake_prepare_and_start(ctx):\n        ctx['fragment_index'] = fragment_index\n        calls['start'].append(ctx)\n\n    def fake_download(ctx, url, info_dict, headers):\n        calls['download'].append((url, headers))\n        item = fragments.pop(0) if fragments else (True, b'')\n        if isinstance(item, Exception):\n            raise item\n        return item\n\n    def fake_append(ctx, content):\n        calls['append'].append(content)\n\n    def fake_finish(ctx):\n        calls['finish'] += 1\n\n    dl._prepare_and_start_frag_download = fake_prepare_and_start\n    dl._download_fragment = fake_download\n    dl._append_fragment = fake_append\n    dl._finish_frag_download = fake_finish\n    return calls\n```\n\nHmm wait, but monkeypatching instance attributes directly - since the instance is created inside the test and discarded, no pollution. But the instructions say to use monkeypatch