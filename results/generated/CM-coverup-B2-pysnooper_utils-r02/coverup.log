        "content": "```python\nimport inspect\nimport re\n\nimport pytest\n\nimport pysnooper.utils as utils_module\n\n\ndef _direct_normalize_repr():\n    return getattr(utils_module, \"normalize_repr\", None)\n\n\ndef _collect_outer_candidates():\n    candidates = []\n    for name in dir(utils_module):\n        try:\n            obj = getattr(utils_module, name)\n        except Exception:\n            continue\n        if inspect.isfunction(obj):\n            try:\n                src = inspect.getsource(obj)\n            except Exception:\n                continue\n            if \"normalize_repr\" in src or \"DEFAULT_REPR_RE\" in src:\n                candidates.append((name, obj))\n        elif inspect.isclass(obj):\n            for meth_name, meth in inspect.getmembers(obj, predicate=inspect.isfunction):\n                try:\n                    src = inspect.getsource(meth)\n                except Exception:\n                    continue\n                if \"normalize_repr\" in src or \"DEFAULT_REPR_RE\" in src:\n                    candidates.append((f\"{name}.{meth_name}\", meth))\n    return candidates\n\n\ndef _try_call_outer(func, arg):\n    # Try common single-arg call, then common (item, max_length) style calls.\n    try:\n        return (True, func(arg))\n    except TypeError:\n        pass\n    except Exception:\n        return (False, None)\n    for extra in (100, 1000, True, False, None):\n        try:\n            return (True, func(arg, extra))\n        except TypeError:\n            continue\n        except Exception:\n            return (False, None)\n    try:\n        sig = inspect.signature(func)\n        params = list(sig.parameters.values())\n        # Build dummy args: first param gets `arg`, rest get defaults or generics.\n        if len(params) >= 1:\n            args = [arg]\n            for p in params[1:]:\n                if p.default is not inspect.Parameter.empty:\n                    args.append(p.default)\n                elif 