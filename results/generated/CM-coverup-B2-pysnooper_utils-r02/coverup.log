urn ``NotImplemented`` when a requested method is explicitly set to\n  ``None`` somewhere in the MRO;\n* return ``NotImplemented`` when a requested method is missing from every\n  class in the MRO.\n\nAll classes used below are created inside the test functions, so no global\nstate is created or left behind (no monkeypatching is required because the\nfunction under test is pure).\n\"\"\"\n\nimport abc\n\nfrom pysnooper.utils import _check_methods\n\n\ndef test_all_methods_defined_directly_returns_true():\n    class Base:\n        def foo(self):\n            return 'foo'\n\n        def bar(self):\n            return 'bar'\n\n    class Derived(Base):\n        pass\n\n    result = _check_methods(Derived, 'foo', 'bar')\n    assert result is True\n\n\ndef test_method_found_in_base_class_returns_true():\n    class Base:\n        def foo(self):\n            return 'foo'\n\n    class Derived(Base):\n        pass\n\n    result = _check_methods(Derived, 'foo')\n    assert result is True\n\n\ndef test_method_in_subclass_shadows_base_returns_true():\n    class Base:\n        def foo(self):\n            return 'base'\n\n    class Derived(Base):\n        def foo(self):\n            return 'derived'\n\n    result = _check_methods(Derived, 'foo')\n    assert result is True\n\n\ndef test_method_is_none_on_class_itself_returns_not_implemented():\n    class C:\n        foo = None\n\n    result = _check_methods(C, 'foo')\n    assert result is NotImplemented\n\n\ndef test_method_is_none_in_base_class_returns_not_implemented():\n    class Base:\n        foo = None\n\n    class Derived(Base):\n        pass\n\n    result = _check_methods(Derived, 'foo')\n    assert result is NotImplemented\n\n\ndef test_missing_method_returns_not_implemented():\n    class Base:\n        def foo(self):\n            return 'foo'\n\n    class Derived(Base):\n        pass\n\n    result = _check_methods(Derived, 'foo', 'does_not_exist')\n    assert result is NotImplemented\n\n\ndef test_later_method_is_none_ret