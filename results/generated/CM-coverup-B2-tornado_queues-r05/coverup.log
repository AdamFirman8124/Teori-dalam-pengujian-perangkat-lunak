eout\" in type(e).__name__\n        assert fut.done()\n        # expired getter is consumed\n        assert len(q._getters) == 0\n\n    IOLoop.current().run_sync(main)\n\n\ndef test_get_with_absolute_deadline_timeout_expires():\n    async def main():\n        q = Queue()\n        deadline = IOLoop.current().time() + 0.01\n        fut = q.get(timeout=deadline)\n        assert not fut.done()\n        assert len(q._getters) == 1\n        try:\n            await fut\n            assert False, \"expected TimeoutError\"\n        except Exception as e:\n            assert \"Timeout\" in type(e).__name__\n        assert len(q._getters) == 0\n\n    IOLoop.current().run_sync(main)\n\n\ndef test_get_with_timeout_resolved_before_expiry():\n    async def main():\n        q = Queue()\n        fut = q.get(timeout=datetime.timedelta(seconds=10))\n        assert not fut.done()\n        assert len(q._getters) == 1\n        await q.put(\"early\")\n        result = await fut\n        assert result == \"early\"\n        assert len(q._getters) == 0\n\n    IOLoop.current().run_sync(main)\n```",
