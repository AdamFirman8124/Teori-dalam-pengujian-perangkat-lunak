        "content": "```python\nimport pytest\n\nfrom typesystem.fields import Array, Object, String\nfrom typesystem.schemas import SchemaDefinitions, set_definitions\nfrom typesystem.fields import Reference\n\n\ndef test_set_definitions_reference_with_none_definitions():\n    definitions = SchemaDefinitions()\n    ref = Reference(to=\"MySchema\")\n    assert ref.definitions is None\n\n    set_definitions(ref, definitions)\n\n    assert ref.definitions is definitions\n\n\ndef test_set_definitions_reference_with_existing_definitions():\n    existing = SchemaDefinitions()\n    new_definitions = SchemaDefinitions()\n    ref = Reference(to=\"MySchema\", definitions=existing)\n    assert ref.definitions is existing\n\n    set_definitions(ref, new_definitions)\n\n    # Existing definitions must not be overwritten.\n    assert ref.definitions is existing\n\n\ndef test_set_definitions_array_with_list_items():\n    definitions = SchemaDefinitions()\n    ref1 = Reference(to=\"A\")\n    ref2 = Reference(to=\"B\")\n    array = Array(items=[ref1, ref2])\n\n    set_definitions(array, definitions)\n\n    assert ref1.definitions is definitions\n    assert ref2.definitions is definitions\n\n\ndef test_set_definitions_array_with_single_field_item():\n    definitions = SchemaDefinitions()\n    ref = Reference(to=\"A\")\n    array = Array(items=ref)\n\n    set_definitions(array, definitions)\n\n    assert ref.definitions is definitions\n\n\ndef test_set_definitions_array_with_no_items():\n    definitions = SchemaDefinitions()\n    array = Array(items=None)\n\n    # Must not raise; nothing to recurse into.\n    set_definitions(array, definitions)\n\n\ndef test_set_definitions_object_properties():\n    definitions = SchemaDefinitions()\n    ref1 = Reference(to=\"A\")\n    ref2 = Reference(to=\"B\")\n    obj = Object(properties={\"a\": ref1, \"b\": ref2})\n\n    set_definitions(obj, definitions)\n\n    assert ref1.definitions is definitions\n    assert ref2.definitions is definitions\n\n\ndef test_set_definitions_nested_structure():\n    definitions = SchemaDefinitions()\n    inner_ref = Reference(to=\"Inner\")\n    inner_array = Array(items=inner_ref)\n    list_ref = Reference(to=\"List\")\n    outer_array = Array(items=[inner_array, list_ref])\n    obj_ref = Reference(to=\"Obj\")\n    obj = Object(properties={\"outer\": outer_array, \"direct\": obj_ref})\n\n    set_definitions(obj, definitions)\n\n    assert inner_ref.definitions is definitions\n    assert list_ref.definitions is definitions\n    assert obj_ref.definitions is definitions\n\n\ndef test_set_definitions_non_reference_scalar_field_untouched():\n    definitions = SchemaDefinitions()\n    scalar = String()\n\n    # Must not raise on a plain field.\n    set_definitions(scalar, definitions)\n\n    assert not hasattr(scalar, \"definitions\") or scalar.definitions is None\n```",
