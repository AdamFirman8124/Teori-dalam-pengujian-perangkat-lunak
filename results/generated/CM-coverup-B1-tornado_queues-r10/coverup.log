        "content": "```python\nimport asyncio\n\nimport pytest\n\nfrom tornado.queues import Queue, QueueFull\n\n\ndef test_put_nowait_else_branch_stores_item():\n    q = Queue(maxsize=2)\n    try:\n        assert q.empty()\n        assert not q.full()\n        assert len(q._getters) == 0\n\n        q.put_nowait(\"a\")\n\n        assert q.qsize() == 1\n        assert not q.empty()\n        assert q.get_nowait() == \"a\"\n        assert q.empty()\n    finally:\n        while not q.empty():\n            q.get_nowait()\n            q.task_done()\n        if q._unfinished_tasks:\n            q.task_done()\n    assert q._unfinished_tasks == 0\n\n\ndef test_put_nowait_unbounded_else_branch_stores_multiple_items():\n    q = Queue()\n    try:\n        q.put_nowait(1)\n        q.put_nowait(2)\n\n        assert q.qsize() == 2\n        assert q.get_nowait() == 1\n        q.task_done()\n        assert q.get_nowait() == 2\n        q.task_done()\n    finally:\n        while not q.empty():\n            q.get_nowait()\n            q.task_done()\n    assert q._unfinished_tasks == 0\n\n\ndef test_put_nowait_full_branch_raises_queue_full():\n    q = Queue(maxsize=1)\n    try:\n        q.put_nowait(\"first\")\n        assert q.full()\n        assert q.qsize() == 1\n\n        with pytest.raises(QueueFull):\n            q.put_nowait(\"second\")\n\n        assert q.qsize() == 1\n        assert q.get_nowait() == \"first\"\n        q.task_done()\n    finally:\n        while not q.empty():\n            q.get_nowait()\n            q.task_done()\n    assert q._unfinished_tasks == 0\n\n\ndef test_put_nowait_with_waiting_getter_hands_off_item():\n    async def main():\n        q = Queue()\n        getter = q.get()\n        try:\n            assert not getter.done()\n            assert len(q._getters) == 1\n            assert q.empty()\n\n            q.put_nowait(\"hello\")\n\n            assert len(q._getters) == 0\n            assert getter.done()\n            assert not getter.cancelled()\n            assert getter.result() == \"hello\"\n            # Item was passed directly to the getter via _get().\n            assert q.empty()\n            assert q.qsize() == 0\n            assert q._unfinished_tasks == 1\n\n            q.task_done()\n            assert q._unfinished_tasks == 0\n        finally:\n            if not getter.done():\n                getter.cancel()\n            while q._getters:\n                pending = q._getters.popleft()\n                if not pending.done():\n                    pending.cancel()\n            while not q.empty():\n                q.get_nowait()\n                q.task_done()\n\n    asyncio.run(main())\n\n\ndef test_put_nowait_with_multiple_waiting_getters_fifo():\n    async def main():\n        q = Queue()\n        getter1 = q.get()\n        getter2 = q.get()\n        try:\n            assert len(q._getters) == 2\n\n            q.put_nowait(1)\n            assert getter1.done()\n            assert getter1.result() == 1\n            assert not getter2.done()\n            assert len(q._getters) == 1\n            assert q.empty()\n\n            q.put_nowait(2)\n            assert getter2.done()\n            assert getter2.result() == 2\n            assert len(q._getters) == 0\n            assert q.empty()\n            assert q._unfinished_tasks == 2\n\n            q.task_done()\n            q.task_done()\n            assert q._unfinished_tasks == 0\n        finally:\n            for getter in (getter1, getter2):\n                if not getter.done():\n                    getter.cancel()\n            while q._getters:\n                pending = q._getters.popleft()\n                if not pending.done():\n                    pending.cancel()\n            while not q.empty():\n                q.get_nowait()\n                q.task_done()\n\n    asyncio.run(main())\n\n\ndef test_put_nowait_consumes_expired_cancelled_getter_and_stores_item():\n    async def main():\n        q = Queue()\n        getter = q.get()\n        try:\n            assert len(q._getters) == 1\n            getter.cancel()\n            assert getter.done()\n\n            # _consume_expired() removes the cancelled getter, so\n            # put_nowait takes the else branch and stores the item.\n            q.put_nowait(\"stored\")\n\n            assert len(q._getters) == 0\n            assert getter.cancelled()\n            assert q.qsize() == 1\n            assert q.get_nowait() == \"stored\"\n            q.task_done()\n            assert q._unfinished_tasks == 0\n        finally:\n            if not getter.done():\n                getter.cancel()\n            while q._getters:\n                pending = q._getters.popleft()\n                if not pending.done():\n                    pending.cancel()\n            while not q.empty():\n                q.get_nowait()\n                q.task_done()\n\n    asyncio.run(main())\n```",
