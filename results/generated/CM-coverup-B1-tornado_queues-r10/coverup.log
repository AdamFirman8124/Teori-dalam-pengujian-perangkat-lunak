        "content": "```python\nimport pytest\nfrom tornado.ioloop import IOLoop\nfrom tornado.queues import Queue\n\ntry:\n    from tornado.queues import QueueEmpty\nexcept ImportError:\n    from queue import Empty as QueueEmpty\n\n\ndef test_get_nowait_returns_available_item_no_putters():\n    q = Queue()\n    q.put_nowait(42)\n    assert q.qsize() == 1\n    assert len(q._putters) == 0\n    result = q.get_nowait()\n    assert result == 42\n    assert q.qsize() == 0\n    assert q.empty()\n\n\ndef test_get_nowait_empty_raises():\n    q = Queue()\n    assert q.empty()\n    assert q.qsize() == 0\n    assert len(q._putters) == 0\n    with pytest.raises(QueueEmpty):\n        q.get_nowait()\n    assert q.empty()\n    assert q.qsize() == 0\n\n\ndef test_get_nowait_consumes_waiting_putter():\n    async def scenario():\n        q = Queue(maxsize=1)\n        q.put_nowait(\"first\")\n        assert q.full()\n        assert q.qsize() == 1\n        put_fut = q.put(\"second\")\n        assert len(q._putters) == 1\n        assert not put_fut.done()\n        result = q.get_nowait()\n        assert result == \"first\"\n        assert put_fut.done()\n        assert put_fut.result() is None\n        assert len(q._putters) == 0\n        assert q.qsize() == 1\n        assert q.full()\n        # waiting item was moved into the queue\n        second = q.get_nowait()\n        assert second == \"second\"\n        assert q.empty()\n        assert q.qsize() == 0\n\n    IOLoop.current().run_sync(scenario)\n```\n",
