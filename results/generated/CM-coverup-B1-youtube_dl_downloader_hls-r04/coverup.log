test_hls_delegate_ffmpeg_with_hooks(monkeypatch, tmp_path):\n    man_url = 'http://example.com/c.m3u8'\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg.ts\\n'\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: False))\n    warns = []\n    monkeypatch.setattr(fd, 'report_warning', lambda *a, **k: warns.append(a))\n    hook = lambda s: None\n    fd._progress_hooks = [hook]\n\n    class FakeFFmpeg:\n        instances = []\n        def __init__(self, y, p):\n            self.hooks = []\n            FakeFFmpeg.instances.append(self)\n        def add_progress_hook(self, ph):\n            self.hooks.append(ph)\n        def real_download(self, fn, info):\n            assert fn.endswith('out.mp4')\n            assert info['url'] == man_url\n            return 'delegated'\n\n    monkeypatch.setattr(hls_mod, 'FFmpegFD', FakeFFmpeg)\n    out = str(tmp_path / 'out.mp4')\n    assert fd.real_download(out, {'url': man_url}) == 'delegated'\n    assert warns\n    assert FakeFFmpeg.instances[0].hooks == [hook]\n\n\ndef test_hls_delegate_ffmpeg_no_hooks(monkeypatch, tmp_path):\n    man_url = 'http://example.com/c2.m3u8'\n    manifest = '#EXTM3U\\n#EXT-X-MAP:URI=\"init.mp4\"\\nseg.ts\\n'\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: False))\n    monkeypatch.setattr(fd, 'report_warning', lambda *a, **k: None)\n    fd._progress_hooks = []\n\n    class FakeFFmpeg2:\n        def __init__(self, y, p):\n            self.hooks = []\n        def add_progress_hook(self, ph):\n            self.hooks.append(ph)\n        def real_download(self, fn, info):\n            return True\n\n    monkeypatch.setattr(hls_mod, 'FFmpegFD', FakeFFmpeg2)\n    out = str(tmp_path / 'out.mp4')\n    assert fd.real_download(out, {'url': man_url}) is True\n\n\ndef test_hls_basic_ad_and_absolute(monkeypatch, tmp_path):\n    man_url = 'http://example.com/play.m3u8'\n    manifest = '\\n'.join([\n        '#EXTM3U',\n        '',\n        '#EXT-X-VERSION:3',\n        '#ANVATO-SEGMENT-INFO type=ad',\n        'ad1.ts',\n        '#ANVATO-SEGMENT-INFO type=master',\n        'http://cdn.example.com/abs.ts',\n        'seg1.ts',\n        '',\n        '#UPLYNK-SEGMENT xyz,ad',\n        'ad2.ts',\n        '#UPLYNK-SEGMENT xyz,segment',\n        'seg2.ts',\n        '#EXT-X-ENDLIST',\n        '',\n    ])\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    seen = {}\n    def fake_prepare(ctx):\n        seen.update(dict(ctx))\n        ctx['fragment_index'] = 0\n    monkeypatch.setattr(fd, '_prepare_and_start_frag_download', fake_prepare)\n    got_urls = []\n    def fake_dl(ctx, frag_url, info, headers=None):\n        got_urls.append(frag_url)\n        return (True, b'data-' + frag_url.encode()[-8:])\n    monkeypatch.setattr(fd, '_download_fragment', fake_dl)\n    appended = []\n    monkeypatch.setattr(fd, '_append_fragment', lambda ctx, c: appended.append(c))\n    finished = []\n    monkeypatch.setattr(fd, '_finish_frag_download', lambda ctx: finished.append(True))\n    out = str(tmp_path / 'out.mp4')\n    assert fd.real_download(out, {'url': man_url}) is True\n    assert seen['total_frags'] == 3\n    assert seen['ad_frags'] == 2\n    assert got_urls == [\n        'http://cdn.example.com/abs.ts',\n        'http://example.com/seg1.ts',\n        'http://example.com/seg2.ts',\n    ]\n    assert len(appended) == 3\n    assert finished == [True]\n\n\ndef test_hls_extra_query_byterange_resume(monkeypatch, tmp_path):\n    man_url = 'http://example.com/v.m3u8'\n    manifest = '\\n'.join([\n        '#EXTM3U',\n        '#EXT-X-MEDIA-SEQUENCE:10',\n        '#EXT-X-BYTERANGE:100@0',\n        'seg1.ts',\n        '#EXT-X-BYTERANGE:50',\n        'seg2.ts',\n        'seg3.ts',\n        '',\n    ])\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    def fake_prepare(ctx):\n        ctx['fragment_index'] = 1\n    monkeypatch.setattr(fd, '_prepare_and_start_frag_download', fake_prepare)\n    calls = []\n    def fake_dl(ctx, frag_url, info, headers=None):\n        calls.append((frag_url, dict(headers or {})))\n        return (True, b'x')\n    monkeypatch.setattr(fd, '_download_fragment', fake_dl)\n    monkeypatch.setattr(fd, '_append_fragment', lambda ctx, c: None)\n    monkeypatch.setattr(fd, '_finish_frag_download', lambda ctx: None)\n    out = str(tmp_path / 'out.mp4')\n    info = {'url': man_url, 'extra_param_to_segment_url': 'foo=bar', 'http_headers': {'User-Agent': 't'}}\n    assert fd.real_download(out, info) is True\n    assert len(calls) == 2\n    assert 'foo=bar' in calls[0][0]\n    assert 'foo=bar' in calls[1][0]\n    assert calls[0][1].get('Range') == 'bytes=100-149'\n    assert calls[1][1].get('Range') == 'bytes=100-149'\n    assert calls[0][1].get('User-Agent') == 't'\n\n\ndef test_hls_retry_then_success(monkeypatch, tmp_path):\n    man_url = 'http://example.com/r.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\n'\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {'fragment_retries': 1})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    monkeypatch.setattr(fd, '_prepare_and_start_frag_download', lambda ctx: ctx.update(fragment_index=0))\n    monkeypatch.setattr(fd, '_append_fragment', lambda ctx, c: None)\n    monkeypatch.setattr(fd, '_finish_frag_download', lambda ctx: None)\n    retries = []\n    monkeypatch.setattr(fd, 'report_retry_fragment', lambda *a, **k: retries.append(a))\n    err = _http_error(man_url)\n    monkeypatch.setattr(fd, '_download_fragment', mock.MagicMock(side_effect=[err, (True, b'data')]))\n    out = str(tmp_path / 'out.mp4')\n    assert fd.real_download(out, {'url': man_url}) is True\n    assert len(retries) == 1\n\n\ndef test_hls_retry_no_report_when_no_retries(monkeypatch, tmp_path):\n    man_url = 'http://example.com/r2.m3u8'\n    manifest = '#EXTM3U\\nseg1.ts\\nseg2.ts\\n'\n    ydl = mock.MagicMock()\n    ydl.urlopen.return_value = _manifest_resp(man_url, manifest)\n    fd = HlsFD(ydl, {'fragment_retries': 0, 'skip_unavailable_fragments': True})\n    monkeypatch.setattr(fd, '_prepare_url', lambda d, u: u)\n    monkeypatch.setattr(fd, 'to_screen', lambda *a, **k: None)\n    monkeypatch.setattr(HlsFD, 'can_download', staticmethod(lambda m, i: True))\n    monkeypatch.setattr(fd, '_prepare_and_start_frag_download', lambda ctx: ctx.update(fragment_index=0))\n    monkeypatch.setattr(fd, '_append_fragment', lambda ctx, c: None)\n    monkeypatch.setattr(fd, '_finish_frag_download', lambda ctx: None)\n    monkeypatch.setattr(fd, 'report_retry_fragment', lambda *a, **k: (_ for _ in ()).throw(AssertionError('should not retry')))\n    skips = []\n    monkeypatch.setattr(fd, 'report_skip_fragment', lambda *a, **k: skips.append(a))\n    err = _http_error(man_url)\n    monkeypatch.setattr(fd, '_download_fragment