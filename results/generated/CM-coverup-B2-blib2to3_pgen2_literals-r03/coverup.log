blib2to3.pgen2.literals.escape covering all branches.\"\"\"\n\nimport re\n\nimport pytest\n\nfrom blib2to3.pgen2 import literals\n\n\ndef _match(text):\n    \"\"\"Build a Match object whose group(1) is the escape tail of `text`.\"\"\"\n    return re.match(r\"\\\\(.*)\", text, re.DOTALL)\n\n\ndef test_escape_simple_escape_returns_mapping():\n    # Covers: simple_escapes hit (lines 26-30)\n    m = _match(r\"\\n\")\n    assert literals.escape(m) == \"\\n\"\n\n\ndef test_escape_hex_valid():\n    # Covers: hex branch with valid hex digits (lines 31-36, 44)\n    m = _match(r\"\\x41\")\n    assert literals.escape(m) == \"A\"\n\n\ndef test_escape_hex_too_short_raises():\n    # Covers: len(hexes) < 2 (lines 33-34)\n    m = _match(r\"\\x\")\n    with pytest.raises(ValueError, match=\"invalid hex string escape\"):\n        literals.escape(m)\n\n\ndef test_escape_hex_invalid_digits_raises():\n    # Covers: int(hexes, 16) ValueError (lines 37-38)\n    m = _match(r\"\\xzz\")\n    with pytest.raises(ValueError, match=\"invalid hex string escape\"):\n        literals.escape(m)\n\n\ndef test_escape_octal_valid():\n    # Covers: else branch with valid octal (lines 40-41, 44)\n    m = _match(r\"\\101\")\n    assert literals.escape(m) == \"A\"\n\n\ndef test_escape_octal_invalid_raises():\n    # Covers: int(tail, 8) ValueError (lines 42-43)\n    m = _match(r\"\\9\")\n    with pytest.raises(ValueError, match=\"invalid octal string escape\"):\n        literals.escape(m)\n\n\ndef test_eval_string_end_to_end():\n    # Integration: evalString drives escape through re.sub\n    assert literals.evalString(r\"'\\x41\\n\\101'\") == \"A\\nA\"\n```\n\nWait, for evalString: `r\"'\\x41\\n\\101'\"` \u2014 the string is `'\\x41\\n\\101'`. evalString strips quotes and applies re.sub with the escape regex. `\\x41` -> 'A', `\\n` -> newline, `\\101` -> 'A'. So result is \"A\\nA\". \n\nHmm, but wait \u2014 the regex in evalString: `r\"\\\\(\\'|\\\"|\\\\|[abfnrtv]|x.{0,2}|[0-7]{1,3})\"`. For `\\101`, the alt