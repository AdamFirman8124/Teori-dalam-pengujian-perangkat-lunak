_fails():\n    with pytest.raises(AssertionError):\n        ExampleSchema({}, {})\n\n\ndef test_init_with_args_and_kwargs_fails():\n    with pytest.raises(AssertionError):\n        ExampleSchema({}, name=\"alice\")\n```",
