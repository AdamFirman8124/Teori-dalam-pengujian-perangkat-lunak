ideo id\n        base_url = 'http://players.brightcove.net/1582188683001/HkiHLnNRx_default/index.html?videoId=%s' % video_id\n        assert entry['url'].startswith(base_url)\n\n        # smuggled data postconditions: geo_ip_blocks and referrer present\n        unsmuggled, data = unsmuggle_url(entry['url'])\n        assert unsmuggled == base_url\n        assert data['geo_ip_blocks'] == [\n            '193.113.0.0/16', '54.36.162.0/23', '159.65.16.0/21']\n        assert data['referrer'] == URL\n\n\ndef test_itvbtcc_real_extract_no_videos(fake_webpage):\n    \"\"\"Branch where the webpage contains no data-video-id attributes.\"\"\"\n    ie = ITVBTCCIE()\n    empty_page = (\n        '<html><head>'\n        '<meta property=\"og:title\" content=\"BTCC 2018: All the action from Brands Hatch\">'\n        '</head><body></body></html>'\n    )\n    fake_webpage  # fixture installed; now override the returned page\n    ITVBTCCIE._download_webpage.__globals__  # no-op, keep fixture reference\n\n    # Re-patch to return an empty page for this test\n    import youtube_dl.extractor.itv as itv_mod\n\n    def fake_download_empty(self, url_or_request, video_id, *args, **kwargs):\n        return empty_page\n\n    itv_mod.ITVBTCCIE._download_webpage = fake_download_empty\n    try:\n        result = ie._real_extract(URL)\n    finally:\n        # restore fixture behaviour is unnecessary; monkeypatch undoes at teardown\n        pass\n\n    assert result['_type'] == 'playlist'\n    assert result['entries'] == []\n    assert result['title'] == 'BTCC 2018: All the action from Brands Hatch'\n```",
