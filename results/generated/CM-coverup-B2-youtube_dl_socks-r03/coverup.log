tr, and on undo: if original was not in instance dict, it delattr's. Same mechanics as patch.object. Good.\n\nLet me write the tests:\n\n```python\nimport struct\nfrom unittest import mock  # maybe not needed if using monkeypatch\n\nimport pytest\n\nfrom youtube_dl.socks import (\n    SOCKS5_USER_AUTH_SUCCESS,\n    SOCKS5_USER_AUTH_VERSION,\n    SOCKS5_VERSION,\n    ProxyType,\n    Socks5Auth,\n    Socks5Error,\n    sockssocket,\n)\n\n\n@pytest.fixture\ndef sock():\n    s = sockssocket()\n    yield s\n    s.close()\n\n\ndef _set_proxy(sock, username=None, password=None):\n    sock.setproxy(ProxyType.SOCKS5, '127.0.0.1', 1080, username=username, password=password)\n\n\ndef _record_sendall(monkeypatch, sock):\n    sent = []\n\n    def fake_sendall(data):\n        sent.append(bytes(data))\n\n    monkeypatch.setattr(sock, 'sendall', fake_sendall)\n    return sent\n\n\ndef _stub_recvall(monkeypatch, sock, responses):\n    recvall = mock.Mock(side_effect=[bytes(r) for r in responses])\n    monkeypatch.setattr(sock, 'recvall', recvall)\n    return recvall\n```\n\nHmm, do I want to use mock.Mock for recvall to assert called_with(2)? Yes, convenient. Or record calls manually. Using unittest.mock is fine.\n\nTest 1 \u2014 no credentials, AUTH_NONE accepted:\n\n```python\ndef test_socks5_auth_no_credentials_none_method(monkeypatch, sock):\n    _set_proxy(sock)\n    sent = _record_sendall(monkeypatch, sock)\n    recvall = _stub_recvall(monkeypatch, sock, [struct.pack('!2B', SOCKS5_VERSION, Socks5Auth.AUTH_NONE)])\n\n    result = sock._socks5_auth()\n\n    assert result is None\n    assert sent == [b'\\x05\\x01\\x00']\n    recvall.assert_called_once_with(2)\n    assert not sock._closed  # hmm, implementation detail\n```\n\nFor \"close not called\" assertion \u2014 checking `sock._closed` is a CPython detail. Alternative: patch close with a recorder in every test. Let me make a helper that records close calls:\n\n```python\ndef _record_close(monkeypatch, sock):\n    calls = []\n    original = sock.close\n\n    def fake_close():\n        calls.append(True)\n        original()\n\n    monkeypatch.setattr(sock, 'close', fake_close)\n    return calls\n```\n\nThen in success tests: `assert close_calls == []`. In error tests: `assert close_calls == [True]` and socket really closed (`sock.fileno() == -1`). `fileno()` after close returns -1. That's a solid public-ish postcondition. \n\nTest 2 \u2014 user/pass success:\n\n```python\ndef test_socks5_auth_user_pass_success(monkeypatch, sock):\n    _set_proxy(sock, username='user', password='pwd')\n    sent = _record_sendall(monkeypatch, sock)\n    close_calls = _record_close(monkeypatch, sock)\n    recvall = _stub_recvall(monkeypatch, sock, [\n        struct.pack('!2B', SOCKS5_VERSION, Socks5Auth.AUTH_USER_PASS),\n        struct.pack('!2B', SOCKS5_USER_AUTH_VERSION, SOCKS5_USER_AUTH_SUCCESS),\n    ])\n\n    result = sock._socks5_auth()\n\n    assert result is None\n    assert sent == [\n        b'\\x05\\x02\\x00\\x02',\n        b'\\x01' + b'\\x04user' + b'\\x03pwd',\n    ]\n    assert recvall.call_args_list == [mock.call(2), mock.call(2)]\n    assert close_calls == []\n```\n\nTest 3 \u2014 no acceptable method:\n\n```python\ndef test_socks5_auth_no_acceptable_method(monkeypatch, sock):\n    _set_proxy(sock, username='user', password='pwd')\n    sent = _record_sendall(monkeypatch, sock)\n    close_calls = _record_close(monkeypatch, sock)\n    recvall = _stub_recvall(monkeypatch, sock, [\n        struct.pack('!2B', SOCKS5_VERSION, Socks5Auth.AUTH_NO_ACCEPTABLE),\n    ])\n\n    with pytest.raises(Socks5Error) as excinfo:\n        sock._socks5_auth()\n\n    assert excinfo.value.code == Socks5Auth.AUTH_NO_ACCEPTABLE\n    assert sent == [b'\\x05\\x02\\x00\\x02']\n    recvall.assert_called_once_with(2)\n    assert close_calls == [True]\n    assert sock.fileno() == -1\n```\n\nWait \u2014 `sock.fileno()` after close: returns -1. Yes, for a closed socket, fileno() returns -1. Good postcondition.\n\nHmm, but care