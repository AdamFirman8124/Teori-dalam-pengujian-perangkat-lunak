e_extract_m3u8_formats)\n    monkeypatch.setattr(LinuxAcademyIE, '_sort_formats', fake_sort_formats)\n    return calls\n\n\nCOURSE_URL = 'https://app.linuxacademy.com/course/dashboard/%s'\nLESSON_URL = 'https://app.linuxacademy.com/chapter/%s/lesson/%s'\n\n\ndef test_course_playlist_full(monkeypatch):\n    course_id = 'weekly-news'\n    url = COURSE_URL % course_id\n    module = {\n        'title': 'Test Course',\n        'md_desc': 'Course description',\n        'duration': '1 hour',\n        'items': [\n            'not-a-dict',\n            {'type': {'name': 'Section', 'slug': 'section'},\n             'course_name': 'Chapter One', 'course_module': 'module-1'},\n            {'type': {'name': 'Quiz', 'slug': 'quiz'}},\n            {'type': {'name': 'Lesson', 'slug': 'lesson'},\n             'lesson_name': 'Lesson A', 'url': '/lesson/a',\n             'date': '2019-01-01', 'duration': '5 minutes',\n             'md_desc': 'MD desc A'},\n            {'type': {'name': 'Section', 'slug': 'section'},\n             'course_name': 'Chapter Two', 'course_module': 'module-2'},\n            {'type': {'name': 'lesson', 'slug': 'lesson'},\n             'title': 'Lesson B', 'url': 'https://example.com/lesson/b',\n             'created_on': '2019-01-02', 'duration': '6:00',\n             'description': '<i>Desc B</i>'},\n            {'type': {'name': 'lesson', 'slug': 'lesson'},\n             'title': 'Lesson C', 'url': '/lesson/c',\n             'text': '<p>Text C</p>'},\n            {'type': {'name': 'lesson', 'slug': 'lesson'},\n             'title': 'Lesson D'},\n        ],\n    }\n    webpage = '<script>window.module = %s;</script>' % json.dumps(module)\n    calls = _patch_io(monkeypatch, webpage)\n\n    result = LinuxAcademyIE()._real_extract(url)\n\n    assert calls['downloads'] == [(url, course_id)]\n    assert calls['m3u8'] == [] and calls['sorted'] == []\n\n    assert result['_type'] == 'playlist'\n    assert result['id'] == course_id\n    assert result['title'] == 'T