e Title\"/>'\n    '<script type=\"application/ld+json\">' + json.dumps(JSON_LD) + '</script>'\n    '</head><body>'\n    '<div id=\"video\" data-video-id=\"1234567\" data-video-hmac=\"aabbcc\"></div>'\n    '<div class=\"episode-info__synopsis\">A <b>test</b> synopsis</div>'\n    '</body></html>'\n)\n\nPLAYLIST = {\n    'Playlist': {\n        'Video': {\n            'Base': 'https://medias.example/',\n            'MediaFiles': [\n                {},\n                {'Href': 'ep.m3u8'},\n                {'Href': 'ep.mp4'},\n            ],\n            'Subtitles': [\n                'garbage',\n                {'Href': 'not a url'},\n                {'Href': 'https://subs.example/en.vtt'},\n            ],\n            'Duration': '2700',\n        },\n    },\n}\n\n\n@pytest.fixture\ndef ie(monkeypatch):\n    ie = ITVIE()\n    calls = {}\n\n    monkeypatch.setattr(ie, '_download_webpage', lambda url, video_id, *a, **kw: WEBPAGE)\n    ...\n```\n\nHmm, monkeypatch.setattr on an instance attribute - monkeypatch.setattr(obj, name, value) works for instances too (it sets the attribute on the instance). Actually `monkeypatch.setattr(ie, '_download_webpage', fn)` sets instance attribute; fine.\n\nBut careful: `_real_extract` calls `self._download_webpage(url, video_id)` - bound method replaced by plain function stored on instance: `self._download_webpage(url, video_id)` would call `fn(url, video_id)` - since it's an instance attribute (not class), no self binding. Good.\n\nAlternatively define a subclass. Subclass is cleaner:\n\n```python\nclass FakeITVIE(ITVIE):\n    def __init__(self, webpage, playlist, json_ld_info=None):\n        super().__init__()\n        ...\n```\n\nBut using monkeypatch on instance is fine and keeps cleanup automatic.\n\nLet me write:\n\n```python\n@pytest.fixture\ndef extractor(monkeypatch):\n    ie = ITVIE()\n    recorded = {}\n\n    def fake_download_webpage(url, video_id, *args, **kwargs):\n        recorded['webpage_url'] = url\n        return WEBP