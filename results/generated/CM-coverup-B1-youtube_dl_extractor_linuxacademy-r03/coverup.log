horize_page(), authorize_urlh),\n            ('<html>callback</html>', callback_urlh),\n        ])\n    download = mocker.patch.object(\n        ie, '_download_webpage',\n        side_effect=[\n            '<html><input type=\"hidden\" name=\"wresult\" value=\"x\"></html>',\n            'ok',\n        ])\n\n    ie._login()\n\n    assert handle.call_count == 2\n    assert download.call_count == 2\n\n    args, kwargs = handle.call_args_list[0]\n    assert args[0] == ie._AUTHORIZE_URL\n    assert args[1] is None\n    query = kwargs['query']\n    assert query['client_id'] == ie._CLIENT_ID\n    assert query['response_type'] == 'token id_token'\n    assert query['response_mode'] == 'web_message'\n    assert query['redirect_uri'] == ie._ORIGIN_URL\n    assert query['scope'] == 'openid email user_impersonation profile'\n    assert query['audience'] == ie._ORIGIN_URL\n    assert len(query['state']) == 32\n    assert len(query['nonce']) == 32\n\n    args, kwargs = download.call_args_list[0]\n    assert args[0] == 'https://login.linuxacademy.com/usernamepassword/login'\n    body = json.loads(kwargs['data'].decode('utf-8'))\n    assert body['username'] == 'user@example.com'\n    assert body['password'] == 'secret'\n    assert body['client_id'] == ie._CLIENT_ID\n    assert body['redirect_uri'] == ie._ORIGIN_URL\n    assert body['tenant'] == 'lacausers'\n    assert body['connection'] == 'Username-Password-Authentication'\n    assert body['sso'] == 'true'\n    assert body['csrf'] == 'csrf-token'\n    assert kwargs['headers']['Content-Type'] == 'application/json'\n    assert kwargs['headers']['Origin'] == 'https://login.linuxacademy.com'\n    assert kwargs['headers']['Referer'] == authorize_urlh.geturl()\n\n    args, kwargs = handle.call_args_list[1]\n    assert args[0] == 'https://login.linuxacademy.com/login/callback'\n    assert kwargs['data'] == b'wresult=wresult-value'\n    assert kwargs['headers']['Content-Type'] == (\n        'application/x-www-form-urlencoded')\n    assert kwargs['headers']['Origin'] == 'https://login.linuxacademy.com'\n    assert kwargs['headers']['Referer'] == authorize_urlh.geturl()\n\n    args, kwargs = download.call_args_list[1]\n    assert args[0] == (\n        'https://linuxacademy.com/cp/login/tokenValidateLogin/token/TOKEN123')\n\n\ndef test_login_with_access_token_from_authorization_response(mocker):\n    ie = _make_ie(mocker)\n    authorize_urlh = _FakeUrlh(\n        'https://login.linuxacademy.com/authorize?state=xyz')\n    callback_urlh = _FakeUrlh(\n        'https://linuxacademy.com/cp/login/callback?code=abc')\n    callback_page = (\n        '<html><script>var authorizationResponse = '\n        '{\"response\": {\"access_token\": \"FALLBACK_TOKEN\"}};</script></html>')\n    handle = mocker.patch.object(\n        ie, '_download_webpage_handle',\n        side_effect=[\n            (_authorize_page(), authorize_urlh),\n            (callback_page, callback_urlh),\n        ])\n    download = mocker.patch.object(\n        ie, '_download_webpage',\n        side_effect=['<html></html>', 'ok'])\n\n    ie._login()\n\n    assert handle.call_count == 2\n    assert download.call_count == 2\n    args, kwargs = download.call_args_list[1]\n    assert args[0] == (\n        'https://linuxacademy.com/cp/login/tokenValidateLogin/token/'\n        'FALLBACK_TOKEN')\n\n\ndef test_login_401_with_description(mocker):\n    ie = _make_ie(mocker)\n    handle = mocker.patch.object(\n        ie, '_download_webpage_handle',\n        return_value=(_authorize_page(), _FakeUrlh('https://login.linuxacademy.com/authorize')))\n    download = mocker.patch.object(\n        ie, '_download_webpage',\n        side_effect=ExtractorError(\n            'HTTP Error 401',\n            cause=_http_error(401, {'description': 'Wrong email or password.'})))\n\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._login()\n\n    assert excinfo.value.expected is True\n    assert ie.IE_NAME in str(excinfo.value)\n    assert 'Wrong email or password.' in str(excinfo.value)\n    assert handle.call_count == 1\n    assert download.call_count == 1\n\n\ndef test_login_401_without_description_uses_code(mocker):\n    ie = _make_ie(mocker)\n    mocker.patch.object(\n        ie, '_download_webpage_handle',\n        return_value=(_authorize_page(), _FakeUrlh('https://login.linuxacademy.com/authorize')))\n    mocker.patch.object(\n        ie, '_download_webpage',\n        side_effect=ExtractorError(\n            'HTTP Error 401',\n            cause=_http_error(401, {'code': 'invalid_user_password'})))\n\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._login()\n\n    assert excinfo.value.expected is True\n    assert 'invalid_user_password' in str(excinfo.value)\n\n\ndef test_login_non_401_http_error_is_reraised(mocker):\n    ie = _make_ie(mocker)\n    mocker.patch.object(\n        ie, '_download_webpage_handle',\n        return_value=(_authorize_page(), _FakeUrlh('https://login.linuxacademy.com/authorize')))\n    original = ExtractorError(\n        'HTTP Error 500', cause=_http_error(500, {'code': 'server_error'}))\n    mocker.patch.object(ie, '_download_webpage', side_effect=original)\n\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._login()\n\n    assert excinfo.value is original\n    assert excinfo.value.expected is False\n\n\ndef test_login_non_http_error_cause_is_reraised(mocker):\n    ie = _make_ie(mocker)\n    mocker.patch.object(\n        ie, '_download_webpage_handle',\n        return_value=(_authorize_page(), _FakeUrlh('https://login.linuxacademy.com/authorize')))\n    original = ExtractorError('boom', cause=ValueError('nope'))\n    mocker.patch.object(ie, '_download_webpage', side_effect=original)\n\n    with pytest.raises(ExtractorError) as excinfo:\n        ie._login()\n\n    assert excinfo.value is original\n```",
