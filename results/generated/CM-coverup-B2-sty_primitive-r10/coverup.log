with the name that matches\n            # input.\n            else:\n                return getattr(self, args[0])\n\n        # If input is an 24bit color code, run 24bit render function.\n        elif len_args == 3:\n            return self.rgb_call(*args, **kwargs)\n\n        else:\n            return \"\"\n\n\nfg = Register(30, rules.fg, \"3\")\nbg = Register(40, rules.bg, \"4\")\nef = Register(1, rules.ef, \"\")\nrs = Register(0, rules.rs, \"\")\n```\n\nAnd base.py:\n\n```python\n# sty/base.py\nfrom typing import Callable, List, Tuple, Union\n\nfrom .utility import ascii_art\n\n\nclass Rule:\n    \"\"\" Rule class. \"\"\"\n\n    def __init__(self, name: str, data: Union[int, str, Tuple[int, int, int]]) -> None:\n        self.name = name\n        self.data = data\n\n\nclass Register:\n    \"\"\" Register class. \"\"\"\n\n    def __init__(self, val: int, rules: List[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted = False\n\n    def mute(self) -> None:\n        self.is_muted = True\n\n    def unmute(self) -> None:\n        self.is_muted = False\n\n    def eightbit_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n\n    def rgb_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n```\n\nHmm, I'm not sure about the exact signature. Let me use get_info to find out.\n\nActually, in the real sty library:\n\n```python\n# sty/base.py\nfrom typing import Callable, List, Tuple, Union\n\nfrom .utility import ascii_art\n\n\nclass Rule:\n    \"\"\" Rule class. \"\"\"\n\n    def __init__(self, name: str, data: Union[int, str, Tuple[int, int, int]]) -> None:\n        self.name = name\n        self.data = data\n\n\nclass Register:\n    \"\"\" Register class. \"\"\"\n\n    def __init__(self, val: int, rules: List[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted = False\n\n    def mute(self) -> None:\n        self.is_muted = True\n\n    def unmute(self) -> None:\n        self.is_muted = False\n\n    def eightbit_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n\n    def rgb_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n```\n\nHmm, I really need to check. Let me use get_info.\n\nThe plan:\n1. Call get_info for 'Register', 'Register.__call__', 'Register.eightbit_call', 'Register.rgb_call', 'Register.is_muted', maybe 'fg', 'bg', 'mute', 'unmute'.\n\nThen write tests:\n\n```python\nimport pytest\n\nfrom sty import fg, bg, ef, rs\nfrom sty.primitive import Register\n\n\n@pytest.fixture\ndef clean_fg():\n    \"\"\"Ensure fg register state is restored after test.\"\"\"\n    yield fg\n    fg.unmute()\n\n\nclass TestRegisterCall:\n    def test_call_muted_returns_empty_string(self):\n        fg.mute()\n        try:\n            assert fg() == \"\"\n            assert fg(42) == \"\"\n            assert fg(1, 2, 3) == \"\"\n        finally:\n            fg.unmute()\n\n    def test_call_single_int_uses_eightbit_call(self):\n        result = fg(42)\n        assert result == fg.eightbit_call(42)\n\n    def test_call_single_str_returns_attribute(self):\n        result = fg('red')\n        assert result == getattr(fg, 'red')\n\n    def test_call_three_args_uses_rgb_call(self):\n        result = fg(1, 2, 3)\n        assert result == fg.rgb_call(1, 2, 3)\n\n    def test_call_other_arg_counts_return_empty_string(self):\n        assert fg() == \"\"\n        assert fg(1, 2) == \"\"\n        assert fg(1, 2, 3, 4) == \"\"\n```\n\nWait, but `fg()` with no args \u2014 is_muted is False, len_args == 0, so it goes to else \u2192 return \"\". Good.\n\nBut hold on \u2014 using the module-level `fg` singleton could cause state pollution if a test mutes it. I'll use try/finally or monkeypatch to restore.\n\nAlternatively, create a fresh Register instance:\n\n```python\nfrom sty.primitive import Register\nfrom sty import rules\n\nreg = Register(30, rules.fg, \"3\")\n```\n\nBut I need to know the constructor signature. Let me check with get_info.\n\nActually, a safer approach that avoids depending on the constructor: use the module-level singletons but restore state. Or use monkeypatch to set `is_muted` attribute:\n\n```python\ndef test_call_muted(monkeypatch):\n    monkeypatch.setattr(fg, 'is_muted', True)\n    assert fg(42) == \"\"\n```\n\nmonkeypatch automatically restores after the test. That's clean.\n\nFor the eightbit_call and rgb_call tests, I could also mock them to verify they're called with the right args:\n\n```python\ndef test_call_single_int(monkeypatch):\n    calls = []\n    monkeypatch.setattr(fg, 'eightbit_call', lambda *a, **kw: calls.append((a, kw)) or 'EIGHTBIT')\n    assert fg(42) == 'EIGHTBIT'\n    assert calls == [((42,), {})]\n```\n\nHmm, but monkeypatch.setattr on an instance attribute \u2014 that works since monkeypatch.setattr can set instance attributes and will restore them (by deleting or restoring original). Actually, monkeypatch.setattr(obj, name, value) works on instances too; it records the original and restores it.\n\nBut wait \u2014 `eightbit_call` is a bound method of the instance. Setting `fg.eightbit_call = ...` sets an instance attribute that shadows the class method. monkeypatch will restore by deleting the instance attribute (since the original was not in the instance dict... actually monkeypatch handles this: it checks if the attribute exists in the instance `__dict__`; if not, it deletes it on teardown). Yes, pytest's monkeypatch handles this correctly.\n\nAlternatively, I can just compare against the real method output:\n\n```python\ndef test_call_single_int():\n    assert fg(42) == fg.eightbit_call(42)\n```\n\nThis is a valid postcondition check but doesn't strictly verify that `eightbit_call` was called. Using mocks is more precise. Let me use a mix: mock-based tests to verify dispatch, plus real-value tests.\n\nActually, let me think about what values to use. For `fg(42)`:\n- `fg.eightbit_call(42)` should produce `\\x1b[38;5;42m` or similar.\n\nFor `fg('red')`:\n- `getattr(fg, 'red')` should produce `\\x1b[31m` or similar.\n\nFor `fg(1, 2, 3)`:\n- `fg.rgb_call(1, 2, 3)` should produce `\\x1b[38;2;1;2;3m`.\n\nBut I shouldn't hardcode escape sequences without knowing the exact format. Better to compare with the direct method calls, or use mocks.\n\nLet me now use get_info to learn the actual API. I'll make these calls:\n\n1. get_info('Register')\n2. get_info('Register.__call__')\n3. get_info('Register.eightbit_call')\n4. get_info('Register.rgb_call')\n5. get_info('Register.is_muted')\n6. get_info('fg')\n7. get_info('Register.mute')\n8. get_info('Register.unmute')\n\nAll independent, so one block.\n\nThen based on results, write the test file.\n\nLet me think about what the tests should look like more concretely, assuming the standard sty API:\n\n```python\nimport pytest\n\nfrom sty import fg\nfrom sty.primitive import Register\n\n\ndef test_call_returns_empty_str_when_muted(monkeypatch):\n    \"\"\"Lines 99-100: muted register returns empty string.\"\"\"\n    monkeypatch.setattr(fg, \"is_muted\", True)\n    assert fg(42) == \"\"\n    assert fg(\"red\") == \"\"\n    assert fg(1, 2, 3) == \"\"\n    assert fg() == \"\"\n\n\ndef test_call_single_int_dispatches_to_eightbit_call(monkeypatch):\n    \"\"\"Lines 104, 107-108: single int arg -> eightbit_call.\"\"\"\n    recorded = {}\n\n    def fake_eightbit_call(*args, **kwargs):\n        recorded[\"args\"] = args\n        recorded[\"kwargs\"] = kwargs\n        return \"EIGHTBIT_RESULT\"\n\n    monkeypatch.setattr(fg, \"eightbit_call\", fake_eightbit_call)\n    assert fg(42) == \"EIGHTBIT_RESULT\"\n    assert recorded[\"args\"] == (42,)\n    assert recorded[\"kwargs\"] == {}\n\n\ndef test_call_single_str_returns_matching_attribute(monkeypatch):\n    \"\"\"Line 113: single str arg -> getattr.\"\"\"\n    monkeypatch.setattr(fg, \"red\", \"RED_RESULT\", raising=False)\n    assert fg(\"red\") == \"RED_RESULT\"\n\n\ndef test_call_three_args_dispatches_to_rgb_call(monkeypatch):\n    \"\"\"Lines 116-117: three args -> rgb_call.\"\"\"\n    recorded = {}\n\n    def fake_rgb_call(*args, **kwargs):\n        recorded[\"args\"] = args\n        recorded[\"kwargs\"] = kwargs\n        return \"RGB_RESULT\"\n\n    monkeypatch.setattr(fg, \"rgb_call\", fake_rgb_call)\n    assert fg(1, 2, 3) == \"RGB_RESULT\"\n    assert recorded[\"args\"] == (1, 2, 3)\n    assert recorded[\"kwargs\"] == {}\n\n\ndef test_call_with_other_arity_returns_empty_string():\n    \"\"\"Line 120: zero, two, or four args -> empty string.\"\"\"\n    assert fg() == \"\"\n    assert fg(1, 2) == \"\"\n    assert fg(1, 2, 3, 4) == \"\"\n```\n\nHmm wait, for `test_call_single_str_returns_matching_attribute`, monkeypatch.setattr(fg, \"red\", ...) \u2014 fg.red exists already (it's a rule attribute), so raising=False isn't needed but harmless. Actually, monkeypatch.setattr requires the attribute to exist unless raising=False. fg.red should exist. But to be safe, I could use raising=False.\n\nActually, wait. There's a subtlety: does `getattr(self, args[0])` return the rendered string or a rule object? In sty, the attributes on fg are... let me think. In sty, `fg.red` is a string like `\\x1b[31m`. Actually in sty, the attributes are set via `setattr` in a loop over rules, and each attribute value is the rendered escape sequence string. Let me check: in sty/primitive.py or wherever registers are created:\n\n```python\ndef make_register(...)...\n```\n\nHmm. In sty:\n\n```python\n# sty/primitive.py (actual source from GitHub)\nfrom typing import Union\n\nfrom . import base\nfrom .base import raw, render, rules\n\n\nclass Register(base.Register):\n    \"\"\" Register class.\n\n        A register is a special object that has attributes and call functionality.\n    \"\"\"\n\n    def __call__(self, *args: Union[int, str], **kwargs) -> str:\n        \"\"\"\n        This function is to handle calls such as `fg(42)`, `bg(102, 49, 42)`, `fg('red')`.\n        \"\"\"\n\n        # Return empty str if object is muted.\n        if self.is_muted:\n            return \"\"\n\n        len_args = len(args)\n\n        if len_args == 1:\n\n            # If input is an 8bit color code, run 8bit render function.\n            if isinstance(args[0], int):\n                return self.eightbit_call(*args, **kwargs)\n\n            # If input is a string, return attribute with the name that matches\n            # input.\n            else:\n                return getattr(self, args[0])\n\n        # If input is an 24bit color code, run 24bit render function.\n        elif len_args == 3:\n            return self.rgb_call(*args, **kwargs)\n\n        else:\n            return \"\"\n\n\nfg = Register(30, rules.fg, \"3\")\nbg = Register(40, rules.bg, \"4\")\nef = Register(1, rules.ef, \"\")\nrs = Register(0, rules.rs, \"\")\n```\n\nAnd in base.py:\n\n```python\nclass Register:\n    \"\"\" Register class. \"\"\"\n\n    def __init__(self, val: int, rules: List[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted = False\n\n        for rule in rules:\n            setattr(self, rule.name, render(escape_seq, rules, rule.data))\n```\n\nHmm, something like that. Actually I recall:\n\n```python\n# sty/base.py\nfrom typing import Callable, List, Tuple, Union\n\nfrom .utility import ascii_art\n\n\nclass Rule:\n    \"\"\" Rule class. \"\"\"\n\n    def __init__(self, name: str, data: Union[int, str, Tuple[int, int, int]]) -> None:\n        self.name = name\n        self.data = data\n\n\nclass Register:\n    \"\"\" Register class. \"\"\"\n\n    def __init__(self, val: int, rules: List[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted