[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted = False\n\n    def mute(self) -> None:\n        self.is_muted = True\n\n    def unmute(self) -> None:\n        self.is_muted = False\n\n    def eightbit_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n\n    def rgb_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n```\n\nActually, let me look at the actual sty source code. The sty package:\n\n```python\n# sty/base.py\nfrom typing import Callable, List, Tuple, Union\n\nfrom .utility import ascii_art\n\n\nclass Rule:\n    \"\"\" Rule class. \"\"\"\n\n    def __init__(self, name: str, data: Union[int, str, Tuple[int, int, int]]) -> None:\n        self.name = name\n        self.data = data\n\n\nclass Register:\n    \"\"\" Register class. \"\"\"\n\n    def __init__(self, val: int, rules: List[Rule], escape_seq: str) -> None:\n        self.rules = rules\n        self.escape_seq = escape_seq\n        self.is_muted = False\n\n    def mute(self) -> None:\n        self.is_muted = True\n\n    def unmute(self) -> None:\n        self.is_muted = False\n\n    def eightbit_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n\n    def rgb_call(self, *args, **kwargs) -> str:\n        return render(self.escape_seq, self.rules, *args, **kwargs)\n```\n\nHmm, I'm not 100% sure. Let me use get_info to find out.\n\nActually, the get_info tool returns information about a symbol. Let me use it to check the Register class and its methods.\n\nLet me plan the calls:\n1. get_info('Register') - to see the class definition\n2. get_info('Register.__call__') - to see the method\n3. get_info('Register.eightbit_call') - to see the eightbit_call method\n4. get_info('Register.rgb_call') - to see the rgb_call method\n5. get_info('Register.is_muted') - attribute info\n\