direction,\n        amount=amount,\n    )\n\n\nclass TestLastBalance:\n    \"\"\"Covers ``Ledger._last_balance`` (lines 127-130).\"\"\"\n\n    def test_empty_ledger_falls_back_to_initial_value(self, account, initial):\n        ## The ``except IndexError`` branch (line 130) must be taken here.\n        ledger = Ledger(account=account, initial=initial)\n\n        assert ledger.entries == []\n        assert ledger._last_balance == Quantity(Decimal(\"100\"))\n\n    def test_non_empty_ledger_returns_last_entry_balance(self, account, initial):\n        ## The ``try`` branch (line 128) must be taken once an entry exists.\n        ledger = Ledger(account=account, initial=initial)\n        last = ledger.add(make_posting(account, Amount(Decimal(\"40\")), Direction.DBT))\n\n        assert ledger._last_balance == last.balance == Quantity(Decimal(\"140\"))\n\n\nclass TestAdd:\n    \"\"\"Covers ``Ledger.add`` (lines 140-146).\"\"\"\n\n    def test_add_to_empty_ledger_computes_balance_from_initial(self, account, initial):\n        ledger = Ledger(account=account, initial=initial)\n        posting = make_posting(account, Amount(Decimal(\"50\")), Direction.DBT)\n\n        entry = ledger.add(posting)\n\n        ## The returned entry is a fresh LedgerEntry wired to ledger/posting:\n        assert isinstance(entry, LedgerEntry)\n        assert entry.ledger is ledger\n        assert entry.posting is posting\n        ## Balance: initial 100 + 50 * (+1 debit) = 150:\n        assert entry.balance == Quantity(Decimal(\"150\"))\n        ## The entry has been buffered (line 143):\n        assert ledger.entries == [entry]\n        ## And it is now the source of the last balance:\n        assert ledger._last_balance == entry.balance\n\n    def test_add_to_non_empty_ledger_compounds_on_last_balance(self, account, initial):\n        ledger = Ledger(account=account, initial=initial)\n        first = ledger.add(make_posting(account, Amount(Decimal(\"50\")), Direction.DBT))\n        second_posting =