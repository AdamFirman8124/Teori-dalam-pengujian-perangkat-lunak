ch, {PAGE_URL: page})\n\n    result = ie._real_extract(PAGE_URL)\n\n    assert result['_type'] == 'url'\n    assert result['url'] == 'https://www.youtube.com/watch?v=BaW_jenozKc'\n    assert result['ie_key'] == 'Youtube'\n    # Only the embed page itself was downloaded, no format URLs.\n    assert calls == [PAGE_URL]\n\n\ndef test_options_path_mp4_formats(monkeypatch):\n    page = (\n        '<html><script>'\n        \"var options = {'video': {'mp4_1080': '/api/1080', 'mp4_empty': '', 'mp4_other': '/api/other'},\"\n        \" 'title': 'Test Title', 'poster': 'https://example.com/poster.jpg'};\"\n        '</script></html>'\n    )\n    responses = {\n        PAGE_URL: page,\n        'https://video.udn.com/api/1080': 'https://cdn.example.com/video_1080p_4000.mp4',\n        'https://video.udn.com/api/other': 'https://cdn.example.com/video.mp4',\n    }\n    ie, calls = _make_ie(monkeypatch, responses)\n\n    result = ie._real_extract(PAGE_URL)\n\n    assert result['id'] == VIDEO_ID\n    assert result['title'] == 'Test Title'\n    assert result['thumbnail'] == 'https://example.com/poster.jpg'\n    formats = result['formats']\n    assert len(formats) == 2  # the entry with an empty URL must be skipped\n    by_id = {f['format_id']: f for f in formats}\n    assert set(by_id) == {'http-mp4_1080', 'http-mp4_other'}\n    assert by_id['http-mp4_1080']['url'] == 'https://cdn.example.com/video_1080p_4000.mp4'\n    assert by_id['http-mp4_1080']['height'] == 1080\n    assert by_id['http-mp4_1080']['tbr'] == 4000\n    assert by_id['http-mp4_other']['url'] == 'https://cdn.example.com/video.mp4'\n    assert 'height' not in by_id['http-mp4_other']\n    assert 'tbr' not in by_id['http-mp4_other']\n    # formats are sorted best-last: the 1080p/4000k one must come after\n    assert formats[-1]['format_id'] == 'http-mp4_1080'\n    assert calls == [PAGE_URL, 'https://video.udn.com/api/1080', 'https://video.udn.com/api/other']\n```\n\nHmm wait, the order of `calls` depends on dict iteration o