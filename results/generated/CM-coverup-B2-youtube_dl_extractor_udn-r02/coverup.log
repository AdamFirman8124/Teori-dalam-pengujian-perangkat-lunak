f.to_screen(u'WARNING: [%s]%s %s' % (self.IE_NAME, idstr, msg))\n```\n\nHmm, wait \u2014 in youtube_dl, `report_warning` might be:\n\n```python\ndef report_warning(self, msg, video_id=None):\n    '''\n    Print the message to stderr, it will be prefixed with 'WARNING:'\n    If stderr is a tty file the 'WARNING:' will be colored\n    '''\n    if self._downloader is not None:\n        self._downloader.report_warning(msg)\n    else:\n        self.to_stderr(msg)\n```\n\nAnd `to_stderr`:\n\n```python\ndef to_stderr(self, message):\n    print(message, file=sys.stderr)\n```\n\nHmm, `to_screen`:\n\n```python\ndef to_screen(self, msg):\n    \"\"\"Print msg to screen (stdout)\"\"\"\n    print(msg)\n```\n\nSomething like that. In any case, with `_downloader = None`, it prints to stderr/stdout \u2014 harmless in tests (pytest captures it). But to be clean, I could set a fake downloader that captures messages. Actually, setting a fake downloader with `params = {}` is needed anyway if `_sort_formats` uses `self._downloader.params`. Let me create:\n\n```python\nclass FakeDownloader:\n    def __init__(self):\n        self.params = {}\n        self.messages = []\n    def to_screen(self, msg):\n        self.messages.append(msg)\n    def report_warning(self, msg):\n        self.messages.append(msg)\n```\n\nHmm, but `report_warning` on the IE calls `self._downloader.report_warning(...)` \u2014 the downloader's method. And `to_screen` on IE calls `self._downloader.to_screen(...)`. Let me check IE.to_screen:\n\n```python\ndef to_screen(self, msg):\n    \"\"\"Print msg to screen (stdout)\"\"\"\n    if self._downloader is not None:\n        self._downloader.to_screen(msg)\n    else:\n        print(msg)\n```\n\nHmm, not sure. Let me check via get_info: `InfoExtractor.to_screen`, `InfoExtractor.report_warning`.\n\nOK let me just do the get_info calls now. I'll batch:\n\n1. `InfoExtractor._sort_formats`\n2. `InfoExtractor.__init__`\n3. `InfoExtractor.url_result`\n4. `InfoExtractor._generic_id`\n5. `InfoExtractor._match_id`\n6. `InfoExtractor._parse_json`\n7. `InfoExtractor._extract_m3u8_formats`\n8. `InfoExtractor._extract_f4m_formats`\n9. `js_to_json`\n10. `determine_ext`\n11. `UDNEmbedIE._VALID_URL`\n12. `InfoExtractor._download_webpage`\n13. `InfoExtractor.report_warning`\n14. `InfoExtractor.to_screen`\n\nThat's a lot; maybe trim to the essential ones: _sort_formats, __init__, url_result, _generic_id, _match_id, _parse_json, _extract_m3u8_formats, _extract_f4m_formats, js_to_json, UDNEmbedIE._VALID_URL, _download_webpage. I'll include most.\n\nLet me make the calls.\n\nAfter getting info, I'll write the test file.\n\nLet me draft the test file now (to be refined after get_info):\n\n```python\nimport pytest\n\nfrom youtube_dl.extractor.udn import UDNEmbedIE\n\n\nPAGE_URL = 'https://video.udn.com/embed/news/300040'\nVIDEO_ID = '300040'\n\n\nclass FakeDownloader(object):\n    def __init__(self):\n        self.params = {}\n        self.messages = []\n\n    def to_screen(self, msg):\n        self.messages.append(msg)\n\n    def report_warning(self, msg):\n        self.messages.append(msg)\n\n\ndef _make_ie(monkeypatch, responses):\n    \"\"\"Create a UDNEmbedIE with a stubbed _download_webpage.\"\"\"\n    ie = UDNEmbedIE(FakeDownloader())\n    calls = []\n\n    def fake_download_webpage(url_or_request, video_id, *args, **kwargs):\n        url = str(url_or_request)\n        calls.append(url)\n        if url not in responses:\n            raise AssertionError('Unexpected _download_webpage call: %r' % url)\n        return responses[url]\n\n    monkeypatch.setattr(ie, '_download_webpage', fake_download_webpage)\n    return ie, calls\n\n\ndef test_youtube_branch(monkeypatch):\n    page = (\n        '<html><script>'\n        \"var options = {'video': {'youtube': 'https://www.youtube.com/watch?v=BaW_jenozKc'},\"\n        \" 'title': 'YT Title', 'poster': 'https://example.com/poster.jpg'};\"\n        '</script></html>'\n    )\n    ie, calls = _make_ie(monkeypatch, {PAGE_URL: page})\n\n    result = ie._real_extract(PAGE_URL)\n\n    assert result['_type'] == 'url'\n    assert result['url'] == 'https://www.youtube.com/watch?v=BaW_jenozKc'\n    assert result['ie_key'] == 'Youtube'\n    # Only the embed page itself was downloaded, no format URLs.\n    assert calls == [PAGE_URL]\n\n\ndef test_options_path_mp4_formats(monkeypatch):\n    page = (\n        '<html><script>'\n        \"var options = {'video': {'mp4_1080': '/api/1080', 'mp4_empty': '', 'mp4_other': '/api/other'},\"\n        \" 'title': 'Test Title', 'poster': 'https://example.com/poster.jpg'};\"\n        '</script></html>'\n    )\n    responses = {\n        PAGE_URL: page,\n        'https://video.udn.com/api/1080': 'https://cdn.example.com/video_1080p_4000.mp4',\n        'https://video.udn.com/api/other': 'https://cdn.example.com/video.mp4',\n    }\n    ie, calls = _make_ie(monkeypatch, responses)\n\n    result = ie._real_extract(PAGE_URL)\n\n    assert result['id'] == VIDEO_ID\n    assert result['title'] == 'Test Title'\n    assert result['thumbnail'] == 'https://example.com/poster.jpg'\n    formats = result['formats']\n    assert len(formats) == 2  # the entry with an empty URL must be skipped\n    by_id = {f['format_id']: f for f in formats}\n    assert set(by_id) == {'http-mp4_1080', 'http-mp4_other'}\n    assert by_id['http-mp4_1080']['url'] == 'https://cdn.example.com/video_1080p_4000.mp4'\n    assert by_id['http-mp4_1080']['height'] == 1080\n    assert by_id['http-mp4_1080']['tbr'] == 4000\n    assert by_id['http-mp4_other']['url'] == 'https://cdn.example.com/video.mp4'\n    assert 'height' not in by_id['http-mp4_other']\n    assert 'tbr' not in by_id['http-mp4_other']\n    # formats are sorted best-last: the 1080p/4000k one must come after\n    assert formats[-1]['format_id'] == 'http-mp4_1080'\n    assert calls == [PAGE_URL, 'https://video.udn.com/api/1080', 'https://video.udn.com/api/other']\n```\n\nHmm wait, the order of `calls` depends on dict iteration ord