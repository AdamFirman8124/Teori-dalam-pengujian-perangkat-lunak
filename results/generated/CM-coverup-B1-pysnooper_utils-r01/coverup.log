        "content": "```python\nimport inspect\nimport re\n\nimport pytest\n\nimport pysnooper.utils as utils_module\n\n\ndef _direct_normalize_repr():\n    return getattr(utils_module, \"normalize_repr\", None)\n\n\ndef _collect_outer_candidates():\n    candidates = []\n    for name in dir(utils_module):\n        try:\n            obj = getattr(utils_module, name)\n        except Exception:\n            continue\n        if inspect.isfunction(obj):\n            try:\n                src = inspect.getsource(obj)\n            except Exception:\n                continue\n            if \"normalize_repr\" in src or \"DEFAULT_REPR_RE\" in src:\n                candidates.append((name, obj))\n        elif inspect.isclass(obj):\n            for meth_name, meth in inspect.getmembers(obj, predicate=inspect.isfunction):\n                try:\n                    src = inspect.getsource(meth)\n                except Exception:\n                    continue\n                if \"normalize_repr\" in src or \"DEFAULT_REPR_RE\" in src:\n                    candidates.append((f\"{name}.{meth_name}\", meth))\n    return candidates\n\n\ndef _try_call_outer(func, arg):\n    # Try common single-arg call, then common (item, max_length) style calls.\n    try:\n        return (True, func(arg))\n    except TypeError:\n        pass\n    except Exception:\n        return (False, None)\n    for extra in (100, 1000, True, False, None):\n        try:\n            return (True, func(arg, extra))\n        except TypeError:\n            continue\n        except Exception:\n            return (False, None)\n    try:\n        sig = inspect.signature(func)\n        params = list(sig.parameters.values())\n        # Build dummy args: first param gets `arg`, rest get defaults or generics.\n        if len(params) >= 1:\n            args = [arg]\n            for p in params[1:]:\n                if p.default is not inspect.Parameter.empty:\n                    args.append(p.default)\n                elif p.kind in (inspect.Parameter.VAR_POSITIONAL, inspect.Parameter.VAR_KEYWORD):\n                    break\n                else:\n                    args.append(100)\n            return (True, func(*args))\n    except Exception:\n        return (False, None)\n    return (False, None)\n\n\ndef test_normalize_repr_direct_removes_address():\n    func = _direct_normalize_repr()\n    if func is None:\n        pytest.skip(\"normalize_repr not exposed at module level\")\n    result = func(\"<object object at 0x7f8b8c0d5e00>\")\n    assert result == \"<object object>\"\n    assert \"0x\" not in result\n    assert \"at 0x\" not in result\n\n\ndef test_normalize_repr_direct_leaves_plain_repr():\n    func = _direct_normalize_repr()\n    if func is None:\n        pytest.skip(\"normalize_repr not exposed at module level\")\n    assert func(\"<object object>\") == \"<object object>\"\n    assert func(\"hello\") == \"hello\"\n    assert func(\"\") == \"\"\n    # Regex requires at least 4 hex digits, so short address stays.\n    assert func(\"foo at 0x12\") == \"foo at 0x12\"\n    # Upper/lower hex, multiple occurrences.\n    assert func(\"<A at 0xABCDEF> and <B at 0x123456>\") == \"<A> and <B>\"\n\n\ndef test_normalize_repr_via_outer_helpers():\n    class WithAddress:\n        def __repr__(self):\n            return \"<WithAddress at 0x1234ABCD>\"\n\n    exercised = False\n    # Try well-known helper names first.\n    for helper_name in (\n        \"get_shortish_repr\",\n        \"get_repr\",\n        \"shortish_repr\",\n        \"get_local_reprs\",\n        \"normalize_repr\",\n    ):\n        helper = getattr(utils_module, helper_name, None)\n        if not callable(helper):\n            continue\n        if helper_name == \"normalize_repr\":\n            ok, res = True, helper(\"<X at 0xDEADBEEF>\")\n            assert res == \"<X>\"\n            exercised = True\n            continue\n        ok, res = _try_call_outer(helper, WithAddress())\n        if not ok:\n            cont