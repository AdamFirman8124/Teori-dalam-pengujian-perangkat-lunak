st file now (to be adjusted after get_info):\n\n```python\nimport pytest\nfrom json.decoder import JSONDecodeError\n\nfrom typesystem.tokenize.tokenize_json import _TokenizingJSONObject\nfrom typesystem.tokenize.tokens import ScalarToken\n\n\ndef fake_scan_once(s, idx):\n    \"\"\"Minimal scanner stand-in: parses unsigned integer literals, nothing else.\"\"\"\n    if idx >= len(s) or not s[idx].isdigit():\n        raise StopIteration(idx)\n    end = idx\n    while end < len(s) and s[end].isdigit():\n        end += 1\n    return ScalarToken(int(s[idx:end]), idx, end - 1, s), end\n\n\ndef test_object_fast_path():\n    content = '{\"a\":1}'\n    result, end = _TokenizingJSONObject(\n        (content, 1), True, fake_scan_once, {}, content\n    )\n    assert end == len(content) == 7\n    assert list(result.keys())[0].value == \"a\"\n    key = list(result.keys())[0]\n    assert (key.start, key.end) == (1, 3)\n    value = list(result.values())[0]\n    assert value.value == 1\n    assert (value.start, value.end) == (5, 5)\n\n\ndef test_object_with_whitespace_around_keys_and_values():\n    content = '{ \"a\" : 1 , \"b\" : 2 }'\n    result, end = _TokenizingJSONObject(\n        (content, 1), True, fake_scan_once, {}, content\n    )\n    assert end == len(content) == 21\n    keys = list(result.keys())\n    assert [k.value for k in keys] == [\"a\", \"b\"]\n    assert [(k.start, k.end) for k in keys] == [(2, 4), (12, 14)]\n    assert [result[k].value for k in keys] == [1, 2]\n\n\ndef test_empty_object():\n    content = \"{}\"\n    result, end = _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert result == {}\n    assert end == 2\n\n\ndef test_empty_object_with_whitespace():\n    content = \"{ }\"\n    result, end = _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert result == {}\n    assert end == 3\n\n\ndef test_invalid_first_character():\n    content = \"{,}\"\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert excinfo.value.msg == \"Expecting property name enclosed in double quotes\"\n    assert excinfo.value.pos == 1\n\n\ndef test_missing_colon_delimiter():\n    content = '{\"a\" 1}'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert excinfo.value.msg == \"Expecting ':' delimiter\"\n    assert excinfo.value.pos == 5\n\n\n@pytest.mark.parametrize(\"content,expected_pos\", [(\"{\\\"a\\\":\", 5), (\"{\\\"a\\\": \", 6)])\ndef test_truncated_after_colon(content, expected_pos):\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert excinfo.value.msg == \"Expecting value\"\n    assert excinfo.value.pos == expected_pos\n\n\ndef test_multiple_whitespace_characters_after_colon():\n    content = '{\"a\":  1}'\n    result, end = _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert end == len(content) == 9\n    value = list(result.values())[0]\n    assert value.value == 1\n    assert (value.start, value.end) == (7, 7)\n\n\ndef test_missing_value_after_colon():\n    content = '{\"a\": }'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert excinfo.value.msg == \"Expecting value\"\n    assert excinfo.value.pos == 6\n\n\ndef test_missing_closing_brace():\n    content = '{\"a\":1'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {}, content)\n    assert excinfo.value.msg == \"Expecting ',' delimiter\"\n    assert excinfo.value.pos == 6\n\n\ndef test_invalid_character_after_comma():\n    content = '{\"a\":1,}'\n    with pytest.raises(JSONDecodeError) as excinfo:\n        _TokenizingJSONObject((content, 1), True, fake_scan_once, {},