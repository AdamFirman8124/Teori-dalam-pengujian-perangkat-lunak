        "content": "```python\nimport pytest\n\nfrom youtube_dl.socks import (\n    InvalidVersionError,\n    Proxy,\n    Socks5Auth,\n    Socks5Error,\n    sockssocket,\n)\n\n\nclass FakeSocks(object):\n    \"\"\"Minimal stand-in for sockssocket that records I/O instead of using a real socket.\"\"\"\n\n    _len_and_data = staticmethod(sockssocket._len_and_data)\n    _check_response_version = sockssocket._check_response_version\n\n    def __init__(self, proxy, responses):\n        self._proxy = proxy\n        self._responses = list(responses)\n        self.sent = []\n        self.closed = False\n\n    def sendall(self, data):\n        self.sent.append(data)\n\n    def _recv_bytes(self, cnt):\n        data = self._responses.pop(0)\n        assert len(data) == cnt\n        return data\n\n    def close(self):\n        self.closed = True\n\n\ndef make_proxy(username=None, password=None):\n    return Proxy('socks5', '127.0.0.1', 1080, username, password, False)\n\n\ndef test_socks5_auth_no_credentials_selects_auth_none():\n    fake = FakeSocks(make_proxy(), [(Socks5Auth.AUTH_NONE,)])\n\n    sockssocket._socks5_auth(fake)\n\n    assert fake.sent == [b'\\x05\\x01\\x00']\n    assert fake.closed is False\n\n\ndef test_socks5_auth_offers_user_pass_when_credentials_present():\n    fake = FakeSocks(make_proxy('user', 'pass'), [(Socks5Auth.AUTH_USER_PASS,), (1, 0)])\n\n    sockssocket._socks5_auth(fake)\n\n    assert fake.sent[0] == b'\\x05\\x02\\x00\\x02'\n    assert fake.sent[1] == b'\\x01\\x04user\\x04pass'\n    assert fake.closed is False\n\n\ndef test_socks5_auth_does_not_offer_user_pass_with_only_username():\n    fake = FakeSocks(make_proxy('user', None), [(Socks5Auth.AUTH_NONE,)])\n\n    sockssocket._socks5_auth(fake)\n\n    assert fake.sent == [b'\\x05\\x01\\x00']\n    assert fake.closed is False\n\n\ndef test_socks5_auth_does_not_offer_user_pass_with_only_password():\n    fake = FakeSocks(make_proxy(None, 'pass'), [(Socks5Auth.AUTH_NONE,)])\n\n    sockssocket._socks5_auth(fake)\n\n    assert fake.sent == [b'\\x05\\x01\\x00']\n    assert fake.closed is False\n\n\ndef test_socks5_auth_accepts_other_method_without_auth_exchange():\n    fake = FakeSocks(make_proxy(), [(Socks5Auth.AUTH_GSSAPI,)])\n\n    sockssocket._socks5_auth(fake)\n\n    assert fake.sent == [b'\\x05\\x01\\x00']\n    assert fake.closed is False\n\n\ndef test_socks5_auth_raises_when_no_acceptable_method():\n    fake = FakeSocks(make_proxy(), [(Socks5Auth.AUTH_NO_ACCEPTABLE,)])\n\n    with pytest.raises(Socks5Error) as excinfo:\n        sockssocket._socks5_auth(fake)\n\n    assert excinfo.value.args[0] == Socks5Auth.AUTH_NO_ACCEPTABLE\n    assert fake.closed is True\n    assert len(fake.sent) == 1\n\n\ndef test_socks5_auth_raises_when_user_pass_requested_without_credentials():\n    fake = FakeSocks(make_proxy(), [(Socks5Auth.AUTH_USER_PASS,)])\n\n    with pytest.raises(Socks5Error) as excinfo:\n        sockssocket._socks5_auth(fake)\n\n    assert excinfo.value.args[0] == Socks5Auth.AUTH_NO_ACCEPTABLE\n    assert fake.closed is True\n    assert len(fake.sent) == 1\n\n\ndef test_socks5_auth_raises_when_user_pass_requested_with_only_username():\n    fake = FakeSocks(make_proxy('user', None), [(Socks5Auth.AUTH_USER_PASS,)])\n\n    with pytest.raises(Socks5Error) as excinfo:\n        sockssocket._socks5_auth(fake)\n\n    assert excinfo.value.args[0] == Socks5Auth.AUTH_NO_ACCEPTABLE\n    assert fake.closed is True\n\n\ndef test_socks5_auth_raises_on_user_pass_failure():\n    fake = FakeSocks(make_proxy('user', 'pass'), [(Socks5Auth.AUTH_USER_PASS,), (1, 1)])\n\n    with pytest.raises(Socks5Error) as excinfo:\n        sockssocket._socks5_auth(fake)\n\n    assert excinfo.value.args[0] == Socks5Error.ERR_GENERAL_FAILURE\n    assert fake.closed is True\n    assert fake.sent[1] == b'\\x01\\x04user\\x04pass'\n\n\ndef test_socks5_auth_raises_on_bad_method_response_version():\n    fake = FakeSocks(make_proxy(), [(4, Socks5Auth.AUTH_NONE)])\n\n    with pytest.raises(InvalidVersionError):\n        sockssocket._socks5_auth(fake)\n\n    assert fake.closed is True\n\n\ndef test_socks5_auth_raises_on_bad_user_pass_response_version():\n    fake = FakeSocks(make_proxy('user', 'pass'), [(Socks5Auth.AUTH_USER_PASS,), (2, 0)])\n\n    with pytest.raises(InvalidVersionError):\n        sockssocket._socks5_auth(fake)\n\n    assert fake.closed is True\n```",
