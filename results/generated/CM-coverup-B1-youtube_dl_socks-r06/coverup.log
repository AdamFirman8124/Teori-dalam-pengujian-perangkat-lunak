        "content": "```python\nimport socket\nimport struct\n\nimport pytest\n\nfrom youtube_dl.socks import (\n    SOCKS5_VERSION,\n    Socks5AddressType,\n    Socks5Command,\n    Socks5Error,\n    sockssocket,\n)\n\n\nclass _FakeSocksSocket(object):\n    \"\"\"Lightweight stand-in exposing only what _setup_socks5 needs.\n\n    Avoids creating a real socket, so there is no file descriptor or\n    other state to clean up after the test.\n    \"\"\"\n\n    def __init__(self, ipaddr, response):\n        self._ipaddr = ipaddr\n        self._buffer = bytearray(response)\n        self.sent = []\n        self.closed = False\n        self.auth_called = False\n        self.resolve_args = None\n\n    # --- methods matching the sockssocket interface ---\n\n    def _resolve_address(self, destaddr, default, use_remote_dns=False):\n        self.resolve_args = (destaddr, default, use_remote_dns)\n        return self._ipaddr\n\n    def _socks5_auth(self):\n        self.auth_called = True\n\n    def sendall(self, data):\n        self.sent.append(bytes(data))\n\n    def recv(self, cnt, *args, **kwargs):\n        chunk = bytes(self._buffer[:cnt])\n        del self._buffer[:cnt]\n        return chunk\n\n    def recvall(self, cnt):\n        # Mirrors sockssocket.recvall, built on the fake recv above.\n        data = b''\n        while len(data) < cnt:\n            cur = self.recv(cnt - len(data))\n            if not cur:\n                raise EOFError('{0} bytes missing'.format(cnt - len(data)))\n            data += cur\n        return data\n\n    def close(self):\n        self.closed = True\n\n\ndef _run_setup_socks5(fake, address):\n    # Invoke the real (unbound) method under test against the fake.\n    return sockssocket._setup_socks5(fake, address)\n\n\ndef test_setup_socks5_ipv4_success():\n    ipaddr = socket.inet_aton(\"93.184.216.34\")\n    bound_addr = socket.inet_aton(\"10.0.0.1\")\n    response = (\n        struct.pack(\n            \"!BBBB\",\n            SOCKS5_VERSION,\n            Socks5Error.ERR_SUCCESS,\n            0,\n            Socks5AddressType.ATYP_IPV4,\n        )\n        + bound_addr\n        + struct.pack(\"!H\", 8080)\n    )\n    fake = _FakeSocksSocket(ipaddr, response)\n\n    result = _run_setup_socks5(fake, (\"93.184.216.34\", 80))\n\n    assert result == (bound_addr, 8080)\n    assert fake.resolve_args == (\"93.184.216.34\", None, True)\n    assert fake.auth_called is True\n    assert fake.closed is False\n    expected_packet = (\n        struct.pack(\"!BBB\", SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + struct.pack(\"!B\", Socks5AddressType.ATYP_IPV4)\n        + ipaddr\n        + struct.pack(\"!H\", 80)\n    )\n    assert fake.sent == [expected_packet]\n\n\ndef test_setup_socks5_domainname_success():\n    bound_name = b\"example.com\"\n    response = (\n        struct.pack(\n            \"!BBBB\",\n            SOCKS5_VERSION,\n            Socks5Error.ERR_SUCCESS,\n            0,\n            Socks5AddressType.ATYP_DOMAINNAME,\n        )\n        + struct.pack(\"!B\", len(bound_name))\n        + bound_name\n        + struct.pack(\"!H\", 1234)\n    )\n    fake = _FakeSocksSocket(None, response)\n\n    result = _run_setup_socks5(fake, (\"example.com\", 443))\n\n    assert result == (bound_name, 1234)\n    assert fake.resolve_args == (\"example.com\", None, True)\n    assert fake.auth_called is True\n    assert fake.closed is False\n    expected_packet = (\n        struct.pack(\"!BBB\", SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + struct.pack(\"!B\", Socks5AddressType.ATYP_DOMAINNAME)\n        + struct.pack(\"!B\", len(b\"example.com\"))\n        + b\"example.com\"\n        + struct.pack(\"!H\", 443)\n    )\n    assert fake.sent == [expected_packet]\n\n\ndef test_setup_socks5_ipv6_response_success():\n    ipaddr = socket.inet_aton(\"192.0.2.1\")\n    bound_addr = bytes(range(16))\n    response = (\n        struct.pack(\n            \"!BBBB\",\n            SOCKS5_VERSION,\n            Socks5Error.ERR_SUCCESS,\n            0,\n            Socks5AddressType.ATYP_IPV6,\n        )\n        + bound_addr\n        + struct.pack(\"!H\", 9999)\n    )\n    fake = _FakeSocksSocket(ipaddr, response)\n\n    result = _run_setup_socks5(fake, (\"192.0.2.1\", 22))\n\n    assert result == (bound_addr, 9999)\n    assert fake.auth_called is True\n    assert fake.closed is False\n    expected_packet = (\n        struct.pack(\"!BBB\", SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + struct.pack(\"!B\", Socks5AddressType.ATYP_IPV4)\n        + ipaddr\n        + struct.pack(\"!H\", 22)\n    )\n    assert fake.sent == [expected_packet]\n\n\ndef test_setup_socks5_error_status_closes_and_raises():\n    ipaddr = socket.inet_aton(\"203.0.113.7\")\n    error_status = 5\n    assert error_status != Socks5Error.ERR_SUCCESS\n    response = struct.pack(\n        \"!BBBB\",\n        SOCKS5_VERSION,\n        error_status,\n        0,\n        Socks5AddressType.ATYP_IPV4,\n    )\n    fake = _FakeSocksSocket(ipaddr, response)\n\n    with pytest.raises(Socks5Error):\n        _run_setup_socks5(fake, (\"203.0.113.7\", 25))\n\n    assert fake.closed is True\n    assert fake.auth_called is True\n    expected_packet = (\n        struct.pack(\"!BBB\", SOCKS5_VERSION, Socks5Command.CMD_CONNECT, 0)\n        + struct.pack(\"!B\", Socks5AddressType.ATYP_IPV4)\n        + ipaddr\n        + struct.pack(\"!H\", 25)\n    )\n    assert fake.sent == [expected_packet]\n\n\ndef test_setup_socks5_unknown_response_atype():\n    ipaddr = socket.inet_aton(\"198.51.100.3\")\n    unknown_atype = 99\n    assert unknown_atype not in (\n        Socks5AddressType.ATYP_IPV4,\n        Socks5AddressType.ATYP_DOMAINNAME,\n        Socks5AddressType.ATYP_IPV6,\n    )\n    response = (\n        struct.pack(\n            \"!BBBB\",\n            SOCKS5_VERSION,\n            Socks5Error.ERR_SUCCESS,\n            0,\n            unknown_atype,\n        )\n        + struct.pack(\"!H\", 5555)\n    )\n    fake = _FakeSocksSocket(ipaddr, response)\n\n    result = _run_setup_socks5(fake, (\"198.51.100.3\", 110))\n\n    # No address bytes are consumed for an unknown ATYP, so the\n    # original destination string is returned unchanged.\n    assert result == (\"198.51.100.3\", 5555)\n    assert fake.auth_called is True\n    assert fake.closed is False\n    assert len(fake.sent) == 1\n```",
