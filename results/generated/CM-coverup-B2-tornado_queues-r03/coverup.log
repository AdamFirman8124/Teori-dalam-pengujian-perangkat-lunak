sert str(q) == \"<Queue maxsize=0 queue=deque(['a', 'b'])>\"\n    assert \"tasks=\" not in str(q)\n\n\ndef test_str_with_waiting_getter():\n    async def main():\n        q = Queue(maxsize=1)\n        # An empty queue makes get() park a future in _getters (340-341).\n        getter = q.get()\n        assert str(q) == \"<Queue maxsize=1 getters[1]>\"\n        assert \"putters[\" not in str(q)\n        # Putting an item hands it straight to the parked getter.\n        q.put_nowait(\"x\")\n        assert await getter == \"x\"\n        # The getter is gone; the handed-over item left an unfinished task.\n        assert str(q) == \"<Queue maxsize=1 tasks=1>\"\n        q.task_done()  # clean up the queue state\n        assert str(q) == \"<Queue maxsize=1>\"\n\n    asyncio.run(main())\n\n\ndef test_str_with_waiting_putter():\n    async def main():\n        q = Queue(maxsize=1)\n        q.put_nowait(\"a\")  # fills the queue and registers an unfinished task\n        # A full queue makes put() park (item, future) in _putters (342-343).\n        putter = q.put(\"b\")\n        assert str(q) == \"<Queue maxsize=1 queue=deque(['a']) putters[1] tasks=1>\"\n        assert \"getters[\" not in str(q)\n        # Taking an item resolves the parked putter.\n        assert await q.get() == \"a\"\n        assert await putter is None\n        # The parked item \"b\" was never enqueued, so the queue is now empty\n        # and only the unfinished task from \"a\" remains.\n        assert str(q) == \"<Queue maxsize=1 tasks=1>\"\n        q.task_done()  # clean up the queue state\n        assert str(q) == \"<Queue maxsize=1>\"\n\n    asyncio.run(main())\n```\n\nWait \u2014 in test 4, after `await q.get()`, is `_unfinished_tasks` 1? `put_nowait(\"a\")` \u2192 `__put_internal` \u2192 `_unfinished_tasks += 1` \u2192 1. The parked putter's \"b\" never went through `__put_internal`. `get_nowait` popping the putter doesn't change `_unfinished_tasks`. So yes, 1. \u2713.\n\nHmm, but wait: does `get_now