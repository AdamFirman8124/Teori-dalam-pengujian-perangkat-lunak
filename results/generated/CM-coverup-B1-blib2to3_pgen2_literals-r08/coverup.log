\n        evalString(\"x'hi'\")\n\n\ndef test_eval_string_mismatched_end_raises():\n    with pytest.raises(AssertionError):\n        evalString(\"'hello\\\"\")\n    with pytest.raises(AssertionError):\n        evalString(\"\\\"hello'\")\n    with pytest.raises(AssertionError):\n        evalString(\"'''hello\\\"\\\"\\\"\")\n\n\ndef test_eval_string_too_short_single_raises():\n    with pytest.raises(AssertionError):\n        evalString(\"'\")\n    with pytest.raises(AssertionError):\n        evalString('\"')\n\n\ndef test_eval_string_too_short_triple_raises():\n    with pytest.raises(AssertionError):\n        evalString(\"'''\")\n    with pytest.raises(AssertionError):\n        evalString('\"\"\"')\n    with pytest.raises(AssertionError):\n        evalString(\"'''''\")\n```",
