hannel'\n    assert info['uploader_id'] == '5'\n    assert info['channel'] == 'fallback channel'\n    assert info['channel_id'] == '5'\n    assert info['timestamp'] is None\n    assert info['like_count'] is None\n    assert info['dislike_count'] is None\n    assert info['view_count'] is None\n    assert info['duration'] is None\n    assert info['age_limit'] == 18\n\n    assert captured['token_url'] == \\\n        'https://tkn.porntube.com/999/desktop/360'\n    assert [f['format_id'] for f in info['formats']] == ['360p']\n    assert info['formats'][0]['url'] == 'http://media/360.mp4'\n```",
