o the body,\n    and, optionally, headers.\n\n    \"\"\"\n    enabled = True\n\n    def __init__(\n        self,\n        env: Environment,\n        color_scheme: str = DEFAULT_COLOR_SCHEME,\n        **kwargs,\n    ):\n        super().__init__(env, **kwargs)\n        if not env.colors:\n            self.enabled = False\n            return\n        self.formatter = TerminalFormatter(\n            env=env,\n            style=get_style_by_name(color_scheme),\n        )\n        # Pygments will not recognize `HTTPie` as a valid MIME type,\n        # so we need to use `http` instead.\n        if self.kwargs['mime'] == HTTPIE_MIME_TYPE:\n            self.kwargs['mime'] = HTTP_MIME_TYPE\n\n    def format_headers(self, headers: str) -> str:\n        return pygments.highlight(\n            code=headers,\n            lexer=HTTPLexer(),\n            formatter=self.formatter,\n        )\n\n    def format_body(self, body: str, mime: str) -> str:\n        lexer = self.get_lexer_for_body(mime, body)\n        if lexer:\n            body = pygments.highlight(\n                code=body,\n                lexer=lexer,\n                formatter=self.formatter,\n            )\n        return body\n\n    def get_lexer_for_body(\n        self,\n        mime: str,\n        body: str,\n    ) -> Optional[pygments.lexer.Lexer]:\n        if self.kwargs['mime'] == HTTPIE_MIME_TYPE:\n            lexer_class = HTTPLexer\n        else:\n            try:\n                lexer_class = get_lexer_for_filename(\n                    filename=f'.{self.kwargs[\"mime\"]}',\n                    code=body,\n                )\n            except ClassNotFound:\n                return None\n        return lexer_class(\n            ensurenl=False,\n            disabledmodules=['_mapping'],\n        )\n```\n\nArgh, I keep producing the same uncertain code. The `lexer_class(ensurenl=False, ...)` on an instance bothers me. Let me think about whether pygments Lexer instances are callable...\n\nActually! I remembe