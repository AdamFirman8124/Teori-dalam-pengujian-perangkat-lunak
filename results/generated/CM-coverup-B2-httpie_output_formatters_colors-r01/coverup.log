exer_mime_type_candidates_tried_in_order():\n    # 'application/vnd.api+json' itself is unknown to pygments, but the\n    # generated 'application/json' candidate resolves via the mime table.\n    lexer = get_lexer('application/vnd.api+json')\n    assert type(lexer) is json_lexer_class()\n\n\ndef test_get_lexer_explicit_json_overrides_text_lexer():\n    # A JSON body served as 'text/plain' gets the JSON lexer.\n    lexer = get_lexer('text/plain', explicit_json=True, body='{\"a\": [1, 2]}')\n    assert type(lexer) is json_lexer_class()\n    assert not isinstance(lexer, TextLexer)\n\n\ndef test_get_lexer_explicit_json_keeps_text_lexer_on_invalid_body():\n    # Invalid JSON body -> the TextLexer is kept as-is.\n    lexer = get_lexer('text/plain', explicit_json=True, body='{nope')\n    assert isinstance(lexer, TextLexer)\n\n\ndef test_get_lexer_explicit_json_no_override_for_json_lexer():\n    # Already a JSON lexer -> the explicit_json branch must not run.\n    lexer = get_lexer('application/json', explicit_json=True, body='{\"a\": 1}')\n    assert type(lexer) is json_lexer_class()\n\n\ndef test_get_lexer_explicit_json_overrides_missing_lexer():\n    # No lexer at all + valid JSON body -> JSON lexer.\n    lexer = get_lexer('foo/bar', explicit_json=True, body='[1, 2, 3]')\n    assert type(lexer) is json_lexer_class()\n\n\ndef test_get_lexer_explicit_json_invalid_body_no_lexer():\n    # No lexer + invalid JSON body -> still no lexer.\n    assert get_lexer('foo/bar', explicit_json=True, body='{') is None\n\n\ndef test_get_lexer_explicit_json_empty_body_is_ignored():\n    # Empty body short-circuits the explicit_json branch.\n    lexer = get_lexer('text/plain', explicit_json=True, body='')\n    assert isinstance(lexer, TextLexer)\n\n\ndef test_get_lexer_explicit_json_disabled():\n    # explicit_json=False -> the JSON sniffing branch must not run.\n    lexer = get_lexer('text/plain', explicit_json=False, body='{\"a\": 1}')\n    assert isinstance(lexer, TextLexer)\n```\n\nWai