        "content": "```python\nimport datetime\n\nimport pytest\nfrom tornado import gen\nfrom tornado.queues import Queue\nfrom tornado.testing import AsyncTestCase, gen_test\nfrom tornado.util import TimeoutError\n\n\nclass TestQueueGet(AsyncTestCase):\n    \"\"\"Tests covering tornado.queues.Queue.get (lines 248-254).\"\"\"\n\n    @gen_test\n    def test_get_immediate_result(self):\n        # Covers lines 248-250: get() on a non-empty queue resolves\n        # the future immediately via get_nowait().\n        q = Queue()\n        q.put_nowait(\"item\")\n        future = q.get()\n        assert future.done()\n        result = await future\n        assert result == \"item\"\n        assert q.empty()\n\n    @gen_test\n    def test_get_empty_appends_getter(self):\n        # Covers lines 251-253: get() on an empty queue catches QueueEmpty,\n        # appends the future to _getters and sets a timeout.\n        q = Queue()\n        future = q.get()\n        assert not future.done()\n        assert len(q._getters) == 1\n        assert q._getters[0] is future\n\n        # A later put resolves the waiting getter.\n        q.put_nowait(42)\n        result = await future\n        assert result == 42\n        assert len(q._getters) == 0\n\n    @gen_test\n    def test_get_timeout_numeric(self):\n        # Covers line 253 with a numeric (absolute-deadline) timeout:\n        # the future resolves with TimeoutError when nothing is put.\n        q = Queue()\n        future = q.get(timeout=0.05)\n        assert len(q._getters) == 1\n        with pytest.raises(TimeoutError):\n            await future\n        # The expired getter has been consumed from _getters.\n        assert len(q._getters) == 0\n\n    @gen_test\n    def test_get_timeout_timedelta(self):\n        # Covers line 253 with a datetime.timedelta timeout.\n        q = Queue()\n        future = q.get(timeout=datetime.timedelta(seconds=0.05))\n        assert len(q._getters) == 1\n        with pytest.raises(TimeoutError):\n            await future\n        assert len(q._getters) == 0\n\n    @gen_test\n    def test_get_timeout_cancelled_by_put(self):\n        # A pending getter with a timeout still resolves normally if an\n        # item arrives before the deadline.\n        q = Queue()\n        future = q.get(timeout=30)\n        assert len(q._getters) == 1\n        q.put_nowait(\"fast\")\n        result = await future\n        assert result == \"fast\"\n        assert len(q._getters) == 0\n```",
