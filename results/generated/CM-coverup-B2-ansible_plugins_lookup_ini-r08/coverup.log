lookup, '_loader', loader)\n\n    lookup._set_options_call = recorded\n    return lookup\n\n\ndef test_set_options_receives_variables_and_direct_kwargs(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key'], variables={'x': 1}) == ['value']\n    assert lookup._set_options_call == {'var_options': {'x': 1}, 'direct': {}}\n\n\ndef test_simple_key_found(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key'], variables={}) == ['value']\n\n\ndef test_multiple_terms_are_accumulated(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key', 'other'], variables={}) == ['value', 'ovalue']\n\n\ndef test_keys_match_case_insensitively_by_default(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n')\n    assert lookup.run(['key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_optionxform_finds_exact_case(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n', case_sensitive=True)\n    assert lookup.run(['Key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_optionxform_misses_other_case(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n', case_sensitive=True)\n    assert lookup.run(['key'], variables={}) == []\n\n\ndef test_missing_key_without_default_yields_nothing(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['missing'], variables={}) == []\n\n\ndef test_missing_key_falls_back_to_scalar_default(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default='fallback')\n    assert lookup.run(['missing'], variables={}) == ['fallback']\n\n\ndef test_mutable_sequence_default_is_appended_item_by_item(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default=['d1', 'd2'])\n    assert lookup.run(['missing'], variables={}) == ['d1', 'd2']\n\n\ndef test_regexp_lookup_returns_every_match(monkeypatch, tmp_path):\n    lookup = _make_lookup(\n        monkeypatch, tmp_path,\n        content='[global]\\nkey1 = v1\\nkey2 = v2\\nother = ov\\n', re=True)\n    assert lookup.run(['key.'], variables={}) == ['v1', 'v2']\n\n\ndef test_inline_parameters_override_options(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key file=ansible.ini section=other_section'], variables={}) == ['ovalue2']\n\n\ndef test_inline_parameters_preserve_spaces_in_the_key(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nother key = ovalue\\n')\n    assert lookup.run(['other key file=ansible.ini'], variables={}) == ['ovalue']\n\n\ndef test_inline_unknown_option_is_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleLookupError, match='bogus is not a valid option'):\n        lookup.run(['bogus=1'], variables={})\n\n\ndef test_inline_value_with_extra_equals_is_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleLookupError, match=\"Could not use 'key=a=b'\"):\n        lookup.run(['key=a=b'], variables={})\n\n\ndef test_inline_options_without_a_key_are_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleOptionsError, match='No key to lookup was provided'):\n        lookup.run(['file=ansible.ini'], variables={})\n\n\ndef test_properties_type_uses_synthetic_java_properties_section(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='key=javavalue\\n', type='properties')\n    assert lookup.run(['key'], variables={}) == ['javavalue']\n\n\ndef test_duplicate_option_is_reported(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]