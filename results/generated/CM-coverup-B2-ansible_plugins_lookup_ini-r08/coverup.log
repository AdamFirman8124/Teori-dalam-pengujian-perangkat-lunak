\ndef test_multiple_terms_accumulate(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key', 'other'], variables={}) == ['value', 'ovalue']\n\n\ndef test_case_insensitive_by_default(monkeypatch, tmp_path):\n    content = '[global]\\nKey = value\\n'\n    lookup = _make_lookup(monkeypatch, tmp_path, content=content)\n    assert lookup.run(['key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_match(monkeypatch, tmp_path):\n    content = '[global]\\nKey = value\\n'\n    lookup = _make_lookup(monkeypatch, tmp_path, content=content, case_sensitive=True)\n    assert lookup.run(['Key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_no_match_returns_empty(monkeypatch, tmp_path):\n    content = '[global]\\nKey = value\\n'\n    lookup = _make_lookup(monkeypatch, tmp_path, content=content, case_sensitive=True)\n    assert lookup.run(['key'], variables={}) == []\n\n\ndef test_missing_key_without_default_yields_nothing(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['missing'], variables={}) == []\n\n\ndef test_missing_key_with_scalar_default(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default='fallback')\n    assert lookup.run(['missing'], variables={}) == ['fallback']\n\n\ndef test_missing_key_with_list_default_extends_result(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default=['d1', 'd2'])\n    assert lookup.run(['missing'], variables={}) == ['d1', 'd2']\n\n\ndef test_inline_params(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key file=ansible.ini section=global'], variables={}) == ['value']\n\n\ndef test_inline_params_only_first_token_is_key(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['other key'], variables={}) == ['ovalue']\n\n\ndef test_inline_params_invalid_option_name(monkeypatch, tmp_path