713.\n\nNow, writing the final answer. Also \u2014 \"Write as little top-level code as possible\" \u2014 imports + constants + helper + tests. That's necessary. No main block. \u2713.\n\nOne last consideration \u2014 flake8-ish cleanliness: unused imports? I import `mock` (used), `pytest` (used), errors (used), LookupModule (used). \u2713.\n\nAlso, should I guard against `paramvals.get('allow_none')` when 'allow_none' absent \u2192 None \u2192 allow_no_value=None? ConfigParser(allow_no_value=None) \u2014 falsy \u2192 OK. \u2713 (default tests).\n\nFinal code below. Let me write it carefully.\n\n```python\n\"\"\"Unit tests for ansible/plugins/lookup/ini.py::LookupModule.run (lines 138-204).\"\"\"\n\nfrom unittest import mock\n\nimport pytest\n\nfrom ansible.errors import AnsibleLookupError, AnsibleOptionsError\nfrom ansible.plugins.lookup.ini import LookupModule\n\n\nDEFAULT_PARAMS = {\n    'file': 'ansible.ini',\n    'section': 'global',\n    'default': None,\n    're': False,\n    'type': 'ini',\n    'encoding': 'utf-8',\n    'case_sensitive': False,\n    'allow_no_value': False,\n}\n\nBASIC_INI = (\n    '[global]\\n'\n    'key = value\\n'\n    'other = ovalue\\n'\n    '\\n'\n    '[other_section]\\n'\n    'key = ovalue2\\n'\n)\n\n\ndef _make_lookup(monkeypatch, tmp_path, content=BASIC_INI, params=None, **overrides):\n    \"\"\"Build a LookupModule with option handling, file resolution and data\n    loading stubbed away so that only the logic of LookupModule.run() runs.\n\n    The stubs are installed with monkeypatch on a throwaway instance, so they\n    are undone automatically and no global state is touched.\n    \"\"\"\n    if params is None:\n        params = dict(DEFAULT_PARAMS)\n        params.update(overrides)\n\n    ini_path = tmp_path / params['file']\n    ini_path.write_bytes(content.encode(params['encoding']))\n\n    lookup = LookupModule()\n\n    recorded = {}\n\n    def fake_set_options(*args, **kwargs):\n        recorded.update(kwargs)\n\n    monkeypatch.setattr(lookup, 'set_options', fake_set_options)\n    monkeypatch.setattr(lookup, 'get_options', lambda: params)\n    monkeypatch.setattr(lookup, '_deprecate_inline_kv', lambda: None)\n    monkeypatch.setattr(lookup, 'find_file_in_search_path', lambda *args, **kwargs: str(ini_path))\n\n    loader = mock.MagicMock()\n    loader._get_file_contents.return_value = (content.encode(params['encoding']), False)\n    monkeypatch.setattr(lookup, '_loader', loader)\n\n    lookup._set_options_call = recorded\n    return lookup\n\n\ndef test_set_options_receives_variables_and_direct_kwargs(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key'], variables={'x': 1}) == ['value']\n    assert lookup._set_options_call == {'var_options': {'x': 1}, 'direct': {}}\n\n\ndef test_simple_key_found(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key'], variables={}) == ['value']\n\n\ndef test_multiple_terms_are_accumulated(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key', 'other'], variables={}) == ['value', 'ovalue']\n\n\ndef test_keys_match_case_insensitively_by_default(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n')\n    assert lookup.run(['key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_optionxform_finds_exact_case(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n', case_sensitive=True)\n    assert lookup.run(['Key'], variables={}) == ['value']\n\n\ndef test_case_sensitive_optionxform_misses_other_case(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nKey = value\\n', case_sensitive=True)\n    assert lookup.run(['key'], variables={}) == []\n\n\ndef test_missing_key_without_default_yields_nothing(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['missing'], variables={}) == []\n\n\ndef test_missing_key_falls_back_to_scalar_default(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default='fallback')\n    assert lookup.run(['missing'], variables={}) == ['fallback']\n\n\ndef test_mutable_sequence_default_is_appended_item_by_item(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, default=['d1', 'd2'])\n    assert lookup.run(['missing'], variables={}) == ['d1', 'd2']\n\n\ndef test_regexp_lookup_returns_every_match(monkeypatch, tmp_path):\n    lookup = _make_lookup(\n        monkeypatch, tmp_path,\n        content='[global]\\nkey1 = v1\\nkey2 = v2\\nother = ov\\n', re=True)\n    assert lookup.run(['key.'], variables={}) == ['v1', 'v2']\n\n\ndef test_inline_parameters_override_options(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    assert lookup.run(['key file=ansible.ini section=other_section'], variables={}) == ['ovalue2']\n\n\ndef test_inline_parameters_preserve_spaces_in_the_key(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nother key = ovalue\\n')\n    assert lookup.run(['other key file=ansible.ini'], variables={}) == ['ovalue']\n\n\ndef test_inline_unknown_option_is_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleLookupError, match='bogus is not a valid option'):\n        lookup.run(['bogus=1'], variables={})\n\n\ndef test_inline_value_with_extra_equals_is_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleLookupError, match=\"Could not use 'key=a=b'\"):\n        lookup.run(['key=a=b'], variables={})\n\n\ndef test_inline_options_without_a_key_are_rejected(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path)\n    with pytest.raises(AnsibleOptionsError, match='No key to lookup was provided'):\n        lookup.run(['file=ansible.ini'], variables={})\n\n\ndef test_properties_type_uses_synthetic_java_properties_section(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='key=javavalue\\n', type='properties')\n    assert lookup.run(['key'], variables={}) == ['javavalue']\n\n\ndef test_duplicate_option_is_reported(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nkey = a\\nkey = b\\n')\n    with pytest.raises(AnsibleLookupError, match='Duplicate option'):\n        lookup.run(['key'], variables={})\n\n\ndef test_missing_section_is_reported(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, section='nope')\n    with pytest.raises(AnsibleLookupError, match=\"No section 'nope' in ansible.ini\"):\n        lookup.run(['key'], variables={})\n\n\ndef test_allow_no_value_accepts_valueless_entries(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nemptykey\\n', allow_no_value=True)\n    assert lookup.run(['emptykey'], variables={}) == []\n\n\ndef test_allow_none_is_used_when_allow_no_value_is_absent(monkeypatch, tmp_path):\n    params = dict(DEFAULT_PARAMS, allow_none=True)\n    del params['allow_no_value']\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nemptykey\\n', params=params)\n    assert lookup.run(['emptykey'], variables={}) == []\n\n\ndef test_encoding_option_is_honoured(monkeypatch, tmp_path):\n    lookup = _make_lookup(monkeypatch, tmp_path, content='[global]\\nkey = caf\u00e9\\n', encoding='latin-1')\n    assert lookup.run(['key'], variables={}) == ['caf\u00e9']\n```\n\nWait \u2014 `test_set_options_receives_variables_and_direct_kwargs`: run(['key'], variables={'x': 1}) \u2192 set_options(var_options={'x':1}, direct={}). recorded == {'var_options': {'x':1}, 'direct': {}}. \u2713.\n\nHmm \u2014 one issue: in `test_inline_parameters_override_options`, term 'key file=ansible.ini section=other_section' \u2014 c