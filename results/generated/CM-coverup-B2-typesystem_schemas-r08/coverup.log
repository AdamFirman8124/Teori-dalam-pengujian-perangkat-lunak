ema(Person())\n    assert instance.name == \"bar\"\n    assert not hasattr(instance, \"age\")\n```\n\nKwargs tests:\n\n```python\ndef test_init_with_kwargs_validates_and_sets_fields(example_schema):\n    instance = example_schema(name=\"foo\", age=3)\n    assert instance.name == \"foo\"\n    assert instance.age == 3\n\ndef test_init_applies_field_defaults(example_schema):\n    instance = example_schema(name=\"foo\")\n    assert instance.name == \"foo\"\n    assert instance.age == 0\n\ndef test_init_leaves_field_unset_when_no_default():\n    class Example(typesystem.Schema):\n        name = typesystem.String()\n        age = typesystem.Integer()\n\n    instance = Example(name=\"foo\")\n    assert instance.name == \"foo\"\n    with pytest.raises(AttributeError):\n        instance.age\n```\n\nError tests:\n\n```python\ndef test_init_invalid_kwarg_value_raises_type_error(example_schema):\n    with pytest.raises(TypeError) as excinfo:\n        example_schema(name=\"x\" * 11)\n    message = str(excinfo.value)\n    assert \"Invalid argument 'name' for Example().\" in message\n    assert \"Must have at most 10 characters.\" in message\n\ndef test_init_unknown_kwarg_raises_type_error(example_schema):\n    with pytest.raises(TypeError) as excinfo:\n        example_schema(name=\"foo\", unknown=1)\n    assert str(excinfo.value) == \"'unknown' is an invalid keyword argument for Example().\"\n```\n\nAssertion tests:\n\n```python\ndef test_init_with_multiple_positional_args_raises_assertion_error(example_schema):\n    with pytest.raises(AssertionError):\n        example_schema({}, {})\n\ndef test_init_with_positional_arg_and_kwargs_raises_assertion_error(example_schema):\n    with pytest.raises(AssertionError):\n        example_schema({}, name=\"foo\")\n```\n\nWait \u2014 careful with `example_schema({}, {})`: `assert len(args) == 1` fails first. Good. `example_schema({}, name=\"foo\")`: len(args)==1 passes, `assert not kwargs` fails. Good.\n\nHmm, one thing about the fixture: `ex