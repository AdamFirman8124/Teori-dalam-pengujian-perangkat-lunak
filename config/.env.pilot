# Salin file ini menjadi config/.env, lalu isi credential lokal.
# Jangan commit config/.env atau backup credential ke Git.
# OctaLabs adalah gateway OpenAI-compatible; token ini dipakai sebagai Bearer
# credential untuk CoverUp dan CODAMOSA, bukan sebagai key native OpenAI.
OCTA_API_KEY=srbyte_0a2cca5c2cdff690018c69db4103f7a6c9da1deeb3336a997b442a61b7bd85e6

# Internal compatibility aliases are populated automatically from OCTA_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://stream.srbyte.id/v1
OPENAI_API_BASE=https://stream.srbyte.id/v1

# CoverUp memakai prefix transport LiteLLM `openai/`.
# ID model yang dikirim ke OctaLabs tetap bare, tanpa prefix tersebut.
# Provider SrByte hanya mengekspos alias `auto`; label hasil memakai backbone
# sebenarnya `gpt-5.6-sol`.
COVERUP_MODELS=openai/auto
COVERUP_TIMEOUT=600
MODEL_ALIASES=auto=gpt-5.6-sol

# CODAMOSA mengirim bare model ID langsung ke chat-completions.
CODAMOSA_MODELS=auto
CODAMOSA_BASE_URL=https://stream.srbyte.id/v1
CODAMOSA_API_KEY=
CODAMOSA_API_STYLE=chat
CODAMOSA_COMPLETIONS_PATH=/chat/completions
# Separate connect/read timeout for the cheap CODAMOSA API preflight.
CODAMOSA_PREFLIGHT_TIMEOUT=90
CODAMOSA_POPULATION=5
# Retry a complete generator invocation when the provider/container fails transiently.
GENERATOR_ATTEMPTS=3
GENERATOR_RETRY_SECONDS=3
# Pilot: batasi evaluasi ke 25 mutant pertama per task agar cepat.
# 0 = evaluasi SEMUA mutant (untuk data paper final).
EVAL_MUTANT_LIMIT=0
# Gunakan semua thread kecuali CPU_RESERVED_THREADS (untuk desktop + remote).
CPU_RESERVED_THREADS=2
# 3 pipeline task paralel; tiap pipeline mengevaluasi 2 mutant sekaligus.
EVAL_MUTANT_WORKERS=2
TASK_WORKERS=4
# Hard CPU limit for each CODAMOSA Docker container.
CODAMOSA_DOCKER_CPUS=2

CODAMOSA_IMAGE=pynguin-runner:latest
# Percepat pencarian CODAMOSA per task (detik). 60 = default paper, 30 = pilot cepat.
CODAMOSA_SEARCH_SECONDS=600

TASK_LIMIT=None
CLEAR_OLD_OUTPUTS=1

# --- Model discovery --------------------------------------------------------
# Sebelum eksperimen, cell readiness memeriksa CPU/RAM/disk/paket/Docker dan
# mendeteksi WSL + selisih jam secara otomatis. Konfigurasi di bawah hanya
# tuning; nilai bawaan sudah aman untuk PC 24 jam.
MODEL_DISCOVERY_PROBE_ALL=1
# Hanya model tetap yang dibandingkan di eksperimen.
MODEL_DISCOVERY_FAMILY_FILTER=^gpt-5\.6-sol$
# 0 = pakai COVERUP_MODELS/CODAMOSA_MODELS saja (satu model tetap).
MODEL_DISCOVERY_USE_ALL=0
# 0 = tanpa batas jumlah model.
MODEL_DISCOVERY_MAX_MODELS=0
MODEL_DISCOVERY_WORKERS=8

# --- Rate limit -------------------------------------------------------------
# Preflight memprobe banyak model. Serialisasi request agar tidak melebihi
RPM_LIMIT=40
# Backoff saat kena HTTP 429: attempts x kenaikan detik.
RPM_RETRY_ATTEMPTS=4
RPM_RETRY_WAIT=5

# --- Filter / resume opsional ----------------------------------------------
# Kosong = semua dataset/task dipakai.
TASK_FILTER=MT:f001,MT:f002,MT:f003,MT:f004,MT:f005,CM:httpie.output.formatters.headers,CM:py_backwards.conf,CM:pytutils.path
# 1 = lanjutkan dari task yang sudah OK (aman untuk PC 24 jam).
RESUME=0
# 1 = tampilkan log per model di cell generator (CoverUp mencoba/OK/skip).
VERBOSE_TASK_LOG=1
# Instal otomatis paket Python yang hilang di cell readiness (0 = BLOCKED manual).
AUTO_INSTALL=0

# --- Auto scale-up ----------------------------------------------------------
# 1 = naikkan TASK_WORKERS otomatis bila PC kuat. Selalu sisakan thread untuk
# navigasi + koneksi remote; tidak pernah melewati CONFIG_MAX_LOAD.
AUTO_SCALE=1
CONFIG_MAX_LOAD=4

# --- Clock drift ------------------------------------------------------------
# Batas selisih jam lokal vs provider: peringatan di atas WARN, BLOCKED di atas BLOCK.
CLOCK_WARN_SECONDS=120
CLOCK_BLOCK_SECONDS=900
CODAMOSA_RAM_GB_PER_WORKER=1
DESKTOP_HEADROOM_GB=2
PAPER_BUDGET_SECONDS=600
N_REPEATS=2
FLAKY_REPEATS=5
RESULTS_DIR=experiment_results_pilot
RUN_LABEL=pilot-fase6-r2-600s
FRESH=1
PYNGUIN_BASELINE=1
GEN_WORKERS=4
EVAL_WORKERS=2
PASS_RATE_ISOLATED=0
CODAMOSA_MEMORY_LIMIT=700m
