# Salin file ini menjadi `.env`, lalu isi credential lokal.
# Jangan commit `.env` atau backup credential ke Git.
# OctaLabs adalah gateway OpenAI-compatible; token ini dipakai sebagai Bearer
# credential untuk CoverUp dan CODAMOSA, bukan sebagai key native OpenAI.
OCTA_API_KEY=

# Internal compatibility aliases are populated automatically from OCTA_API_KEY.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://router.octalabs.id/v1
OPENAI_API_BASE=https://router.octalabs.id/v1

# CoverUp memakai prefix transport LiteLLM `openai/`.
# ID model yang dikirim ke OctaLabs tetap bare, tanpa prefix tersebut.
COVERUP_MODELS=openai/gpt-5.6-sol
COVERUP_TIMEOUT=900

# CODAMOSA mengirim bare model ID langsung ke chat-completions.
CODAMOSA_MODELS=gpt-5.6-sol
CODAMOSA_BASE_URL=https://router.octalabs.id/v1
CODAMOSA_API_KEY=
CODAMOSA_API_STYLE=chat
CODAMOSA_COMPLETIONS_PATH=/chat/completions
# Separate connect/read timeout for the cheap CODAMOSA API preflight.
CODAMOSA_PREFLIGHT_TIMEOUT=90
CODAMOSA_SEARCH_SECONDS=60
CODAMOSA_POPULATION=5
# Retry a complete generator invocation when the provider/container fails transiently.
GENERATOR_ATTEMPTS=3
GENERATOR_RETRY_SECONDS=3
# Pilot only: evaluate at most 25 mutants per task; use 0/all for full evaluation.
EVAL_MUTANT_LIMIT=0
# Conservative-but-faster profile for a 12-core / 14-GiB machine:
# three task pipelines in parallel, one mutant subprocess per pipeline.
EVAL_MUTANT_WORKERS=1
TASK_WORKERS=3
# Hard CPU limit for each CODAMOSA Docker container.
CODAMOSA_DOCKER_CPUS=2

CODAMOSA_IMAGE=pynguin-runner:latest

# Trustworthy multi-model pilot; use all only after this pilot is valid.
TASK_LIMIT=5
CLEAR_OLD_OUTPUTS=1

# --- Model discovery --------------------------------------------------------
# Sebelum eksperimen, daftar semua model dari /models lalu probe tiap model
# dengan request 1 token (0 = nonaktif). Laporan ditulis ke
# experiment_results/model_discovery/ (model_discovery.json + .md).
MODEL_DISCOVERY_PROBE_ALL=1
# Hanya keluarga model yang dibandingkan di eksperimen.
MODEL_DISCOVERY_FAMILY_FILTER=gpt-5.6-sol
# 0 = pakai COVERUP_MODELS/CODAMOSA_MODELS saja (satu model tetap).
MODEL_DISCOVERY_USE_ALL=0
# 0 = tanpa batas jumlah model.
MODEL_DISCOVERY_MAX_MODELS=0
MODEL_DISCOVERY_WORKERS=8

# --- Rate limit -------------------------------------------------------------
# Preflight memprobe banyak model. Serialisasi request agar tidak melebihi
# kuota provider (50 = satu request setiap 1,2 detik).
RPM_LIMIT=50
# Backoff saat kena HTTP 429: attempts x kenaikan detik.
RPM_RETRY_ATTEMPTS=4
RPM_RETRY_WAIT=5

# --- Filter / resume opsional ----------------------------------------------
# Kosong = semua dataset/task dipakai.
TASK_FILTER=
# 0 = jalankan dari awal.
RESUME=0
